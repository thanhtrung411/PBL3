                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-dark px-4" onclick="submitAddBooking()">Xác nhận đặt phòng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Filter Logic
            $('.booking-stats-tile').click(function() {
                $('.booking-stats-tile').removeClass('active');
                $(this).addClass('active');
                filterList();
            });

            // Search Logic
            $('#bookingSearchInput').on('input', function() {
                filterList();
            });

            function filterList() {
                var searchText = $('#bookingSearchInput').val().toLowerCase();
                var activeTile = $('.booking-stats-tile.active');
                var activeFilter = activeTile.data('filter');

                $('.booking-card').each(function() {
                    var card = $(this);
                    var name = (card.data('name') || '').toLowerCase();
                    var id = (card.data('id') || '').toLowerCase();
                    var status = card.data('status');

                    var matchesSearch = name.includes(searchText) || id.includes(searchText);
                    var matchesFilter = (activeFilter === 'all') || (status === activeFilter);

                    if (matchesSearch && matchesFilter) {
                        card.show();
                    } else {
                        card.hide();
                    }
                });

                // Show no results if all hidden
                if ($('.booking-card:visible').length === 0) {
                    if ($('#no-results-msg').length === 0) {
                        $('#bookingList').append('<div id="no-results-msg" class="text-center py-5 text-muted"><i class="bi bi-search fs-1 d-block mb-3"></i>Không tìm thấy kết quả phù hợp.</div>');
                    }
                } else {
                    $('#no-results-msg').remove();
                }
            }

            // Initial filter
            filterList();
        });

        function showBookingDetail(id) {
            var card = $('.booking-card[data-id="' + id + '"]');
            
            // Populate modal with card data
            $('#modalGuestName').text(card.data('name'));
            $('#modalPhone').text(card.data('phone'));
            $('#modalEmail').text(card.data('email'));
            $('#modalAddress').text(card.data('address'));
            
            $('#modalRoomNo').text(card.data('room'));
            $('#modalRoomType').text(card.data('roomtype'));
            $('#modalCheckin').text(card.data('checkin'));
            $('#modalCheckout').text(card.data('checkout'));
            $('#modalNights').text(card.data('nights'));
            $('#modalGuests').text(card.data('guests'));
            
            // Update status badge in modal
            var status = card.data('status');
            var statusText = "Đang ở";
            if(status === 'arrival') statusText = "Sắp đến";
            if(status === 'departure') statusText = "Sắp đi";
            $('#modalStatus').text(statusText);

            var modal = new bootstrap.Modal(document.getElementById('bookingDetailModal'));
            modal.show();
        }

        function submitAddBooking() {
            // Demo logic
            alert("Đã thêm đặt phòng mới thành công!");
            var modal = bootstrap.Modal.getInstance(document.getElementById('addBookingModal'));
            modal.hide();
        }
    </script>
}
