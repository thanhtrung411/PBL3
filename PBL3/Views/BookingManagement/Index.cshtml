@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý đặt phòng";
}

<style>
    :root {
        --bs-card-border-radius: 12px;
        --color-arrival: #108e66;
        --color-staying: #2563eb;
        --color-departure: #c2410c;
        --color-all: #fde047;
    }

    .booking-stats-tile {
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: none;
        border-radius: 20px;
        position: relative;
        overflow: hidden;
        min-height: 100px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
        padding: 1.25rem;
        text-align: center;
    }

    .booking-stats-tile i {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
    }

    .booking-stats-tile:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
    }

    .booking-stats-tile.active {
        box-shadow: 0 0 0 4px rgba(0,0,0,0.1);
        transform: scale(1.05);
    }

    .tile-arrival { 
        background: linear-gradient(135deg, #10b981 0%, #059669 100%); 
    }
    .tile-staying { 
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); 
    }
    .tile-departure { 
        background: linear-gradient(135deg, #f97316 0%, #ea580c 100%); 
    }
    .tile-all { 
        background: linear-gradient(135deg, #fde047 0%, #facc15 100%); 
        color: #854d0e; 
    }
    .tile-all i { color: #854d0e; }

    .search-container {
        max-width: 100%;
        margin: 0 auto 2.5rem;
    }

    .booking-card {
        background: white;
        border-radius: 16px;
        border: 1px solid #f1f5f9;
        transition: all 0.3s ease;
        margin-bottom: 1.5rem;
        padding: 1.5rem;
        box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
    }

    .booking-card:hover {
        box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
    }

    .info-block {
        background-color: #f8fafc;
        border-radius: 12px;
        padding: 1rem;
        display: flex;
        justify-content: space-between;
        gap: 1rem;
    }

    .info-item {
        flex: 1;
        text-align: center;
    }

    .info-label {
        font-size: 0.75rem;
        color: #64748b;
        margin-bottom: 0.25rem;
    }

    .info-value {
        font-weight: 700;
        color: #1e293b;
        font-size: 0.9rem;
    }

    .status-badge {
        padding: 0.4rem 0.8rem;
        border-radius: 30px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .badge-confirmed { background-color: #d1fae5; color: #065f46; }
    .badge-paid { background-color: #dcfce7; color: #166534; }
    .badge-inhouse { background-color: #dbeafe; color: #1e40af; }

    .btn-view-details {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e2e8f0;
        background: white;
        transition: all 0.2s;
    }

    .btn-view-details:hover {
        background-color: #f1f5f9;
        color: #2563eb;
    }

    /* Modal styling */
    .modal-custom-header {
        border: none;
        padding: 1.5rem;
    }

    .detail-section-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
        color: #1e293b;
    }

    .detail-item-box {
        background-color: #f1f5f9;
        border-radius: 12px;
        padding: 0.75rem 1rem;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .detail-item-box i {
        color: #64748b;
        font-size: 1.1rem;
    }

    .detail-item-label {
        font-size: 0.7rem;
        color: #64748b;
        display: block;
    }

    .detail-item-value {
        font-weight: 600;
        color: #1e293b;
    }

    .note-box {
        background-color: #fefce8;
        border-radius: 12px;
        padding: 1rem;
        border-left: 4px solid #facc15;
    }

    .btn-payment {
        background-color: #dcfce7;
        color: #166534;
        border: none;
        border-radius: 8px;
        padding: 0.5rem 1.5rem;
        font-weight: 600;
        transition: all 0.2s;
    }
    
    .btn-payment:hover {
        background-color: #bbf7d0;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1 fw-bold">Quản lý đặt phòng</h3>
