@model PBL3.Models.AdminBookingManagementViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý đặt phòng";
}

<style>
    :root {
        --booking-bg: #f7f9fc;
        --booking-surface: #ffffff;
        --booking-soft: #f1f6fb;
        --booking-ink: #142033;
        --booking-muted: #66758a;
        --booking-line: #dfe7f0;
        --booking-blue: #1f6feb;
        --booking-blue-soft: #eaf2ff;
        --booking-green: #168a55;
        --booking-green-soft: #e9f8f0;
        --booking-orange: #d97706;
        --booking-orange-soft: #fff7e6;
        --booking-red: #b42318;
        --booking-radius: 8px;
        --booking-shadow: 0 16px 38px rgba(20, 32, 51, 0.08);
    }

    .admin-booking-page {
        color: var(--booking-ink);
    }

    .booking-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        min-height: 44px;
        margin-bottom: 22px;
    }

    .booking-page-header h1 {
        margin: 0;
        color: #111827;
        font-size: 1.45rem;
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: 0;
    }

    .booking-page-header p {
        margin: 8px 0 0;
        color: var(--booking-muted);
        display: none;
        font-size: 1rem;
        font-weight: 560;
    }

    .booking-primary-btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 0;
        border-radius: var(--booking-radius);
        background: #111827;
        color: #ffffff;
        font-weight: 750;
        padding: 9px 16px;
        box-shadow: none;
    }

    .booking-primary-btn:hover,
    .booking-primary-btn:focus-visible {
        background: #000000;
        color: #ffffff;
        outline: none;
    }

    .booking-control-panel,
    .booking-list-panel {
        border: 1px solid var(--booking-line);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.96);
        box-shadow: var(--booking-shadow);
    }

    .booking-control-panel {
        display: grid;
        gap: 16px;
        margin-bottom: 18px;
        padding: 18px;
    }

    .booking-search-box {
        min-height: 48px;
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px solid var(--booking-line);
        border-radius: var(--booking-radius);
        background: #ffffff;
        padding: 0 14px;
    }

    .booking-search-box i {
        color: var(--booking-muted);
        font-size: 1.05rem;
    }

    .booking-search-box input {
        width: 100%;
        border: 0;
        outline: none;
        color: var(--booking-ink);
        font-size: 0.98rem;
        font-weight: 560;
    }

    .booking-filter-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
    }

    .booking-filter-card {
        min-height: 66px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        border: 1px solid var(--booking-line);
        border-radius: var(--booking-radius);
        background: #ffffff;
        color: var(--booking-muted);
        padding: 12px 14px;
        text-align: left;
        transition: border-color 0.16s ease, background 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
    }

    .booking-filter-card strong,
    .booking-filter-card span {
        display: block;
    }

    .booking-filter-card strong {
        color: var(--booking-ink);
        font-size: 0.96rem;
        font-weight: 820;
    }

    .booking-filter-card span {
        margin-top: 2px;
        color: var(--booking-muted);
        font-size: 0.78rem;
        font-weight: 680;
    }

    .booking-filter-card i {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        background: var(--booking-soft);
        color: var(--booking-blue);
        font-size: 1.05rem;
        flex: 0 0 auto;
    }

    .booking-filter-card.active {
        border-color: rgba(31, 111, 235, 0.28);
        background: var(--booking-blue-soft);
        box-shadow: inset 3px 0 0 var(--booking-blue);
    }

    .booking-filter-card.active strong,
    .booking-filter-card.active span {
        color: var(--booking-blue);
    }

    .booking-list-panel {
        padding: 18px;
    }

    .booking-list-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
    }

    .booking-list-title h2 {
        margin: 0;
        color: var(--booking-ink);
        font-size: 1.18rem;
        font-weight: 850;
    }

    .booking-count-pill {
        border-radius: 999px;
        background: var(--booking-blue-soft);
        color: var(--booking-blue);
        font-size: 0.82rem;
        font-weight: 820;
        padding: 7px 11px;
        white-space: nowrap;
    }

    .booking-card-list {
        display: grid;
        gap: 12px;
    }

    .booking-card {
        display: grid;
        grid-template-columns: minmax(240px, 1.2fr) minmax(260px, 1fr) minmax(190px, 0.7fr) auto;
        align-items: center;
        gap: 18px;
        border: 1px solid var(--booking-line);
        border-radius: var(--booking-radius);
        background: #ffffff;
        padding: 16px 18px;
        transition: border-color 0.16s ease, box-shadow 0.16s ease, transform 0.16s ease;
    }

    .booking-card:hover {
        border-color: rgba(31, 111, 235, 0.22);
        box-shadow: 0 12px 30px rgba(20, 32, 51, 0.08);
        transform: translateY(-1px);
    }

    .booking-guest-block {
        min-width: 0;
    }

    .booking-code {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 8px;
        border-radius: 999px;
        background: #f1f5f9;
        color: var(--booking-muted);
        font-size: 0.78rem;
        font-weight: 820;
        padding: 5px 9px;
    }

    .booking-guest-name {
        margin: 0;
        color: #111827;
        font-size: 1.02rem;
        font-weight: 850;
        line-height: 1.2;
    }

    .booking-room-line,
    .booking-meta-line {
        margin-top: 5px;
        color: var(--booking-muted);
        font-size: 0.9rem;
        font-weight: 620;
    }

    .booking-date-block {
        display: grid;
        gap: 8px;
    }

    .booking-info-row {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--booking-muted);
        font-size: 0.9rem;
        font-weight: 650;
    }

    .booking-info-row i {
        color: var(--booking-blue);
    }

    .booking-money-block {
        display: grid;
        gap: 8px;
        justify-items: start;
    }

    .booking-total {
        color: #111827;
        font-size: 1.05rem;
        font-weight: 880;
    }

    .booking-badge-row {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .booking-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 780;
        padding: 5px 9px;
        white-space: nowrap;
    }

    .booking-badge.confirmed,
    .booking-badge.paid {
        background: var(--booking-green-soft);
        color: var(--booking-green);
    }

    .booking-badge.unpaid {
        background: var(--booking-orange-soft);
        color: var(--booking-orange);
    }

    .booking-status-action {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
    }

    .booking-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border-radius: 999px;
        font-size: 0.86rem;
        font-weight: 820;
        padding: 8px 11px;
        white-space: nowrap;
    }

    .booking-status.arrival {
        background: var(--booking-green-soft);
        color: var(--booking-green);
    }

    .booking-status.staying {
        background: var(--booking-blue-soft);
        color: var(--booking-blue);
    }

    .booking-status.departure {
        background: var(--booking-orange-soft);
        color: var(--booking-orange);
    }

    .booking-status.completed {
        background: #f1f5f9;
        color: var(--booking-muted);
    }

    .booking-icon-btn {
        width: 42px;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--booking-line);
        border-radius: 999px;
        background: #ffffff;
        color: var(--booking-muted);
        transition: background 0.16s ease, color 0.16s ease, border-color 0.16s ease;
    }

    .booking-icon-btn:hover,
    .booking-icon-btn:focus-visible {
        border-color: rgba(31, 111, 235, 0.25);
        background: var(--booking-blue-soft);
        color: var(--booking-blue);
        outline: none;
    }

    .booking-empty-state {
        display: none;
        border: 1px dashed #cbd5e1;
        border-radius: var(--booking-radius);
        background: #fbfdff;
        color: var(--booking-muted);
        padding: 38px 16px;
        text-align: center;
        font-weight: 720;
    }

    .booking-empty-state.is-visible {
        display: block;
    }

    .booking-detail-modal .modal-content,
    .booking-create-modal .modal-content {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 26px 70px rgba(15, 23, 42, 0.24);
    }

    .booking-modal-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
        border-bottom: 1px solid var(--booking-line);
        padding: 22px 24px 18px;
    }

    .booking-modal-header h3 {
        margin: 0;
        color: #111827;
        font-size: 1.35rem;
        font-weight: 850;
    }

    .booking-modal-header p {
        margin: 5px 0 0;
        color: var(--booking-muted);
        font-size: 0.9rem;
        font-weight: 620;
    }

    .booking-modal-body {
        display: grid;
        gap: 16px;
        padding: 22px 24px 24px;
    }

    .booking-detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .booking-detail-section {
        border: 1px solid var(--booking-line);
        border-radius: var(--booking-radius);
        background: #ffffff;
        padding: 16px;
    }

    .booking-detail-section h4 {
        margin: 0 0 12px;
        color: #111827;
        font-size: 1rem;
        font-weight: 850;
    }

    .booking-detail-row,
    .booking-total-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        border-top: 1px solid #edf2f7;
        padding: 10px 0;
    }

    .booking-detail-row:first-of-type,
    .booking-total-row:first-child {
        border-top: 0;
        padding-top: 0;
    }

    .booking-detail-row span,
    .booking-total-row span {
        color: var(--booking-muted);
        font-weight: 680;
    }

    .booking-detail-row strong,
    .booking-total-row strong {
        color: #111827;
        font-weight: 760;
        text-align: right;
    }

    .booking-total-row.highlight {
        margin-top: 4px;
        border-radius: var(--booking-radius);
        background: var(--booking-blue-soft);
        color: var(--booking-blue);
        padding: 12px;
    }

    .booking-total-row.highlight span,
    .booking-total-row.highlight strong {
        color: var(--booking-blue);
    }

    .booking-create-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .booking-form-group {
        display: grid;
        gap: 7px;
    }

    .booking-form-group.full {
        grid-column: 1 / -1;
    }

    .booking-form-group label {
        color: var(--booking-muted);
        font-size: 0.84rem;
        font-weight: 760;
    }

    .booking-form-group input,
    .booking-form-group select,
    .booking-form-group textarea {
        width: 100%;
        border: 1px solid #dbe3ef;
        border-radius: var(--booking-radius);
        background: #ffffff;
        color: #111827;
        font-weight: 620;
        padding: 11px 12px;
        outline: none;
    }

    .booking-form-group textarea {
        resize: vertical;
    }

    .booking-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        border-top: 1px solid var(--booking-line);
        padding: 16px 24px 22px;
    }

    @@media (max-width: 1200px) {
        .booking-card {
            grid-template-columns: 1fr 1fr;
        }

        .booking-status-action {
            justify-content: flex-start;
        }
    }

    @@media (max-width: 900px) {
        .booking-page-header,
        .booking-list-title {
            align-items: flex-start;
            flex-direction: column;
        }

        .booking-filter-grid,
        .booking-card,
        .booking-detail-grid,
        .booking-create-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="admin-booking-page">
    <header class="booking-page-header">
        <div>
            <h1>Quản lý đặt phòng</h1>
        </div>
        <button type="button" class="booking-primary-btn" data-bs-toggle="modal" data-bs-target="#addBookingModal">
            <i class="bi bi-plus-lg"></i>
            Đặt phòng mới
        </button>
    </header>

    <section class="booking-control-panel" aria-label="Bộ lọc đặt phòng">
        <label class="booking-search-box" for="bookingSearchInput">
            <i class="bi bi-search"></i>
            <input type="search" id="bookingSearchInput" placeholder="Tìm theo tên khách, mã đặt phòng, số phòng..." autocomplete="off" />
        </label>

        <div class="booking-filter-grid">
            <button type="button" class="booking-filter-card active" data-filter="arrival">
                <div>
                    <strong>Khách đến hôm nay</strong>
                    <span>@Model.ArrivalCount đặt phòng</span>
                </div>
                <i class="bi bi-box-arrow-in-right"></i>
            </button>
            <button type="button" class="booking-filter-card" data-filter="staying">
                <div>
                    <strong>Đang ở</strong>
                    <span>@Model.StayingCount đặt phòng</span>
                </div>
                <i class="bi bi-house-check"></i>
            </button>
            <button type="button" class="booking-filter-card" data-filter="departure">
                <div>
                    <strong>Trả phòng hôm nay</strong>
                    <span>@Model.DepartureCount đặt phòng</span>
                </div>
                <i class="bi bi-box-arrow-right"></i>
            </button>
            <button type="button" class="booking-filter-card" data-filter="all">
                <div>
                    <strong>Tất cả đặt phòng</strong>
                    <span>@Model.TotalCount đặt phòng</span>
                </div>
                <i class="bi bi-collection"></i>
            </button>
        </div>
    </section>

    <section class="booking-list-panel">
        <div class="booking-list-title">
            <h2>Danh sách đặt phòng</h2>
            <span class="booking-count-pill" id="bookingVisibleCount">0 đặt phòng</span>
        </div>

        <div class="booking-card-list" id="bookingList">
            @foreach (var booking in Model.Bookings)
            {
                var phoneLabel = string.IsNullOrWhiteSpace(booking.Phone) ? "Chưa có SĐT" : booking.Phone;
                var emailLabel = string.IsNullOrWhiteSpace(booking.Email) ? "Chưa có email" : booking.Email;
                var addressLabel = string.IsNullOrWhiteSpace(booking.Address) ? "Chưa có địa chỉ" : booking.Address;
                var identityLabel = string.IsNullOrWhiteSpace(booking.IdentityNumber) ? "Chưa có CCCD/Hộ chiếu" : booking.IdentityNumber;
                <article class="booking-card"
                         data-status="@booking.FilterStatus"
                         data-statuses="@booking.FilterStatuses"
                         data-status-class="@booking.BookingStatusClass"
                         data-status-label="@booking.BookingStatusLabel"
                         data-status-icon="@booking.BookingStatusIcon"
                         data-name="@booking.GuestName"
                         data-id="@booking.BookingCode"
                         data-phone="@phoneLabel"
                         data-email="@emailLabel"
                         data-address="@addressLabel"
                         data-identity="@identityLabel"
                         data-room="@booking.RoomNumbers"
                         data-roomtype="@booking.RoomTypes"
                         data-room-summary="@booking.RoomSummary"
                         data-checkin="@booking.CheckInLabel"
                         data-checkout="@booking.CheckOutLabel"
                         data-created="@booking.CreatedAtLabel"
                         data-nights="@booking.NightsLabel"
                         data-guests="@booking.GuestsLabel"
                         data-total="@booking.TotalLabel"
                         data-paid="@booking.PaidLabel"
                         data-payment="@booking.PaymentStatusLabel">
                    <div class="booking-guest-block">
                        <span class="booking-code"><i class="bi bi-receipt"></i> @booking.BookingCode</span>
                        <h3 class="booking-guest-name">@booking.GuestName</h3>
                        <div class="booking-room-line">@booking.RoomSummary</div>
                        <div class="booking-meta-line">@phoneLabel · @emailLabel</div>
                    </div>
                    <div class="booking-date-block">
                        <div class="booking-info-row">
                            <i class="bi bi-calendar3"></i>
                            <span>@booking.DateRangeLabel</span>
                        </div>
                        <div class="booking-info-row">
                            <i class="bi bi-moon"></i>
                            <span>@booking.NightsLabel · @booking.GuestsLabel</span>
                        </div>
                    </div>
                    <div class="booking-money-block">
                        <div class="booking-total">@booking.TotalLabel</div>
                        <div class="booking-badge-row">
                            <span class="booking-badge confirmed"><i class="bi bi-check-circle-fill"></i> @booking.BookingStatusLabel</span>
                            <span class="booking-badge @booking.PaymentStatusClass">
                                <i class="bi @(booking.PaymentStatusClass == "paid" ? "bi-check-circle-fill" : "bi-clock")"></i>
                                @booking.PaymentStatusLabel
                            </span>
                        </div>
                    </div>
                    <div class="booking-status-action">
                        <span class="booking-status @booking.BookingStatusClass"><i class="bi @booking.BookingStatusIcon"></i> @booking.BookingStatusLabel</span>
                        <button type="button" class="booking-icon-btn" data-booking-detail="@booking.BookingCode" aria-label="Xem chi tiết @booking.BookingCode">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </article>
            }
        </div>

        <div class="booking-empty-state" id="bookingEmptyState">
            <i class="bi bi-search d-block fs-2 mb-2"></i>
            Không tìm thấy đặt phòng phù hợp.
        </div>
    </section>
</div>

<div class="modal fade booking-detail-modal" id="bookingDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="booking-modal-header">
                <div>
                    <h3>Chi tiết đặt phòng</h3>
                    <p id="modalBookingCode">BK001</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="booking-status staying" id="modalStatus"><i class="bi bi-house-check"></i> Đang ở</span>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
            </div>
            <div class="booking-modal-body">
                <div class="booking-detail-grid">
                    <section class="booking-detail-section">
                        <h4>Thông tin khách</h4>
                        <div class="booking-detail-row">
                            <span>Họ và tên</span>
                            <strong id="modalGuestName">Võ Thị Giang</strong>
                        </div>
                        <div class="booking-detail-row">
                            <span>Số điện thoại</span>
                            <strong id="modalPhone">0934567890</strong>
                        </div>
                        <div class="booking-detail-row">
                            <span>CCCD/Hộ chiếu</span>
                            <strong id="modalIdentity">Chưa có CCCD/Hộ chiếu</strong>
                        </div>
                        <div class="booking-detail-row">
                            <span>Email</span>
                            <strong id="modalEmail">vothigiang@gmail.com</strong>
                        </div>
                        <div class="booking-detail-row">
                            <span>Địa chỉ</span>
                            <strong id="modalAddress">Huế</strong>
                        </div>
                    </section>

                    <section class="booking-detail-section">
                        <h4>Thông tin phòng</h4>
                        <div class="booking-detail-row">
                            <span>Phòng</span>
                            <strong id="modalRoomNo">104</strong>
                        </div>
                        <div class="booking-detail-row">
                            <span>Loại phòng</span>
                            <strong id="modalRoomType">Standard</strong>
                        </div>
                        <div class="booking-detail-row">
                            <span>Nhận phòng</span>
                            <strong id="modalCheckin">12/05/2026</strong>
                        </div>
                        <div class="booking-detail-row">
                            <span>Trả phòng</span>
                            <strong id="modalCheckout">14/05/2026</strong>
                        </div>
                        <div class="booking-detail-row">
                            <span>Ngày đặt</span>
                            <strong id="modalCreated">12/05/2026 10:00</strong>
                        </div>
                    </section>
                </div>

                <section class="booking-detail-section">
                    <h4>Thanh toán</h4>
                    <div class="booking-total-row">
                        <span>Thời gian lưu trú</span>
                        <strong id="modalNights">3 đêm</strong>
                    </div>
                    <div class="booking-total-row">
                        <span>Số khách</span>
                        <strong id="modalGuests">1 người</strong>
                    </div>
                    <div class="booking-total-row">
                        <span>Trạng thái thanh toán</span>
                        <strong id="modalPayment">Đã trả</strong>
                    </div>
                    <div class="booking-total-row">
                        <span>Đã thanh toán</span>
                        <strong id="modalPaid">0 đ</strong>
                    </div>
                    <div class="booking-total-row highlight">
                        <span>Tổng tiền</span>
                        <strong id="modalTotal">10.000.000 đ</strong>
                    </div>
                </section>
            </div>
            <div class="booking-modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="booking-primary-btn">Cập nhật đặt phòng</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade booking-create-modal" id="addBookingModal" tabindex="-1" aria-labelledby="addBookingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="booking-modal-header">
                <div>
                    <h3 id="addBookingModalLabel">Đặt phòng mới</h3>
                    <p>Nhập thông tin khách và thời gian lưu trú.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form id="addBookingForm">
                <div class="booking-modal-body">
                    <div class="booking-create-grid">
                        <div class="booking-form-group">
                            <label>Họ và tên</label>
                            <input type="text" placeholder="Nhập họ và tên" required />
                        </div>
                        <div class="booking-form-group">
                            <label>CCCD/Hộ chiếu</label>
                            <input type="text" placeholder="Nhập số giấy tờ" required />
                        </div>
                        <div class="booking-form-group">
                            <label>Số điện thoại</label>
                            <input type="tel" placeholder="Nhập số điện thoại" required />
                        </div>
                        <div class="booking-form-group">
                            <label>Email</label>
                            <input type="email" placeholder="example@email.com" />
                        </div>
                        <div class="booking-form-group">
                            <label>Ngày nhận phòng</label>
                            <input type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="booking-form-group">
                            <label>Ngày trả phòng</label>
                            <input type="date" value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="booking-form-group">
                            <label>Số khách</label>
                            <input type="number" min="1" value="1" />
                        </div>
                        <div class="booking-form-group">
                            <label>Phòng</label>
                            <select>
                                <option>Chọn phòng</option>
                                <option>101 - Standard</option>
                                <option>201 - Deluxe</option>
                                <option>301 - VIP</option>
                            </select>
                        </div>
                        <div class="booking-form-group full">
                            <label>Ghi chú</label>
                            <textarea rows="3" placeholder="Yêu cầu đặc biệt của khách"></textarea>
                        </div>
                    </div>
                </div>
                <div class="booking-modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="booking-primary-btn" id="submitAddBooking">Xác nhận đặt phòng</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const searchInput = document.getElementById("bookingSearchInput");
            const filterButtons = Array.from(document.querySelectorAll("[data-filter]"));
            const bookingCards = Array.from(document.querySelectorAll(".booking-card"));
            const emptyState = document.getElementById("bookingEmptyState");
            const visibleCount = document.getElementById("bookingVisibleCount");

            function getStatusText(status) {
                if (status === "arrival") return { text: "Sắp đến", icon: "bi-box-arrow-in-right" };
                if (status === "departure") return { text: "Sắp trả phòng", icon: "bi-box-arrow-right" };
                if (status === "completed") return { text: "Hoàn tất", icon: "bi-check2-circle" };
                return { text: "Đang ở", icon: "bi-house-check" };
            }

            function filterBookings() {
                const keyword = (searchInput?.value || "").trim().toLowerCase();
                const activeFilter = document.querySelector("[data-filter].active")?.dataset.filter || "all";
                let shown = 0;

                bookingCards.forEach(function (card) {
                    const haystack = [
                        card.dataset.name,
                        card.dataset.id,
                        card.dataset.room,
                        card.dataset.roomtype,
                        card.dataset.phone
                    ].join(" ").toLowerCase();
                    const matchesSearch = !keyword || haystack.includes(keyword);
                    const statuses = (card.dataset.statuses || card.dataset.status || "all").split(/\s+/);
                    const matchesFilter = activeFilter === "all" || statuses.includes(activeFilter);
                    const isVisible = matchesSearch && matchesFilter;
                    card.hidden = !isVisible;
                    if (isVisible) shown += 1;
                });

                if (visibleCount) {
                    visibleCount.textContent = `${shown} đặt phòng`;
                }
                emptyState?.classList.toggle("is-visible", shown === 0);
            }

            filterButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    filterButtons.forEach(item => item.classList.remove("active"));
                    button.classList.add("active");
                    filterBookings();
                });
            });

            searchInput?.addEventListener("input", filterBookings);

            document.addEventListener("click", function (event) {
                const detailButton = event.target.closest("[data-booking-detail]");
                if (!detailButton) return;

                const card = document.querySelector(`.booking-card[data-id="${detailButton.dataset.bookingDetail}"]`);
                if (!card) return;

                const modalStatus = document.getElementById("modalStatus");
                modalStatus.className = `booking-status ${card.dataset.statusClass || card.dataset.status}`;
                modalStatus.innerHTML = `<i class="bi ${card.dataset.statusIcon || "bi-calendar-check"}"></i> ${card.dataset.statusLabel || "Đặt phòng"}`;

                document.getElementById("modalBookingCode").textContent = card.dataset.id || "";
                document.getElementById("modalGuestName").textContent = card.dataset.name || "";
                document.getElementById("modalPhone").textContent = card.dataset.phone || "";
                document.getElementById("modalIdentity").textContent = card.dataset.identity || "";
                document.getElementById("modalEmail").textContent = card.dataset.email || "";
                document.getElementById("modalAddress").textContent = card.dataset.address || "";
                document.getElementById("modalRoomNo").textContent = card.dataset.room || "";
                document.getElementById("modalRoomType").textContent = card.dataset.roomtype || "";
                document.getElementById("modalCheckin").textContent = card.dataset.checkin || "";
                document.getElementById("modalCheckout").textContent = card.dataset.checkout || "";
                document.getElementById("modalCreated").textContent = card.dataset.created || "";
                document.getElementById("modalNights").textContent = card.dataset.nights || "";
                document.getElementById("modalGuests").textContent = card.dataset.guests || "";
                document.getElementById("modalPayment").textContent = card.dataset.payment || "";
                document.getElementById("modalPaid").textContent = card.dataset.paid || "";
                document.getElementById("modalTotal").textContent = card.dataset.total || "";

                new bootstrap.Modal(document.getElementById("bookingDetailModal")).show();
            });

            document.getElementById("submitAddBooking")?.addEventListener("click", function () {
                alert("Đã thêm đặt phòng mới thành công.");
                bootstrap.Modal.getInstance(document.getElementById("addBookingModal"))?.hide();
            });

            filterBookings();
        })();
    </script>
}
