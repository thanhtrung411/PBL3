                                <input type="text" class="form-control" placeholder="Nhập họ và tên" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">CMND/CCCD/Hộ chiếu</label>
                                <input type="text" class="form-control" placeholder="Nhập số giấy tờ" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Số điện thoại</label>
                                <input type="tel" class="form-control" placeholder="Nhập số điện thoại" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Quốc tịch</label>
                                <input type="text" class="form-control" value="Việt Nam">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Giới tính</label>
                                <select class="form-select">
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                    <option value="Khác">Khác</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Booking Information -->
                    <div>
                        <h6 class="fw-bold text-primary mb-3 border-bottom pb-2"><i class="bi bi-calendar-check me-2"></i>Thông tin đặt phòng</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Số phòng</label>
                                <input type="text" class="form-control" placeholder="Ví dụ: 101" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Số lượng khách</label>
                                <input type="number" class="form-control" value="1" min="1">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Giờ nhận phòng</label>
                                <input type="time" class="form-control" value="14:00">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Ngày nhận phòng</label>
                                <input type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Ngày trả phòng</label>
                                <input type="date" class="form-control" value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Ghi chú đặc biệt</label>
                                <textarea class="form-control" rows="2" placeholder="Nhập các yêu cầu đặc biệt của khách..."></textarea>
