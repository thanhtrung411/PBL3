@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý đặt phòng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1 fw-bold">Quản lý đặt phòng</h3>
        <p class="text-muted mb-0">Theo dõi và quản lý trạng thái tất cả đặt phòng</p>
    </div>
    <button class="btn btn-dark px-4"><i class="bi bi-plus"></i> Đặt phòng mới</button>
</div>

<div class="row mb-4">
    <div class="col-md-9">
        <!-- Filters -->
        <div class="card-custom py-3 px-4 h-100 d-flex align-items-center">
            <div class="row w-100 g-3">
                <div class="col-md-5">
                    <div class="input-group flex-nowrap">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control bg-light border-start-0" placeholder="Tìm kiếm theo tên, mã phòng...">
                    </div>
                </div>
                <div class="col-md-4">
                    <select class="form-select bg-light text-muted">
                        <option>Trạng thái</option>
                        <option>Đã xác nhận</option>
                        <option>Chờ xác nhận</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button class="btn btn-light w-100 border text-muted"><i class="bi bi-calendar"></i> Lọc theo ngày</button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom py-3 text-center h-100">
            <div class="card-title-sm">Tổng đặt phòng hôm nay</div>
            <div class="fw-bold fs-3">12</div>
            <div class="card-subtext">+3 so với hôm qua</div>
        </div>
    </div>
</div>

<!-- Status Summary -->
<div class="row g-3 mb-4">
    <div class="col">
        <div class="card-custom p-3 border-0 shadow-sm" style="border-top: 3px solid #10b981 !important;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-bold fs-4">2</span>
                <i class="bi bi-check-circle text-success fs-5"></i>
            </div>
            <div class="text-muted small">Đã xác nhận</div>
        </div>
    </div>
    <div class="col">
        <div class="card-custom p-3 border-0 shadow-sm" style="border-top: 3px solid #f59e0b !important;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-bold fs-4">1</span>
                <i class="bi bi-clock text-warning fs-5"></i>
            </div>
            <div class="text-muted small">Chờ xác nhận</div>
        </div>
    </div>
    <div class="col">
        <div class="card-custom p-3 border-0 shadow-sm" style="border-top: 3px solid #3b82f6 !important;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-bold fs-4">2</span>
                <i class="bi bi-calendar-check text-primary fs-5"></i>
            </div>
            <div class="text-muted small">Đã đặt phòng</div>
        </div>
    </div>
    <div class="col">
        <div class="card-custom p-3 border-0 shadow-sm" style="border-top: 3px solid #6b7280 !important;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-bold fs-4">2</span>
                <i class="bi bi-box-arrow-right text-secondary fs-5"></i>
            </div>
            <div class="text-muted small">Đã trả phòng</div>
        </div>
    </div>
    <div class="col">
        <div class="card-custom p-3 border-0 shadow-sm" style="border-top: 3px solid #ef4444 !important;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-bold fs-4">2</span>
                <i class="bi bi-x-circle text-danger fs-5"></i>
            </div>
            <div class="text-muted small">Đã huỷ</div>
        </div>
    </div>
</div>

<!-- Table -->
<div class="card-custom p-0 overflow-hidden border">
    <div class="p-3 bg-light border-bottom fw-bold text-dark">
        Danh sách đặt phòng
    </div>
    <div class="table-responsive p-3">
        <table class="table-custom mb-0 w-100">
            <thead class="bg-light">
                <tr>
                    <th>Mã đặt phòng</th>
                    <th>Khách hàng</th>
                    <th>Phòng</th>
                    <th>Nhận phòng</th>
                    <th>Trả phòng</th>
                    <th>Số đêm</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="fw-bold">BK001</td>
                    <td>
                        <div>Nguyễn Văn A</div>
                        <small class="text-muted">0912453482</small>
                    </td>
                    <td>301</td>
                    <td>2024-01-15</td>
                    <td>2024-01-18</td>
                    <td>3</td>
                    <td>3,600,000đ</td>
                    <td><span class="badge-status badge-booked">Đã xác nhận</span></td>
                    <td>
                        <button class="btn btn-icon-only"><i class="bi bi-eye"></i></button>
                        <button class="btn btn-icon-only"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-icon-only text-danger"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
                <tr>
                    <td class="fw-bold">BK002</td>
                    <td>
                        <div>Trần Thị B</div>
                        <small class="text-muted">0905642357</small>
                    </td>
                    <td>102</td>
                    <td>2024-01-15</td>
                    <td>2024-01-16</td>
                    <td>1</td>
                    <td>1,200,000đ</td>
                    <td><span class="badge-status badge-empty">Đã nhận phòng</span></td>
                    <td>
                        <button class="btn btn-icon-only"><i class="bi bi-eye"></i></button>
                        <button class="btn btn-icon-only"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-icon-only text-danger"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
                <tr>
                    <td class="fw-bold">BK003</td>
                    <td>
                        <div>Lê Văn C</div>
                        <small class="text-muted">0932365421</small>
                    </td>
                    <td>202</td>
                    <td>2024-01-15</td>
                    <td>2024-01-20</td>
                    <td>5</td>
                    <td>12,500,000đ</td>
                    <td><span class="badge-status badge-maintenance">Chờ xác nhận</span></td>
                    <td>
                        <button class="btn btn-icon-only"><i class="bi bi-eye"></i></button>
                        <button class="btn btn-icon-only"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-icon-only text-danger"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
                <tr>
                    <td class="fw-bold">BK004</td>
                    <td>
                        <div>Phạm Thị D</div>
                        <small class="text-muted">0387214482</small>
                    </td>
                    <td>204</td>
                    <td>2024-01-15</td>
                    <td>2024-01-17</td>
                    <td>2</td>
                    <td>3,000,000đ</td>
                    <td><span class="badge-status badge-cleaning">Đã trả phòng</span></td>
                    <td>
                        <button class="btn btn-icon-only"><i class="bi bi-eye"></i></button>
                        <button class="btn btn-icon-only"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-icon-only text-danger"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

