<div id="invoicePrintArea" class="invoice-print-area" aria-hidden="true"></div>

@functions {
    private static decimal ParseCurrency(string value)
    {
        var digits = new string(value.Where(char.IsDigit).ToArray());
        return decimal.TryParse(digits, out var parsed) ? parsed : 0;
    }
}

@section Scripts {
    <script>
        (function () {
            const invoiceLineItems = @Html.Raw(invoiceLineItemsJson);
            const searchInput = document.getElementById("invoiceSearchInput");
            const dateFromFilter = document.getElementById("invoiceDateFromFilter");
            const dateToFilter = document.getElementById("invoiceDateToFilter");
            const employeeFilter = document.getElementById("invoiceEmployeeFilter");
            const resetFilterButton = document.getElementById("invoiceResetFilterButton");
            const sortSelect = document.getElementById("invoiceSortSelect");
            const rows = Array.from(document.querySelectorAll("[data-invoice-row]"));
            const tableBody = document.getElementById("invoiceTableBody");
            const emptyState = document.getElementById("invoiceEmptyState");
            const visibleCount = document.getElementById("invoiceVisibleCount");
            const filterButtons = Array.from(document.querySelectorAll("[data-status-filter]"));
            const printArea = document.getElementById("invoicePrintArea");
            const detailPrintButton = document.getElementById("detailInvoicePrintButton");
            let activeStatus = "all";
            let activeInvoiceRow = null;
            let originalDocumentTitle = document.title;

            function normalizeText(value) {
                return (value || "")
                    .toLowerCase()
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .replace(/đ/g, "d");
            }

            function compareText(left, right) {
                return String(left || "").localeCompare(String(right || ""), "vi", { sensitivity: "base" });
            }

            function compareNumber(left, right) {
                return Number(left || 0) - Number(right || 0);
            }

            function applySort() {
                const sortValue = sortSelect?.value || "date-desc";
                const sortedRows = rows.slice().sort(function (left, right) {
                    switch (sortValue) {
                        case "date-asc":
                            return compareText(left.dataset.date, right.dataset.date);
                        case "total-desc":
                            return compareNumber(right.dataset.totalNumber, left.dataset.totalNumber);
                        case "paid-desc":
                            return compareNumber(right.dataset.paidNumber, left.dataset.paidNumber);
                        case "customer-asc":
                            return compareText(left.dataset.customer, right.dataset.customer);
                        default:
                            return compareText(right.dataset.date, left.dataset.date);
                    }
                });

                sortedRows.forEach(row => tableBody.appendChild(row));
            }

            function filterInvoices() {
                const keyword = normalizeText(searchInput?.value);
                const selectedDateFrom = dateFromFilter?.value || "";
                const selectedDateTo = dateToFilter?.value || "";
                const selectedEmployee = employeeFilter?.value || "all";
                let shown = 0;

                rows.forEach(function (row) {
                    const matchesSearch = !keyword || normalizeText(row.dataset.search).includes(keyword);
                    const matchesDateFrom = !selectedDateFrom || row.dataset.date >= selectedDateFrom;
                    const matchesDateTo = !selectedDateTo || row.dataset.date <= selectedDateTo;
                    const matchesEmployee = selectedEmployee === "all" || row.dataset.employeeId === selectedEmployee;
                    const matchesStatus = activeStatus === "all" || row.dataset.status === activeStatus;
                    const visible = matchesSearch && matchesDateFrom && matchesDateTo && matchesEmployee && matchesStatus;
                    row.hidden = !visible;
                    if (visible) shown += 1;
                });

                if (visibleCount) {
                    visibleCount.innerHTML = `<i class="bi bi-list-check"></i>${shown} hóa đơn`;
                }
                emptyState?.classList.toggle("is-visible", shown === 0);
            }

            function applyControls() {
                applySort();
                filterInvoices();
            }

            function escapeHtml(value) {
                return String(value || "")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            function renderInvoiceLineItems(invoiceCode) {
                const lines = invoiceLineItems[invoiceCode] || [];
                const tbody = document.getElementById("detailInvoiceLineItems");
                const empty = document.getElementById("detailInvoiceLineEmpty");
                const count = document.getElementById("detailInvoiceLineCount");

                tbody.innerHTML = lines.map(function (item) {
                    return `<tr>
                        <td><span class="badge bg-light text-dark border rounded-pill">${escapeHtml(item.TypeLabel)}</span></td>
                        <td class="fw-semibold text-dark">${escapeHtml(item.Description)}</td>
                        <td>${escapeHtml(item.RoomCode)}</td>
                        <td>${escapeHtml(item.DateLabel)}</td>
                        <td class="text-center">${escapeHtml(item.Quantity)}</td>
                        <td class="text-end">${escapeHtml(item.UnitPriceLabel)}</td>
                        <td class="text-end fw-bold">${escapeHtml(item.AmountLabel)}</td>
                    </tr>`;
                }).join("");

                count.textContent = `${lines.length} dòng`;
                empty?.classList.toggle("d-none", lines.length > 0);
            }

            function buildPrintLineRows(lines) {
                if (!lines.length) {
                    return `<tr><td colspan="7" style="text-align:center;">Chưa có chi tiết hóa đơn</td></tr>`;
                }

                return lines.map(function (item) {
                    return `<tr>
                        <td>${escapeHtml(item.TypeLabel)}</td>
                        <td>${escapeHtml(item.Description)}</td>
                        <td>${escapeHtml(item.RoomCode)}</td>
                        <td>${escapeHtml(item.DateLabel)}</td>
                        <td class="text-end">${escapeHtml(item.Quantity)}</td>
                        <td class="text-end">${escapeHtml(item.UnitPriceLabel)}</td>
                        <td class="text-end">${escapeHtml(item.AmountLabel)}</td>
                    </tr>`;
                }).join("");
            }

            function buildReceiptLineRows(lines, row) {
                if (!lines.length) {
                    return `<tr><td colspan="3" style="text-align:center;">Chưa có chi tiết hóa đơn</td></tr>`;
                }

                return lines.map(function (item) {
                    const isRoom = String(item.TypeLabel || "").toLowerCase().includes("ph");
                    const roomName = getReceiptRoomName(item);
                    const roomCode = getReceiptRoomCode(item, roomName);
                    const info = isRoom
                        ? `<div class="invoice-print-rental-info">
                            <strong>Phòng ${escapeHtml(roomName)}</strong>
                            ${roomCode ? `<span>${escapeHtml(roomCode)}</span>` : ""}
                            <span>Từ ${escapeHtml(row.dataset.checkin || item.DateLabel)} đến ${escapeHtml(row.dataset.checkout || item.DateLabel)}</span>
                        </div>`
                        : `<div class="invoice-print-rental-info">
                            <strong>Dịch vụ</strong>
                            <span>${escapeHtml(item.Description)}</span>
                        </div>`;

                    return `<tr>
                        <td>${info}</td>
                        <td class="text-end">${escapeHtml(item.Quantity)}</td>
                        <td class="text-end">${escapeHtml(item.AmountLabel)}</td>
                    </tr>`;
                }).join("");
            }

            function getReceiptRoomName(item) {
                const description = String(item.Description || "");
                const hyphenIndex = description.lastIndexOf("-");
                if (hyphenIndex >= 0 && hyphenIndex < description.length - 1) {
                    return description.slice(hyphenIndex + 1).trim();
                }

                return String(item.RoomCode || description || "Phòng").trim();
            }

            function getReceiptRoomCode(item, roomName) {
                const roomCode = String(item.RoomCode || "").trim();
                if (!roomCode || roomCode.toLowerCase() === String(roomName || "").toLowerCase()) {
                    return "";
                }

                return roomCode;
            }

            function renderPrintInvoice(row) {
                const invoiceCode = row.dataset.invoice || "";
                const lines = invoiceLineItems[invoiceCode] || [];
                const printedAt = new Date().toLocaleTimeString("vi-VN", { hour: "2-digit", minute: "2-digit" });
                const printedDate = new Date().toLocaleDateString("vi-VN");
                printArea.innerHTML = `
                    <article class="invoice-print-doc">
                        <header class="invoice-print-head">
                            <div class="invoice-print-brand">Venus Hotel</div>
                            <div class="invoice-print-meta">Số 54 Nguyễn Lương Bằng, Phường Liên Chiểu, Thành phố Đà Nẵng</div>
                            <div class="invoice-print-meta">Hotline: 0858272059</div>
                            <div class="invoice-print-title">
                                <h1>Hóa đơn bán hàng</h1>
                            </div>
                        </header>

                        <section class="invoice-receipt-meta">
                            <div>Ngày: ${escapeHtml(row.dataset.created || printedDate)}</div>
                            <div>Số: ${escapeHtml(invoiceCode)}</div>
                            <div>Thu ngân: Admin</div>
                            <div>In lúc: ${escapeHtml(printedAt)}</div>
                            <div>Khách: ${escapeHtml(row.dataset.customer || "")}</div>
                            <div>DT: ${escapeHtml(row.dataset.phone || "-")}</div>
                        </section>

                        <table class="invoice-print-table">
                            <thead>
                                <tr>
                                    <th>Thông tin thuê</th>
                                    <th class="text-end">SL</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>${buildReceiptLineRows(lines, row)}</tbody>
                        </table>

                        <section class="invoice-print-summary">
                            <div class="invoice-print-summary-row"><span>Tiền phòng:</span><strong>${escapeHtml(row.dataset.roomAmount)}</strong></div>
                            <div class="invoice-print-summary-row"><span>Dịch vụ:</span><strong>${escapeHtml(row.dataset.serviceAmount)}</strong></div>
                            <div class="invoice-print-summary-row"><span>Giảm giá:</span><strong>${escapeHtml(row.dataset.discount)}</strong></div>
                            <div class="invoice-print-summary-row total"><span>Tổng:</span><strong>${escapeHtml(row.dataset.total)}</strong></div>
                            <div class="invoice-print-summary-row"><span>Khách đưa:</span><strong>${escapeHtml(row.dataset.paid)}</strong></div>
                            <div class="invoice-print-summary-row"><span>Còn lại:</span><strong>${escapeHtml(row.dataset.remaining)}</strong></div>
                        </section>

                        <div class="invoice-print-thanks">Trân Trọng Cảm Ơn Quý Khách!</div>
                    </article>`;
            }

            function cleanupPrintMode() {
                document.body.classList.remove("invoice-print-mode");
                document.title = originalDocumentTitle;
            }

            function printInvoice(row) {
                if (!row) return;
                renderPrintInvoice(row);
                originalDocumentTitle = document.title;
                document.title = row.dataset.invoice || originalDocumentTitle;
                document.body.classList.add("invoice-print-mode");
                setTimeout(function () {
                    window.print();
                }, 50);
            }

            function openInvoiceDetail(row) {
                activeInvoiceRow = row;
                const statusClass = row.dataset.status || "";
                const statusLabel = row.dataset.statusLabel || "";
                document.getElementById("invoiceDetailModalLabel").textContent = row.dataset.invoice || "Chi tiết hóa đơn";
                document.getElementById("detailInvoiceSub").textContent = `Mã đặt phòng: ${row.dataset.booking || ""}`;
                document.getElementById("detailInvoiceCustomer").textContent = row.dataset.customer || "";
                document.getElementById("detailInvoicePhone").textContent = row.dataset.phone || "Chưa có SĐT";
                document.getElementById("detailInvoiceStatus").innerHTML = `<span class="invoice-status ${statusClass}"><i class="bi bi-circle-fill"></i>${statusLabel}</span>`;
                document.getElementById("detailInvoiceBooking").textContent = row.dataset.booking || "";
                document.getElementById("detailInvoiceRoom").textContent = row.dataset.room || "";
                document.getElementById("detailInvoiceCreated").textContent = row.dataset.created || "";
                const employeeMeta = row.dataset.employeePosition
                    ? `${row.dataset.employeePosition} - ${row.dataset.employeeId || ""}`
                    : row.dataset.employeeId || "";
                document.getElementById("detailInvoiceEmployeeLine").textContent = `Xử lý bởi ${row.dataset.employee || "Chưa có nhân viên"}${employeeMeta ? " (" + employeeMeta + ")" : ""}`;
                document.getElementById("detailInvoicePaidDate").textContent = row.dataset.paidDate || "";
                document.getElementById("detailInvoicePayment").textContent = row.dataset.payment || "";
                document.getElementById("detailInvoiceRoomAmount").textContent = row.dataset.roomAmount || "";
                document.getElementById("detailInvoiceServiceAmount").textContent = row.dataset.serviceAmount || "";
                document.getElementById("detailInvoiceDiscount").textContent = row.dataset.discount || "";
                document.getElementById("detailInvoicePaid").textContent = row.dataset.paid || "";
                document.getElementById("detailInvoiceRemaining").textContent = row.dataset.remaining || "";
                document.getElementById("detailInvoiceTotal").textContent = row.dataset.total || "";
                renderInvoiceLineItems(row.dataset.invoice || "");
                new bootstrap.Modal(document.getElementById("invoiceDetailModal")).show();
            }

            searchInput?.addEventListener("input", filterInvoices);
            dateFromFilter?.addEventListener("change", filterInvoices);
            dateToFilter?.addEventListener("change", filterInvoices);
            employeeFilter?.addEventListener("change", filterInvoices);
            sortSelect?.addEventListener("change", applyControls);
            resetFilterButton?.addEventListener("click", function () {
                if (searchInput) searchInput.value = "";
                if (dateFromFilter) dateFromFilter.value = "";
                if (dateToFilter) dateToFilter.value = "";
                if (employeeFilter) employeeFilter.value = "all";
                activeStatus = "all";
                filterButtons.forEach(function (button) {
                    button.classList.toggle("active", button.dataset.statusFilter === "all");
                });
                applyControls();
            });

            filterButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    filterButtons.forEach(item => item.classList.remove("active"));
                    button.classList.add("active");
                    activeStatus = button.dataset.statusFilter || "all";
                    filterInvoices();
                });
            });

            rows.forEach(function (row) {
                row.addEventListener("click", function (event) {
                    if (event.target.closest("button")) {
                        return;
                    }
                    openInvoiceDetail(row);
                });
            });

            document.querySelectorAll(".btn-invoice-detail").forEach(function (button) {
                button.addEventListener("click", function (event) {
                    event.stopPropagation();
                    openInvoiceDetail(button.closest("[data-invoice-row]"));
                });
            });

            document.querySelectorAll(".btn-invoice-print").forEach(function (button) {
                button.addEventListener("click", function (event) {
                    event.stopPropagation();
                    printInvoice(button.closest("[data-invoice-row]"));
                });
            });

            detailPrintButton?.addEventListener("click", function () {
                printInvoice(activeInvoiceRow);
            });

            window.addEventListener("afterprint", cleanupPrintMode);

            applyControls();
        })();
    </script>
}
