                            <span>Ngày thanh toán</span>
                            <strong id="detailInvoicePaidDate"></strong>
                        </div>
                        <div class="invoice-detail-summary-row">
                            <span>Phương thức</span>
                            <strong id="detailInvoicePayment"></strong>
                        </div>
                        <div class="invoice-detail-summary-total">
                            <span>Tổng thanh toán</span>
                            <strong id="detailInvoiceTotal"></strong>
