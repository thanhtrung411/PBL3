@model PBL3.Models.AdminInvoiceManagementViewModel
@using System.Globalization
@using System.Text.Json

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Hóa đơn";
    string Money(decimal value) => $"{value.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))} đ";
    var invoiceLineItemsJson = JsonSerializer.Serialize(Model.Invoices.ToDictionary(x => x.InvoiceCode, x => x.LineItems));
}

<style>
    .invoice-page {
        color: #172033;
    }

    .invoice-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 18px;
        align-items: center;
        min-height: 44px;
        margin-bottom: 22px;
    }

    .invoice-hero h1 {
        margin: 0;
        color: #0f172a;
        font-size: 1.45rem;
        font-weight: 800;
        letter-spacing: 0;
        line-height: 1.2;
    }

    .invoice-toolbar {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 10px;
    }

    .invoice-control {
        min-height: 44px;
        border: 1px solid #d8e2ee;
        border-radius: 10px;
        background: #ffffff;
        color: #1f2937;
        font-weight: 650;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
    }

    .invoice-search {
        min-width: 330px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 13px;
    }

    .invoice-search i {
        color: #64748b;
        font-size: 1.05rem;
    }

    .invoice-search input {
        width: 100%;
        border: 0;
        outline: none;
        color: #111827;
        font-weight: 650;
    }

    .invoice-date,
    .invoice-select {
        padding: 0 12px;
    }

    .invoice-action {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 0;
        border-radius: 10px;
        background: #111827;
        color: #ffffff;
        font-weight: 820;
        padding: 10px 16px;
        box-shadow: 0 16px 28px rgba(17, 24, 39, 0.16);
    }

    .invoice-action:hover,
    .invoice-action:focus-visible {
        background: #1f2937;
        color: #ffffff;
        outline: none;
    }

    .invoice-stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 18px;
    }

    .invoice-stat-card {
        position: relative;
        overflow: hidden;
        min-height: 116px;
        border: 1px solid #dfe7f0;
        border-radius: 14px;
        background: #ffffff;
        padding: 18px;
        box-shadow: 0 18px 42px rgba(15, 23, 42, 0.07);
    }

    .invoice-stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 12px;
    }

    .invoice-stat-label {
        color: #64748b;
        font-size: 0.82rem;
        font-weight: 780;
    }

    .invoice-stat-icon {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        font-size: 1.08rem;
    }

    .invoice-stat-icon.paid {
        background: #e8f7ef;
        color: #15803d;
    }

    .invoice-stat-icon.pending {
        background: #fff7e6;
        color: #c2410c;
    }

    .invoice-stat-icon.overdue {
        background: #fff1f0;
        color: #b42318;
    }

    .invoice-stat-icon.total {
        background: #eaf2ff;
        color: #1f6feb;
    }

    .invoice-stat-value {
        color: #0f172a;
        font-size: 1.45rem;
        font-weight: 900;
        line-height: 1.05;
    }

    .invoice-shell {
        border: 1px solid #dfe7f0;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.98);
        box-shadow: 0 18px 42px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    .invoice-shell-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        border-bottom: 1px solid #e5edf5;
        padding: 18px 20px;
    }

    .invoice-shell-head h2 {
        margin: 0;
        color: #0f172a;
        font-size: 1.2rem;
        font-weight: 900;
    }

    .invoice-shell-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        flex-wrap: wrap;
    }

    .invoice-date-range {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .invoice-date-compact {
        width: 138px;
        min-height: 36px;
        border: 1px solid #d8e2ee;
        border-radius: 9px;
        background: #ffffff;
        color: #1f2937;
        font-size: 0.82rem;
        font-weight: 700;
        padding: 0 9px;
    }

    .invoice-reset-filter {
        min-height: 36px;
        border: 1px solid #d8e2ee;
        border-radius: 9px;
        background: #ffffff;
        color: #475569;
        font-size: 0.82rem;
        font-weight: 800;
        padding: 0 11px;
    }

    .invoice-reset-filter:hover,
    .invoice-reset-filter:focus-visible {
        border-color: #1f6feb;
        color: #1f6feb;
        outline: none;
    }

    .invoice-count-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border-radius: 999px;
        background: #eaf2ff;
        color: #1f6feb;
        font-size: 0.82rem;
        font-weight: 850;
        padding: 8px 12px;
    }

    .invoice-filter-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        border-bottom: 1px solid #e5edf5;
        padding: 12px 20px;
        background: #fbfdff;
    }

    .invoice-filter-chip {
        min-height: 34px;
        border: 1px solid #d8e2ee;
        border-radius: 999px;
        background: #ffffff;
        color: #475569;
        font-size: 0.82rem;
        font-weight: 780;
        padding: 7px 12px;
    }

    .invoice-filter-chip.active {
        border-color: #1f6feb;
        background: #eaf2ff;
        color: #1f6feb;
    }

    .invoice-table-wrap {
        overflow-x: auto;
        padding: 12px 16px 18px;
    }

    .invoice-table {
        width: 100%;
        min-width: 980px;
        border-collapse: separate;
        border-spacing: 0 10px;
    }

    .invoice-table th {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 850;
        padding: 0 12px 3px;
        text-align: left;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .invoice-row {
        cursor: pointer;
    }

    .invoice-row td {
        border-top: 1px solid #dfe7f0;
        border-bottom: 1px solid #dfe7f0;
        background: #ffffff;
        color: #172033;
        font-size: 0.9rem;
        font-weight: 650;
        padding: 12px 10px;
        vertical-align: middle;
        white-space: nowrap;
    }

    .invoice-row:hover td {
        border-color: #bdd3f0;
        background: #fbfdff;
    }

    .invoice-row td:first-child {
        border-left: 1px solid #dfe7f0;
        border-radius: 12px 0 0 12px;
    }

    .invoice-row td:last-child {
        border-right: 1px solid #dfe7f0;
        border-radius: 0 12px 12px 0;
    }

    .invoice-main-code {
        color: #0f172a;
        font-size: 0.96rem;
        font-weight: 900;
    }

    .invoice-subtext {
        display: block;
        margin-top: 3px;
        color: #667085;
        font-size: 0.78rem;
        font-weight: 680;
    }

    .invoice-customer {
        max-width: 190px;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .invoice-room-pill {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        background: #f1f5f9;
        color: #334155;
        font-size: 0.82rem;
        font-weight: 820;
        padding: 6px 10px;
    }

    .invoice-money {
        color: #0f172a;
        font-weight: 900;
        text-align: right;
    }

    .invoice-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 850;
        padding: 7px 11px;
    }

    .invoice-status i {
        font-size: 0.62rem;
    }

    .invoice-status.paid {
        background: #e8f7ef;
        color: #15803d;
    }

    .invoice-status.partial {
        background: #eaf2ff;
        color: #1f6feb;
    }

    .invoice-status.unpaid {
        background: #fff7e6;
        color: #b45309;
    }

    .invoice-status.overdue,
    .invoice-status.cancelled {
        background: #fff1f0;
        color: #b42318;
    }

    .invoice-action-cell {
        display: flex;
        gap: 8px;
        justify-content: center;
    }

    .invoice-status-cell {
        text-align: center;
    }

    .invoice-status-cell .invoice-subtext {
        text-align: center;
    }

    .invoice-icon-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #d8e2ee;
        border-radius: 10px;
        background: #ffffff;
        color: #475569;
    }

    .invoice-icon-btn:hover,
    .invoice-icon-btn:focus-visible {
        border-color: #1f6feb;
        background: #eaf2ff;
        color: #1f6feb;
        outline: none;
    }

    .invoice-empty-state {
        display: none;
        margin: 18px;
        border: 1px dashed #cbd5e1;
        border-radius: 12px;
        background: #fbfdff;
        color: #64748b;
        padding: 34px 16px;
        text-align: center;
        font-weight: 760;
    }

    .invoice-empty-state.is-visible {
        display: block;
    }

    .invoice-detail-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .invoice-detail-dialog {
        max-width: 1080px;
    }

    .invoice-detail-modal {
        border-radius: 16px;
        overflow: hidden;
    }

    .invoice-detail-modal .modal-header {
        align-items: flex-start;
        border-bottom: 1px solid #e5edf5;
        padding: 18px 22px 14px;
    }

    .invoice-detail-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        width: 100%;
    }

    .invoice-detail-eyebrow {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 850;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .invoice-detail-modal h5 {
        margin: 2px 0 3px;
        color: #0f172a;
        font-size: 1.35rem;
        font-weight: 900;
    }

    .invoice-detail-header-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .invoice-detail-modal .modal-body {
        background: #f8fafc;
        padding: 18px 22px;
    }

    .invoice-detail-customer-strip {
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(150px, 1fr));
        gap: 10px;
        margin-bottom: 14px;
    }

    .invoice-detail-fact {
        border: 1px solid #e5edf5;
        border-radius: 12px;
        background: #ffffff;
        padding: 11px 13px;
    }

    .invoice-detail-fact-label {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 780;
        margin-bottom: 4px;
    }

    .invoice-detail-fact-value {
        color: #0f172a;
        font-size: 0.96rem;
        font-weight: 850;
        line-height: 1.25;
        word-break: break-word;
    }

    .invoice-detail-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 310px;
        gap: 14px;
        align-items: start;
    }

    .invoice-detail-lines {
        border: 1px solid #e5edf5;
        border-radius: 12px;
        background: #ffffff;
        overflow: hidden;
    }

    .invoice-detail-lines-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border-bottom: 1px solid #e5edf5;
        background: #ffffff;
        padding: 13px 14px;
    }

    .invoice-detail-lines-head h6 {
        margin: 0;
        color: #0f172a;
        font-weight: 850;
    }

    .invoice-detail-lines table {
        margin: 0;
        font-size: 0.86rem;
    }

    .invoice-detail-lines th,
    .invoice-detail-lines td {
        padding: 10px 12px;
        white-space: nowrap;
        vertical-align: middle;
    }

    .invoice-detail-empty {
        padding: 16px;
        color: #64748b;
        font-weight: 650;
        text-align: center;
    }

    .invoice-detail-summary {
        border: 1px solid #e5edf5;
        border-radius: 12px;
        background: #ffffff;
        padding: 14px;
    }

    .invoice-detail-summary h6 {
        margin: 0 0 12px;
        color: #0f172a;
        font-size: 0.96rem;
        font-weight: 900;
    }

    .invoice-detail-summary-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        border-bottom: 1px solid #edf2f7;
        padding: 9px 0;
        color: #475569;
        font-size: 0.88rem;
        font-weight: 700;
    }

    .invoice-detail-summary-row strong {
        color: #0f172a;
        font-weight: 900;
        text-align: right;
    }

    .invoice-detail-summary-total {
        margin-top: 12px;
        border-radius: 12px;
        background: #111827;
        color: #ffffff;
        padding: 13px;
    }

    .invoice-detail-summary-total span {
        display: block;
        color: rgba(255, 255, 255, 0.72);
        font-size: 0.78rem;
        font-weight: 750;
        margin-bottom: 3px;
    }

    .invoice-detail-summary-total strong {
        color: #ffffff;
        font-size: 1.35rem;
        font-weight: 900;
    }

    .invoice-detail-note {
        margin-top: 10px;
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 650;
        line-height: 1.45;
    }

    .invoice-detail-card {
        border: 1px solid #e5edf5;
        border-radius: 10px;
        background: #fbfdff;
        padding: 11px 12px;
    }

    .invoice-detail-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 760;
        margin-bottom: 4px;
    }

    .invoice-detail-value {
        color: #0f172a;
        font-size: 0.96rem;
        font-weight: 850;
        word-break: break-word;
    }

    .invoice-print-area {
        display: none;
    }

    .invoice-print-doc {
        width: 76mm;
        max-width: 76mm;
        margin: 0 auto;
        color: #111827;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 11px;
        line-height: 1.28;
    }

    .invoice-print-head {
        display: block;
        border-bottom: 1px dashed #111827;
        padding-bottom: 8px;
        margin-bottom: 8px;
        text-align: center;
    }

    .invoice-print-brand {
        font-size: 18px;
        font-weight: 900;
        letter-spacing: 0.02em;
        text-transform: uppercase;
    }

    .invoice-print-title {
        margin-top: 7px;
        text-align: center;
    }

    .invoice-print-title h1 {
        margin: 0;
        font-size: 15px;
        font-weight: 900;
        text-transform: uppercase;
    }

    .invoice-print-meta {
        font-size: 10.5px;
    }

    .invoice-receipt-meta {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 4px 12px;
        border-bottom: 1px dashed #111827;
        padding-bottom: 7px;
        margin-bottom: 7px;
    }

    .invoice-print-table {
        width: 100%;
        border-collapse: collapse;
        margin: 6px 0 8px;
        font-size: 10.5px;
    }

    .invoice-print-table th,
    .invoice-print-table td {
        border: 1px dashed #111827;
        padding: 4px 5px;
        text-align: left;
        vertical-align: top;
    }

    .invoice-print-table th {
        background: #ffffff;
        color: #111827;
        font-weight: 800;
    }

    .invoice-print-table .text-end {
        text-align: right;
    }

    .invoice-print-rental-info {
        min-width: 40mm;
    }

    .invoice-print-rental-info strong {
        display: block;
        font-size: 11.5px;
    }

    .invoice-print-rental-info span {
        display: block;
        margin-top: 2px;
    }

    .invoice-print-summary {
        width: 100%;
        margin-left: 0;
        border-top: 1px dashed #111827;
        padding-top: 4px;
    }

    .invoice-print-summary-row {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        padding: 3px 0;
        font-size: 11px;
    }

    .invoice-print-summary-row.total {
        color: #111827;
        font-size: 15px;
        font-weight: 900;
    }

    .invoice-print-thanks {
        border-top: 1px dashed #111827;
        margin-top: 8px;
        padding-top: 7px;
        text-align: center;
        font-size: 12px;
        font-weight: 900;
    }

    @@media (max-width: 1180px) {
        .invoice-hero {
            grid-template-columns: 1fr;
        }

        .invoice-toolbar {
            justify-content: flex-start;
        }
    }

    @@media (max-width: 900px) {
        .invoice-stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .invoice-search {
            min-width: 0;
            flex: 1 1 100%;
        }

        .invoice-detail-customer-strip,
        .invoice-detail-layout {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 640px) {
        .invoice-stat-grid,
        .invoice-detail-list {
            grid-template-columns: 1fr;
        }

        .invoice-hero h1 {
            font-size: 1.9rem;
        }
    }

    @@media print {
        @@page {
            size: 80mm auto;
            margin: 5mm;
        }

        body.invoice-print-mode .sidebar,
        body.invoice-print-mode .invoice-page,
        body.invoice-print-mode .modal,
        body.invoice-print-mode .modal-backdrop {
            display: none !important;
        }

        body.invoice-print-mode .main-wrapper {
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
        }

        body.invoice-print-mode .invoice-print-area {
            display: block !important;
        }

        body:not(.invoice-print-mode) .sidebar,
        body:not(.invoice-print-mode) .invoice-toolbar,
        body:not(.invoice-print-mode) .invoice-filter-row,
        body:not(.invoice-print-mode) .invoice-action-cell,
        body:not(.invoice-print-mode) .btn-close,
        body:not(.invoice-print-mode) .modal-footer {
            display: none !important;
        }
    }
</style>

<div class="invoice-page">
    <header class="invoice-hero">
        <div>
            <h1>Hóa đơn</h1>
        </div>
        <div class="invoice-toolbar">
            <label class="invoice-control invoice-search" for="invoiceSearchInput">
                <i class="bi bi-search"></i>
                <input id="invoiceSearchInput" type="search" placeholder="Tìm hóa đơn, khách, mã đặt phòng, nhân viên..." autocomplete="off" />
            </label>
            <select id="invoiceEmployeeFilter" class="invoice-control invoice-select">
                <option value="all">Tất cả nhân viên</option>
                @foreach (var employee in Model.Employees)
                {
                    <option value="@employee.EmployeeId">@employee.EmployeeName</option>
                }
            </select>
            <select id="invoiceSortSelect" class="invoice-control invoice-select">
                <option value="date-desc">Mới nhất</option>
                <option value="date-asc">Cũ nhất</option>
                <option value="total-desc">Tổng tiền cao</option>
                <option value="paid-desc">Đã thu cao</option>
                <option value="customer-asc">Tên khách A-Z</option>
            </select>
            <button type="button" class="invoice-action" onclick="window.print()">
                <i class="bi bi-printer"></i>
                In danh sách
            </button>
        </div>
    </header>

    <section class="invoice-stat-grid" aria-label="Thống kê hóa đơn">
        <div class="invoice-stat-card">
            <div class="invoice-stat-top">
                <span class="invoice-stat-label">Đã thu</span>
                <span class="invoice-stat-icon paid"><i class="bi bi-cash-coin"></i></span>
            </div>
            <div class="invoice-stat-value">@Money(Model.TotalPaid)</div>
        </div>
        <div class="invoice-stat-card">
            <div class="invoice-stat-top">
                <span class="invoice-stat-label">Chờ thu</span>
                <span class="invoice-stat-icon pending"><i class="bi bi-hourglass-split"></i></span>
            </div>
            <div class="invoice-stat-value">@Money(Model.TotalRemaining)</div>
        </div>
        <div class="invoice-stat-card">
            <div class="invoice-stat-top">
                <span class="invoice-stat-label">Quá hạn</span>
                <span class="invoice-stat-icon overdue"><i class="bi bi-exclamation-circle"></i></span>
            </div>
            <div class="invoice-stat-value">@Money(Model.OverdueRemaining)</div>
        </div>
        <div class="invoice-stat-card">
            <div class="invoice-stat-top">
                <span class="invoice-stat-label">Tổng thanh toán</span>
                <span class="invoice-stat-icon total"><i class="bi bi-receipt"></i></span>
            </div>
            <div class="invoice-stat-value">@Money(Model.TotalAmount)</div>
        </div>
    </section>

    <section class="invoice-shell">
        <div class="invoice-shell-head">
            <div>
                <h2>Danh sách hóa đơn</h2>
            </div>
            <div class="invoice-shell-actions">
                <div class="invoice-date-range" aria-label="Lọc ngày lập hóa đơn">
                    <input id="invoiceDateFromFilter" class="invoice-date-compact" type="date" title="Từ ngày" />
                    <input id="invoiceDateToFilter" class="invoice-date-compact" type="date" title="Đến ngày" />
                    <button type="button" class="invoice-reset-filter" id="invoiceResetFilterButton">Đặt lại</button>
                </div>
                <span class="invoice-count-pill" id="invoiceVisibleCount">
                    <i class="bi bi-list-check"></i>
                    0 hóa đơn
                </span>
            </div>
        </div>

        <div class="invoice-filter-row" aria-label="Lọc trạng thái hóa đơn">
            <button type="button" class="invoice-filter-chip active" data-status-filter="all">Tất cả</button>
            <button type="button" class="invoice-filter-chip" data-status-filter="paid">Đã thanh toán</button>
            <button type="button" class="invoice-filter-chip" data-status-filter="partial">Một phần</button>
            <button type="button" class="invoice-filter-chip" data-status-filter="unpaid">Chưa thanh toán</button>
            <button type="button" class="invoice-filter-chip" data-status-filter="overdue">Quá hạn</button>
            <button type="button" class="invoice-filter-chip" data-status-filter="cancelled">Đã hủy</button>
        </div>

        <div class="invoice-table-wrap">
            <table class="invoice-table">
                <thead>
                    <tr>
                        <th>Hóa đơn</th>
                        <th>Khách hàng</th>
                        <th>Ngày lập</th>
                        <th class="text-end">Tiền phòng</th>
                        <th class="text-end">Dịch vụ</th>
                        <th class="text-end">Đã thu</th>
                        <th class="text-end">Tổng tiền</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="invoiceTableBody">
                    @foreach (var invoice in Model.Invoices)
                    {
                        var totalNumber = ParseCurrency(invoice.TotalAmountLabel);
                        var paidNumber = ParseCurrency(invoice.PaidAmountLabel);
                        <tr class="invoice-row"
                            data-invoice-row
                            data-invoice="@invoice.InvoiceCode"
                            data-booking="@invoice.BookingCode"
                            data-customer="@invoice.CustomerName"
                            data-phone="@(invoice.CustomerPhone ?? "")"
                            data-employee-id="@invoice.EmployeeId"
                            data-employee="@invoice.EmployeeName"
                            data-employee-position="@invoice.EmployeePosition"
                            data-room="@invoice.RoomSummary"
                            data-created="@invoice.CreatedDateLabel"
                            data-checkin="@invoice.CheckInLabel"
                            data-checkout="@invoice.CheckOutLabel"
                            data-paid-date="@invoice.PaidDateLabel"
                            data-room-amount="@invoice.RoomAmountLabel"
                            data-service-amount="@invoice.ServiceAmountLabel"
                            data-discount="@invoice.DiscountAmountLabel"
                            data-paid="@invoice.PaidAmountLabel"
                            data-remaining="@invoice.RemainingAmountLabel"
                            data-total="@invoice.TotalAmountLabel"
                            data-payment="@invoice.PaymentMethod"
                            data-status="@invoice.StatusClass"
                            data-status-label="@invoice.StatusLabel"
                            data-search="@($"{invoice.InvoiceCode} {invoice.BookingCode} {invoice.CustomerName} {invoice.CustomerPhone} {invoice.EmployeeId} {invoice.EmployeeName} {invoice.EmployeePosition} {invoice.RoomSummary} {invoice.StatusLabel} {invoice.PaymentMethod}")"
                            data-date="@invoice.SortDateValue"
                            data-total-number="@totalNumber.ToString(CultureInfo.InvariantCulture)"
                            data-paid-number="@paidNumber.ToString(CultureInfo.InvariantCulture)">
                            <td>
                                <div class="invoice-main-code">@invoice.InvoiceCode</div>
                                <span class="invoice-subtext">@invoice.BookingCode</span>
                            </td>
                            <td>
                                <div class="invoice-customer">@invoice.CustomerName</div>
                                <span class="invoice-subtext">@(invoice.CustomerPhone ?? "Chưa có SĐT")</span>
                            </td>
                            <td>
                                @invoice.CreatedDateLabel
                                <span class="invoice-subtext">@invoice.PaidDateLabel</span>
                            </td>
                            <td class="invoice-money">@invoice.RoomAmountLabel</td>
                            <td class="invoice-money">@invoice.ServiceAmountLabel</td>
                            <td class="invoice-money">@invoice.PaidAmountLabel</td>
                            <td class="invoice-money">@invoice.TotalAmountLabel</td>
                            <td class="invoice-status-cell">
                                <span class="invoice-status @invoice.StatusClass">
                                    <i class="bi bi-circle-fill"></i>
                                    @invoice.StatusLabel
                                </span>
                                <span class="invoice-subtext">@invoice.PaymentMethod</span>
                            </td>
                            <td>
                                <div class="invoice-action-cell">
                                    <button type="button" class="invoice-icon-btn btn-invoice-detail" title="Chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button type="button" class="invoice-icon-btn btn-invoice-print" title="In hóa đơn">
                                        <i class="bi bi-printer"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="invoice-empty-state" id="invoiceEmptyState">
            <i class="bi bi-search d-block fs-2 mb-2"></i>
            Không tìm thấy hóa đơn phù hợp.
        </div>
    </section>
</div>

<div class="modal fade" id="invoiceDetailModal" tabindex="-1" aria-labelledby="invoiceDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl invoice-detail-dialog">
        <div class="modal-content border-0 shadow-lg invoice-detail-modal">
            <div class="modal-header">
                <div class="invoice-detail-heading">
                    <div>
                        <div class="invoice-detail-eyebrow">Chi tiết hóa đơn</div>
                        <h5 class="modal-title" id="invoiceDetailModalLabel">Hóa đơn</h5>
                        <div class="text-muted small" id="detailInvoiceSub"></div>
