        }

        .booking-rooms .room-select-panel {
            grid-column: 1 / -1;
            border-top: 1px solid var(--hotel-border);
            border-left: 0;
        }

        .booking-rooms .booking-summary-bar {
            max-width: calc(100% - 24px);
        }

        .booking-rooms .summary-total {
            text-align: left;
        }
    }

    @@media (max-width: 767.98px) {
        .booking-rooms {
            padding-top: 2rem !important;
            padding-bottom: 2.5rem !important;
        }

        .booking-rooms .text-center.mb-5 {
            margin-bottom: 2rem !important;
        }

        .booking-rooms .result-summary {
            display: block;
        }

        .booking-rooms .result-summary span {
            display: inline-flex;
            margin-top: 6px;
        }

        .booking-rooms .guest-picker-panel {
