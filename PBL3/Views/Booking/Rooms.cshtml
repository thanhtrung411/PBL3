        padding: 16px 22px 22px;
        border-top: 1px solid var(--hotel-border);
    }

    .capacity-actions .btn {
        min-height: 44px;
        border-radius: 7px;
        font-weight: 750;
    }

    .booking-rooms .room-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 14px;
    }

    .booking-rooms .room-actions .btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        white-space: normal;
    }

    .booking-rooms .state-card {
        display: none;
        padding: 38px 22px;
        background-color: #ffffff;
        text-align: center;
    }

    .booking-rooms .state-card.is-visible {
        display: block;
    }

    .booking-rooms .state-card i {
        color: var(--hotel-gold);
        font-size: 2rem;
    }

    .booking-rooms .state-card p {
        max-width: 560px;
        margin-left: auto;
        margin-right: auto;
    }

    .booking-rooms .loading-results {
        display: none;
    }

    .booking-rooms .search-card.is-loading ~ .loading-results {
        display: flex;
    }

    .booking-rooms .skeleton-card {
        border: 1px solid var(--hotel-border);
        border-radius: 10px;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 8px 24px rgba(16, 24, 40, 0.06);
    }

    .booking-rooms .skeleton-block {
        display: block;
        border-radius: 8px;
        background: linear-gradient(90deg, #f0f1f2, #fbfbfb, #f0f1f2);
        background-size: 200% 100%;
        animation: roomsShimmer 1.1s ease-in-out infinite;
    }

    @@keyframes roomsShimmer {
        0% {
            background-position: 100% 0;
        }

        100% {
            background-position: -100% 0;
        }
    }

    @@media (max-width: 991.98px) {
        .booking-rooms .search-card .card-body {
