    }

    .capacity-modal {
        --hotel-ink: #111111;
        --hotel-gold: #d4af37;
        --hotel-muted: #667085;
        --hotel-border: #e9ecef;
        position: fixed;
        inset: 0;
        z-index: 2000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(17, 17, 17, 0.58);
    }

    .capacity-modal.is-visible {
        display: flex;
    }

    .capacity-dialog {
        width: min(460px, 100%);
        border: 1px solid rgba(255, 255, 255, 0.32);
        border-radius: 10px;
        background: #ffffff;
        box-shadow: 0 24px 64px rgba(16, 24, 40, 0.28);
        overflow: hidden;
    }

    .capacity-dialog-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 22px 14px;
    }

    .capacity-icon {
        width: 42px;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
