@model PBL3.Models.RoomSearchViewModel

@{
    ViewData["Title"] = "Chọn phòng";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var checkIn = Model.CheckIn.ToString("yyyy-MM-dd");
    var checkOut = Model.CheckOut.ToString("yyyy-MM-dd");
    var selectedGuests = Model.Guests.ToString();
    var selectedRooms = Model.NumberOfRooms.ToString();
    var selectedRoomType = Model.RoomTypeId;
    var roomTypeOptions = Model.RoomTypeOptions;
    var requestedRooms = Math.Max(Model.NumberOfRooms, 1);
    var recommendedRoomCount = Model.RecommendedRooms.Sum(x => x.Rooms);
    var initialAdults = Math.Clamp(Model.Guests, 1, 80);
    var initialChildren = 0;
    var initialRooms = Math.Clamp(Model.NumberOfRooms, 1, 20);
}

<style>
