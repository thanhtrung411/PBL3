@model PBL3.Models.RoomSearchViewModel

@{
    ViewData["Title"] = "Chọn phòng";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var checkIn = Model.CheckIn.ToString("yyyy-MM-dd");
    var checkOut = Model.CheckOut.ToString("yyyy-MM-dd");
    var selectedGuests = Model.Guests.ToString();
}

<style>
    .booking-rooms {
        --hotel-ink: #111111;
        --hotel-gold: #d4af37;
        --hotel-muted: #667085;
        --hotel-border: #e9ecef;
        --hotel-danger: #b42318;
        --hotel-soft: #f8f9fa;
        --hotel-warm: #fbf7ec;
        overflow-x: hidden;
    }

    .booking-rooms .row,
    .booking-rooms .card,
    .booking-rooms .card-body,
    .booking-rooms .room-actions,
    .booking-rooms .result-summary {
        min-width: 0;
    }

    .booking-rooms .page-kicker {
        color: var(--hotel-gold);
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .booking-rooms .page-title {
        color: var(--hotel-ink);
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 800;
        letter-spacing: 0;
        overflow-wrap: anywhere;
    }

    .booking-rooms .page-subtitle {
        max-width: 640px;
        margin: 0 auto;
        color: var(--hotel-muted);
        overflow-wrap: anywhere;
    }

    .booking-rooms .search-card,
    .booking-rooms .room-card,
    .booking-rooms .state-card {
        border: 1px solid var(--hotel-border);
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(16, 24, 40, 0.06);
    }

    .booking-rooms .search-card {
        position: relative;
        overflow: hidden;
        background: #ffffff;
    }

    .booking-rooms .search-card::before {
        content: "";
        display: block;
        height: 4px;
        background: linear-gradient(90deg, var(--hotel-ink), var(--hotel-gold));
    }

    .booking-rooms .search-card.is-loading {
        border-color: rgba(212, 175, 55, 0.45);
    }

    .booking-rooms .form-label {
        color: var(--hotel-muted);
        font-size: 0.8rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .booking-rooms .form-control,
    .booking-rooms .form-select {
        min-height: 50px;
        border-radius: 6px;
        border-color: var(--hotel-border);
        color: var(--hotel-ink);
        font-weight: 600;
    }

    .booking-rooms .form-control:focus,
    .booking-rooms .form-select:focus {
        border-color: var(--hotel-ink);
        box-shadow: 0 0 0 0.2rem rgba(17, 17, 17, 0.12);
    }

    .booking-rooms .form-control[aria-invalid="true"] {
        border-color: var(--hotel-danger);
        box-shadow: 0 0 0 0.2rem rgba(180, 35, 24, 0.1);
    }

    .booking-rooms .btn-hotel {
        min-height: 50px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-color: var(--hotel-ink);
        background-color: var(--hotel-ink);
        color: #ffffff;
        font-weight: 800;
        white-space: normal;
    }

    .booking-rooms .btn-hotel:hover,
    .booking-rooms .btn-hotel:focus-visible {
        border-color: var(--hotel-gold);
        background-color: var(--hotel-gold);
        color: var(--hotel-ink);
    }

    .booking-rooms .btn-hotel:disabled {
        cursor: wait;
        opacity: 0.8;
    }

    .booking-rooms .btn-room {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 2px solid var(--hotel-ink);
        border-radius: 6px;
        background: transparent;
        color: var(--hotel-ink);
        font-weight: 800;
        white-space: normal;
    }

    .booking-rooms .btn-room:hover,
    .booking-rooms .btn-room:focus-visible {
        border-color: var(--hotel-gold);
        background-color: var(--hotel-gold);
        color: var(--hotel-ink);
    }

    .booking-rooms .loading-icon,
    .booking-rooms .is-loading .default-icon {
        display: none;
    }

    .booking-rooms .is-loading .loading-icon {
        display: inline-block;
    }

    .booking-rooms .inline-error {
        display: none;
        border: 1px solid rgba(180, 35, 24, 0.22);
        border-radius: 6px;
        background-color: #fff4f2;
        color: var(--hotel-danger);
        font-size: 0.95rem;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .booking-rooms .inline-error.is-visible {
        display: block;
    }

    .booking-rooms .loading-note {
        display: none;
        margin-top: 12px;
        color: var(--hotel-muted);
        font-size: 0.9rem;
        font-weight: 600;
    }

    .booking-rooms .search-card.is-loading .loading-note {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .booking-rooms .result-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin: 28px 0 20px;
        padding: 0 2px;
        color: var(--hotel-muted);
        font-size: 0.95rem;
        overflow-wrap: anywhere;
    }

    .booking-rooms .result-summary strong {
        color: var(--hotel-ink);
        font-size: 1.05rem;
    }

    .booking-rooms .result-summary > span,
    .booking-rooms .result-count {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid rgba(212, 175, 55, 0.35);
        border-radius: 999px;
        background: var(--hotel-warm);
        padding: 8px 12px;
        color: var(--hotel-ink);
        font-weight: 700;
    }

    .booking-rooms .room-card {
        overflow: hidden;
        background: #ffffff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .booking-rooms .room-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 32px rgba(16, 24, 40, 0.1);
    }

    .booking-rooms .room-card img {
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        background: linear-gradient(135deg, #eeeeee, #f7f7f7);
    }

    .booking-rooms .room-media {
        position: relative;
        background: var(--hotel-soft);
    }

    .booking-rooms .room-badge {
        position: absolute;
        left: 16px;
        top: 16px;
        border-radius: 999px;
        background: rgba(17, 17, 17, 0.88);
        color: #ffffff;
        font-size: 0.78rem;
        font-weight: 800;
        padding: 7px 11px;
    }

    .booking-rooms .room-title {
        color: var(--hotel-ink);
        font-weight: 800;
        line-height: 1.3;
        overflow-wrap: anywhere;
    }

    .booking-rooms .room-meta,
    .booking-rooms .room-feature {
        color: var(--hotel-muted);
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

    .booking-rooms .room-feature {
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }

    .booking-rooms .room-feature-icon {
        width: 18px;
        margin-top: 4px;
        color: var(--hotel-gold);
        text-align: center;
        flex: 0 0 18px;
    }

    .booking-rooms .price {
        color: #b42318;
        font-size: clamp(1.25rem, 3vw, 1.5rem);
        font-weight: 800;
        overflow-wrap: anywhere;
    }

    .booking-rooms .price-note {
        display: block;
        margin-top: 2px;
        color: var(--hotel-muted);
    }

    .booking-rooms .room-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 14px;
    }

    .booking-rooms .room-actions .btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        white-space: normal;
    }

    .booking-rooms .state-card {
        display: none;
        padding: 38px 22px;
        background-color: #ffffff;
        text-align: center;
    }

    .booking-rooms .state-card.is-visible {
        display: block;
    }

    .booking-rooms .state-card i {
        color: var(--hotel-gold);
        font-size: 2rem;
    }

    .booking-rooms .state-card p {
        max-width: 560px;
        margin-left: auto;
        margin-right: auto;
    }

    .booking-rooms .loading-results {
        display: none;
    }

    .booking-rooms .search-card.is-loading ~ .loading-results {
        display: flex;
    }

    .booking-rooms .skeleton-card {
        border: 1px solid var(--hotel-border);
        border-radius: 10px;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 8px 24px rgba(16, 24, 40, 0.06);
    }

    .booking-rooms .skeleton-block {
        display: block;
        border-radius: 8px;
        background: linear-gradient(90deg, #f0f1f2, #fbfbfb, #f0f1f2);
        background-size: 200% 100%;
        animation: roomsShimmer 1.1s ease-in-out infinite;
    }

    @@keyframes roomsShimmer {
        0% {
            background-position: 100% 0;
        }

        100% {
            background-position: -100% 0;
        }
    }

    @@media (max-width: 991.98px) {
        .booking-rooms .search-card .card-body {
            padding: 1.25rem !important;
        }
    }

    @@media (max-width: 767.98px) {
        .booking-rooms {
            padding-top: 2rem !important;
            padding-bottom: 2.5rem !important;
        }

        .booking-rooms .text-center.mb-5 {
            margin-bottom: 2rem !important;
        }

        .booking-rooms .result-summary {
            display: block;
        }

        .booking-rooms .result-summary span {
            display: inline-flex;
            margin-top: 6px;
        }
    }

    @@media (max-width: 575.98px) {
        .booking-rooms .page-title {
            font-size: 1.7rem;
        }

        .booking-rooms .search-card .card-body {
            padding: 1rem !important;
        }

        .booking-rooms .room-actions {
            align-items: stretch;
        }

        .booking-rooms .room-actions,
        .booking-rooms .room-actions .btn {
            width: 100%;
        }

        .booking-rooms .room-card .card-body {
            padding: 1.25rem !important;
        }

        .booking-rooms .state-card {
            padding: 30px 18px;
        }

        .booking-rooms .result-count {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="booking-rooms container py-5">
    <div class="text-center mb-5">
        <div class="page-kicker mb-2">Venus Hotel</div>
        <h1 class="page-title mb-2">Khám phá các hạng phòng</h1>
        <p class="page-subtitle">Lựa chọn không gian nghỉ dưỡng phù hợp với lịch trình của bạn</p>
    </div>

    <section class="search-card card mb-4 border-0" id="roomsSearchPanel" aria-label="Tìm phòng trống" aria-busy="false">
        <div class="card-body p-4">
            <div class="inline-error mb-3 p-3" id="roomsError" role="alert" aria-live="assertive" tabindex="-1">
                <i class="fa fa-exclamation-circle me-2" aria-hidden="true"></i>
                <span></span>
            </div>

            <form action="/Booking/Rooms" method="GET" class="row g-3 align-items-end" id="roomsSearchForm">
                <div class="col-lg-3 col-md-6">
                    <label for="checkInDate" class="form-label">Nhận phòng</label>
                    <input type="date" id="checkInDate" name="checkIn" class="form-control" value="@checkIn" required>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label for="checkOutDate" class="form-label">Trả phòng</label>
                    <input type="date" id="checkOutDate" name="checkOut" class="form-control" value="@checkOut" required>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label for="guests" class="form-label">Số người</label>
                    <select class="form-select" id="guests" name="guests">
                        @if (selectedGuests == "1")
                        {
                            <option value="1" selected>1 Người lớn</option>
                        }
                        else
                        {
                            <option value="1">1 Người lớn</option>
                        }

                        @if (selectedGuests == "2")
                        {
                            <option value="2" selected>2 Người lớn</option>
                        }
                        else
                        {
                            <option value="2">2 Người lớn</option>
                        }

                        @if (selectedGuests == "3")
                        {
                            <option value="3" selected>3 Người lớn</option>
                        }
                        else
                        {
                            <option value="3">3 Người lớn</option>
                        }

                        @if (selectedGuests == "4")
                        {
                            <option value="4" selected>Gia đình (4 người)</option>
                        }
                        else
                        {
                            <option value="4">Gia đình (4 người)</option>
                        }
                    </select>
                </div>
                <div class="col-lg-3 col-md-6">
                    <button type="submit" class="btn btn-hotel w-100 py-2" id="roomsSearchButton">
                        <i class="fa fa-search default-icon" aria-hidden="true"></i>
                        <i class="fa fa-spinner fa-spin loading-icon" aria-hidden="true"></i>
                        <span>Tìm phòng trống</span>
                    </button>
                </div>
            </form>

            <p class="loading-note mb-0" id="roomsLoadingNote" aria-live="polite">
                <i class="fa fa-spinner fa-spin" aria-hidden="true"></i>
                Đang kiểm tra lựa chọn phòng phù hợp...
            </p>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="inline-error is-visible mb-4 p-3" role="alert">
            <i class="fa fa-exclamation-circle me-2" aria-hidden="true"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <div class="result-summary" id="resultSummary">
        <strong>Phòng gợi ý cho kỳ nghỉ của bạn</strong>
        <span><i class="fa fa-bed" aria-hidden="true"></i>Hiển thị @Model.Results.Count lựa chọn phù hợp</span>
    </div>

    <div class="row g-4 loading-results mb-4" aria-hidden="true">
        <div class="col-lg-4 col-md-6">
            <div class="skeleton-card">
                <span class="skeleton-block" style="height: 190px; border-radius: 0;"></span>
                <div class="p-4">
                    <span class="skeleton-block mb-3" style="height: 22px; width: 70%;"></span>
                    <span class="skeleton-block mb-2" style="height: 14px; width: 92%;"></span>
                    <span class="skeleton-block mb-4" style="height: 14px; width: 58%;"></span>
                    <span class="skeleton-block" style="height: 44px; width: 100%;"></span>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6">
            <div class="skeleton-card">
                <span class="skeleton-block" style="height: 190px; border-radius: 0;"></span>
                <div class="p-4">
                    <span class="skeleton-block mb-3" style="height: 22px; width: 65%;"></span>
                    <span class="skeleton-block mb-2" style="height: 14px; width: 88%;"></span>
                    <span class="skeleton-block mb-4" style="height: 14px; width: 60%;"></span>
                    <span class="skeleton-block" style="height: 44px; width: 100%;"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="state-card mb-4" id="roomsEmptyState" role="status" aria-live="polite">
        <i class="fa fa-bed mb-3" aria-hidden="true"></i>
        <h2 class="h5 fw-bold mb-2">Không tìm thấy phòng phù hợp</h2>
        <p class="text-muted mb-0">Hãy thử đổi ngày lưu trú hoặc số lượng khách để xem thêm lựa chọn.</p>
    </div>

    <div class="row g-4" id="roomResults" aria-live="polite">
        @foreach (var room in Model.Results)
        {
            <div class="col-lg-4 col-md-6 room-result">
                <article class="room-card card h-100 border-0">
                    <div class="room-media">
                        <img src="@room.ImageUrl" class="card-img-top" alt="Ảnh phòng @room.RoomName" loading="lazy" onerror="this.src='/images/deluxe-room.jpg';">
                        <span class="room-badge">Còn @room.AvailableRooms phòng</span>
                    </div>
                    <div class="card-body d-flex flex-column p-4">
                        <h2 class="room-title h5 mb-2">@room.RoomName</h2>
                        <p class="room-meta small mb-3">
                            <i class="fa fa-user me-2" aria-hidden="true"></i>Tối đa @room.MaxGuests người
                            <span aria-hidden="true">&bull;</span>
                            <i class="fa fa-calendar-days me-2 ms-1" aria-hidden="true"></i>@Model.CheckIn.ToString("dd/MM") - @Model.CheckOut.ToString("dd/MM")
                        </p>
                        <ul class="list-unstyled small mb-4">
                            <li class="room-feature mb-2"><i class="fa fa-wifi room-feature-icon" aria-hidden="true"></i><span>Wifi tốc độ cao miễn phí</span></li>
                            <li class="room-feature mb-2"><i class="fa fa-mug-saucer room-feature-icon" aria-hidden="true"></i><span>Bữa sáng và tiện nghi theo hạng phòng</span></li>
                            <li class="room-feature"><i class="fa fa-circle-info room-feature-icon" aria-hidden="true"></i><span>@room.Description</span></li>
                        </ul>
                        <div class="room-actions mt-auto">
                            <div>
                                <span class="price">@room.PricePerNight.ToString("N0")đ</span><br>
                                <span class="small price-note">/ đêm (VNPay hoặc thanh toán tại khách sạn)</span>
                            </div>
                            <a href="@Url.Action("Checkout", "Booking", new {
                                roomId = room.RoomTypeId,
                                checkIn = Model.CheckIn.ToString("yyyy-MM-dd"),
                                checkOut = Model.CheckOut.ToString("yyyy-MM-dd"),
                                guests = Model.Guests
                            })" class="btn btn-room px-4">Chọn phòng</a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
</div>

<script>
    (function () {
        const form = document.getElementById('roomsSearchForm');
        const button = document.getElementById('roomsSearchButton');
        const panel = document.getElementById('roomsSearchPanel');
        const error = document.getElementById('roomsError');
        const errorText = error?.querySelector('span');
        const emptyState = document.getElementById('roomsEmptyState');
        const roomResults = document.querySelectorAll('.room-result');
        const checkInInput = document.getElementById('checkInDate');
        const checkOutInput = document.getElementById('checkOutDate');

        function showError(message) {
            if (errorText) {
                errorText.textContent = message;
            }
            error.classList.add('is-visible');
            error.focus();
        }

        function clearError() {
            if (errorText) {
                errorText.textContent = '';
            }
            error.classList.remove('is-visible');
            checkInInput?.removeAttribute('aria-invalid');
            checkOutInput?.removeAttribute('aria-invalid');
        }

        function setLoading(isLoading) {
            button.disabled = isLoading;
            button.classList.toggle('is-loading', isLoading);
            panel.classList.toggle('is-loading', isLoading);
            panel.setAttribute('aria-busy', String(isLoading));
            button.querySelector('span').textContent = isLoading ? 'Đang tìm...' : 'Tìm phòng trống';
        }

        if (roomResults.length === 0) {
            emptyState.classList.add('is-visible');
        }

        form?.addEventListener('submit', function (event) {
            clearError();

            const checkIn = checkInInput.value;
            const checkOut = checkOutInput.value;

            if (!checkIn || !checkOut) {
                event.preventDefault();
                checkInInput.setAttribute('aria-invalid', String(!checkIn));
                checkOutInput.setAttribute('aria-invalid', String(!checkOut));
                showError('Vui lòng chọn ngày nhận và trả phòng.');
                return;
            }

            if (new Date(checkOut) <= new Date(checkIn)) {
                event.preventDefault();
                checkOutInput.setAttribute('aria-invalid', 'true');
                showError('Ngày trả phòng phải sau ngày nhận phòng.');
                return;
            }

            setLoading(true);
        });
    })();
</script>
