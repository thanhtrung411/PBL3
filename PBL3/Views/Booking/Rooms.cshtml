        .booking-rooms .booking-summary-bar .card-body {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .booking-rooms .booking-summary-bar .btn {
            width: 100%;
        }
    }

    @@media (max-width: 575.98px) {
        .booking-rooms .page-title {
            font-size: 1.7rem;
        }

        .booking-rooms .search-card .card-body {
            padding: 1rem !important;
        }

        .booking-rooms .room-actions {
            align-items: stretch;
        }

        .booking-rooms .room-actions,
        .booking-rooms .room-actions .btn {
            width: 100%;
        }

        .booking-rooms .room-card .card-body {
            padding: 1.25rem !important;
        }

        .booking-rooms .room-card-horizontal {
            grid-template-columns: 1fr;
        }

        .booking-rooms .room-card img {
            min-height: 190px;
            aspect-ratio: 16 / 9;
        }

        .booking-rooms .room-main,
        .booking-rooms .room-select-panel {
            padding: 18px;
        }

        .booking-rooms .state-card {
            padding: 30px 18px;
        }

        .booking-rooms .result-count {
            width: 100%;
            justify-content: center;
        }

        .booking-rooms .guest-picker-panel {
            position: fixed;
            top: auto;
            right: 14px;
            bottom: 18px;
            left: 14px;
            width: auto;
            max-height: calc(100vh - 36px);
            overflow-y: auto;
        }
    }
</style>

<div class="booking-rooms container py-5">
    <div class="text-center mb-5">
        <div class="page-kicker mb-2">Venus Hotel</div>
        <h1 class="page-title mb-2">Khám phá các hạng phòng</h1>
        <p class="page-subtitle">Lựa chọn không gian nghỉ dưỡng phù hợp với lịch trình của bạn</p>
    </div>

    <section class="search-card card mb-4 border-0" id="roomsSearchPanel" aria-label="Tìm phòng" aria-busy="false">
        <div class="card-body p-4">
            <div class="inline-error mb-3 p-3" id="roomsError" role="alert" aria-live="assertive" tabindex="-1">
                <i class="fa fa-exclamation-circle me-2" aria-hidden="true"></i>
                <span></span>
            </div>

            <form action="/Booking/Rooms" method="GET" class="row g-3 align-items-end" id="roomsSearchForm">
                <div class="col-xl-2 col-lg-3 col-md-6">
                    <label for="checkInDate" class="form-label">Nhận phòng</label>
                    <input type="date" id="checkInDate" name="checkIn" class="form-control" value="@checkIn" required>
                </div>
                <div class="col-xl-2 col-lg-3 col-md-6">
                    <label for="checkOutDate" class="form-label">Trả phòng</label>
                    <input type="date" id="checkOutDate" name="checkOut" class="form-control" value="@checkOut" required>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6">
                    <label for="roomType" class="form-label">Loại phòng</label>
                    <select class="form-select" id="roomType" name="roomType">
                        <option value="">Tất cả loại phòng</option>
                        @foreach (var roomType in roomTypeOptions)
                        {
                            <option value="@roomType.RoomTypeId" selected="@(selectedRoomType == roomType.RoomTypeId)">@roomType.RoomName</option>
                        }
                    </select>
                </div>
                <div class="col-xl-2 col-lg-3 col-md-6">
                    <label for="guests" class="form-label">Số người</label>
                    <select class="form-select" id="guests" name="guests">
                        @if (selectedGuests == "1")
                        {
                            <option value="1" selected>1 Người lớn</option>
                        }
                        else
                        {
                            <option value="1">1 Người lớn</option>
                        }

                        @if (selectedGuests == "2")
                        {
                            <option value="2" selected>2 Người lớn</option>
                        }
                        else
                        {
                            <option value="2">2 Người lớn</option>
                        }

                        @if (selectedGuests == "3")
                        {
                            <option value="3" selected>3 Người lớn</option>
                        }
                        else
                        {
                            <option value="3">3 Người lớn</option>
                        }

                        @if (selectedGuests == "4")
                        {
                            <option value="4" selected>Gia đình (4 người)</option>
                        }
                        else
                        {
                            <option value="4">Gia đình (4 người)</option>
                        }
                    </select>
                </div>
                <div class="col-xl-2 col-lg-3 col-md-6">
                    <label for="rooms" class="form-label">Số phòng</label>
                    <select class="form-select" id="rooms" name="rooms">
                        @for (var roomCount = 1; roomCount <= 20; roomCount++)
                        {
                            <option value="@roomCount" selected="@(selectedRooms == roomCount.ToString())">@roomCount phòng</option>
                        }
                    </select>
                </div>
                <div class="col-xl-2 col-lg-12 col-md-6">
                    <button type="submit" class="btn btn-hotel w-100 py-2" id="roomsSearchButton">
                        <i class="fa fa-search default-icon" aria-hidden="true"></i>
                        <i class="fa fa-spinner fa-spin loading-icon" aria-hidden="true"></i>
                        <span>Tìm phòng</span>
                    </button>
                </div>
            </form>

            <p class="loading-note mb-0" id="roomsLoadingNote" aria-live="polite">
                <i class="fa fa-spinner fa-spin" aria-hidden="true"></i>
                Đang kiểm tra lựa chọn phòng phù hợp...
            </p>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="inline-error is-visible mb-4 p-3" role="alert">
            <i class="fa fa-exclamation-circle me-2" aria-hidden="true"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <div class="result-summary" id="resultSummary">
        <strong>Phòng gợi ý cho kỳ nghỉ của bạn</strong>
        <span><i class="fa fa-bed" aria-hidden="true"></i>Hiển thị @Model.Results.Count lựa chọn phù hợp</span>
    </div>

    @if (Model.Results.Any())
    {
        <form action="@Url.Action("Checkout", "Booking")" method="get" class="booking-summary-bar" id="comboCheckoutForm" aria-live="polite">
            <input type="hidden" name="checkIn" value="@Model.CheckIn.ToString("yyyy-MM-dd")">
            <input type="hidden" name="checkOut" value="@Model.CheckOut.ToString("yyyy-MM-dd")">
            <input type="hidden" name="guests" value="@Model.Guests">
            <input type="hidden" name="rooms" id="comboRoomsInput" value="@recommendedRoomCount">
            <input type="hidden" name="roomSelection" id="comboSelectionInput" value="@Model.RoomSelection">
            <input type="hidden" name="capacityWarningConfirmed" id="comboCapacityWarningConfirmedInput" value="false">
            <div class="card-body p-4 d-flex flex-wrap justify-content-between gap-3 align-items-center">
                <div>
                    <h2 class="h5 fw-bold mb-1">Tùy chỉnh combo phòng</h2>
                    <p class="text-muted mb-0" id="comboSummary">Chọn số phòng từng loại để đủ sức chứa.</p>
                </div>
                <button type="submit" class="btn btn-hotel px-4" id="comboSubmitButton">Thanh toán</button>
            </div>
        </form>
    }

    @if (false && Model.HasSearched && Model.RecommendedRooms.Any() && !string.IsNullOrWhiteSpace(Model.RoomSelection))
    {
        <section class="search-card card mb-4 border-0">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap justify-content-between gap-3 align-items-start">
                    <div>
                        <h2 class="h5 fw-bold mb-2">Combo tiết kiệm nhất</h2>
                        @foreach (var item in Model.RecommendedRooms)
                        {
                            <p class="text-muted mb-1">@item.RoomName: @item.Rooms phòng · @item.Guests khách</p>
                        }
                        <p class="fw-bold mb-0">@Model.RecommendedRooms.Sum(x => x.LineTotalPerNight).ToString("N0")đ / đêm</p>
                    </div>
                    <a href="@Url.Action("Checkout", "Booking", new {
                        checkIn = Model.CheckIn.ToString("yyyy-MM-dd"),
                        checkOut = Model.CheckOut.ToString("yyyy-MM-dd"),
                        guests = Model.Guests,
                        rooms = recommendedRoomCount,
                        roomSelection = Model.RoomSelection
                    })" class="btn btn-room px-4">Chọn combo</a>
                </div>
            </div>
        </section>
    }

    <div class="row g-4 loading-results mb-4" aria-hidden="true">
        <div class="col-lg-4 col-md-6">
            <div class="skeleton-card">
                <span class="skeleton-block" style="height: 190px; border-radius: 0;"></span>
                <div class="p-4">
                    <span class="skeleton-block mb-3" style="height: 22px; width: 70%;"></span>
                    <span class="skeleton-block mb-2" style="height: 14px; width: 92%;"></span>
                    <span class="skeleton-block mb-4" style="height: 14px; width: 58%;"></span>
                    <span class="skeleton-block" style="height: 44px; width: 100%;"></span>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6">
            <div class="skeleton-card">
                <span class="skeleton-block" style="height: 190px; border-radius: 0;"></span>
                <div class="p-4">
                    <span class="skeleton-block mb-3" style="height: 22px; width: 65%;"></span>
                    <span class="skeleton-block mb-2" style="height: 14px; width: 88%;"></span>
                    <span class="skeleton-block mb-4" style="height: 14px; width: 60%;"></span>
                    <span class="skeleton-block" style="height: 44px; width: 100%;"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="state-card mb-4" id="roomsEmptyState" role="status" aria-live="polite">
        <i class="fa fa-bed mb-3" aria-hidden="true"></i>
        <h2 class="h5 fw-bold mb-2">Không tìm thấy phòng phù hợp</h2>
        <p class="text-muted mb-0">Hãy thử đổi ngày lưu trú hoặc số lượng khách để xem thêm lựa chọn.</p>
    </div>

    <div class="room-list" id="roomResults" aria-live="polite">
        @foreach (var room in Model.Results)
        {
            var roomsToBook = Math.Min(requestedRooms, Math.Max(room.AvailableRooms, 1));
            var roomActionText = roomsToBook == requestedRooms
                ? "Chọn phòng"
                : $"Chọn {roomsToBook} phòng";
            <div class="room-result">
                <article class="room-card room-card-horizontal">
                    <div class="room-media">
                        <img src="@room.ImageUrl" class="card-img-top" alt="Ảnh phòng @room.RoomName" loading="lazy" onerror="this.src='/images/booking_hero.jpg';">
                        <span class="room-badge">Còn @room.AvailableRooms phòng</span>
                    </div>
                    <div class="room-main">
                        <h2 class="room-title h5 mb-2">@room.RoomName</h2>
                        <p class="room-meta small mb-3">
                            <i class="fa fa-user me-2" aria-hidden="true"></i>Tối đa @room.MaxGuests người
                            <span aria-hidden="true">&bull;</span>
                            <i class="fa fa-calendar-days me-2 ms-1" aria-hidden="true"></i>@Model.CheckIn.ToString("dd/MM") - @Model.CheckOut.ToString("dd/MM")
                        </p>
                        @if (room.AvailableRooms < requestedRooms)
                        {
                            <p class="small text-muted mb-3">Loại này chỉ còn @room.AvailableRooms phòng, có thể ghép thêm với loại khác.</p>
                        }
                        <ul class="list-unstyled small mb-4">
                            <li class="room-feature mb-2"><i class="fa fa-wifi room-feature-icon" aria-hidden="true"></i><span>Wifi tốc độ cao miễn phí</span></li>
                            <li class="room-feature mb-2"><i class="fa fa-mug-saucer room-feature-icon" aria-hidden="true"></i><span>Bữa sáng và tiện nghi theo hạng phòng</span></li>
                            <li class="room-feature"><i class="fa fa-circle-info room-feature-icon" aria-hidden="true"></i><span>@room.Description</span></li>
                        </ul>
                    </div>
                    <div class="room-select-panel">
                            <div>
                                <span class="price">@room.PricePerNight.ToString("N0")đ</span><br>
                                <span class="small price-note">/ đêm (VNPay hoặc thanh toán tại khách sạn)</span>
                                <label class="form-label small mt-3 mb-1" for="comboRooms_@room.RoomTypeId">Số phòng trong combo</label>
                                <div class="room-quantity-control">
                                    <button class="combo-stepper" type="button" data-target="comboRooms_@room.RoomTypeId" data-delta="-1" aria-label="Giảm số phòng @room.RoomName">-</button>
                                    <input class="combo-room-count" id="comboRooms_@room.RoomTypeId" type="text" inputmode="numeric" min="0" max="@room.AvailableRooms" value="@room.RecommendedRooms" data-room-type="@room.RoomTypeId" data-room-name="@room.RoomName" data-capacity="@room.MaxGuests" data-price="@room.PricePerNight.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                    <button class="combo-stepper" type="button" data-target="comboRooms_@room.RoomTypeId" data-delta="1" aria-label="Tăng số phòng @room.RoomName">+</button>
                                </div>
                                <div class="room-line-total" data-line-total-for="@room.RoomTypeId"></div>
                            </div>
                            <a href="@Url.Action("Checkout", "Booking", new {
                                roomId = room.RoomTypeId,
                                checkIn = Model.CheckIn.ToString("yyyy-MM-dd"),
                                checkOut = Model.CheckOut.ToString("yyyy-MM-dd"),
                                guests = Model.Guests,
                                rooms = roomsToBook
                            })" class="btn btn-room px-4">Chọn phòng</a>
                        </div>
                </article>
            </div>
        }
    </div>
</div>

<div class="capacity-modal" id="capacityWarningModal" role="dialog" aria-modal="true" aria-labelledby="capacityWarningTitle" aria-describedby="capacityWarningText">
    <div class="capacity-dialog">
        <div class="capacity-dialog-header">
            <span class="capacity-icon"><i class="fa fa-triangle-exclamation" aria-hidden="true"></i></span>
            <h2 class="capacity-title" id="capacityWarningTitle">Sức chứa chưa đủ</h2>
        </div>
        <div class="capacity-body">
            <p class="mb-2" id="capacityWarningText"></p>
            <p class="mb-0"><strong>Bạn vẫn muốn xác nhận thanh toán?</strong></p>
        </div>
        <div class="capacity-actions">
            <button type="button" class="btn btn-outline-dark px-4" id="capacityCancelButton">Hủy</button>
            <button type="button" class="btn btn-hotel px-4" id="capacityConfirmButton">Xác nhận</button>
        </div>
    </div>
</div>

<script>
    (function () {
        const form = document.getElementById('roomsSearchForm');
        const button = document.getElementById('roomsSearchButton');
        const panel = document.getElementById('roomsSearchPanel');
        const error = document.getElementById('roomsError');
        const errorText = error?.querySelector('span');
        const emptyState = document.getElementById('roomsEmptyState');
        const roomResultsPanel = document.getElementById('roomResults');
        const roomResults = document.querySelectorAll('.room-result');
        const checkInInput = document.getElementById('checkInDate');
        const checkOutInput = document.getElementById('checkOutDate');
        const comboForm = document.getElementById('comboCheckoutForm');
        const comboTitle = comboForm?.querySelector('h2');
        const comboSummary = document.getElementById('comboSummary');
        const comboSubmitButton = document.getElementById('comboSubmitButton');
        const comboSelectionInput = document.getElementById('comboSelectionInput');
        const comboRoomsInput = document.getElementById('comboRoomsInput');
        const comboCapacityWarningConfirmedInput = document.getElementById('comboCapacityWarningConfirmedInput');
        const comboRoomInputs = document.querySelectorAll('.combo-room-count');
        const comboStepButtons = document.querySelectorAll('.combo-stepper');
        const capacityWarningModal = document.getElementById('capacityWarningModal');
        const capacityWarningText = document.getElementById('capacityWarningText');
        const capacityConfirmButton = document.getElementById('capacityConfirmButton');
        const capacityCancelButton = document.getElementById('capacityCancelButton');
        const requiredGuests = Number('@Model.Guests');
        const stayNights = Math.max(1, Math.ceil((new Date('@checkOut') - new Date('@checkIn')) / 86400000));
        const bookingRoomsPage = document.querySelector('.booking-rooms');
        const searchGuestSelect = document.getElementById('guests');
        const searchRoomSelect = document.getElementById('rooms');
        let roomOptionsInView = false;
        let selectedComboRooms = 0;
        let selectedComboCapacity = 0;
        let submittingAfterCapacityConfirm = false;
        let roomsGuestState = {
            adults: Math.max(1, Number('@initialAdults')),
            children: Number('@initialChildren'),
            rooms: Math.max(1, Number('@initialRooms'))
        };

        function setupRoomsGuestPicker() {
            if (!searchGuestSelect || !searchRoomSelect || document.getElementById('roomsGuestSelector')) return;

            searchGuestSelect.closest('[class*="col-"]')?.classList.add('d-none');
            searchRoomSelect.closest('[class*="col-"]')?.classList.add('d-none');
            searchGuestSelect.disabled = true;
            searchRoomSelect.disabled = true;

            const guestInput = document.createElement('input');
            guestInput.type = 'hidden';
            guestInput.name = 'guests';
            guestInput.id = 'roomsGuestHiddenInput';

            const roomsInput = document.createElement('input');
            roomsInput.type = 'hidden';
            roomsInput.name = 'rooms';
            roomsInput.id = 'roomsCountHiddenInput';

            const wrapper = document.createElement('div');
            wrapper.className = 'col-xl-3 col-lg-6 col-md-6 rooms-guest-selector';
            wrapper.id = 'roomsGuestSelector';
            wrapper.innerHTML = `
                <label for="roomsGuestSummaryButton" class="form-label">S\u1ed1 ng\u01b0\u1eddi</label>
                <button class="guest-summary-button" id="roomsGuestSummaryButton" type="button" aria-expanded="false" aria-controls="roomsGuestPickerPanel">
                    <i class="fa-regular fa-user" aria-hidden="true"></i>
                    <span id="roomsGuestSummaryText"></span>
                    <i class="fa fa-chevron-down guest-chevron" aria-hidden="true"></i>
                </button>
                <div class="guest-picker-panel" id="roomsGuestPickerPanel">
                    <div class="guest-counter-row">
                        <div class="guest-counter-label">Ng\u01b0\u1eddi l\u1edbn</div>
                        <div class="guest-counter-control">
                            <button class="guest-stepper" type="button" data-counter="adults" data-delta="-1">-</button>
                            <span class="guest-count-value" data-count-for="adults"></span>
                            <button class="guest-stepper" type="button" data-counter="adults" data-delta="1">+</button>
                        </div>
                    </div>
                    <div class="guest-counter-row">
                        <div class="guest-counter-label">Tr\u1ebb em</div>
                        <div class="guest-counter-control">
                            <button class="guest-stepper" type="button" data-counter="children" data-delta="-1">-</button>
                            <span class="guest-count-value" data-count-for="children"></span>
                            <button class="guest-stepper" type="button" data-counter="children" data-delta="1">+</button>
                        </div>
                    </div>
                    <div class="guest-counter-row">
                        <div class="guest-counter-label">Ph\u00f2ng</div>
                        <div class="guest-counter-control">
                            <button class="guest-stepper" type="button" data-counter="rooms" data-delta="-1">-</button>
                            <span class="guest-count-value" data-count-for="rooms"></span>
                            <button class="guest-stepper" type="button" data-counter="rooms" data-delta="1">+</button>
                        </div>
                    </div>
                    <button class="guest-picker-done" id="roomsGuestPickerDone" type="button">Xong</button>
                </div>`;

            wrapper.appendChild(guestInput);
            wrapper.appendChild(roomsInput);
            searchRoomSelect.closest('[class*="col-"]')?.after(wrapper);

            const summaryButton = document.getElementById('roomsGuestSummaryButton');
            const doneButton = document.getElementById('roomsGuestPickerDone');
            const limits = {
                adults: { min: 1, max: 80 },
                children: { min: 0, max: 80 },
                rooms: { min: 1, max: 20 },
                totalGuests: 80
            };

            function updatePicker() {
                const totalGuests = roomsGuestState.adults + roomsGuestState.children;
                const childrenText = roomsGuestState.children > 0 ? ` \u00b7 ${roomsGuestState.children} tr\u1ebb em` : '';
                document.getElementById('roomsGuestSummaryText').textContent =
                    `${roomsGuestState.adults} ng\u01b0\u1eddi l\u1edbn${childrenText} \u00b7 ${roomsGuestState.rooms} ph\u00f2ng`;
                guestInput.value = String(totalGuests);
                roomsInput.value = String(roomsGuestState.rooms);
                wrapper.querySelectorAll('[data-count-for]').forEach((item) => {
                    item.textContent = roomsGuestState[item.dataset.countFor];
                });
                wrapper.querySelectorAll('.guest-stepper').forEach((button) => {
                    const name = button.dataset.counter;
                    const delta = Number(button.dataset.delta);
                    const value = roomsGuestState[name];
                    let disabled = delta < 0 ? value <= limits[name].min : value >= limits[name].max;
                    if ((name === 'adults' || name === 'children') && delta > 0) {
                        disabled = disabled || totalGuests >= limits.totalGuests;
                    }
                    button.disabled = disabled;
                });
            }

            function setPickerOpen(isOpen) {
                wrapper.classList.toggle('is-open', isOpen);
                panel?.classList.toggle('has-open-picker', isOpen);
                summaryButton?.setAttribute('aria-expanded', String(isOpen));
            }

            summaryButton?.addEventListener('click', () => {
                setPickerOpen(!wrapper.classList.contains('is-open'));
            });
            doneButton?.addEventListener('click', () => setPickerOpen(false));
            wrapper.querySelectorAll('.guest-stepper').forEach((button) => {
                button.addEventListener('click', () => {
                    const name = button.dataset.counter;
                    const limit = limits[name];
                    roomsGuestState[name] = Math.min(limit.max, Math.max(limit.min, roomsGuestState[name] + Number(button.dataset.delta)));
                    updatePicker();
                });
            });
            document.addEventListener('click', (event) => {
                if (!wrapper.contains(event.target)) setPickerOpen(false);
            });
            updatePicker();
        }

        setupRoomsGuestPicker();
        if (comboSubmitButton) {
            comboSubmitButton.textContent = 'Thanh toán';
        }

        function showError(message) {
            if (errorText) {
                errorText.textContent = message;
            }
            error.classList.add('is-visible');
            error.focus();
        }

        function clearError() {
            if (errorText) {
                errorText.textContent = '';
            }
            error.classList.remove('is-visible');
            checkInInput?.removeAttribute('aria-invalid');
            checkOutInput?.removeAttribute('aria-invalid');
        }

        function setLoading(isLoading) {
            button.disabled = isLoading;
            button.classList.toggle('is-loading', isLoading);
            panel.classList.toggle('is-loading', isLoading);
            panel.setAttribute('aria-busy', String(isLoading));
            button.querySelector('span').textContent = isLoading ? 'Đang tìm...' : 'Tìm phòng';
        }

        if (roomResults.length === 0) {
            emptyState.classList.add('is-visible');
        }

        function updateComboSelection() {
            let rooms = 0;
            let capacity = 0;
            let nightlyTotal = 0;
            const selection = [];

            comboRoomInputs.forEach((input) => {
                const max = Number(input.max || 0);
                let count = Math.max(0, Math.min(max, Number(input.value || 0)));
                input.value = String(count);
                const price = Number(input.dataset.price || 0);
                const lineTotal = count * price * stayNights;
                const lineTotalElement = document.querySelector(`[data-line-total-for="${input.dataset.roomType}"]`);
                if (lineTotalElement) {
                    lineTotalElement.textContent = count > 0
                        ? `${lineTotal.toLocaleString('vi-VN')}đ cho ${stayNights} đêm`
                        : 'Chưa chọn phòng';
                }
                if (count <= 0) return;

                rooms += count;
                capacity += count * Number(input.dataset.capacity || 0);
                nightlyTotal += count * price;
                selection.push(`${input.dataset.roomType}:${count}`);
            });

            if (comboSelectionInput) comboSelectionInput.value = selection.join(',');
            if (comboRoomsInput) comboRoomsInput.value = String(rooms);
            selectedComboRooms = rooms;
            selectedComboCapacity = capacity;
            if (comboCapacityWarningConfirmedInput && !submittingAfterCapacityConfirm) {
                comboCapacityWarningConfirmedInput.value = 'false';
            }
            const totalAmount = nightlyTotal * stayNights;
            if (comboTitle) {
                comboTitle.textContent = rooms === 0 ? 'Chọn phòng để tiếp tục' : `${rooms} phòng đã chọn`;
            }
            if (comboSummary) {
                comboSummary.textContent = rooms === 0
                    ? 'Chọn số phòng từng loại để đủ sức chứa.'
                    : `${capacity >= requiredGuests ? 'Đáp ứng' : 'Chưa đủ'} ${requiredGuests} khách · ${stayNights} đêm · ${totalAmount.toLocaleString('vi-VN')}đ`;
            }
            if (comboSubmitButton) {
                comboSubmitButton.disabled = rooms <= 0;
            }
            comboStepButtons.forEach((button) => {
                const input = document.getElementById(button.dataset.target);
                if (!input) return;
                const value = Number(input.value || 0);
                const max = Number(input.max || 0);
                const delta = Number(button.dataset.delta || 0);
                button.disabled = delta < 0 ? value <= 0 : value >= max;
            });
            updateStickySummary();
        }

        comboStepButtons.forEach((button) => {
            button.addEventListener('click', () => {
                const input = document.getElementById(button.dataset.target);
                if (!input) return;
                const max = Number(input.max || 0);
                const value = Number(input.value || 0);
                const nextValue = Math.max(0, Math.min(max, value + Number(button.dataset.delta || 0)));
                input.value = String(nextValue);
                updateComboSelection();
            });
        });

        comboRoomInputs.forEach((input) => {
            input.addEventListener('input', updateComboSelection);
            input.addEventListener('change', updateComboSelection);
        });

        function setCapacityModalOpen(isOpen) {
            capacityWarningModal?.classList.toggle('is-visible', isOpen);
            document.body.classList.toggle('modal-open', isOpen);
            if (isOpen) {
                capacityConfirmButton?.focus();
            }
        }

        function showCapacityWarning() {
            if (capacityWarningText) {
                capacityWarningText.innerHTML =
                    `Combo ph\u00f2ng hi\u1ec7n t\u1ea1i ch\u1ec9 ch\u1ee9a t\u1ed1i \u0111a <strong>${selectedComboCapacity} kh\u00e1ch</strong>, trong khi b\u1ea1n \u0111ang \u0111\u1eb7t cho <strong>${requiredGuests} kh\u00e1ch</strong>.`;
            }
            setCapacityModalOpen(true);
        }

        capacityCancelButton?.addEventListener('click', () => setCapacityModalOpen(false));
        capacityWarningModal?.addEventListener('click', (event) => {
            if (event.target === capacityWarningModal) {
                setCapacityModalOpen(false);
            }
        });
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && capacityWarningModal?.classList.contains('is-visible')) {
                setCapacityModalOpen(false);
            }
        });
        capacityConfirmButton?.addEventListener('click', () => {
            if (comboCapacityWarningConfirmedInput) {
                comboCapacityWarningConfirmedInput.value = 'true';
            }
            submittingAfterCapacityConfirm = true;
            setCapacityModalOpen(false);
            comboForm?.requestSubmit();
        });

        function updateStickySummary() {
            const shouldShow = Boolean(comboForm && roomResults.length > 0 && roomOptionsInView && selectedComboRooms > 0);
            comboForm?.classList.toggle('is-visible', shouldShow);
            bookingRoomsPage?.classList.toggle('has-sticky-summary', shouldShow);
        }

        if (roomResultsPanel && 'IntersectionObserver' in window) {
            const roomObserver = new IntersectionObserver((entries) => {
                roomOptionsInView = entries.some((entry) => entry.isIntersecting);
                updateStickySummary();
            }, { threshold: 0.04 });
            roomObserver.observe(roomResultsPanel);
        } else {
            const detectRoomOptions = () => {
                if (!roomResultsPanel) return;
                const rect = roomResultsPanel.getBoundingClientRect();
                roomOptionsInView = rect.top < window.innerHeight && rect.bottom > 0;
                updateStickySummary();
            };
            window.addEventListener('scroll', detectRoomOptions, { passive: true });
            window.addEventListener('resize', detectRoomOptions);
            detectRoomOptions();
        }

        comboForm?.addEventListener('submit', function (event) {
            updateComboSelection();
            if (submittingAfterCapacityConfirm && comboCapacityWarningConfirmedInput) {
                comboCapacityWarningConfirmedInput.value = 'true';
            }

            if (selectedComboRooms <= 0) {
                event.preventDefault();
                showError('Vui l\u00f2ng ch\u1ecdn \u00edt nh\u1ea5t 1 ph\u00f2ng \u0111\u1ec3 thanh to\u00e1n.');
                return;
            }

            if (selectedComboCapacity < requiredGuests && !submittingAfterCapacityConfirm) {
                event.preventDefault();
                showCapacityWarning();
                return;
            }

            submittingAfterCapacityConfirm = false;
        });

        updateComboSelection();

        form?.addEventListener('submit', function (event) {
            clearError();

            const checkIn = checkInInput.value;
            const checkOut = checkOutInput.value;

            if (!checkIn || !checkOut) {
                event.preventDefault();
                checkInInput.setAttribute('aria-invalid', String(!checkIn));
                checkOutInput.setAttribute('aria-invalid', String(!checkOut));
                showError('Vui lòng chọn ngày nhận và trả phòng.');
                return;
            }

            if (new Date(checkOut) <= new Date(checkIn)) {
                event.preventDefault();
                checkOutInput.setAttribute('aria-invalid', 'true');
                showError('Ngày trả phòng phải sau ngày nhận phòng.');
                return;
            }

            setLoading(true);
        });
    })();
</script>
