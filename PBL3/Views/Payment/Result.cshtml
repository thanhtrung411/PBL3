@model PBL3.Models.PaymentCallbackResult

@{
    ViewData["Title"] = Model.Success ? "Thanh toán thành công" : "Thanh toán chưa hoàn tất";
}

<style>
    .payment-result {
        --hotel-ink: #111111;
        --hotel-gold: #d4af37;
        --hotel-border: #e9ecef;
        --hotel-muted: #667085;
        --hotel-success: #198754;
        --hotel-danger: #b42318;
        overflow-x: hidden;
    }

    .payment-result .result-card {
        border: 1px solid var(--hotel-border);
        border-radius: 12px;
        box-shadow: 0 14px 36px rgba(16, 24, 40, 0.08);
        overflow: hidden;
    }

    .payment-result .result-icon {
        width: 82px;
        height: 82px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 2.8rem;
    }

    .payment-result .result-icon.is-success {
        background: #eaf7ef;
        color: var(--hotel-success);
    }

    .payment-result .result-icon.is-error {
        background: #fff4f2;
        color: var(--hotel-danger);
    }

    .payment-result .summary-row {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        padding: 10px 0;
        border-bottom: 1px solid var(--hotel-border);
    }

    .payment-result .summary-row span:first-child {
        color: var(--hotel-muted);
    }

    .payment-result .summary-row span:last-child {
        font-weight: 800;
        text-align: right;
        overflow-wrap: anywhere;
    }

    .payment-result .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 36px;
        border-radius: 999px;
        font-size: 0.9rem;
        font-weight: 800;
        padding: 7px 13px;
    }

    .payment-result .status-pill.is-success {
        background: #eaf7ef;
        color: var(--hotel-success);
    }

    .payment-result .status-pill.is-error {
        background: #fff4f2;
        color: var(--hotel-danger);
    }

    .payment-result .btn-hotel,
    .payment-result .btn-soft {
        min-height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        white-space: normal;
    }

    .payment-result .btn-hotel {
        border-color: var(--hotel-ink);
        background: var(--hotel-ink);
        color: #ffffff;
    }

    .payment-result .btn-hotel:hover,
    .payment-result .btn-hotel:focus-visible,
    .payment-result .btn-soft:hover,
    .payment-result .btn-soft:focus-visible {
        border-color: var(--hotel-gold);
        background: var(--hotel-gold);
        color: var(--hotel-ink);
    }

    .payment-result .btn-soft {
        border: 2px solid var(--hotel-ink);
        color: var(--hotel-ink);
    }

    @@media (max-width: 575.98px) {
        .payment-result .summary-row {
            display: block;
        }

        .payment-result .summary-row span:last-child {
            display: block;
            margin-top: 4px;
            text-align: left;
        }

        .payment-result .btn-hotel,
        .payment-result .btn-soft {
            width: 100%;
        }
    }
</style>

<div class="payment-result container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <section class="result-card card border-0 p-4 p-md-5 text-center" role="status" aria-live="polite">
                <div class="result-icon @(Model.Success ? "is-success" : "is-error") mb-4 mx-auto">
                    <i class="fa @(Model.Success ? "fa-circle-check" : "fa-circle-exclamation")" aria-hidden="true"></i>
                </div>

                <h1 class="h2 fw-bold mb-3">@ViewData["Title"]</h1>
                <p class="text-muted fs-5 mb-4">@Model.Message</p>

                <div class="status-pill @(Model.Success ? "is-success" : "is-error") mb-4">
                    <i class="fa @(Model.Success ? "fa-shield-check" : "fa-triangle-exclamation")" aria-hidden="true"></i>
                    <span>@(Model.Success ? "Giao dịch đã được xác minh" : "Giao dịch chưa được ghi nhận thành công")</span>
                </div>

                <div class="text-start mb-4">
                    <div class="summary-row"><span>Mã đặt phòng</span><span>@Model.BookingCode</span></div>
                    <div class="summary-row"><span>Số tiền</span><span>@Model.Amount.ToString("N0")đ</span></div>
                    <div class="summary-row"><span>Mã phản hồi</span><span>@Model.ResponseCode</span></div>
                    <div class="summary-row"><span>Mã giao dịch VNPay</span><span>@(Model.TransactionNo ?? "Không có")</span></div>
                    <div class="summary-row"><span>Ngân hàng</span><span>@(Model.BankCode ?? "Không có")</span></div>
                </div>

                <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                    <a asp-controller="Booking" asp-action="Success" asp-route-id="@Model.BookingCode" class="btn btn-hotel btn-lg px-4">
                        <i class="fa fa-receipt me-2" aria-hidden="true"></i>Xem đặt phòng
                    </a>
                    @if (!Model.Success)
                    {
                        <a asp-controller="Payment" asp-action="Start" asp-route-id="@Model.BookingCode" class="btn btn-soft btn-lg px-4">
                            <i class="fa fa-rotate-right me-2" aria-hidden="true"></i>Thanh toán lại
                        </a>
                    }
                    <a asp-controller="Booking" asp-action="Lookup" class="btn btn-soft btn-lg px-4">
                        <i class="fa fa-magnifying-glass me-2" aria-hidden="true"></i>Tra cứu
                    </a>
                </div>
            </section>
        </div>
    </div>
</div>
