@model PBL3.Models.AdminReportViewModel
@using System.Globalization
@using System.Text.Json

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Báo cáo & Thống kê";
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    string Money(decimal value) => $"{value.ToString("N0", vi)} đ";
}

<div class="admin-page-header">
    <div>
        <h3 class="admin-page-title">Báo cáo & Thống kê</h3>
    </div>
</div>

<div class="card-custom mb-4">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3 flex-wrap gap-3">
        <div>
            <div class="fw-bold fs-5">Báo cáo tổng hợp</div>
            <div class="text-muted small">Thời gian: @Model.PeriodLabel</div>
        </div>
        <form class="d-flex gap-2 align-items-center flex-wrap" method="get" asp-controller="Report" asp-action="Index">
            <input class="form-control bg-light" style="width: 170px;" type="month" name="month" value="@Model.SelectedMonthValue" />
            <button class="btn btn-dark" type="submit"><i class="bi bi-funnel"></i> Xem</button>
            <a class="btn btn-dark" asp-controller="Report" asp-action="Export" asp-route-month="@Model.SelectedMonthValue">
                <i class="bi bi-download"></i> Xuất file
            </a>
        </form>
    </div>

    <div class="row g-3">
        <div class="col-md-3">
            <div class="p-3 border rounded">
                <div class="text-muted small mb-2">Tổng doanh thu</div>
                <div class="fw-bold fs-3 text-dark">@Money(Model.TotalRevenue)</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-3 border rounded">
                <div class="text-muted small mb-2">Tổng đặt phòng</div>
                <div class="fw-bold fs-3 text-dark">@Model.TotalBookings</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-3 border rounded">
                <div class="text-muted small mb-2">Tỷ lệ lấp đầy TB</div>
                <div class="fw-bold fs-3 text-dark">@Model.OccupancyRate.ToString("0.#", vi)%</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-3 border rounded">
                <div class="text-muted small mb-2">Giá trị đơn TB</div>
                <div class="fw-bold fs-3 text-dark">@Money(Model.AverageOrderValue)</div>
            </div>
        </div>
    </div>
</div>

<div class="card-custom mb-4">
    <div class="fw-bold fs-5 mb-3 text-dark">Xu hướng doanh thu</div>
    <div style="height: 300px; width: 100%;">
        <canvas id="revenueTrendChart"></canvas>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card-custom">
            <div class="fw-bold fs-5 mb-3 text-dark">Doanh thu theo loại phòng</div>
            <div style="height: 250px; width: 100%;">
                <canvas id="revenueByTypeChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card-custom">
            <div class="fw-bold fs-5 mb-3 text-dark">Tỷ lệ lấp đầy</div>
            <div style="height: 250px; width: 100%;">
                <canvas id="occupancyChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const revenueTrendLabels = @Html.Raw(JsonSerializer.Serialize(Model.RevenueTrendLabels));
        const revenueTrendValues = @Html.Raw(JsonSerializer.Serialize(Model.RevenueTrendValues));
        const roomTypeRevenueLabels = @Html.Raw(JsonSerializer.Serialize(Model.RoomTypeRevenueLabels));
        const roomTypeRevenueValues = @Html.Raw(JsonSerializer.Serialize(Model.RoomTypeRevenueValues));
        const occupancyLabels = @Html.Raw(JsonSerializer.Serialize(Model.OccupancyLabels));
        const occupancyValues = @Html.Raw(JsonSerializer.Serialize(Model.OccupancyValues));

        function formatCurrency(value) {
            return new Intl.NumberFormat("vi-VN").format(value || 0) + " đ";
        }

        const ctxTrend = document.getElementById('revenueTrendChart').getContext('2d');
        new Chart(ctxTrend, {
            type: 'line',
            data: {
                labels: revenueTrendLabels,
                datasets: [{
                    label: 'Doanh thu',
                    data: revenueTrendValues,
                    borderColor: '#4e73df',
                    backgroundColor: 'rgba(78, 115, 223, 0.1)',
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: context => formatCurrency(context.parsed.y)
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: value => formatCurrency(value)
                        }
                    }
                }
            }
        });

        const ctxType = document.getElementById('revenueByTypeChart').getContext('2d');
        new Chart(ctxType, {
            type: 'bar',
            data: {
                labels: roomTypeRevenueLabels.length ? roomTypeRevenueLabels : ['Chưa có dữ liệu'],
                datasets: [{
                    label: 'Doanh thu',
                    data: roomTypeRevenueValues.length ? roomTypeRevenueValues : [0],
                    backgroundColor: '#4e73df',
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: context => formatCurrency(context.parsed.y)
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: value => formatCurrency(value)
                        }
                    }
                }
            }
        });

        const ctxOcc = document.getElementById('occupancyChart').getContext('2d');
        new Chart(ctxOcc, {
            type: 'line',
            data: {
                labels: occupancyLabels,
                datasets: [{
                    label: 'Tỷ lệ lấp đầy',
                    data: occupancyValues,
                    borderColor: '#1cc88a',
                    backgroundColor: 'rgba(28, 200, 138, 0.08)',
                    fill: true,
                    tension: 0.25
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: context => `${context.parsed.y || 0}%`
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100,
                        ticks: {
                            callback: value => `${value}%`
                        }
                    }
                }
            }
        });
    </script>
}
