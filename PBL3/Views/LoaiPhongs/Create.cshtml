@model PBL3.Models.AdminRoomTypeCreateViewModel
@using System.Globalization

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thêm loại phòng mới";
    var weekdayLabels = new Dictionary<byte, string>
    {
        [2] = "Thứ 2",
        [3] = "Thứ 3",
        [4] = "Thứ 4",
        [5] = "Thứ 5",
        [6] = "Thứ 6",
        [7] = "Thứ 7",
        [8] = "Chủ nhật"
    };
}

<style>
    .room-create-page {
        color: #111827;
    }

    .room-create-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 24px;
    }

    .room-create-header h1 {
        margin: 0;
        font-size: 2rem;
        font-weight: 820;
        letter-spacing: 0;
    }

    .room-create-header p {
        margin: 6px 0 0;
        color: #64748b;
        font-size: 1rem;
    }

    .room-create-layout {
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(430px, 1.05fr);
        gap: 18px;
        align-items: start;
    }

    .room-create-panel {
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        background: #ffffff;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.07);
        overflow: hidden;
    }

    .panel-heading {
        display: flex;
        align-items: center;
        gap: 10px;
        border-bottom: 1px solid #edf2f7;
        background: #fbfdff;
        padding: 18px 20px;
    }

    .panel-heading i {
        color: #1d4ed8;
        font-size: 1.1rem;
    }

    .panel-heading h2 {
        margin: 0;
        font-size: 1rem;
        font-weight: 760;
    }

    .panel-body {
        display: grid;
        gap: 16px;
        padding: 20px;
    }

    .form-grid-2 {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .create-field {
        display: grid;
        gap: 7px;
        margin: 0;
    }

    .create-field.full {
        grid-column: 1 / -1;
    }

    .create-field label,
    .create-field > span {
        color: #475569;
        font-size: 0.78rem;
        font-weight: 740;
        text-transform: uppercase;
    }

    .create-field input,
    .create-field textarea {
        width: 100%;
        border: 1px solid #dbe3ef;
        border-radius: 10px;
        background: #ffffff;
        color: #111827;
        font-size: 0.95rem;
        font-weight: 620;
        padding: 11px 12px;
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .create-field textarea {
        min-height: 124px;
        resize: vertical;
    }

    .create-field input:focus,
    .create-field textarea:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
    }

    .field-hint {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 560;
    }

    .validation-summary-errors {
        border: 1px solid #fecaca;
        border-radius: 12px;
        background: #fef2f2;
        color: #991b1b;
        padding: 12px 14px;
    }

    .text-danger {
        font-size: 0.78rem;
        font-weight: 650;
    }

    .default-price-card {
        display: grid;
        gap: 10px;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: #fbfdff;
        padding: 14px;
    }

    .default-price-card strong {
        color: #b91c1c;
        font-size: 1.35rem;
        font-weight: 780;
    }

    .weekday-create-grid {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 9px;
    }

    .weekday-create-card {
        display: grid;
        gap: 8px;
        border: 1px solid #dbe7f3;
        border-radius: 12px;
        background: #ffffff;
        padding: 11px;
    }

    .weekday-create-card.is-changed {
        border-color: #f0c04a;
        background: #fff7d6;
    }

    .weekday-create-card > span {
        color: #111827;
        font-size: 0.82rem;
        font-weight: 760;
        text-align: center;
    }

    .weekday-create-card input {
        border: 1px solid #dbe3ef;
        border-radius: 8px;
        padding: 8px;
        text-align: center;
    }

    .weekday-create-card small {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 650;
        text-align: center;
    }

    .create-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 18px;
    }

    .create-actions .btn {
        border-radius: 9px;
        font-weight: 740;
        padding: 10px 16px;
    }

    @@media (max-width: 1180px) {
        .room-create-layout,
        .form-grid-2 {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 760px) {
        .room-create-header,
        .create-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .weekday-create-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="room-create-page">
    <div class="room-create-header">
        <div>
            <h1>Thêm loại phòng mới</h1>
            <p>Tạo hạng phòng và thiết lập giá nền ngay trong một bước.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Quay lại
        </a>
    </div>

    <form asp-action="Create" method="post" id="roomTypeCreateForm">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="room-create-layout">
            <section class="room-create-panel">
                <div class="panel-heading">
                    <i class="bi bi-layers"></i>
                    <h2>Thông tin loại phòng</h2>
                </div>
                <div class="panel-body">
                    <div class="form-grid-2">
                        <label class="create-field">
                            <span>Mã loại phòng</span>
                            <input asp-for="RoomTypeId" placeholder="LP05" autocomplete="off" />
                            <small class="field-hint">Tối đa 10 ký tự, ví dụ LP05.</small>
                            <span asp-validation-for="RoomTypeId" class="text-danger"></span>
                        </label>

                        <label class="create-field">
                            <span>Sức chứa</span>
                            <input asp-for="MaxGuests" type="number" min="1" step="1" />
                            <small class="field-hint">Số khách tối đa cho một phòng.</small>
                            <span asp-validation-for="MaxGuests" class="text-danger"></span>
                        </label>

                        <label class="create-field full">
                            <span>Tên loại phòng</span>
                            <input asp-for="RoomTypeName" placeholder="Premium Deluxe" autocomplete="off" />
                            <span asp-validation-for="RoomTypeName" class="text-danger"></span>
                        </label>

                        <label class="create-field full">
                            <span>Mô tả</span>
                            <textarea asp-for="Description" placeholder="Mô tả ngắn về hạng phòng, tiện nghi hoặc vị trí..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </label>
                    </div>
                </div>
            </section>

            <section class="room-create-panel">
                <div class="panel-heading">
                    <i class="bi bi-cash-stack"></i>
                    <h2>Thiết lập giá</h2>
                </div>
                <div class="panel-body">
                    <label class="create-field">
                        <span>Giá mặc định</span>
                        <input asp-for="DefaultPrice"
                               type="number"
                               min="0"
                               step="1000"
                               data-default-price-input
                               value="@Model.DefaultPrice.ToString("0.##", CultureInfo.InvariantCulture)" />
                        <small class="field-hint">Giá nền áp dụng hằng ngày nếu không có giá theo thứ hoặc ngày lễ.</small>
                        <span asp-validation-for="DefaultPrice" class="text-danger"></span>
                    </label>

                    <div class="default-price-card">
                        <span class="field-hint">Preview giá mặc định</span>
                        <strong data-default-price-preview>0đ</strong>
                    </div>

                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong>Giá theo thứ</strong>
                            <span class="field-hint">Hệ số 1 nghĩa là giữ nguyên giá mặc định.</span>
                        </div>
                        <div class="weekday-create-grid">
                            @for (var i = 0; i < Model.WeekdayMultipliers.Count; i++)
                            {
                                var day = Model.WeekdayMultipliers[i].DayValue;
                                var multiplier = Model.WeekdayMultipliers[i].Multiplier;
                                <label class="weekday-create-card">
                                    <span>@weekdayLabels[day]</span>
                                    <input type="hidden" asp-for="WeekdayMultipliers[i].DayValue" />
                                    <input asp-for="WeekdayMultipliers[i].Multiplier"
                                           type="number"
                                           min="0.1"
                                           step="0.05"
                                           value="@multiplier.ToString("0.####", CultureInfo.InvariantCulture)"
                                           data-weekday-multiplier />
                                    <small data-weekday-price-preview>0đ</small>
                                </label>
                            }
                        </div>
                        <span asp-validation-for="WeekdayMultipliers" class="text-danger"></span>
                    </div>
                </div>
            </section>
        </div>

        <div class="create-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            <button type="submit" class="btn btn-dark">
                <i class="bi bi-plus-lg"></i>
                Tạo loại phòng
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            const form = document.getElementById("roomTypeCreateForm");
            if (!form) return;

            const defaultInput = form.querySelector("[data-default-price-input]");
            const defaultPreview = form.querySelector("[data-default-price-preview]");

            function parseNumber(value) {
                const parsed = Number(String(value || "").replace(",", "."));
                return Number.isFinite(parsed) ? parsed : 0;
            }

            function formatCurrency(value) {
                return `${new Intl.NumberFormat("vi-VN").format(Math.round(value || 0))}đ`;
            }

            function updatePreview() {
                const defaultPrice = parseNumber(defaultInput.value);
                defaultPreview.textContent = defaultPrice > 0 ? formatCurrency(defaultPrice) : "0đ";

                form.querySelectorAll("[data-weekday-multiplier]").forEach(function (input) {
                    const card = input.closest(".weekday-create-card");
                    const multiplier = parseNumber(input.value || "1");
                    const preview = card.querySelector("[data-weekday-price-preview]");
                    const isChanged = Math.abs(multiplier - 1) > 0.0001;

                    card.classList.toggle("is-changed", isChanged);
                    preview.textContent = defaultPrice > 0 && multiplier > 0
                        ? formatCurrency(defaultPrice * multiplier)
                        : "0đ";
                });
            }

            form.addEventListener("input", updatePreview);
            updatePreview();
        })();
    </script>
}
