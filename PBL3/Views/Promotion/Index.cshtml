@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý khuyến mãi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1 fw-bold">Quản lý khuyến mãi</h3>
        <p class="text-muted mb-0">Quản lý các chương trình ưu đãi và giảm giá</p>
    </div>
    <div class="d-flex gap-2">
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control bg-white border-start-0" placeholder="Tìm kiếm khuyến mãi...">
        </div>
        <button class="btn btn-outline-secondary px-3 bg-white">+ Tạo khuyến mãi mới</button>
    </div>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card-custom p-3 border">
            <div class="d-flex flex-column">
                <i class="bi bi-tags text-primary fs-5 mb-2"></i>
                <div class="fw-bold fs-4">5</div>
                <div class="text-muted small">Tổng chương trình</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom p-3 border">
            <div class="d-flex flex-column">
                <i class="bi bi-check-circle text-success fs-5 mb-2"></i>
                <div class="fw-bold fs-4">3</div>
                <div class="text-muted small">Đang áp dụng</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom p-3 border">
            <div class="d-flex flex-column">
                <i class="bi bi-graph-up text-primary fs-5 mb-2"></i>
                <div class="fw-bold fs-4">508</div>
                <div class="text-muted small">Lượt sử dụng</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom p-3 border">
            <div class="d-flex flex-column">
                <i class="bi bi-arrow-down-right text-warning fs-5 mb-2"></i>
                <div class="fw-bold fs-4">3.2 tỷ</div>
                <div class="text-muted small">Tổng giảm giá</div>
            </div>
        </div>
    </div>
</div>

<!-- Promotion List -->
<div class="row">
    <div class="col-md-6">
        <div class="card-custom p-4 border position-relative">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-tag text-primary fs-5"></i>
                    <div>
                        <div class="fw-bold fs-5 text-dark">Tết đến Xuân về</div>
                        <div class="small text-muted"><span class="badge border text-dark fw-normal me-2">TET2026</span> Đang áp dụng</div>
                    </div>
                </div>
            </div>
            <p class="text-muted small mb-3 mt-2">Giảm giá 20% cho tất cả phòng trong dịp Tết nguyên đán</p>

            <div class="bg-primary bg-opacity-10 rounded p-3 mb-3 text-primary d-flex justify-content-between align-items-center">
                <div>
                    <div class="small fw-bold">Mức giảm</div>
                    <div class="fw-bold fs-4 mt-1">20%</div>
                </div>
                <div class="text-end">
                    <div class="small fw-bold">Tối đa</div>
                    <div class="fw-bold fs-4 mt-1">500.000 đ</div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 mb-2 text-muted small">
                <i class="bi bi-calendar3"></i> 01/02/2026 - 01/03/2026
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between small text-muted mb-1 mt-3">
                    <span>Lượt sử dụng</span>
                    <span>45 / 100</span>
                </div>
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-primary" role="progressbar" style="width: 45%" aria-valuenow="45" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center border-top pt-3">
                <button class="btn btn-outline-primary btn-sm px-4 rounded-pill"><i class="bi bi-eye me-1"></i> Chi tiết</button>
                <div class="d-flex gap-1">
                    <button class="btn btn-icon-only"><i class="bi bi-pencil mt-1 text-muted"></i></button>
                    <button class="btn btn-icon-only text-danger"><i class="bi bi-trash mt-1"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>

