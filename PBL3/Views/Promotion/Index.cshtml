            <div class="mb-2">
                <div class="d-flex justify-content-between small text-dark fw-bold mb-2">
                    <span>Lượt sử dụng</span>
                    <span>234 / 500</span>
                </div>
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-primary" role="progressbar" style="width: 46.8%" aria-valuenow="46.8" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Tạo khuyến mãi mới -->
<div class="modal fade" id="addPromotionModal" tabindex="-1" aria-labelledby="addPromotionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border: none; border-radius: 1rem; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.15);">
            <!-- Header -->
            <div class="modal-header border-0 px-4 pt-4 pb-2">
                <div>
                    <h5 class="modal-title fw-bold fs-5" id="addPromotionModalLabel">
                        <i class="bi bi-plus-circle-fill text-primary me-2"></i>Tạo chương trình khuyến mãi mới
                    </h5>
                    <p class="text-muted small mb-0 mt-1">Thiết lập thông tin, mức giảm và thời gian áp dụng khuyến mãi</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <!-- Body -->
            <div class="modal-body px-4 py-3" style="max-height: 70vh; overflow-y: auto;">
                <form id="addPromotionForm">
                    <!-- Section 1: Thông tin chung -->
                    <div class="mb-4">
                        <h6 class="text-primary fw-bold mb-3 border-bottom pb-2">
                            <i class="bi bi-info-circle-fill me-2"></i>Thông tin chung
                        </h6>
                        <div class="row g-3">
                            <!-- Tên chương trình -->
                            <div class="col-md-6">
                                <label for="promoName" class="form-label fw-semibold text-dark">Tên chương trình <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="promoName" required placeholder="VD: Khai xuân đón lộc"
                                       style="border-radius: 0.5rem; padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s;">
                            </div>
                            <!-- Mã khuyến mãi -->
                            <div class="col-md-6">
                                <label for="promoCode" class="form-label fw-semibold text-dark">Mã khuyến mãi <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="promoCode" required placeholder="VD: XUAN2026"
                                       style="border-radius: 0.5rem; padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s; text-transform: uppercase;">
                            </div>
                            <!-- Mô tả -->
                            <div class="col-12">
                                <label for="promoDescription" class="form-label fw-semibold text-dark">Mô tả</label>
                                <textarea class="form-control" id="promoDescription" rows="2" placeholder="Nhập mô tả chi tiết chương trình khuyến mãi..."
                                          style="border-radius: 0.5rem; padding: 0.6rem 0.85rem; border-color: #e5e7eb; resize: vertical; transition: all 0.2s;"></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Section 2: Thiết lập giảm giá -->
                    <div class="mb-4">
                        <h6 class="text-primary fw-bold mb-3 border-bottom pb-2">
                            <i class="bi bi-sliders me-2"></i>Thiết lập giảm giá
                        </h6>
                        <div class="row g-3">
                            <!-- Loại giảm giá -->
                            <div class="col-md-6">
                                <label for="discountType" class="form-label fw-semibold text-dark">Loại giảm giá <span class="text-danger">*</span></label>
                                <select class="form-select" id="discountType" required
                                        style="border-radius: 0.5rem; padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s; cursor: pointer;">
                                    <option value="percentage" selected>Giảm theo phần trăm (%)</option>
                                    <option value="fixed">Giảm theo số tiền cố định (VNĐ)</option>
                                </select>
                            </div>
                            <!-- Giá trị giảm -->
                            <div class="col-md-6">
                                <label for="discountValue" id="lblDiscountValue" class="form-label fw-semibold text-dark">Phần trăm giảm (%) <span class="text-danger">*</span></label>
                                <div class="input-group" style="border-radius: 0.5rem; overflow: hidden;">
                                    <input type="number" class="form-control" id="discountValue" min="1" required placeholder="VD: 20"
                                           style="padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s;">
                                    <span class="input-group-text bg-light text-muted" id="discountValueSuffix" style="border-color: #e5e7eb; font-weight: 500;">%</span>
                                </div>
                            </div>
                            <!-- Giảm tối đa -->
                            <div class="col-md-6" id="maxDiscountContainer">
                                <label for="maxDiscount" class="form-label fw-semibold text-dark">Giảm tối đa (VNĐ) <span class="text-danger">*</span></label>
                                <div class="input-group" style="border-radius: 0.5rem; overflow: hidden;">
                                    <input type="number" class="form-control" id="maxDiscount" min="0" placeholder="VD: 500000" required
                                           style="padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s;">
                                    <span class="input-group-text bg-light text-muted" style="border-color: #e5e7eb; font-weight: 500;">VNĐ</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Section 3: Điều kiện áp dụng -->
                    <div class="mb-4">
                        <h6 class="text-primary fw-bold mb-3 border-bottom pb-2">
                            <i class="bi bi-shield-check me-2"></i>Điều kiện áp dụng
                        </h6>
                        <div class="row g-3">
                            <!-- Đơn tối thiểu -->
                            <div class="col-md-4">
                                <label for="minOrderValue" class="form-label fw-semibold text-dark">Đơn tối thiểu (VNĐ)</label>
                                <div class="input-group" style="border-radius: 0.5rem; overflow: hidden;">
                                    <input type="number" class="form-control" id="minOrderValue" min="0" placeholder="VD: 1000000"
                                           style="padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s;">
                                    <span class="input-group-text bg-light text-muted" style="border-color: #e5e7eb; font-weight: 500;">VNĐ</span>
                                </div>
                            </div>
                            <!-- Loại phòng áp dụng -->
                            <div class="col-md-4">
                                <label for="roomType" class="form-label fw-semibold text-dark">Loại phòng</label>
                                <select class="form-select" id="roomType"
                                        style="border-radius: 0.5rem; padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s; cursor: pointer;">
                                    <option value="Tất cả loại phòng" selected>Tất cả loại phòng</option>
                                    <option value="Standard">Standard</option>
                                    <option value="Deluxe">Deluxe</option>
                                    <option value="Suite">Suite</option>
                                    <option value="Family">Family</option>
                                </select>
                            </div>
                            <!-- Số lượt sử dụng -->
                            <div class="col-md-4">
                                <label for="maxUses" class="form-label fw-semibold text-dark">Số lượt sử dụng <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="maxUses" required min="1" placeholder="VD: 100"
                                       style="border-radius: 0.5rem; padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s;">
                            </div>
                        </div>
                    </div>

                    <!-- Section 4: Thời gian -->
                    <div class="mb-2">
                        <h6 class="text-primary fw-bold mb-3 border-bottom pb-2">
                            <i class="bi bi-calendar-event me-2"></i>Thời gian áp dụng
                        </h6>
                        <div class="row g-3">
                            <!-- Ngày bắt đầu -->
                            <div class="col-md-6">
                                <label for="startDate" class="form-label fw-semibold text-dark">Ngày bắt đầu <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="startDate" required
                                       style="border-radius: 0.5rem; padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s;">
                            </div>
                            <!-- Ngày kết thúc -->
                            <div class="col-md-6">
                                <label for="endDate" class="form-label fw-semibold text-dark">Ngày kết thúc <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="endDate" required
                                       style="border-radius: 0.5rem; padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s;">
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <!-- Footer -->
            <div class="modal-footer border-0 px-4 pb-4 pt-2">
                <button type="button" class="btn btn-light px-4 border" data-bs-dismiss="modal"
                        style="border-radius: 0.5rem; font-weight: 500;">
                    Hủy
                </button>
                <button type="button" class="btn btn-primary px-4" id="btnSavePromotion"
                        style="border-radius: 0.5rem; font-weight: 500;">
                    <i class="bi bi-check-lg me-1"></i>Tạo khuyến mãi
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function removeVietnameseTones(str) {
            str = str.replace(/à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ/g, "a");
            str = str.replace(/è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ễ/g, "e");
            str = str.replace(/ì|í|ị|ỉ|ĩ/g, "i");
            str = str.replace(/ò|ó|ọ|ỏ|õ|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ/g, "o");
            str = str.replace(/ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ/g, "u");
            str = str.replace(/ỳ|ý|ỵ|ỷ|ỹ/g, "y");
            str = str.replace(/đ/g, "d");
            str = str.replace(/À|Á|Ạ|Ả|Ã|Â|Ầ|Ấ|Ậ|Ẩ|Ẫ|Ă|Ằ|Ắ|Ặ|Ẳ|Ẵ/g, "A");
            str = str.replace(/È|É|Ẹ|Ẻ|Ẽ|Ê|Ề|Ế|Ệ|Ể|Ễ/g, "E");
            str = str.replace(/Ì|Í|Ị|Ỉ|Ĩ/g, "I");
            str = str.replace(/Ò|Ó|Ọ|Ỏ|Õ|Ô|Ồ|Ố|Ộ|Ổ|Ỗ|Ơ|Ờ|Ớ|Ợ|Ở|Ỡ/g, "O");
            str = str.replace(/Ù|Ú|Ụ|Ủ|Ũ|Ư|Ừ|Ứ|Ự|Ử|Ữ/g, "U");
            str = str.replace(/Ỳ|Ý|Ỵ|Ỷ|Ỹ/g, "Y");
            str = str.replace(/Đ/g, "D");
            return str;
        }

        $(document).ready(function() {
            // Function to filter promotions
            function filterPromotions() {
                var searchObj = removeVietnameseTones($('#searchInput').val().toLowerCase().trim());
                var statusObj = $('#statusFilter').val();

                $('.promotion-item').each(function() {
                    var name = removeVietnameseTones($(this).data('name').toLowerCase());
                    var code = removeVietnameseTones($(this).data('code').toLowerCase());
                    var status = $(this).data('status');

                    var matchSearch = name.includes(searchObj) || code.includes(searchObj);
                    var matchStatus = (statusObj === 'all' || status === statusObj);

                    if (matchSearch && matchStatus) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            }

            $('#searchInput').on('input', filterPromotions);
            $('#statusFilter').on('change', filterPromotions);

            // Toggling of discount settings
            $('#discountType').on('change', function() {
                var type = $(this).val();
                if (type === 'percentage') {
                    $('#lblDiscountValue').html('Phần trăm giảm (%) <span class="text-danger">*</span>');
                    $('#discountValueSuffix').text('%');
                    $('#discountValue').attr('placeholder', 'VD: 20').attr('max', '100');
                    $('#maxDiscountContainer').show();
                    $('#maxDiscount').attr('required', true);
                } else {
                    $('#lblDiscountValue').html('Số tiền giảm (VNĐ) <span class="text-danger">*</span>');
                    $('#discountValueSuffix').text('VNĐ');
                    $('#discountValue').attr('placeholder', 'VD: 50000').removeAttr('max');
                    $('#maxDiscountContainer').hide();
                    $('#maxDiscount').removeAttr('required').val('');
                }
            });

            // Trigger discount type change on init
            $('#discountType').trigger('change');

            // Form focus styles
            $('#addPromotionForm .form-control, #addPromotionForm .form-select').on('focus', function () {
                $(this).css({
                    'border-color': '#3b82f6',
                    'box-shadow': '0 0 0 3px rgba(59, 130, 246, 0.15)'
                });
            }).on('blur', function () {
                $(this).css({
                    'border-color': '#e5e7eb',
                    'box-shadow': 'none'
                });
            });

            // Date helpers
            function formatDate(dateStr) {
                if (!dateStr) return '';
                var parts = dateStr.split('-');
                if (parts.length === 3) {
                    return parts[2] + '/' + parts[1] + '/' + parts[0];
                }
                return dateStr;
            }

            function getStatus(startDateStr, endDateStr) {
                var today = new Date();
                today.setHours(0,0,0,0);

                var start = new Date(startDateStr);
                start.setHours(0,0,0,0);

                var end = new Date(endDateStr);
                end.setHours(0,0,0,0);

                if (today < start) {
                    return "Sắp diễn ra";
                } else if (today >= start && today <= end) {
                    return "Đang áp dụng";
                } else {
                    return "Đã hết hạn";
                }
            }

            function getStatusHtml(status) {
                if (status === "Đang áp dụng") {
                    return '<span class="text-success small fw-bold"><i class="bi bi-check-circle me-1"></i> Đang áp dụng</span>';
                } else if (status === "Sắp diễn ra") {
                    return '<span class="text-primary small fw-bold"><i class="bi bi-clock me-1"></i> Sắp diễn ra</span>';
                } else {
                    return '<span class="text-danger small fw-bold"><i class="bi bi-x-circle me-1"></i> Đã hết hạn</span>';
                }
            }

            function updatePromotionStats() {
                var total = $('.promotion-item').length;
                var active = $('.promotion-item').filter(function() {
                    return $(this).attr('data-status') === 'Đang áp dụng';
                }).length;

                $('#totalPromotionsCount').text(total);
                $('#activePromotionsCount').text(active);
            }

            // Save promotion
            $('#btnSavePromotion').click(function () {
                var form = $('#addPromotionForm')[0];
                if (!form.checkValidity()) {
                    form.reportValidity();
                    return;
                }

                // Get field values
                var promoName = $('#promoName').val();
                var promoCode = $('#promoCode').val().toUpperCase();
                var promoDescription = $('#promoDescription').val();
                var discountType = $('#discountType').val();
                var discountValue = parseFloat($('#discountValue').val());
                var maxDiscount = $('#maxDiscount').val();
                var minOrderValue = $('#minOrderValue').val();
                var roomType = $('#roomType').val();
                var maxUses = parseInt($('#maxUses').val());
                var startDate = $('#startDate').val();
                var endDate = $('#endDate').val();

                // Logical checks
                if (discountType === 'percentage') {
                    if (discountValue <= 0 || discountValue > 100) {
                        Swal.fire({
                            title: 'Lỗi nhập liệu!',
                            text: 'Phần trăm giảm giá phải từ 1 đến 100.',
                            icon: 'warning',
                            confirmButtonColor: '#3b82f6'
                        });
                        return;
                    }
                } else {
                    if (discountValue <= 0) {
                        Swal.fire({
                            title: 'Lỗi nhập liệu!',
                            text: 'Số tiền giảm cố định phải lớn hơn 0.',
                            icon: 'warning',
                            confirmButtonColor: '#3b82f6'
                        });
                        return;
                    }
                }

                if (new Date(startDate) > new Date(endDate)) {
                    Swal.fire({
                        title: 'Lỗi ngày áp dụng!',
                        text: 'Ngày bắt đầu không được lớn hơn ngày kết thúc.',
                        icon: 'warning',
                        confirmButtonColor: '#3b82f6'
                    });
                    return;
                }

                // Format values for rendering
                var formattedValue = "";
                var discountDetailsHtml = "";
                if (discountType === 'percentage') {
                    formattedValue = discountValue + '%';
                    var maxValFormatted = parseInt(maxDiscount).toLocaleString('vi-VN') + ' đ';
                    discountDetailsHtml = `
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <div class="text-muted small mb-1">Mức giảm</div>
                                <div class="fw-bold fs-4 text-primary">${formattedValue}</div>
                            </div>
                            <div class="text-end">
                                <div class="text-muted small mb-1">Tối đa</div>
                                <div class="fw-bold fs-5 text-dark">${maxValFormatted}</div>
                            </div>
                        </div>
                    `;
                } else {
                    formattedValue = parseInt(discountValue).toLocaleString('vi-VN') + ' đ';
                    discountDetailsHtml = `
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <div class="text-muted small mb-1">Mức giảm</div>
                                <div class="fw-bold fs-4 text-primary">${formattedValue}</div>
                            </div>
                        </div>
                    `;
                }

                var formattedMinOrder = minOrderValue ? parseInt(minOrderValue).toLocaleString('vi-VN') + ' đ' : '0 đ';
                var dateRangeText = formatDate(startDate) + ' - ' + formatDate(endDate);
                var status = getStatus(startDate, endDate);
                var statusHtml = getStatusHtml(status);

                var newCardHtml = `
                    <div class="col-md-6 promotion-item" data-name="${promoName}" data-code="${promoCode}" data-status="${status}">
                        <div class="card-custom p-4 border h-100 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-primary bg-opacity-10 rounded d-flex align-items-center justify-content-center text-primary" style="width: 50px; height: 50px;">
                                        <i class="bi bi-tag fs-4"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold fs-5 text-dark mb-1">${promoName}</div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-light text-muted border px-2 py-1 fw-normal" style="font-size: 11px; text-transform: uppercase;">${promoCode}</span>
                                            ${statusHtml}
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <p class="text-dark small mb-4">${promoDescription || 'Không có mô tả'}</p>

                            <div class="bg-light rounded p-3 mb-4 mt-auto">
                                ${discountDetailsHtml}
                                <div class="text-muted" style="font-size: 11px;">Đơn tối thiểu: ${formattedMinOrder} | Loại phòng: ${roomType}</div>
                            </div>

                            <div class="d-flex align-items-center gap-2 mb-3 text-muted small">
                                <i class="bi bi-calendar3"></i> ${dateRangeText}
                            </div>

                            <div class="mb-2">
                                <div class="d-flex justify-content-between small text-dark fw-bold mb-2">
                                    <span>Lượt sử dụng</span>
                                    <span>0 / ${maxUses}</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-primary" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;

                // Add to list, update stats and filter
                $('#promotionList').prepend(newCardHtml);
                updatePromotionStats();
                filterPromotions();

                // Close Modal
                bootstrap.Modal.getInstance(document.getElementById('addPromotionModal')).hide();

                Swal.fire({
                    title: 'Thành công!',
                    text: 'Chương trình khuyến mãi mới đã được tạo.',
                    icon: 'success',
                    timer: 1500,
                    showConfirmButton: false
                });
            });

            // Cleanup form on modal hide
            $('#addPromotionModal').on('hidden.bs.modal', function () {
                $('#addPromotionForm')[0].reset();
                $('#discountType').trigger('change');
            });
        });
    </script>
}
