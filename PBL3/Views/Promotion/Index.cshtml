@model PBL3.Models.AdminPromotionManagementViewModel
@using System.Globalization

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý khuyến mãi";
    string Money(decimal value) => $"{value.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))} đ";
}

<style>
    .promo-page {
        color: #142033;
    }

    .promo-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        min-height: 44px;
        margin-bottom: 22px;
    }

    .promo-header h1 {
        margin: 0;
        color: #111827;
        font-size: 1.45rem;
        font-weight: 800;
        letter-spacing: 0;
        line-height: 1.2;
    }

    .promo-header p {
        margin: 8px 0 0;
        display: none;
        color: #66758a;
        font-weight: 560;
    }

    .promo-primary-btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 0;
        border-radius: 8px;
        background: #111827;
        color: #ffffff;
        font-weight: 750;
        padding: 9px 16px;
        box-shadow: none;
    }

    .promo-primary-btn:hover,
    .promo-primary-btn:focus-visible {
        background: #000000;
        color: #ffffff;
        outline: none;
    }

    .promo-alert {
        border-radius: 8px;
        font-weight: 650;
    }

    .promo-control-panel,
    .promo-stat-card,
    .promo-list-panel {
        border: 1px solid #dfe7f0;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.96);
        box-shadow: 0 16px 38px rgba(20, 32, 51, 0.08);
    }

    .promo-control-panel {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 220px;
        gap: 12px;
        margin-bottom: 18px;
        padding: 18px;
    }

    .promo-search-box,
    .promo-filter-select {
        min-height: 48px;
        border: 1px solid #dfe7f0;
        border-radius: 8px;
        background: #ffffff;
    }

    .promo-search-box {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 14px;
    }

    .promo-search-box i {
        color: #66758a;
    }

    .promo-search-box input {
        width: 100%;
        border: 0;
        outline: none;
        color: #142033;
        font-weight: 560;
    }

    .promo-filter-select {
        color: #142033;
        font-weight: 650;
        padding: 0 12px;
    }

    .promo-stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .promo-stat-card {
        padding: 16px;
    }

    .promo-stat-card span {
        color: #66758a;
        font-size: 0.84rem;
        font-weight: 700;
    }

    .promo-stat-card strong {
        display: block;
        margin-top: 5px;
        color: #111827;
        font-size: 1.55rem;
        font-weight: 880;
        line-height: 1;
    }

    .promo-list-panel {
        padding: 18px;
    }

    .promo-list-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
    }

    .promo-list-title h2 {
        margin: 0;
        font-size: 1.18rem;
        font-weight: 850;
    }

    .promo-count-pill {
        border-radius: 999px;
        background: #eaf2ff;
        color: #1f6feb;
        font-size: 0.82rem;
        font-weight: 820;
        padding: 7px 11px;
    }

    .promo-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .promo-card {
        display: grid;
        gap: 14px;
        border: 1px solid #dfe7f0;
        border-radius: 10px;
        background: #ffffff;
        padding: 18px;
        transition: border-color 0.16s ease, box-shadow 0.16s ease, transform 0.16s ease;
    }

    .promo-card:hover {
        border-color: rgba(31, 111, 235, 0.22);
        box-shadow: 0 12px 30px rgba(20, 32, 51, 0.08);
        transform: translateY(-1px);
    }

    .promo-card-top,
    .promo-card-actions {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
    }

    .promo-title-row {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        min-width: 0;
    }

    .promo-icon {
        width: 46px;
        height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #eaf2ff;
        color: #1f6feb;
        font-size: 1.18rem;
        flex: 0 0 auto;
    }

    .promo-name {
        margin: 0;
        color: #111827;
        font-size: 1.08rem;
        font-weight: 850;
    }

    .promo-code {
        display: inline-flex;
        margin-top: 6px;
        border-radius: 999px;
        background: #f1f5f9;
        color: #66758a;
        font-size: 0.78rem;
        font-weight: 820;
        padding: 5px 9px;
    }

    .promo-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 800;
        padding: 7px 10px;
        white-space: nowrap;
    }

    .promo-status.active {
        background: #e9f8f0;
        color: #168a55;
    }

    .promo-status.upcoming {
        background: #eaf2ff;
        color: #1f6feb;
    }

    .promo-status.expired,
    .promo-status.inactive {
        background: #fff1ef;
        color: #b42318;
    }

    .promo-desc {
        margin: 0;
        color: #66758a;
        font-size: 0.92rem;
        font-weight: 570;
    }

    .promo-discount-box {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        border-radius: 10px;
        background: #f8fbff;
        padding: 14px;
    }

    .promo-discount-box span {
        display: block;
        color: #66758a;
        font-size: 0.78rem;
        font-weight: 720;
    }

    .promo-discount-box strong {
        display: block;
        margin-top: 5px;
        color: #111827;
        font-size: 1rem;
        font-weight: 850;
    }

    .promo-main-discount strong {
        color: #1f6feb;
        font-size: 1.35rem;
    }

    .promo-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        color: #66758a;
        font-size: 0.86rem;
        font-weight: 650;
    }

    .promo-progress-row {
        display: grid;
        gap: 7px;
    }

    .promo-progress-label {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        color: #142033;
        font-size: 0.86rem;
        font-weight: 760;
    }

    .promo-progress {
        height: 7px;
        overflow: hidden;
        border-radius: 999px;
        background: #edf2f7;
    }

    .promo-progress > span {
        display: block;
        height: 100%;
        border-radius: inherit;
        background: #1f6feb;
    }

    .promo-delete-btn {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #dfe7f0;
        border-radius: 999px;
        background: #ffffff;
        color: #b42318;
    }

    .promo-empty-state {
        display: none;
        border: 1px dashed #cbd5e1;
        border-radius: 8px;
        background: #fbfdff;
        color: #66758a;
        padding: 38px 16px;
        text-align: center;
        font-weight: 720;
    }

    .promo-empty-state.is-visible {
        display: block;
    }

    .promo-modal .modal-content {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 26px 70px rgba(15, 23, 42, 0.24);
    }

    .promo-modal-header {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        border-bottom: 1px solid #dfe7f0;
        padding: 22px 24px 18px;
    }

    .promo-modal-header h3 {
        margin: 0;
        color: #111827;
        font-size: 1.28rem;
        font-weight: 850;
    }

    .promo-modal-header p {
        margin: 5px 0 0;
        color: #66758a;
        font-weight: 620;
    }

    .promo-modal-body {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        padding: 22px 24px;
    }

    .promo-form-group {
        display: grid;
        gap: 7px;
    }

    .promo-form-group.full {
        grid-column: 1 / -1;
    }

    .promo-form-group label {
        color: #66758a;
        font-size: 0.84rem;
        font-weight: 760;
    }

    .promo-form-group input,
    .promo-form-group select,
    .promo-form-group textarea {
        width: 100%;
        border: 1px solid #dbe3ef;
        border-radius: 8px;
        background: #ffffff;
        color: #111827;
        font-weight: 620;
        padding: 11px 12px;
        outline: none;
    }

    .promo-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        border-top: 1px solid #dfe7f0;
        padding: 16px 24px 22px;
    }

    @@media (max-width: 1000px) {
        .promo-header,
        .promo-list-title {
            align-items: flex-start;
            flex-direction: column;
        }

        .promo-control-panel,
        .promo-stat-grid,
        .promo-grid,
        .promo-modal-body {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="promo-page">
    <header class="promo-header">
        <div>
            <h1>Quản lý khuyến mãi</h1>
        </div>
        <button type="button" class="promo-primary-btn" data-bs-toggle="modal" data-bs-target="#addPromotionModal">
            <i class="bi bi-plus-lg"></i>
            Tạo khuyến mãi
        </button>
    </header>

    @if (TempData["PromotionSuccess"] is string successMessage)
    {
        <div class="alert alert-success promo-alert">@successMessage</div>
    }
    @if (TempData["PromotionError"] is string errorMessage)
    {
        <div class="alert alert-danger promo-alert">@errorMessage</div>
    }

    <section class="promo-control-panel" aria-label="Bộ lọc khuyến mãi">
        <label class="promo-search-box" for="promotionSearchInput">
            <i class="bi bi-search"></i>
            <input type="search" id="promotionSearchInput" placeholder="Tìm theo tên chương trình, mã khuyến mãi..." autocomplete="off" />
        </label>
        <select id="promotionStatusFilter" class="promo-filter-select">
            <option value="all">Tất cả trạng thái</option>
            <option value="active">Đang áp dụng</option>
            <option value="upcoming">Sắp diễn ra</option>
            <option value="expired">Đã hết hạn</option>
            <option value="inactive">Ngừng áp dụng</option>
        </select>
    </section>

    <section class="promo-stat-grid" aria-label="Thống kê khuyến mãi">
        <div class="promo-stat-card">
            <span>Tổng chương trình</span>
            <strong>@Model.TotalCount</strong>
        </div>
        <div class="promo-stat-card">
            <span>Đang áp dụng</span>
            <strong>@Model.ActiveCount</strong>
        </div>
        <div class="promo-stat-card">
            <span>Lượt sử dụng</span>
            <strong>@Model.TotalUsage</strong>
        </div>
        <div class="promo-stat-card">
            <span>Tổng giảm giá</span>
            <strong>@Money(Model.TotalDiscountAmount)</strong>
        </div>
    </section>

    <section class="promo-list-panel">
        <div class="promo-list-title">
            <h2>Danh sách khuyến mãi</h2>
            <span class="promo-count-pill" id="promotionVisibleCount">0 khuyến mãi</span>
        </div>

        <div class="promo-grid" id="promotionList">
            @foreach (var promotion in Model.Promotions)
            {
                <article class="promo-card"
                         data-promotion-card
                         data-search="@($"{promotion.Name} {promotion.Code} {promotion.Description}")"
                         data-status="@promotion.StatusKey">
                    <div class="promo-card-top">
                        <div class="promo-title-row">
                            <span class="promo-icon"><i class="bi bi-tag"></i></span>
                            <div>
                                <h3 class="promo-name">@promotion.Name</h3>
                                <span class="promo-code">@promotion.Code</span>
                            </div>
                        </div>
                        <span class="promo-status @promotion.StatusClass">
                            <i class="bi @promotion.StatusIcon"></i>
                            @promotion.StatusLabel
                        </span>
                    </div>

                    <p class="promo-desc">@promotion.Description</p>

                    <div class="promo-discount-box">
                        <div class="promo-main-discount">
                            <span>Mức giảm</span>
                            <strong>@promotion.DiscountLabel</strong>
                        </div>
                        <div>
                            <span>Tối đa</span>
                            <strong>@promotion.MaxDiscountLabel</strong>
                        </div>
                        <div>
                            <span>Đơn tối thiểu</span>
                            <strong>@promotion.MinimumInvoiceLabel</strong>
                        </div>
                    </div>

                    <div class="promo-meta">
                        <span><i class="bi bi-calendar3"></i> @promotion.DateRangeLabel</span>
                        <span><i class="bi bi-bullseye"></i> @promotion.ScopeLabel</span>
                    </div>

                    <div class="promo-progress-row">
                        <div class="promo-progress-label">
                            <span>Lượt sử dụng</span>
                            <span>@promotion.UsedCount / @promotion.IssuedCount</span>
                        </div>
                        <div class="promo-progress" aria-label="Lượt sử dụng @promotion.UsagePercent%">
                            <span style="width: @promotion.UsagePercent.ToString("0.#", CultureInfo.InvariantCulture)%"></span>
                        </div>
                    </div>

                    <div class="promo-card-actions">
                        <span class="promo-meta">@promotion.PromotionId</span>
                        <form asp-controller="Promotion" asp-action="Delete" method="post" data-delete-promotion-form>
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@promotion.PromotionId" />
                            <button type="submit" class="promo-delete-btn" aria-label="Xóa @promotion.Name">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </article>
            }
        </div>

        <div class="promo-empty-state" id="promotionEmptyState">
            <i class="bi bi-search d-block fs-2 mb-2"></i>
            Không tìm thấy khuyến mãi phù hợp.
        </div>
    </section>
</div>

<div class="modal fade promo-modal" id="addPromotionModal" tabindex="-1" aria-labelledby="addPromotionModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form class="modal-content" asp-controller="Promotion" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="promo-modal-header">
                <div>
                    <h3 id="addPromotionModalTitle">Tạo khuyến mãi</h3>
                    <p>Khuyến mãi mới sẽ được lưu trực tiếp vào cơ sở dữ liệu.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="promo-modal-body">
                <div class="promo-form-group">
                    <label for="promotionName">Tên chương trình</label>
                    <input id="promotionName" name="TenMaGiamGia" type="text" required />
                </div>
                <div class="promo-form-group">
                    <label for="promotionCode">Mã khuyến mãi</label>
                    <input id="promotionCode" name="CodeGiamGia" type="text" required placeholder="VD: SUMMER2026" />
                </div>
                <div class="promo-form-group">
                    <label for="promotionType">Loại giảm giá</label>
                    <select id="promotionType" name="LoaiGiamGia">
                        <option value="PHANTRAM">Giảm theo phần trăm</option>
                        <option value="TIENMAT">Giảm theo số tiền</option>
                    </select>
                </div>
                <div class="promo-form-group">
                    <label for="promotionValue">Giá trị giảm</label>
                    <input id="promotionValue" name="GiaTriGiam" type="number" min="1" step="1" required />
                </div>
                <div class="promo-form-group">
                    <label for="promotionMax">Giảm tối đa</label>
                    <input id="promotionMax" name="GiamToiDa" type="number" min="0" step="1000" />
                </div>
                <div class="promo-form-group">
                    <label for="promotionMin">Đơn tối thiểu</label>
                    <input id="promotionMin" name="HoaDonToiThieu" type="number" min="0" step="1000" value="0" />
                </div>
                <div class="promo-form-group">
                    <label for="promotionScope">Phạm vi áp dụng</label>
                    <select id="promotionScope" name="PhamViApDung">
                        <option value="TAT_CA">Tất cả</option>
                        <option value="CHI_PHONG">Chỉ phòng</option>
                        <option value="CHI_DICHVU">Chỉ dịch vụ</option>
                    </select>
                </div>
                <div class="promo-form-group">
                    <label for="promotionLimit">Số lượt phát hành</label>
                    <input id="promotionLimit" name="SoLuongPhatHanh" type="number" min="1" value="100" required />
                </div>
                <div class="promo-form-group">
                    <label for="promotionStart">Ngày bắt đầu</label>
                    <input id="promotionStart" name="TuNgay" type="date" required />
                </div>
                <div class="promo-form-group">
                    <label for="promotionEnd">Ngày kết thúc</label>
                    <input id="promotionEnd" name="DenNgay" type="date" required />
                </div>
                <div class="promo-form-group">
                    <label for="promotionStatus">Trạng thái</label>
                    <select id="promotionStatus" name="TrangThai">
                        <option value="Hoạt động">Hoạt động</option>
                        <option value="Ngừng áp dụng">Ngừng áp dụng</option>
                    </select>
                </div>
                <div class="promo-form-group full">
                    <label for="promotionDescription">Mô tả</label>
                    <textarea id="promotionDescription" name="MoTa" rows="3"></textarea>
                </div>
            </div>
            <div class="promo-modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="promo-primary-btn">Lưu khuyến mãi</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const searchInput = document.getElementById("promotionSearchInput");
            const statusFilter = document.getElementById("promotionStatusFilter");
            const cards = Array.from(document.querySelectorAll("[data-promotion-card]"));
            const emptyState = document.getElementById("promotionEmptyState");
            const visibleCount = document.getElementById("promotionVisibleCount");

            function normalizeText(value) {
                return (value || "")
                    .toLowerCase()
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .replace(/đ/g, "d");
            }

            function filterPromotions() {
                const keyword = normalizeText(searchInput?.value);
                const status = statusFilter?.value || "all";
                let shown = 0;

                cards.forEach(function (card) {
                    const matchesSearch = !keyword || normalizeText(card.dataset.search).includes(keyword);
                    const matchesStatus = status === "all" || card.dataset.status === status;
                    const visible = matchesSearch && matchesStatus;
                    card.hidden = !visible;
                    if (visible) shown += 1;
                });

                if (visibleCount) {
                    visibleCount.textContent = `${shown} khuyến mãi`;
                }
                emptyState?.classList.toggle("is-visible", shown === 0);
            }

            document.querySelectorAll("[data-delete-promotion-form]").forEach(function (form) {
                form.addEventListener("submit", function (event) {
                    const card = form.closest("[data-promotion-card]");
                    const name = card?.querySelector(".promo-name")?.textContent || "khuyến mãi này";
                    if (!confirm(`Xóa ${name}?`)) {
                        event.preventDefault();
                    }
                });
            });

            searchInput?.addEventListener("input", filterPromotions);
            statusFilter?.addEventListener("change", filterPromotions);
            filterPromotions();
        })();
    </script>
}
