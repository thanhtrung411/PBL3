@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý khách hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1 fw-bold">Quản lý khách hàng</h3>
        <p class="text-muted mb-0">Theo dõi thông tin và lịch sử khách hàng</p>
    </div>
    <button class="btn btn-dark px-4"><i class="bi bi-person-plus"></i> Thêm khách hàng</button>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card-custom text-center py-4">
            <div class="text-muted small mb-2">Tổng khách hàng</div>
            <div class="fw-bold display-6">50</div>
            <div class="small text-muted mt-2">Khách hàng</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom text-center py-4">
            <div class="text-muted small mb-2">VIP Platinum</div>
            <div class="fw-bold display-6 text-primary">10</div>
            <div class="small text-muted mt-2">Khách hàng</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom text-center py-4">
            <div class="text-muted small mb-2">VIP Gold</div>
            <div class="fw-bold display-6 text-warning">25</div>
            <div class="small text-muted mt-2">Khách hàng</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom text-center py-4">
            <div class="text-muted small mb-2">Khách mới</div>
            <div class="fw-bold display-6 text-success">15</div>
            <div class="small text-muted mt-2">Khách hàng</div>
        </div>
    </div>
</div>

<div class="d-flex w-100 gap-2 mb-4">
    <div class="input-group flex-grow-1">
        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control bg-white border-start-0 py-2" placeholder="Tìm kiếm theo tên, email, số điện thoại,...">
    </div>
    <button class="btn btn-primary px-4"><i class="bi bi-download"></i> Xuất file</button>
</div>

<!-- Table -->
