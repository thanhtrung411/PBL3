<!-- Edit Customer Modal -->
<div class="modal fade" id="customerEditModal" tabindex="-1" aria-labelledby="customerEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 px-4 pt-4 pb-2">
                <h5 class="modal-title fw-bold" id="customerEditModalLabel">
                    <i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh sửa thông tin khách hàng
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <form id="editCustomerForm">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Họ và tên</label>
                            <input type="text" class="form-control" id="editCustomerName" required disabled style="border-radius: 8px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Giới tính</label>
                            <select class="form-select" id="editCustomerGender" required disabled style="border-radius: 8px;">
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">CMND/CCCD/Hộ chiếu</label>
                            <input type="text" class="form-control" id="editCustomerIdCard" required disabled style="border-radius: 8px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Số điện thoại</label>
                            <input type="tel" class="form-control" id="editCustomerPhone" required disabled style="border-radius: 8px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Email</label>
                            <input type="email" class="form-control" id="editCustomerEmail" required disabled style="border-radius: 8px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Địa chỉ thường trú</label>
                            <input type="text" class="form-control" id="editCustomerAddress" required disabled style="border-radius: 8px;">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 px-4 pb-4 pt-2">
                <button type="button" class="btn btn-light px-4 border" data-bs-dismiss="modal" style="border-radius: 8px;">Đóng</button>
                <button type="button" class="btn btn-primary px-4" id="btnUnlockEdit" style="border-radius: 8px;">Chỉnh sửa</button>
                <button type="button" class="btn btn-dark px-4" id="btnSaveCustomer" style="border-radius: 8px;" disabled>Lưu</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function removeVietnameseTones(str) {
        str = str.replace(/à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ/g, "a");
        str = str.replace(/è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ễ/g, "e");
        str = str.replace(/ì|í|ị|ỉ|ĩ/g, "i");
        str = str.replace(/ò|ó|ọ|ỏ|õ|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ/g, "o");
        str = str.replace(/ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ/g, "u");
        str = str.replace(/ỳ|ý|ỵ|ỷ|ỹ/g, "y");
        str = str.replace(/đ/g, "d");
        str = str.replace(/À|Á|Ạ|Ả|Ã|Â|Ầ|Ấ|Ậ|Ẩ|Ẫ|Ă|Ằ|Ắ|Ặ|Ẳ|Ẵ/g, "A");
        str = str.replace(/È|É|Ẹ|Ẻ|Ẽ|Ê|Ề|Ế|Ệ|Ể|Ễ/g, "E");
        str = str.replace(/Ì|Í|Ị|Ỉ|Ĩ/g, "I");
        str = str.replace(/Ò|Ó|Ọ|Ỏ|Õ|Ô|Ồ|Ố|Ộ|Ổ|Ỗ|Ơ|Ờ|Ớ|Ợ|Ở|Ỡ/g, "O");
        str = str.replace(/Ù|Ú|Ụ|Ủ|Ũ|Ư|Ừ|Ứ|Ự|Ử|Ữ/g, "U");
        str = str.replace(/Ỳ|Ý|Ỵ|Ỷ|Ỹ/g, "Y");
        str = str.replace(/Đ/g, "D");
        return str;
        }

        $(document).ready(function() {
        var activeRow = null;

        function filterCustomers() {
        var searchObj = removeVietnameseTones($('#searchInput').val().toLowerCase().trim());
        var tierObj = $('#tierFilter').val();

        $('.customer-item').each(function() {
        var name = removeVietnameseTones($(this).data('name').toLowerCase());
        var email = removeVietnameseTones($(this).data('email').toLowerCase());
        var phone = removeVietnameseTones($(this).data('phone').toLowerCase());
        var tier = $(this).data('tier');

        var matchSearch = name.includes(searchObj) || email.includes(searchObj) || phone.includes(searchObj);
        var matchTier = (tierObj === 'all' || tier === tierObj);

        if (matchSearch && matchTier) {
        $(this).show();
        } else {
        $(this).hide();
        }
        });
        }

        $('#searchInput').on('input', filterCustomers);
        $('#tierFilter').on('change', filterCustomers);

        // Open Edit Modal
        $(document).on('click', '.btn-edit-customer', function(e) {
        e.preventDefault();
        activeRow = $(this).closest('.customer-item');

        $('#editCustomerName').val(activeRow.data('name'));
        $('#editCustomerGender').val(activeRow.data('gender') || 'Nam');
        $('#editCustomerIdCard').val(activeRow.data('idcard') || '');
        $('#editCustomerPhone').val(activeRow.data('phone'));
        $('#editCustomerEmail').val(activeRow.data('email'));
        $('#editCustomerAddress').val(activeRow.data('address'));

        // Reset disabled states
        $('#editCustomerForm input, #editCustomerForm select').prop('disabled', true);
        $('#btnSaveCustomer').prop('disabled', true);
        $('#btnUnlockEdit').prop('disabled', false).show();

        var editModal = new bootstrap.Modal(document.getElementById('customerEditModal'));
        editModal.show();
        });

        // Unlock editing inside Modal
        $('#btnUnlockEdit').click(function() {
        $('#editCustomerForm input, #editCustomerForm select').prop('disabled', false);
        $('#btnSaveCustomer').prop('disabled', false);
        $(this).prop('disabled', true);
        });

        // Save customer details
        $('#btnSaveCustomer').click(function() {
        var form = $('#editCustomerForm')[0];
        if (!form.checkValidity()) {
        form.reportValidity();
        return;
        }

        var name = $('#editCustomerName').val();
        var gender = $('#editCustomerGender').val();
        var idcard = $('#editCustomerIdCard').val();
        var phone = $('#editCustomerPhone').val();
        var email = $('#editCustomerEmail').val();
        var address = $('#editCustomerAddress').val();

        // Update data attributes on active row
        activeRow.data('name', name);
        activeRow.data('gender', gender);
        activeRow.data('idcard', idcard);
        activeRow.data('phone', phone);
        activeRow.data('email', email);
        activeRow.data('address', address);

        // Update visible row values
        activeRow.find('td:nth-child(1) .fw-bold').text(name);
        activeRow.find('td:nth-child(2) div:nth-child(1)').html('<i class="bi bi-envelope me-2"></i>' + email);
        activeRow.find('td:nth-child(2) div:nth-child(2)').html('<i class="bi bi-telephone me-2"></i>' + phone);
        activeRow.find('td:nth-child(3) span').html('<i class="bi bi-geo-alt me-1"></i> ' + address);

        // Hide modal
        bootstrap.Modal.getInstance(document.getElementById('customerEditModal')).hide();

        // Update statistics
        updateStats();

        Swal.fire({
        title: 'Đã cập nhật!',
        text: 'Thông tin khách hàng đã được lưu thành công.',
        icon: 'success',
        timer: 1500,
        showConfirmButton: false
        });
        });

        // Delete customer row
        $(document).on('click', '.btn-delete-customer', function(e) {
        e.preventDefault();
        var row = $(this).closest('.customer-item');
        var name = row.data('name');

        Swal.fire({
        title: 'Xác nhận xóa?',
        text: `Bạn có chắc chắn muốn xóa khách hàng "${name}" không?`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#212529',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Xác nhận',
        cancelButtonText: 'Hủy'
        }).then((result) => {
        if (result.isConfirmed) {
        row.remove();
        updateStats();

        Swal.fire({
        title: 'Đã xóa!',
        text: 'Khách hàng đã được xóa khỏi danh sách.',
        icon: 'success',
        timer: 1500,
        showConfirmButton: false
        });
        }
        });
        });

        // Helper function to update page stats card
        function updateStats() {
        var total = $('.customer-item').length;
        var regular = $('.customer-item[data-tier="Thường"]').length;
        var silver = $('.customer-item[data-tier="Bạc"]').length;
        var gold = $('.customer-item[data-tier="Vàng"]').length;
        var platinum = $('.customer-item[data-tier="Bạch Kim"]').length;

        $('#totalCustomersCount').text(total);
        $('#tierRegularCount').text(regular);
        $('#tierSilverCount').text(silver);
        $('#tierGoldCount').text(gold);
        $('#tierPlatinumCount').text(platinum);
        }
        });
    </script>
}
