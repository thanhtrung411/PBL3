@model PBL3.Models.AdminCustomerManagementViewModel
@using System.Globalization
@using System.Text.Json

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý khách hàng";
    var bookingHistoryJson = JsonSerializer.Serialize(Model.Customers.ToDictionary(x => x.CustomerId, x => x.BookingHistory));
}

<style>
    .customer-detail-dialog {
        max-width: 1040px;
    }

    .customer-detail-content {
        border-radius: 14px;
        color: #1f2937;
    }

    .customer-detail-content .modal-header,
    .customer-detail-content .modal-body,
    .customer-detail-content .modal-footer {
        padding-left: 22px;
        padding-right: 22px;
    }

    .customer-detail-title {
        font-size: 1.15rem;
        letter-spacing: 0;
    }

    .customer-detail-subtitle,
    .customer-detail-label,
    .booking-history-table {
        font-size: 0.82rem;
    }

    .customer-detail-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: #f8fafc;
        padding: 14px;
        margin-bottom: 14px;
    }

    .customer-detail-avatar {
        width: 46px;
        height: 46px;
        flex: 0 0 46px;
    }

    .customer-detail-name {
        font-size: 1.2rem;
        line-height: 1.15;
    }

    .customer-detail-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
    }

    .customer-detail-card {
        min-height: 70px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #ffffff;
        padding: 10px 12px;
    }

    .customer-detail-label {
        color: #6b7280;
        margin-bottom: 4px;
    }

    .customer-detail-value {
        font-size: 0.92rem;
        font-weight: 700;
        color: #111827;
        word-break: break-word;
    }

    .customer-detail-metric {
        min-width: 130px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #ffffff;
        padding: 10px 12px;
    }

    .customer-detail-metric .metric-value {
        font-size: 1.1rem;
        font-weight: 800;
    }

    .booking-history-panel {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
        margin-top: 14px;
    }

    .booking-history-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        background: #f8fafc;
        padding: 12px 14px;
        border-bottom: 1px solid #e5e7eb;
    }

    .booking-history-search {
        max-width: 360px;
    }

    .booking-history-table th,
    .booking-history-table td {
        padding: 10px 12px;
        vertical-align: middle;
        white-space: nowrap;
    }

    .booking-history-empty {
        padding: 18px;
        color: #6b7280;
        text-align: center;
        font-size: 0.9rem;
    }

    @@media (max-width: 992px) {
        .customer-detail-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 576px) {
        .customer-detail-grid {
            grid-template-columns: 1fr;
        }

        .customer-detail-hero,
        .booking-history-header {
            align-items: stretch;
            flex-direction: column;
        }

        .booking-history-search {
            max-width: none;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex gap-2 flex-grow-1 me-3">
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" id="searchInput" class="form-control bg-white border-start-0" placeholder="Tìm kiếm khách hàng...">
        </div>
        <select id="tierFilter" class="form-select bg-white" style="min-width: 160px; max-width: 200px;">
            <option value="all">Tất cả hạng</option>
            <option value="Thường">Thường</option>
            <option value="Bạc">Bạc</option>
            <option value="Vàng">Vàng</option>
            <option value="Bạch Kim">Bạch Kim</option>
        </select>
        <select id="sortSelect" class="form-select bg-white" style="min-width: 190px; max-width: 240px;">
            <option value="name-asc">Tên A-Z</option>
            <option value="name-desc">Tên Z-A</option>
            <option value="spend-desc">Chi tiêu cao nhất</option>
            <option value="spend-asc">Chi tiêu thấp nhất</option>
            <option value="bookings-desc">Đặt nhiều nhất</option>
            <option value="bookings-asc">Đặt ít nhất</option>
            <option value="last-desc">Đặt gần nhất</option>
            <option value="tier-desc">Hạng cao nhất</option>
        </select>
    </div>
</div>

@if (TempData["CustomerSuccess"] is string successMessage)
{
    <div class="alert alert-success border-0 fw-semibold">@successMessage</div>
}

@if (TempData["CustomerError"] is string errorMessage)
{
    <div class="alert alert-danger border-0 fw-semibold">@errorMessage</div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-lg">
        <div class="card-custom p-3 border">
            <div id="totalCustomersCount" class="fw-bold fs-3 text-dark">@Model.TotalCount</div>
            <div class="text-muted small">Tổng khách hàng</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <div class="card-custom p-3 border">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-star text-muted"></i>
                <div id="tierRegularCount" class="fw-bold fs-3 text-dark">@Model.RegularCount</div>
            </div>
            <div class="text-muted small">Thường</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <div class="card-custom p-3 border">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-star text-secondary"></i>
                <div id="tierSilverCount" class="fw-bold fs-3 text-dark">@Model.SilverCount</div>
            </div>
            <div class="text-muted small">Bạc</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <div class="card-custom p-3 border">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-star text-warning"></i>
                <div id="tierGoldCount" class="fw-bold fs-3 text-dark">@Model.GoldCount</div>
            </div>
            <div class="text-muted small">Vàng</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <div class="card-custom p-3 border">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-star" style="color: #a855f7;"></i>
                <div id="tierPlatinumCount" class="fw-bold fs-3 text-dark">@Model.PlatinumCount</div>
            </div>
            <div class="text-muted small">Bạch Kim</div>
        </div>
    </div>
</div>

<div class="card-custom p-0 overflow-hidden border">
    <div class="table-responsive p-3">
        <table class="table-custom mb-0 w-100 align-middle">
            <thead class="bg-light">
                <tr>
                    <th>Khách hàng</th>
                    <th>Liên hệ</th>
                    <th>Địa chỉ</th>
                    <th class="text-center">Số lần đặt</th>
                    <th class="text-end">Tổng chi tiêu</th>
                    <th class="text-center">Đặt gần nhất</th>
                    <th class="text-center">Hạng thành viên</th>
                    <th class="text-center" style="width: 170px;">Thao tác</th>
                </tr>
            </thead>
            <tbody id="customerList">
                @if (Model.Customers.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">Chưa có dữ liệu khách hàng.</td>
                    </tr>
                }
                else
                {
                    @foreach (var customer in Model.Customers)
                    {
                        <tr class="customer-item"
                            style="cursor: pointer;"
                            data-id="@customer.CustomerId"
                            data-name="@customer.CustomerName"
                            data-email="@customer.Email"
                            data-phone="@customer.Phone"
                            data-tier="@customer.MemberTier"
                            data-tier-rank="@customer.MemberTierRank"
                            data-gender="@customer.Gender"
                            data-idcard="@customer.IdentityNumber"
                            data-address="@customer.Address"
                            data-nationality="@customer.Nationality"
                            data-birthdate="@customer.BirthDateLabel"
                            data-bookings="@customer.BookingCount"
                            data-spend="@customer.TotalSpend.ToString(CultureInfo.InvariantCulture)"
                            data-spend-label="@customer.TotalSpendLabel"
                            data-last-booking="@customer.LastBookingSortValue"
                            data-last-booking-label="@customer.LastBookingLabel">
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center text-primary fw-bold" style="width: 40px; height: 40px;">
                                        @customer.Initials
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@customer.CustomerName</div>
                                        <small class="text-muted">ID: @customer.CustomerId</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="text-muted small"><i class="bi bi-envelope me-2"></i>@(string.IsNullOrWhiteSpace(customer.Email) ? "Chưa có email" : customer.Email)</div>
                                <div class="text-muted small mt-1"><i class="bi bi-telephone me-2"></i>@(string.IsNullOrWhiteSpace(customer.Phone) ? "Chưa có SĐT" : customer.Phone)</div>
                            </td>
                            <td>
                                <span class="text-muted small"><i class="bi bi-geo-alt me-1"></i> @(string.IsNullOrWhiteSpace(customer.Address) ? "Chưa có địa chỉ" : customer.Address)</span>
                            </td>
                            <td class="text-center fw-bold text-dark">@customer.BookingCount</td>
                            <td class="text-end fw-bold text-dark">@customer.TotalSpendLabel</td>
                            <td class="text-center text-muted small">@customer.LastBookingLabel</td>
                            <td class="text-center">
                                <span class="badge @customer.MemberTierClass px-2 py-1 rounded-pill" style="font-size: 11px; @customer.MemberTierStyle">
                                    <i class="bi bi-star-fill me-1"></i> @customer.MemberTier
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <button class="btn btn-icon-only border btn-view-customer" title="Chi tiết"><i class="bi bi-eye text-primary"></i></button>
                                    <button class="btn btn-icon-only border btn-edit-customer" title="Chỉnh sửa"><i class="bi bi-pencil-square text-muted"></i></button>
                                    <form asp-action="Delete" method="post" class="delete-customer-form d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@customer.CustomerId">
                                        <button type="submit" class="btn btn-icon-only border text-danger btn-delete-customer" title="Xóa"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="customerDetailModal" tabindex="-1" aria-labelledby="customerDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl customer-detail-dialog">
        <div class="modal-content border-0 shadow-lg customer-detail-content">
            <div class="modal-header border-0 pb-2">
                <div>
                    <h5 class="modal-title fw-bold customer-detail-title" id="customerDetailModalLabel">
                        <i class="bi bi-person-vcard text-primary me-2"></i>Chi tiết khách hàng
                    </h5>
                    <div class="text-muted customer-detail-subtitle mt-1" id="detailCustomerCode"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2">
                <div class="customer-detail-hero">
                    <div class="d-flex align-items-center gap-3">
                        <div id="detailCustomerAvatar" class="customer-detail-avatar bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center text-primary fw-bold"></div>
                        <div>
                            <div id="detailCustomerName" class="customer-detail-name fw-bold mb-1"></div>
                            <div id="detailCustomerTier"></div>
                        </div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <div class="customer-detail-metric">
                            <div class="customer-detail-label">Số lần đặt</div>
                            <div id="detailCustomerBookings" class="metric-value text-dark"></div>
                        </div>
                        <div class="customer-detail-metric">
                            <div class="customer-detail-label">Tổng chi tiêu</div>
                            <div id="detailCustomerSpend" class="metric-value text-dark"></div>
                        </div>
                        <div class="customer-detail-metric">
                            <div class="customer-detail-label">Đặt gần nhất</div>
                            <div id="detailCustomerLastBooking" class="metric-value text-dark"></div>
                        </div>
                    </div>
                </div>

                <div class="customer-detail-grid">
                    <div class="customer-detail-card">
                        <div class="customer-detail-label">Email</div>
                        <div class="customer-detail-value" id="detailCustomerEmail"></div>
                    </div>
                    <div class="customer-detail-card">
                        <div class="customer-detail-label">Số điện thoại</div>
                        <div class="customer-detail-value" id="detailCustomerPhone"></div>
                    </div>
                    <div class="customer-detail-card">
                        <div class="customer-detail-label">Giới tính</div>
                        <div class="customer-detail-value" id="detailCustomerGender"></div>
                    </div>
                    <div class="customer-detail-card">
                        <div class="customer-detail-label">Ngày sinh</div>
                        <div class="customer-detail-value" id="detailCustomerBirthDate"></div>
                    </div>
                    <div class="customer-detail-card">
                        <div class="customer-detail-label">CMND/CCCD/Hộ chiếu</div>
                        <div class="customer-detail-value" id="detailCustomerIdCard"></div>
                    </div>
                    <div class="customer-detail-card">
                        <div class="customer-detail-label">Quốc tịch</div>
                        <div class="customer-detail-value" id="detailCustomerNationality"></div>
                    </div>
                    <div class="customer-detail-card" style="grid-column: span 2;">
                        <div class="customer-detail-label">Địa chỉ</div>
                        <div class="customer-detail-value" id="detailCustomerAddress"></div>
                    </div>
                </div>

                <div class="booking-history-panel">
                    <div class="booking-history-header">
                        <div>
                            <div class="fw-bold text-dark">Lịch sử đặt phòng</div>
                            <div class="text-muted small">Tìm theo mã đặt, mã phòng, ngày đặt hoặc ngày trả.</div>
                        </div>
                        <div class="input-group booking-history-search">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                            <input type="text" id="detailBookingSearch" class="form-control bg-white border-start-0" placeholder="Tìm giao dịch...">
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table mb-0 booking-history-table">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã đặt</th>
                                    <th>Ngày đặt</th>
                                    <th>Ngày nhận</th>
                                    <th>Ngày trả</th>
                                    <th>Mã phòng</th>
                                    <th class="text-end">Tổng tiền</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody id="detailBookingHistoryList"></tbody>
                        </table>
                    </div>
                    <div id="detailBookingHistoryEmpty" class="booking-history-empty d-none">Không có giao dịch phù hợp.</div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-2">
                <button type="button" class="btn btn-light px-4 border" data-bs-dismiss="modal" style="border-radius: 8px;">Đóng</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="customerEditModal" tabindex="-1" aria-labelledby="customerEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 px-4 pt-4 pb-2">
                <h5 class="modal-title fw-bold" id="customerEditModalLabel">
                    <i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh sửa thông tin khách hàng
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Edit" method="post" id="editCustomerForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="MaKh" id="editCustomerId">
                <div class="modal-body px-4 py-3">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Họ và tên</label>
                            <input type="text" class="form-control customer-edit-field" name="HoTen" id="editCustomerName" required disabled style="border-radius: 8px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Giới tính</label>
                            <select class="form-select customer-edit-field" name="GioiTinh" id="editCustomerGender" disabled style="border-radius: 8px;">
                                <option value="">Chưa chọn</option>
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">CMND/CCCD/Hộ chiếu</label>
                            <input type="text" class="form-control customer-edit-field" name="Cccd" id="editCustomerIdCard" disabled style="border-radius: 8px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Số điện thoại</label>
                            <input type="tel" class="form-control customer-edit-field" name="SoDienThoai" id="editCustomerPhone" disabled style="border-radius: 8px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Email</label>
                            <input type="email" class="form-control customer-edit-field" name="Email" id="editCustomerEmail" disabled style="border-radius: 8px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Quốc tịch</label>
                            <input type="text" class="form-control customer-edit-field" name="QuocTich" id="editCustomerNationality" disabled style="border-radius: 8px;">
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Địa chỉ thường trú</label>
                            <input type="text" class="form-control customer-edit-field" name="DiaChi" id="editCustomerAddress" disabled style="border-radius: 8px;">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4 pt-2">
                    <button type="button" class="btn btn-light px-4 border" data-bs-dismiss="modal" style="border-radius: 8px;">Đóng</button>
                    <button type="button" class="btn btn-primary px-4" id="btnUnlockEdit" style="border-radius: 8px;">Chỉnh sửa</button>
                    <button type="submit" class="btn btn-dark px-4" id="btnSaveCustomer" style="border-radius: 8px;" disabled>Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const customerBookingHistory = @Html.Raw(bookingHistoryJson);

        function removeVietnameseTones(str) {
            str = str.replace(/à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ/g, "a");
            str = str.replace(/è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ễ/g, "e");
            str = str.replace(/ì|í|ị|ỉ|ĩ/g, "i");
            str = str.replace(/ò|ó|ọ|ỏ|õ|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ/g, "o");
            str = str.replace(/ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ/g, "u");
            str = str.replace(/ỳ|ý|ỵ|ỷ|ỹ/g, "y");
            str = str.replace(/đ/g, "d");
            str = str.replace(/À|Á|Ạ|Ả|Ã|Â|Ầ|Ấ|Ậ|Ẩ|Ẫ|Ă|Ằ|Ắ|Ặ|Ẳ|Ẵ/g, "A");
            str = str.replace(/È|É|Ẹ|Ẻ|Ẽ|Ê|Ề|Ế|Ệ|Ể|Ễ/g, "E");
            str = str.replace(/Ì|Í|Ị|Ỉ|Ĩ/g, "I");
            str = str.replace(/Ò|Ó|Ọ|Ỏ|Õ|Ô|Ồ|Ố|Ộ|Ổ|Ỗ|Ơ|Ờ|Ớ|Ợ|Ở|Ỡ/g, "O");
            str = str.replace(/Ù|Ú|Ụ|Ủ|Ũ|Ư|Ừ|Ứ|Ự|Ử|Ữ/g, "U");
            str = str.replace(/Ỳ|Ý|Ỵ|Ỷ|Ỹ/g, "Y");
            str = str.replace(/Đ/g, "D");
            return str;
        }

        $(document).ready(function () {
            var activeBookingHistory = [];

            function applyCustomerControls() {
                var searchObj = removeVietnameseTones($('#searchInput').val().toLowerCase().trim());
                var tierObj = $('#tierFilter').val();
                var sortObj = $('#sortSelect').val();
                var rows = $('.customer-item').get();

                rows.sort(function (left, right) {
                    var a = $(left);
                    var b = $(right);

                    switch (sortObj) {
                        case 'name-desc':
                            return compareText(b.data('name'), a.data('name'));
                        case 'spend-desc':
                            return compareNumber(b.data('spend'), a.data('spend'));
                        case 'spend-asc':
                            return compareNumber(a.data('spend'), b.data('spend'));
                        case 'bookings-desc':
                            return compareNumber(b.data('bookings'), a.data('bookings'));
                        case 'bookings-asc':
                            return compareNumber(a.data('bookings'), b.data('bookings'));
                        case 'last-desc':
                            return compareNumber(b.data('last-booking'), a.data('last-booking'));
                        case 'tier-desc':
                            return compareNumber(b.data('tier-rank'), a.data('tier-rank')) || compareText(a.data('name'), b.data('name'));
                        default:
                            return compareText(a.data('name'), b.data('name'));
                    }
                });

                $('#customerList').append(rows);

                $('.customer-item').each(function () {
                    var name = removeVietnameseTones(String($(this).data('name') || '').toLowerCase());
                    var email = removeVietnameseTones(String($(this).data('email') || '').toLowerCase());
                    var phone = removeVietnameseTones(String($(this).data('phone') || '').toLowerCase());
                    var tier = $(this).data('tier');

                    var matchSearch = name.includes(searchObj) || email.includes(searchObj) || phone.includes(searchObj);
                    var matchTier = (tierObj === 'all' || tier === tierObj);

                    $(this).toggle(matchSearch && matchTier);
                });
            }

            function compareText(left, right) {
                return String(left || '').localeCompare(String(right || ''), 'vi', { sensitivity: 'base' });
            }

            function compareNumber(left, right) {
                return Number(left || 0) - Number(right || 0);
            }

            function fallback(value, label) {
                return value ? value : label;
            }

            function escapeHtml(value) {
                return String(value || '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            function renderBookingHistory() {
                var keyword = removeVietnameseTones($('#detailBookingSearch').val().toLowerCase().trim());
                var rows = activeBookingHistory.filter(function (item) {
                    var searchText = removeVietnameseTones(String(item.SearchText || '').toLowerCase());
                    return !keyword || searchText.includes(keyword);
                });

                var html = rows.map(function (item) {
                    return '<tr>' +
                        '<td class="fw-bold text-dark">' + escapeHtml(item.BookingCode) + '</td>' +
                        '<td>' + escapeHtml(item.BookingDateLabel) + '</td>' +
                        '<td>' + escapeHtml(item.CheckInLabel) + '</td>' +
                        '<td>' + escapeHtml(item.CheckOutLabel) + '</td>' +
                        '<td>' + escapeHtml(item.RoomCodes) + '</td>' +
                        '<td class="text-end fw-semibold">' + escapeHtml(item.TotalLabel) + '</td>' +
                        '<td><span class="badge bg-light text-dark border rounded-pill">' + escapeHtml(item.StatusLabel) + '</span></td>' +
                        '</tr>';
                }).join('');

                $('#detailBookingHistoryList').html(html);
                $('#detailBookingHistoryEmpty').toggleClass('d-none', rows.length > 0);
            }

            $('#searchInput').on('input', applyCustomerControls);
            $('#tierFilter').on('change', applyCustomerControls);
            $('#sortSelect').on('change', applyCustomerControls);
            $('#detailBookingSearch').on('input', renderBookingHistory);

            $(document).on('click', '.btn-view-customer', function (e) {
                e.preventDefault();
                var row = $(this).closest('.customer-item');
                var tierText = row.data('tier') || '';
                var tierClass = row.find('td:nth-child(7) .badge').attr('class') || 'badge bg-light text-muted border px-2 py-1 rounded-pill';
                var tierStyle = row.find('td:nth-child(7) .badge').attr('style') || '';
                var initials = row.find('td:nth-child(1) .rounded-circle').text().trim();

                $('#detailCustomerAvatar').text(initials);
                $('#detailCustomerCode').text('Mã khách hàng: ' + row.data('id'));
                $('#detailCustomerName').text(row.data('name'));
                $('#detailCustomerTier').html('<span class="' + tierClass + '" style="' + tierStyle + '">' + tierText + '</span>');
                $('#detailCustomerEmail').text(fallback(row.data('email'), 'Chưa có email'));
                $('#detailCustomerPhone').text(fallback(row.data('phone'), 'Chưa có số điện thoại'));
                $('#detailCustomerGender').text(fallback(row.data('gender'), 'Chưa có'));
                $('#detailCustomerBirthDate').text(fallback(row.data('birthdate'), 'Chưa có'));
                $('#detailCustomerIdCard').text(fallback(row.data('idcard'), 'Chưa có'));
                $('#detailCustomerNationality').text(fallback(row.data('nationality'), 'Chưa có'));
                $('#detailCustomerAddress').text(fallback(row.data('address'), 'Chưa có địa chỉ'));
                $('#detailCustomerBookings').text(row.data('bookings') || 0);
                $('#detailCustomerSpend').text(row.data('spend-label') || '0 đ');
                $('#detailCustomerLastBooking').text(row.data('last-booking-label') || 'Chưa đặt');
                $('#detailBookingSearch').val('');
                activeBookingHistory = customerBookingHistory[String(row.data('id'))] || [];
                renderBookingHistory();

                new bootstrap.Modal(document.getElementById('customerDetailModal')).show();
            });

            $(document).on('click', '.customer-item', function (e) {
                if ($(e.target).closest('button, form, input, select, a').length) {
                    return;
                }

                $(this).find('.btn-view-customer').trigger('click');
            });

            $(document).on('click', '.btn-edit-customer', function (e) {
                e.preventDefault();
                var row = $(this).closest('.customer-item');

                $('#editCustomerId').val(row.data('id'));
                $('#editCustomerName').val(row.data('name'));
                $('#editCustomerGender').val(row.data('gender') || '');
                $('#editCustomerIdCard').val(row.data('idcard') || '');
                $('#editCustomerPhone').val(row.data('phone') || '');
                $('#editCustomerEmail').val(row.data('email') || '');
                $('#editCustomerAddress').val(row.data('address') || '');
                $('#editCustomerNationality').val(row.data('nationality') || '');

                $('.customer-edit-field').prop('disabled', true);
                $('#btnSaveCustomer').prop('disabled', true);
                $('#btnUnlockEdit').prop('disabled', false).show();

                new bootstrap.Modal(document.getElementById('customerEditModal')).show();
            });

            $('#btnUnlockEdit').click(function () {
                $('.customer-edit-field').prop('disabled', false);
                $('#btnSaveCustomer').prop('disabled', false);
                $(this).prop('disabled', true);
            });

            $('.delete-customer-form').on('submit', function (e) {
                e.preventDefault();
                var form = this;
                var row = $(form).closest('.customer-item');
                var name = row.data('name');

                Swal.fire({
                    title: 'Xác nhận xóa?',
                    text: `Bạn có chắc chắn muốn xóa khách hàng "${name}" không?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#212529',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Xác nhận',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    </script>
}
