@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý dịch vụ";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="input-group flex-grow-1 me-3">
        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
        <input type="text" id="searchInput" class="form-control bg-white border-start-0"
               placeholder="Tìm kiếm dịch vụ...">
    </div>
    <button class="btn btn-primary px-4" data-bs-toggle="modal" data-bs-target="#addServiceModal"><i class="bi bi-plus"></i> Thêm dịch vụ mới</button>
</div>

<div class="d-flex gap-2 mb-4">
    <button class="btn btn-primary text-white rounded-pill px-4 category-btn" data-category="all">Tất cả</button>
    <button class="btn btn-outline-secondary bg-white text-dark border rounded-pill px-4 category-btn"
            data-category="Ăn uống">
        Ăn uống
    </button>
    <button class="btn btn-outline-secondary bg-white text-dark border rounded-pill px-4 category-btn"
            data-category="Giải trí">
        Giải trí
    </button>
    <button class="btn btn-outline-secondary bg-white text-dark border rounded-pill px-4 category-btn"
            data-category="Tiện ích">
        Tiện ích
    </button>
    <button class="btn btn-outline-secondary bg-white text-dark border rounded-pill px-4 category-btn"
            data-category="Vận chuyển">
        Vận chuyển
    </button>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card-custom p-3 border h-100 d-flex flex-column justify-content-center">
            <div id="totalServicesCount" class="fw-bold fs-3 text-dark">7</div>
            <div class="text-muted small">Tổng dịch vụ</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom p-3 border h-100 d-flex flex-column justify-content-center">
            <div id="activeServicesCount" class="fw-bold fs-3 text-success">7</div>
            <div class="text-muted small">Đang hoạt động</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom p-3 border h-100 d-flex flex-column justify-content-center">
            <div class="fw-bold fs-3 text-dark">256</div>
            <div class="text-muted small">Lượt sử dụng tháng</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom p-3 border h-100 d-flex flex-column justify-content-center">
            <div class="fw-bold fs-3 text-dark">8.5 triệu</div>
            <div class="text-muted small">Doanh thu tháng</div>
        </div>
    </div>
</div>

<!-- Cards -->
<div class="row g-4" id="serviceList">
    <!-- Card 1 -->
    <div class="col-md-4 service-item" data-name="Spa & Massage" data-category="Giải trí" data-unit="60 phút" data-price="500000" data-status="active" data-description="Dịch vụ spa và massage thư giãn cao cấp">
        <div class="card-custom p-4 border h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="bg-primary bg-opacity-10 rounded d-flex align-items-center justify-content-center text-primary"
                     style="width: 40px; height: 40px;">
                    <i class="bi bi-water"></i>
                </div>
                <span class="badge bg-light text-muted border rounded-pill px-2 py-1 fw-normal"
                      style="font-size: 11px;">Giải trí</span>
            </div>
            <div class="fw-bold fs-5 text-dark mb-1">Spa & Massage</div>
            <div class="text-muted small mb-3">Dịch vụ spa và massage thư giãn cao cấp</div>
            <div class="fw-bold fs-4 text-dark mb-3">
                500.000 đ <span class="text-muted fs-6 fw-normal">/ 60 phút</span>
            </div>
            <div class="mb-4 d-flex align-items-center gap-2">
                <i class="bi bi-circle-fill text-success" style="font-size: 8px;"></i>
                <span class="text-muted small">Đang hoạt động</span>
            </div>
            <div class="d-flex gap-2 justify-content-end">
                <button class="btn btn-icon-only border btn-edit-service" title="Chỉnh sửa"><i class="bi bi-pencil-square text-muted"></i></button>
                <button class="btn btn-icon-only border text-danger btn-delete-service" title="Xóa"><i class="bi bi-trash"></i></button>
            </div>
        </div>
    </div>
    <!-- Card 2 -->
    <div class="col-md-4 service-item" data-name="Nhà hàng" data-category="Ăn uống" data-unit="người" data-price="200000" data-status="active" data-description="Thực đơn đa dạng các món Á - Âu">
