@model PBL3.Models.AdminServiceManagementViewModel
@using System.Globalization

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý dịch vụ";
    var monthlyRevenueLabel = $"{Model.MonthlyRevenue.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))} đ";
}

<style>
    .service-page {
        color: #142033;
    }

    .service-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 22px;
    }

    .service-header h1 {
        margin: 0;
        color: #111827;
        font-size: clamp(1.85rem, 3vw, 2.6rem);
        font-weight: 850;
        letter-spacing: 0;
        line-height: 1.08;
    }

    .service-header p {
        margin: 8px 0 0;
        color: #66758a;
        font-weight: 560;
    }

    .service-primary-btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 0;
        border-radius: 8px;
        background: #1f6feb;
        color: #ffffff;
        font-weight: 820;
        padding: 10px 16px;
        box-shadow: 0 14px 30px rgba(31, 111, 235, 0.18);
    }

    .service-primary-btn:hover,
    .service-primary-btn:focus-visible {
        background: #1659c7;
        color: #ffffff;
        outline: none;
    }

    .service-alert {
        border-radius: 8px;
        font-weight: 650;
    }

    .service-control-panel,
    .service-list-panel,
    .service-stat-card {
        border: 1px solid #dfe7f0;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.96);
        box-shadow: 0 16px 38px rgba(20, 32, 51, 0.08);
    }

    .service-control-panel {
        display: grid;
        gap: 16px;
        margin-bottom: 18px;
        padding: 18px;
    }

    .service-search-box {
        min-height: 48px;
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px solid #dfe7f0;
        border-radius: 8px;
        background: #ffffff;
        padding: 0 14px;
    }

    .service-search-box i {
        color: #66758a;
    }

    .service-search-box input {
        width: 100%;
        border: 0;
        outline: none;
        color: #142033;
        font-weight: 560;
    }

    .service-category-row {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
    }

    .service-category-btn {
        min-height: 38px;
        border: 1px solid #dfe7f0;
        border-radius: 999px;
        background: #ffffff;
        color: #66758a;
        font-weight: 760;
        padding: 7px 13px;
    }

    .service-category-btn.active {
        border-color: rgba(31, 111, 235, 0.26);
        background: #eaf2ff;
        color: #1f6feb;
    }

    .service-stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .service-stat-card {
        padding: 16px;
    }

    .service-stat-card span {
        color: #66758a;
        font-size: 0.84rem;
        font-weight: 700;
    }

    .service-stat-card strong {
        display: block;
        margin-top: 5px;
        color: #111827;
        font-size: 1.55rem;
        font-weight: 880;
        line-height: 1;
    }

    .service-list-panel {
        padding: 18px;
    }

    .service-list-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
    }

    .service-list-title h2 {
        margin: 0;
        font-size: 1.18rem;
        font-weight: 850;
    }

    .service-count-pill {
        border-radius: 999px;
        background: #eaf2ff;
        color: #1f6feb;
        font-size: 0.82rem;
        font-weight: 820;
        padding: 7px 11px;
        white-space: nowrap;
    }

    .service-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }

    .service-card {
        display: grid;
        gap: 14px;
        min-height: 248px;
        border: 1px solid #dfe7f0;
        border-radius: 10px;
        background: #ffffff;
        padding: 16px;
        cursor: pointer;
        transition: border-color 0.16s ease, box-shadow 0.16s ease, transform 0.16s ease;
    }

    .service-card:hover,
    .service-card:focus-visible {
        border-color: rgba(31, 111, 235, 0.22);
        box-shadow: 0 12px 30px rgba(20, 32, 51, 0.08);
        transform: translateY(-1px);
        outline: none;
    }

    .service-card::after {
        content: "Xem chi tiết";
        justify-self: start;
        width: fit-content;
        border-radius: 999px;
        background: #f8fbff;
        color: #1f6feb;
        font-size: 0.78rem;
        font-weight: 800;
        padding: 5px 9px;
    }

    .service-card-top,
    .service-card-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .service-icon {
        width: 42px;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #eaf2ff;
        color: #1f6feb;
        font-size: 1.12rem;
    }

    .service-category-pill {
        border-radius: 999px;
        background: #f1f5f9;
        color: #66758a;
        font-size: 0.78rem;
        font-weight: 780;
        padding: 6px 10px;
    }

    .service-name {
        margin: 0;
        color: #111827;
        font-size: 1.08rem;
        font-weight: 850;
    }

    .service-desc {
        min-height: 40px;
        margin: 6px 0 0;
        color: #66758a;
        font-size: 0.9rem;
        font-weight: 570;
    }

    .service-price {
        color: #111827;
        font-size: 1.25rem;
        font-weight: 880;
    }

    .service-price.free {
        color: #168a55;
    }

    .service-price span {
        color: #66758a;
        font-size: 0.88rem;
        font-weight: 620;
    }

    .service-meta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .service-status,
    .service-usage-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 760;
        padding: 6px 9px;
    }

    .service-status.active {
        background: #e9f8f0;
        color: #168a55;
    }

    .service-status.inactive {
        background: #fff1ef;
        color: #b42318;
    }

    .service-usage-chip {
        background: #f1f6fb;
        color: #66758a;
    }

    .service-icon-btn {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #dfe7f0;
        border-radius: 999px;
        background: #ffffff;
        color: #66758a;
    }

    .service-icon-btn:hover,
    .service-icon-btn:focus-visible {
        border-color: rgba(31, 111, 235, 0.25);
        background: #eaf2ff;
        color: #1f6feb;
        outline: none;
    }

    .service-delete-btn:hover,
    .service-delete-btn:focus-visible {
        border-color: #fecaca;
        background: #fff1ef;
        color: #b42318;
    }

    .service-empty-state {
        display: none;
        border: 1px dashed #cbd5e1;
        border-radius: 8px;
        background: #fbfdff;
        color: #66758a;
        padding: 38px 16px;
        text-align: center;
        font-weight: 720;
    }

    .service-empty-state.is-visible {
        display: block;
    }

    .service-modal .modal-content {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 26px 70px rgba(15, 23, 42, 0.24);
    }

    .service-modal-header {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        border-bottom: 1px solid #dfe7f0;
        padding: 22px 24px 18px;
    }

    .service-modal-header h3 {
        margin: 0;
        color: #111827;
        font-size: 1.28rem;
        font-weight: 850;
    }

    .service-modal-header p {
        margin: 5px 0 0;
        color: #66758a;
        font-weight: 620;
    }

    .service-modal-body {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        padding: 22px 24px;
    }

    .service-form-group {
        display: grid;
        gap: 7px;
    }

    .service-form-group.full {
        grid-column: 1 / -1;
    }

    .service-form-group label {
        color: #66758a;
        font-size: 0.84rem;
        font-weight: 760;
    }

    .service-form-group input,
    .service-form-group select,
    .service-form-group textarea {
        width: 100%;
        border: 1px solid #dbe3ef;
        border-radius: 8px;
        background: #ffffff;
        color: #111827;
        font-weight: 620;
        padding: 11px 12px;
        outline: none;
    }

    .service-form-group textarea {
        resize: vertical;
    }

    .service-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        border-top: 1px solid #dfe7f0;
        padding: 16px 24px 22px;
    }

    .service-detail-hero {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 20px 24px;
    }

    .service-detail-icon {
        width: 54px;
        height: 54px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        border-radius: 12px;
        background: #eaf2ff;
        color: #1f6feb;
        font-size: 1.35rem;
    }

    .service-detail-hero h3 {
        margin: 0;
        color: #111827;
        font-size: 1.35rem;
        font-weight: 880;
    }

    .service-detail-hero p {
        margin: 5px 0 0;
        color: #66758a;
        font-weight: 650;
    }

    .service-detail-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        padding: 0 24px 22px;
    }

    .service-detail-box {
        border: 1px solid #dfe7f0;
        border-radius: 10px;
        background: #fbfdff;
        padding: 14px;
    }

    .service-detail-box.full {
        grid-column: 1 / -1;
    }

    .service-detail-box span {
        display: block;
        color: #66758a;
        font-size: 0.8rem;
        font-weight: 780;
    }

    .service-detail-box strong,
    .service-detail-box p {
        display: block;
        margin: 6px 0 0;
        color: #111827;
        font-size: 1rem;
        font-weight: 820;
    }

    .service-detail-box p {
        line-height: 1.45;
        font-weight: 650;
    }

    @@media (max-width: 1200px) {
        .service-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 900px) {
        .service-header,
        .service-list-title {
            align-items: flex-start;
            flex-direction: column;
        }

        .service-stat-grid,
        .service-grid,
        .service-modal-body,
        .service-detail-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="service-page">
    <header class="service-header">
        <div>
            <h1>Quản lý dịch vụ</h1>
            <p>Theo dõi dịch vụ, đơn giá, trạng thái và lượt sử dụng trong tháng.</p>
        </div>
        <button type="button" class="service-primary-btn" data-bs-toggle="modal" data-bs-target="#addServiceModal">
            <i class="bi bi-plus-lg"></i>
            Thêm dịch vụ
        </button>
    </header>

    @if (TempData["ServiceSuccess"] is string successMessage)
    {
        <div class="alert alert-success service-alert">@successMessage</div>
    }
    @if (TempData["ServiceError"] is string errorMessage)
    {
        <div class="alert alert-danger service-alert">@errorMessage</div>
    }

    <section class="service-control-panel" aria-label="Bộ lọc dịch vụ">
        <label class="service-search-box" for="serviceSearchInput">
            <i class="bi bi-search"></i>
            <input type="search" id="serviceSearchInput" placeholder="Tìm theo tên dịch vụ, mã dịch vụ, loại dịch vụ..." autocomplete="off" />
        </label>

        <div class="service-category-row">
            <button type="button" class="service-category-btn active" data-category="all">Tất cả</button>
            @foreach (var category in Model.Categories)
            {
                <button type="button" class="service-category-btn" data-category="@category">@category</button>
            }
        </div>
    </section>

    <section class="service-stat-grid" aria-label="Thống kê dịch vụ">
        <div class="service-stat-card">
            <span>Tổng dịch vụ</span>
            <strong>@Model.TotalCount</strong>
        </div>
        <div class="service-stat-card">
            <span>Đang hoạt động</span>
            <strong>@Model.ActiveCount</strong>
        </div>
        <div class="service-stat-card">
            <span>Lượt sử dụng tháng</span>
            <strong>@Model.MonthlyUsageCount</strong>
        </div>
        <div class="service-stat-card">
            <span>Doanh thu tháng</span>
            <strong>@monthlyRevenueLabel</strong>
        </div>
    </section>

    <section class="service-list-panel">
        <div class="service-list-title">
            <h2>Danh sách dịch vụ</h2>
            <span class="service-count-pill" id="serviceVisibleCount">0 dịch vụ</span>
        </div>

        <div class="service-grid" id="serviceList">
            @foreach (var service in Model.Services)
            {
                <article class="service-card"
                         data-service-card
                         role="button"
                         tabindex="0"
                         data-id="@service.ServiceId"
                         data-name="@service.ServiceName"
                         data-category="@service.Category"
                         data-unit="@service.Unit"
                         data-price="@service.Price.ToString("0.##", CultureInfo.InvariantCulture)"
                         data-price-label="@service.PriceLabel"
                         data-status="@service.Status"
                         data-description="@service.Description"
                         data-icon="@service.IconClass"
                         data-monthly-usage="@service.MonthlyUsageCount"
                         data-monthly-revenue="@service.MonthlyRevenueLabel">
                    <div class="service-card-top">
                        <span class="service-icon"><i class="bi @service.IconClass"></i></span>
                        <span class="service-category-pill">@service.Category</span>
                    </div>

                    <div>
                        <h3 class="service-name">@service.ServiceName</h3>
                        <p class="service-desc">@service.Description</p>
                    </div>

                    <div class="service-price @(service.Price <= 0 ? "free" : "")">
                        @service.PriceLabel
                        @if (service.Price > 0)
                        {
                            <span>/ @service.Unit</span>
                        }
                    </div>

                    <div class="service-meta-row">
                        <span class="service-status @(service.IsActive ? "active" : "inactive")">
                            <i class="bi bi-circle-fill"></i>
                            @service.Status
                        </span>
                        <span class="service-usage-chip">@service.MonthlyUsageCount lượt · @service.MonthlyRevenueLabel</span>
                    </div>

                    <div class="service-card-actions">
                        <span class="service-code">@service.ServiceId</span>
                        <div class="d-flex gap-2">
                            <button type="button" class="service-icon-btn" data-edit-service aria-label="Sửa @service.ServiceName">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <form asp-controller="Service" asp-action="Delete" method="post" data-delete-service-form>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@service.ServiceId" />
                                <button type="submit" class="service-icon-btn service-delete-btn" aria-label="Xóa @service.ServiceName">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </article>
            }
        </div>

        <div class="service-empty-state" id="serviceEmptyState">
            <i class="bi bi-search d-block fs-2 mb-2"></i>
            Không tìm thấy dịch vụ phù hợp.
        </div>
    </section>
</div>

<div class="modal fade service-modal" id="addServiceModal" tabindex="-1" aria-labelledby="addServiceModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form class="modal-content" asp-controller="Service" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="service-modal-header">
                <div>
                    <h3 id="addServiceModalTitle">Thêm dịch vụ</h3>
                    <p>Dịch vụ mới sẽ được lưu trực tiếp vào cơ sở dữ liệu.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="service-modal-body">
                <div class="service-form-group">
                    <label for="addServiceName">Tên dịch vụ</label>
                    <input id="addServiceName" name="TenDv" type="text" required />
                </div>
                <div class="service-form-group">
                    <label for="addServiceCategory">Loại dịch vụ</label>
                    <select id="addServiceCategory" name="LoaiDichVu">
                        <option value="Ăn uống">Ăn uống</option>
                        <option value="Giải trí">Giải trí</option>
                        <option value="Tiện ích">Tiện ích</option>
                        <option value="Vận chuyển">Vận chuyển</option>
                    </select>
                </div>
                <div class="service-form-group">
                    <label for="addServiceUnit">Đơn vị tính</label>
                    <input id="addServiceUnit" name="DonViTinh" type="text" required placeholder="Ví dụ: cái, kg, lượt" />
                </div>
                <div class="service-form-group">
                    <label for="addServicePrice">Đơn giá</label>
                    <input id="addServicePrice" name="DonGia" type="number" min="0" step="1000" value="0" required />
                </div>
                <div class="service-form-group">
                    <label for="addServiceStatus">Trạng thái</label>
                    <select id="addServiceStatus" name="TrangThai">
                        <option value="Hoạt động">Hoạt động</option>
                        <option value="Ngừng hoạt động">Ngừng hoạt động</option>
                    </select>
                </div>
                <div class="service-form-group full">
                    <label for="addServiceDescription">Mô tả</label>
                    <textarea id="addServiceDescription" name="GhiChu" rows="3"></textarea>
                </div>
            </div>
            <div class="service-modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="service-primary-btn">Lưu dịch vụ</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade service-modal" id="editServiceModal" tabindex="-1" aria-labelledby="editServiceModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form class="modal-content" asp-controller="Service" asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="editServiceId" name="MaDv" />
            <div class="service-modal-header">
                <div>
                    <h3 id="editServiceModalTitle">Cập nhật dịch vụ</h3>
                    <p>Thay đổi sẽ được lưu vào bảng dịch vụ.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="service-modal-body">
                <div class="service-form-group">
                    <label for="editServiceName">Tên dịch vụ</label>
                    <input id="editServiceName" name="TenDv" type="text" required />
                </div>
                <div class="service-form-group">
                    <label for="editServiceCategory">Loại dịch vụ</label>
                    <select id="editServiceCategory" name="LoaiDichVu">
                        <option value="Ăn uống">Ăn uống</option>
                        <option value="Giải trí">Giải trí</option>
                        <option value="Tiện ích">Tiện ích</option>
                        <option value="Vận chuyển">Vận chuyển</option>
                    </select>
                </div>
                <div class="service-form-group">
                    <label for="editServiceUnit">Đơn vị tính</label>
                    <input id="editServiceUnit" name="DonViTinh" type="text" required />
                </div>
                <div class="service-form-group">
                    <label for="editServicePrice">Đơn giá</label>
                    <input id="editServicePrice" name="DonGia" type="number" min="0" step="1000" required />
                </div>
                <div class="service-form-group">
                    <label for="editServiceStatus">Trạng thái</label>
                    <select id="editServiceStatus" name="TrangThai">
                        <option value="Hoạt động">Hoạt động</option>
                        <option value="Ngừng hoạt động">Ngừng hoạt động</option>
                    </select>
                </div>
                <div class="service-form-group full">
                    <label for="editServiceDescription">Mô tả</label>
                    <textarea id="editServiceDescription" name="GhiChu" rows="3"></textarea>
                </div>
            </div>
            <div class="service-modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="service-primary-btn">Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade service-modal" id="serviceDetailModal" tabindex="-1" aria-labelledby="serviceDetailTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="service-modal-header">
                <div>
                    <h3 id="serviceDetailTitle">Chi tiết dịch vụ</h3>
                    <p id="serviceDetailSubtitle">Thông tin dịch vụ đang chọn.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="service-detail-hero">
                <span class="service-detail-icon"><i id="serviceDetailIcon" class="bi bi-gear"></i></span>
                <div>
                    <h3 id="serviceDetailName">Dịch vụ</h3>
                    <p id="serviceDetailCode">Mã dịch vụ</p>
                </div>
            </div>
            <div class="service-detail-grid">
                <div class="service-detail-box">
                    <span>Loại dịch vụ</span>
                    <strong id="serviceDetailCategory">-</strong>
                </div>
                <div class="service-detail-box">
                    <span>Trạng thái</span>
                    <strong id="serviceDetailStatus">-</strong>
                </div>
                <div class="service-detail-box">
                    <span>Đơn giá</span>
                    <strong id="serviceDetailPrice">-</strong>
                </div>
                <div class="service-detail-box">
                    <span>Đơn vị tính</span>
                    <strong id="serviceDetailUnit">-</strong>
                </div>
                <div class="service-detail-box">
                    <span>Lượt dùng tháng này</span>
                    <strong id="serviceDetailUsage">0 lượt</strong>
                </div>
                <div class="service-detail-box">
                    <span>Doanh thu tháng này</span>
                    <strong id="serviceDetailRevenue">0 đ</strong>
                </div>
                <div class="service-detail-box full">
                    <span>Mô tả</span>
                    <p id="serviceDetailDescription">Chưa có mô tả.</p>
                </div>
            </div>
            <div class="service-modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const searchInput = document.getElementById("serviceSearchInput");
            const categoryButtons = Array.from(document.querySelectorAll(".service-category-btn[data-category]"));
            const serviceCards = Array.from(document.querySelectorAll("[data-service-card]"));
            const emptyState = document.getElementById("serviceEmptyState");
            const visibleCount = document.getElementById("serviceVisibleCount");
            const editModalElement = document.getElementById("editServiceModal");
            const detailModalElement = document.getElementById("serviceDetailModal");

            function normalizeText(value) {
                return (value || "")
                    .toLowerCase()
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .replace(/đ/g, "d");
            }

            function filterServices() {
                const keyword = normalizeText(searchInput?.value);
                const activeCategory = document.querySelector(".service-category-btn[data-category].active")?.dataset.category || "all";
                let shown = 0;

                serviceCards.forEach(function (card) {
                    const haystack = normalizeText([
                        card.dataset.id,
                        card.dataset.name,
                        card.dataset.category,
                        card.dataset.description
                    ].join(" "));
                    const matchesSearch = !keyword || haystack.includes(keyword);
                    const matchesCategory = activeCategory === "all" || card.dataset.category === activeCategory;
                    const visible = matchesSearch && matchesCategory;
                    card.hidden = !visible;
                    if (visible) shown += 1;
                });

                if (visibleCount) {
                    visibleCount.textContent = `${shown} dịch vụ`;
                }
                emptyState?.classList.toggle("is-visible", shown === 0);
            }

            categoryButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    categoryButtons.forEach(item => item.classList.remove("active"));
                    button.classList.add("active");
                    filterServices();
                });
            });

            searchInput?.addEventListener("input", filterServices);

            function fillServiceDetail(card) {
                document.getElementById("serviceDetailTitle").textContent = card.dataset.name || "Chi tiết dịch vụ";
                document.getElementById("serviceDetailSubtitle").textContent = card.dataset.category || "Thông tin dịch vụ";
                document.getElementById("serviceDetailName").textContent = card.dataset.name || "Dịch vụ";
                document.getElementById("serviceDetailCode").textContent = card.dataset.id || "";
                document.getElementById("serviceDetailCategory").textContent = card.dataset.category || "-";
                document.getElementById("serviceDetailStatus").textContent = card.dataset.status || "-";
                document.getElementById("serviceDetailPrice").textContent = card.dataset.priceLabel || "0 đ";
                document.getElementById("serviceDetailUnit").textContent = card.dataset.unit || "-";
                document.getElementById("serviceDetailUsage").textContent = `${card.dataset.monthlyUsage || "0"} lượt`;
                document.getElementById("serviceDetailRevenue").textContent = card.dataset.monthlyRevenue || "0 đ";
                document.getElementById("serviceDetailDescription").textContent = card.dataset.description || "Chưa có mô tả.";

                const icon = document.getElementById("serviceDetailIcon");
                icon.className = `bi ${card.dataset.icon || "bi-gear"}`;
            }

            function openServiceDetail(card) {
                if (!card || !detailModalElement) return;
                fillServiceDetail(card);
                new bootstrap.Modal(detailModalElement).show();
            }

            document.addEventListener("click", function (event) {
                const editButton = event.target.closest("[data-edit-service]");
                if (!editButton) return;

                const card = editButton.closest("[data-service-card]");
                if (!card) return;

                document.getElementById("editServiceId").value = card.dataset.id || "";
                document.getElementById("editServiceName").value = card.dataset.name || "";
                document.getElementById("editServiceCategory").value = card.dataset.category || "";
                document.getElementById("editServiceUnit").value = card.dataset.unit || "";
                document.getElementById("editServicePrice").value = card.dataset.price || "0";
                document.getElementById("editServiceStatus").value = card.dataset.status || "Hoạt động";
                document.getElementById("editServiceDescription").value = card.dataset.description || "";

                new bootstrap.Modal(editModalElement).show();
            });

            serviceCards.forEach(function (card) {
                card.addEventListener("click", function (event) {
                    if (event.target.closest("[data-edit-service], [data-delete-service-form], button, a, input, select, textarea")) {
                        return;
                    }

                    openServiceDetail(card);
                });

                card.addEventListener("keydown", function (event) {
                    if (event.key !== "Enter" && event.key !== " ") return;
                    if (event.target.closest("button, a, input, select, textarea")) return;
                    event.preventDefault();
                    openServiceDetail(card);
                });
            });

            document.querySelectorAll("[data-delete-service-form]").forEach(function (form) {
                form.addEventListener("submit", function (event) {
                    const card = form.closest("[data-service-card]");
                    const serviceName = card?.dataset.name || "dịch vụ này";
                    if (!confirm(`Xóa ${serviceName}?`)) {
                        event.preventDefault();
                    }
                });
            });

            filterServices();
        })();
    </script>
}
