            </div>
            <!-- Body -->
            <div class="modal-body px-4 py-3">
                <form id="editServiceForm">
                    <div class="row g-3">
                        <!-- Tên dịch vụ -->
                        <div class="col-md-6">
                            <label for="editServiceName" class="form-label fw-semibold text-dark">
                                <i class="bi bi-tag-fill text-primary me-1" style="font-size: 0.8rem;"></i>Tên dịch vụ <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="editServiceName" name="editServiceName"
                                   placeholder="VD: Spa & Massage" required disabled
                                   style="border-radius: 0.5rem; padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s;">
                        </div>
                        <!-- Đơn vị tính -->
                        <div class="col-md-6">
                            <label for="editServiceUnit" class="form-label fw-semibold text-dark">
                                <i class="bi bi-rulers text-primary me-1" style="font-size: 0.8rem;"></i>Đơn vị tính <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="editServiceUnit" name="editServiceUnit"
                                   placeholder="VD: 60 phút, người, ngày, kg..." required disabled
                                   style="border-radius: 0.5rem; padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s;">
                        </div>
                        <!-- Loại dịch vụ -->
                        <div class="col-md-6">
                            <label for="editServiceType" class="form-label fw-semibold text-dark">
                                <i class="bi bi-grid-fill text-primary me-1" style="font-size: 0.8rem;"></i>Loại dịch vụ <span class="text-danger">*</span>
                            </label>
                            <select class="form-select" id="editServiceType" name="editServiceType" required disabled
                                    style="border-radius: 0.5rem; padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s; cursor: pointer;">
                                <option value="" disabled selected>-- Chọn loại dịch vụ --</option>
                                <option value="Ăn uống">🍽️ Ăn uống</option>
                                <option value="Giải trí">🎮 Giải trí</option>
                                <option value="Tiện ích">⚡ Tiện ích</option>
                                <option value="Vận chuyển">🚗 Vận chuyển</option>
                            </select>
                        </div>
                        <!-- Số tiền -->
                        <div class="col-md-6">
                            <label for="editServicePrice" class="form-label fw-semibold text-dark">
                                <i class="bi bi-cash-stack text-primary me-1" style="font-size: 0.8rem;"></i>Số tiền (VNĐ) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group" style="border-radius: 0.5rem; overflow: hidden;">
                                <input type="number" class="form-control" id="editServicePrice" name="editServicePrice"
                                       placeholder="VD: 500000" min="0" required disabled
                                       style="padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s;">
                                <span class="input-group-text bg-light text-muted" style="border-color: #e5e7eb; font-size: 0.85rem;">VNĐ</span>
                            </div>
                        </div>
                        <!-- Trạng thái -->
                        <div class="col-md-6">
                            <label for="editServiceStatus" class="form-label fw-semibold text-dark">
                                <i class="bi bi-toggle-on text-primary me-1" style="font-size: 0.8rem;"></i>Trạng thái
                            </label>
                            <select class="form-select" id="editServiceStatus" name="editServiceStatus" required disabled
                                    style="border-radius: 0.5rem; padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s; cursor: pointer;">
                                <option value="active">🟢 Đang hoạt động</option>
                                <option value="inactive">🔴 Ngừng hoạt động</option>
                            </select>
                        </div>
                        <!-- Spacer for alignment -->
                        <div class="col-md-6"></div>
                        <!-- Mô tả -->
                        <div class="col-12">
                            <label for="editServiceDescription" class="form-label fw-semibold text-dark">
                                <i class="bi bi-chat-left-text-fill text-primary me-1" style="font-size: 0.8rem;"></i>Mô tả
                            </label>
                            <textarea class="form-control" id="editServiceDescription" name="editServiceDescription" rows="3" disabled
                                      placeholder="Nhập mô tả chi tiết về dịch vụ..."
                                      style="border-radius: 0.5rem; padding: 0.6rem 0.85rem; border-color: #e5e7eb; resize: vertical; transition: all 0.2s;"></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <!-- Footer -->
            <div class="modal-footer border-0 px-4 pb-4 pt-2">
                <button type="button" class="btn btn-light px-4 border" data-bs-dismiss="modal"
                        style="border-radius: 0.5rem; font-weight: 500;">
                    Đóng
                </button>
                <button type="button" class="btn btn-primary px-4" id="btnUnlockEditService"
                        style="border-radius: 0.5rem; font-weight: 500;">
                    Chỉnh sửa
                </button>
                <button type="button" class="btn btn-dark px-4" id="btnSaveServiceEdit" disabled
                        style="border-radius: 0.5rem; font-weight: 500;">
                    <i class="bi bi-check-lg me-1"></i>Lưu
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function removeVietnameseTones(str) {
        str = str.replace(/à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ/g, "a");
        str = str.replace(/è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ễ/g, "e");
        str = str.replace(/ì|í|ị|ỉ|ĩ/g, "i");
        str = str.replace(/ò|ó|ọ|ỏ|õ|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ/g, "o");
        str = str.replace(/ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ/g, "u");
        str = str.replace(/ỳ|ý|ỵ|ỷ|ỹ/g, "y");
        str = str.replace(/đ/g, "d");
        str = str.replace(/À|Á|Ạ|Ả|Ã|Â|Ầ|Ấ|Ậ|Ẩ|Ẫ|Ă|Ằ|Ắ|Ặ|Ẳ|Ẵ/g, "A");
        str = str.replace(/È|É|Ẹ|Ẻ|Ẽ|Ê|Ề|Ế|Ệ|Ể|Ễ/g, "E");
        str = str.replace(/Ì|Í|Ị|Ỉ|Ĩ/g, "I");
        str = str.replace(/Ò|Ó|Ọ|Ỏ|Õ|Ô|Ồ|Ố|Ộ|Ổ|Ỗ|Ơ|Ờ|Ớ|Ợ|Ở|Ỡ/g, "O");
        str = str.replace(/Ù|Ú|Ụ|Ủ|Ũ|Ư|Ừ|Ứ|Ự|Ử|Ữ/g, "U");
        str = str.replace(/Ỳ|Ý|Ỵ|Ỷ|Ỹ/g, "Y");
        str = str.replace(/Đ/g, "D");
        return str;
        }

        $(document).ready(function () {
        var activeCategory = 'all';
        var activeCard = null;

        function filterServices() {
        var searchObj = removeVietnameseTones($('#searchInput').val().toLowerCase().trim());

        $('.service-item').each(function () {
        var name = removeVietnameseTones($(this).attr('data-name').toLowerCase());
        var category = $(this).attr('data-category');

        var matchSearch = name.includes(searchObj);
        var matchCategory = (activeCategory === 'all' || category === activeCategory);

        if (matchSearch && matchCategory) {
        $(this).show();
        } else {
        $(this).hide();
        }
        });
        }

        $('.category-btn').click(function () {
        $('.category-btn').removeClass('btn-primary text-white').addClass('btn-outline-secondary bg-white text-dark');
        $(this).removeClass('btn-outline-secondary bg-white text-dark').addClass('btn-primary text-white');
        activeCategory = $(this).data('category');
        filterServices();
        });

        $('#searchInput').on('input', filterServices);

        // Function to update stats
        function updateServiceStats() {
        var total = $('.service-item').length;
        var active = $('.service-item[data-status="active"]').length;
        $('#totalServicesCount').text(total);
        $('#activeServicesCount').text(active);
        }

        // Open Edit Modal
        $(document).on('click', '.btn-edit-service', function (e) {
        e.preventDefault();
        activeCard = $(this).closest('.service-item');

        $('#editServiceName').val(activeCard.attr('data-name'));
        $('#editServiceUnit').val(activeCard.attr('data-unit'));
        $('#editServiceType').val(activeCard.attr('data-category'));
        $('#editServicePrice').val(activeCard.attr('data-price'));
        $('#editServiceStatus').val(activeCard.attr('data-status') || 'active');
        $('#editServiceDescription').val(activeCard.attr('data-description') || '');

        // Reset disabled state
        $('#editServiceForm input, #editServiceForm select, #editServiceForm textarea').prop('disabled', true);
        $('#btnSaveServiceEdit').prop('disabled', true);
        $('#btnUnlockEditService').prop('disabled', false).show();

        var editModal = new bootstrap.Modal(document.getElementById('editServiceModal'));
        editModal.show();
        });

        // Unlock Edit Modal fields
        $('#btnUnlockEditService').click(function () {
        $('#editServiceForm input, #editServiceForm select, #editServiceForm textarea').prop('disabled', false);
        $('#btnSaveServiceEdit').prop('disabled', false);
        $(this).prop('disabled', true);
        });

        // Save edited service details
        $('#btnSaveServiceEdit').click(function () {
        var form = $('#editServiceForm')[0];
        if (!form.checkValidity()) {
        form.reportValidity();
        return;
        }

        var name = $('#editServiceName').val();
        var unit = $('#editServiceUnit').val();
        var category = $('#editServiceType').val();
        var price = $('#editServicePrice').val();
        var status = $('#editServiceStatus').val();
        var description = $('#editServiceDescription').val();

        // Update data attributes on the card
        activeCard.attr('data-name', name);
        activeCard.attr('data-unit', unit);
        activeCard.attr('data-category', category);
        activeCard.attr('data-price', price);
        activeCard.attr('data-status', status);
        activeCard.attr('data-description', description);

        // Update card layout
        activeCard.find('.fw-bold.fs-5.text-dark.mb-1').text(name);
        activeCard.find('.badge').text(category);
        activeCard.find('.text-muted.small.mb-3').text(description);

        var iconMap = {
        'Ăn uống': 'bi-cup-hot',
        'Giải trí': 'bi-activity',
        'Tiện ích': 'bi-basket',
        'Vận chuyển': 'bi-airplane'
        };
        var newIconClass = iconMap[category] || 'bi-gear';
        activeCard.find('.bg-primary i').attr('class', 'bi ' + newIconClass);

        var priceContainer = activeCard.find('.fs-4');
        if (parseInt(price) === 0) {
        priceContainer.html('Miễn phí').removeClass('text-dark').addClass('text-success');
        } else {
        var formattedPrice = parseInt(price).toLocaleString('vi-VN');
        priceContainer.html(formattedPrice + ' đ <span class="text-muted fs-6 fw-normal">/ ' + unit + '</span>').removeClass('text-success').addClass('text-dark');
        }

        var statusContainer = activeCard.find('.mb-4.d-flex.align-items-center');
        if (status === 'active') {
        statusContainer.html('<i class="bi bi-circle-fill text-success" style="font-size: 8px;"></i><span class="text-muted small">Đang hoạt động</span>');
        } else {
        statusContainer.html('<i class="bi bi-circle-fill text-danger" style="font-size: 8px;"></i><span class="text-muted small">Ngừng hoạt động</span>');
        }

        // Close Modal
        bootstrap.Modal.getInstance(document.getElementById('editServiceModal')).hide();

        // Update stats and search filter
        updateServiceStats();
        filterServices();

        Swal.fire({
        title: 'Đã lưu!',
        text: 'Thông tin dịch vụ đã được lưu thành công.',
        icon: 'success',
        timer: 1500,
        showConfirmButton: false
        });
        });

        // Delete Service
        $(document).on('click', '.btn-delete-service', function (e) {
        e.preventDefault();
        var card = $(this).closest('.service-item');
        var name = card.attr('data-name');

        Swal.fire({
        title: 'Xác nhận xóa?',
        text: `Bạn có chắc chắn muốn xóa dịch vụ "${name}" không?`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#212529',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Xác nhận',
        cancelButtonText: 'Hủy'
        }).then((result) => {
        if (result.isConfirmed) {
        card.remove();
        updateServiceStats();

        Swal.fire({
        title: 'Đã xóa!',
        text: 'Dịch vụ đã được xóa khỏi danh sách.',
        icon: 'success',
        timer: 1500,
        showConfirmButton: false
        });
        }
        });
        });

        // Modal form interactions for Add Service
        $('#addServiceModal').on('shown.bs.modal', function () {
        $('#serviceName').focus();
        });

        $('#addServiceModal').on('hidden.bs.modal', function () {
        $('#addServiceForm')[0].reset();
        });

        // Form focus styles
        $('#addServiceForm .form-control, #addServiceForm .form-select, #editServiceForm .form-control, #editServiceForm .form-select').on('focus', function () {
        $(this).css({
        'border-color': '#3b82f6',
        'box-shadow': '0 0 0 3px rgba(59, 130, 246, 0.15)'
        });
        }).on('blur', function () {
        $(this).css({
        'border-color': '#e5e7eb',
        'box-shadow': 'none'
        });
        });

        // Save button handler for Add Service
        $('#btnSaveService').click(function () {
        var form = $('#addServiceForm')[0];
        if (!form.checkValidity()) {
        form.reportValidity();
        return;
        }

        var name = $('#serviceName').val();
        var unit = $('#serviceUnit').val();
        var category = $('#serviceType').val();
        var price = $('#servicePrice').val();
        var status = $('#serviceStatus').val();
        var description = $('#serviceDescription').val();

        var iconMap = {
        'Ăn uống': 'bi-cup-hot',
        'Giải trí': 'bi-activity',
        'Tiện ích': 'bi-basket',
        'Vận chuyển': 'bi-airplane'
        };
        var iconClass = iconMap[category] || 'bi-gear';
        var priceHtml = '';
        if (parseInt(price) === 0) {
        priceHtml = '<div class="fw-bold fs-4 text-success mb-3">Miễn phí</div>';
        } else {
        var formattedPrice = parseInt(price).toLocaleString('vi-VN');
        priceHtml = '<div class="fw-bold fs-4 text-dark mb-3">' + formattedPrice + ' đ <span class="text-muted fs-6 fw-normal">/ ' + unit + '</span></div>';
        }

        var statusHtml = '';
        if (status === 'active') {
        statusHtml = '<i class="bi bi-circle-fill text-success" style="font-size: 8px;"></i><span class="text-muted small">Đang hoạt động</span>';
        } else {
        statusHtml = '<i class="bi bi-circle-fill text-danger" style="font-size: 8px;"></i><span class="text-muted small">Ngừng hoạt động</span>';
        }

        var newCardHtml = `
        <div class="col-md-4 service-item" data-name="${name}" data-category="${category}" data-unit="${unit}" data-price="${price}" data-status="${status}" data-description="${description}">
        <div class="card-custom p-4 border h-100">
        <div class="d-flex justify-content-between align-items-start mb-3">
        <div class="bg-primary bg-opacity-10 rounded d-flex align-items-center justify-content-center text-primary"
        style="width: 40px; height: 40px;">
        <i class="bi ${iconClass}"></i>
        </div>
        <span class="badge bg-light text-muted border rounded-pill px-2 py-1 fw-normal"
        style="font-size: 11px;">${category}</span>
        </div>
        <div class="fw-bold fs-5 text-dark mb-1">${name}</div>
        <div class="text-muted small mb-3">${description}</div>
        ${priceHtml}
        <div class="mb-4 d-flex align-items-center gap-2">
        ${statusHtml}
        </div>
        <div class="d-flex gap-2 justify-content-end">
        <button class="btn btn-icon-only border btn-edit-service" title="Chỉnh sửa"><i class="bi bi-pencil-square text-muted"></i></button>
        <button class="btn btn-icon-only border text-danger btn-delete-service" title="Xóa"><i class="bi bi-trash"></i></button>
        </div>
        </div>
        </div>`;

        $('#serviceList').prepend(newCardHtml);
        updateServiceStats();
        filterServices();

        $('#addServiceModal').modal('hide');
        Swal.fire({
        title: 'Đã thêm!',
        text: 'Dịch vụ mới đã được tạo thành công.',
        icon: 'success',
        timer: 1500,
        showConfirmButton: false
        });
        });
        });
    </script>
}
