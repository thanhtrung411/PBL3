@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý dịch vụ";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1 fw-bold">Quản lý dịch vụ</h3>
        <p class="text-muted mb-0">Theo dõi thông tin và hiệu suất của các dịch vụ</p>
    </div>
    <button class="btn btn-dark px-4"><i class="bi bi-plus"></i> Tạo phiếu dịch vụ</button>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card-custom py-3 text-center border">
            <div class="text-muted small mb-2">Tổng phiếu dịch vụ</div>
            <div class="fw-bold fs-3">500 phiếu</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom py-3 text-center border">
            <div class="text-muted small mb-2">Chờ duyệt</div>
            <div class="fw-bold fs-3">3 phiếu</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom py-3 text-center border">
            <div class="text-muted small mb-2">Đang sử dụng</div>
            <div class="fw-bold fs-3">12 phiếu</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom py-3 text-center border">
            <div class="text-muted small mb-2">Doanh thu hôm nay</div>
            <div class="d-flex justify-content-center align-items-baseline gap-2">
                <div class="fw-bold fs-3">1,200,000</div>
                <div class="text-success small fw-bold">+8% so với hôm qua</div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between mb-4">
    <div class="input-group" style="width: 350px;">
        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control bg-white border-start-0" placeholder="Tìm kiếm dịch vụ">
    </div>
    <div class="d-flex gap-2">
        <select class="form-select bg-light text-muted"><option>Loại</option></select>
        <select class="form-select bg-light text-muted"><option>Trạng thái</option></select>
    </div>
</div>

