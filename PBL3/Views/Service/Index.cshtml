<!-- Modal Thêm dịch vụ mới -->
<div class="modal fade" id="addServiceModal" tabindex="-1" aria-labelledby="addServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border: none; border-radius: 1rem; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.15);">
            <!-- Header -->
            <div class="modal-header border-0 px-4 pt-4 pb-2">
                <div>
                    <h5 class="modal-title fw-bold fs-5" id="addServiceModalLabel">
                        <i class="bi bi-plus-circle-fill text-primary me-2"></i>Thêm dịch vụ mới
                    </h5>
                    <p class="text-muted small mb-0 mt-1">Điền đầy đủ thông tin để tạo dịch vụ mới</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <!-- Body -->
            <div class="modal-body px-4 py-3">
                <form id="addServiceForm">
                    <div class="row g-3">
                        <!-- Tên dịch vụ -->
                        <div class="col-md-6">
                            <label for="serviceName" class="form-label fw-semibold text-dark">
                                <i class="bi bi-tag-fill text-primary me-1" style="font-size: 0.8rem;"></i>Tên dịch vụ <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="serviceName" name="serviceName"
                                   placeholder="VD: Spa & Massage" required
                                   style="border-radius: 0.5rem; padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s;">
                        </div>
                        <!-- Đơn vị tính -->
                        <div class="col-md-6">
                            <label for="serviceUnit" class="form-label fw-semibold text-dark">
                                <i class="bi bi-rulers text-primary me-1" style="font-size: 0.8rem;"></i>Đơn vị tính <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="serviceUnit" name="serviceUnit"
                                   placeholder="VD: 60 phút, người, ngày, kg..."
                                   style="border-radius: 0.5rem; padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s;">
                        </div>
                        <!-- Loại dịch vụ -->
                        <div class="col-md-6">
                            <label for="serviceType" class="form-label fw-semibold text-dark">
                                <i class="bi bi-grid-fill text-primary me-1" style="font-size: 0.8rem;"></i>Loại dịch vụ <span class="text-danger">*</span>
                            </label>
                            <select class="form-select" id="serviceType" name="serviceType" required
                                    style="border-radius: 0.5rem; padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s; cursor: pointer;">
                                <option value="" disabled selected>-- Chọn loại dịch vụ --</option>
                                <option value="Ăn uống">🍽️ Ăn uống</option>
                                <option value="Giải trí">🎮 Giải trí</option>
                                <option value="Tiện ích">⚡ Tiện ích</option>
                                <option value="Vận chuyển">🚗 Vận chuyển</option>
                            </select>
                        </div>
                        <!-- Số tiền -->
                        <div class="col-md-6">
                            <label for="servicePrice" class="form-label fw-semibold text-dark">
                                <i class="bi bi-cash-stack text-primary me-1" style="font-size: 0.8rem;"></i>Số tiền (VNĐ) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group" style="border-radius: 0.5rem; overflow: hidden;">
                                <input type="number" class="form-control" id="servicePrice" name="servicePrice"
                                       placeholder="VD: 500000" min="0" required
                                       style="padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s;">
                                <span class="input-group-text bg-light text-muted" style="border-color: #e5e7eb; font-size: 0.85rem;">VNĐ</span>
                            </div>
                        </div>
                        <!-- Trạng thái -->
                        <div class="col-md-6">
                            <label for="serviceStatus" class="form-label fw-semibold text-dark">
                                <i class="bi bi-toggle-on text-primary me-1" style="font-size: 0.8rem;"></i>Trạng thái
                            </label>
                            <select class="form-select" id="serviceStatus" name="serviceStatus"
                                    style="border-radius: 0.5rem; padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s; cursor: pointer;">
                                <option value="active" selected>🟢 Đang hoạt động</option>
                                <option value="inactive">🔴 Ngừng hoạt động</option>
                            </select>
                        </div>
                        <!-- Spacer for alignment -->
                        <div class="col-md-6"></div>
                        <!-- Mô tả -->
                        <div class="col-12">
                            <label for="serviceDescription" class="form-label fw-semibold text-dark">
                                <i class="bi bi-chat-left-text-fill text-primary me-1" style="font-size: 0.8rem;"></i>Mô tả
                            </label>
                            <textarea class="form-control" id="serviceDescription" name="serviceDescription" rows="3"
                                      placeholder="Nhập mô tả chi tiết về dịch vụ..."
                                      style="border-radius: 0.5rem; padding: 0.6rem 0.85rem; border-color: #e5e7eb; resize: vertical; transition: all 0.2s;"></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <!-- Footer -->
            <div class="modal-footer border-0 px-4 pb-4 pt-2">
                <button type="button" class="btn btn-light px-4 border" data-bs-dismiss="modal"
                        style="border-radius: 0.5rem; font-weight: 500;">
                    Hủy
                </button>
                <button type="button" class="btn btn-primary px-4" id="btnSaveService"
                        style="border-radius: 0.5rem; font-weight: 500;">
                    <i class="bi bi-check-lg me-1"></i>Lưu dịch vụ
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chỉnh sửa dịch vụ -->
<div class="modal fade" id="editServiceModal" tabindex="-1" aria-labelledby="editServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border: none; border-radius: 1rem; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.15);">
            <!-- Header -->
            <div class="modal-header border-0 px-4 pt-4 pb-2">
                <div>
                    <h5 class="modal-title fw-bold fs-5" id="editServiceModalLabel">
                        <i class="bi bi-pencil-square text-primary me-2"></i>Thông tin dịch vụ
                    </h5>
                    <p class="text-muted small mb-0 mt-1">Thông tin chi tiết dịch vụ của bạn</p>
