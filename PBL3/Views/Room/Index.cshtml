@model PBL3.Services.Receptionist.ReceptionistRoomMapResult

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý phòng";

    var roomTypes = Model.Floors
        .SelectMany(x => x.Rooms)
        .Select(x => x.RoomTypeName)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();
    var allRoomTypes = ViewBag.RoomTypeOptions as IEnumerable<PBL3.Controllers.RoomTypeOptionDto>
        ?? Enumerable.Empty<PBL3.Controllers.RoomTypeOptionDto>();

    string StatusLabel(string status) => status switch
    {
        "available" => "Trống",
        "occupied" => "Đang sử dụng",
        "maintenance" => "Bảo trì",
        _ => status
    };
}

@section Styles {
    <style>
        .room-admin-page {
            color: #142033;
        }

        .room-admin-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            min-height: 44px;
            margin-bottom: 22px;
        }

        .room-admin-header h1 {
            margin: 0;
            color: #111827;
            font-size: 1.45rem;
            font-weight: 800;
            letter-spacing: 0;
            line-height: 1.2;
        }

        .room-admin-header p {
            margin: 8px 0 0;
            display: none;
            color: #66758a;
            font-weight: 560;
        }

        .room-admin-panel {
            border: 1px solid #dfe7f0;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.96);
            box-shadow: 0 16px 38px rgba(20, 32, 51, 0.08);
            padding: 20px;
        }

        .room-admin-search {
            min-height: 48px;
            display: flex;
            align-items: center;
            gap: 10px;
            border: 1px solid #dfe7f0;
            border-radius: 8px;
            background: #ffffff;
            padding: 0 14px;
            margin-bottom: 16px;
        }

        .room-admin-search i {
            color: #66758a;
        }

        .room-admin-search input {
            width: 100%;
            border: 0;
            outline: none;
            color: #142033;
            font-weight: 560;
        }

        .room-map-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            flex-wrap: wrap;
            margin-bottom: 18px;
        }

        .room-map-controls {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            flex-wrap: wrap;
        }

        .room-map-type-filter {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 0;
        }

        .room-map-type-filter span {
            color: #66758a;
            font-size: 0.84rem;
            font-weight: 850;
            white-space: nowrap;
        }

        .room-map-type-filter select {
            width: 160px;
            min-height: 34px;
            border-radius: 999px;
            color: #142033;
            font-size: 0.86rem;
            font-weight: 780;
        }

        .room-map-summary {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .room-map-count {
            border-radius: 999px;
            background: #f4f7fb;
            color: #66758a;
            font-size: 0.86rem;
            font-weight: 800;
            padding: 7px 11px;
        }

        .room-map-count.available {
            background: #e9f8f0;
            color: #168a55;
        }

        .room-map-count.occupied {
            background: #eaf2ff;
            color: #1f6feb;
        }

        .room-map-count.maintenance {
            background: #fff5df;
            color: #9d741f;
        }

        .room-map-filters {
            display: inline-flex;
            gap: 6px;
            padding: 5px;
            border: 1px solid #dfe7f0;
            border-radius: 999px;
            background: #f8fbff;
        }

        .room-map-filters button {
            min-height: 34px;
            border: 0;
            border-radius: 999px;
            background: transparent;
            color: #66758a;
            font-size: 0.86rem;
            font-weight: 800;
            padding: 6px 11px;
        }

        .room-map-filters button.active {
            background: #ffffff;
            color: #1f6feb;
            box-shadow: 0 6px 14px rgba(20, 32, 51, 0.08);
        }

        .room-map-floors {
            display: grid;
            gap: 14px;
        }

        .room-map-floor {
            display: grid;
            gap: 10px;
            border: 1px solid #e7eef6;
            border-radius: 10px;
            background: #fbfdff;
            padding: 12px;
        }

        .room-map-floor-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .room-map-floor-header h3 {
            margin: 0;
            color: #142033;
            font-size: 1rem;
            font-weight: 850;
        }

        .room-map-floor-header span {
            color: #66758a;
            font-size: 0.86rem;
            font-weight: 800;
        }

        .room-map-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, 120px);
            gap: 8px;
            justify-content: start;
        }

        .room-map-tile {
            width: 120px;
            min-height: 88px;
            display: grid;
            gap: 7px;
            align-content: space-between;
            text-align: left;
            border: 1px solid #dfe8f2;
            border-radius: 8px;
            background: #ffffff;
            padding: 9px 10px;
            box-shadow: 0 6px 14px rgba(20, 32, 51, 0.04);
            cursor: pointer;
        }

        .room-map-tile:hover,
        .room-map-tile:focus-visible,
        .room-map-tile.selected {
            border-color: #1f6feb;
            box-shadow: 0 8px 18px rgba(31, 111, 235, 0.14);
            outline: none;
        }

        .room-map-tile.available {
            border-color: #bfe6d2;
            background: #f7fdf9;
        }

        .room-map-tile.occupied {
            border-color: #bfd6ff;
            background: #f7fbff;
        }

        .room-map-tile.maintenance {
            border-color: #f2dda8;
            background: #fffdf8;
        }

        .room-map-tile strong,
        .room-map-tile small,
        .room-map-tile-meta span {
            display: block;
        }

        .room-map-tile strong {
            color: #142033;
            font-size: 1.04rem;
            font-weight: 900;
            line-height: 1.1;
        }

        .room-map-tile small,
        .room-map-tile-meta span {
            color: #66758a;
            font-size: 0.76rem;
            font-weight: 750;
            line-height: 1.25;
            overflow-wrap: anywhere;
        }

        .room-map-tile-meta span {
            color: #142033;
            font-weight: 850;
        }

        .room-map-tile-meta {
            display: grid;
            gap: 2px;
        }

        .room-map-empty-line {
            min-height: 0.95rem;
        }

        .room-map-modal[hidden] {
            display: none !important;
        }

        .room-map-modal {
            position: fixed;
            inset: 0;
            z-index: 1050;
            display: grid;
            place-items: center;
            background: rgba(15, 23, 42, 0.54);
            padding: 24px;
        }

        .room-map-modal-dialog {
            width: min(760px, 100%);
            max-height: min(720px, calc(100vh - 48px));
            overflow: hidden;
            display: grid;
            grid-template-rows: auto minmax(0, 1fr);
            border-radius: 16px;
            background: #ffffff;
            box-shadow: 0 28px 72px rgba(15, 23, 42, 0.34);
        }

        .room-map-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            border-bottom: 1px solid #e7eef6;
            padding: 18px 22px;
        }

        .room-map-modal-header h3 {
            margin: 0;
            color: #142033;
            font-size: 1.12rem;
            font-weight: 900;
        }

        .room-map-modal-close {
            width: 38px;
            height: 38px;
            display: inline-grid;
            place-items: center;
            border: 0;
            border-radius: 999px;
            background: #f4f7fb;
            color: #142033;
        }

        .room-map-modal-body {
            overflow: auto;
            display: grid;
            gap: 14px;
            padding: 20px 22px 22px;
        }

        .room-map-detail-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .room-map-detail-head h3 {
            margin: 0;
            color: #142033;
            font-size: 1.08rem;
            font-weight: 900;
        }

        .room-map-detail-status {
            border-radius: 999px;
            background: #edf2f7;
            color: #66758a;
            font-size: 0.82rem;
            font-weight: 880;
            padding: 6px 10px;
            white-space: nowrap;
        }

        .room-map-detail-status.available {
            background: #e9f8f0;
            color: #168a55;
        }

        .room-map-detail-status.occupied {
            background: #eaf2ff;
            color: #1f6feb;
        }

        .room-map-detail-status.maintenance {
            background: #fff5df;
            color: #9d741f;
        }

        .room-map-detail-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(150px, 1fr));
            gap: 10px;
        }

        .room-map-guest-box {
            display: grid;
            gap: 10px;
        }

        .room-map-section-title {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .room-map-section-title span {
            color: #142033;
            font-size: 0.98rem;
            font-weight: 900;
        }

        .room-map-detail-grid > div {
            min-width: 0;
            border: 1px solid #edf2f7;
            border-radius: 8px;
            background: #fbfdff;
            padding: 10px;
        }

        .room-map-detail-grid span {
            display: block;
            color: #66758a;
            font-size: 0.82rem;
            font-weight: 760;
        }

        .room-map-detail-grid strong {
            display: block;
            color: #142033;
            font-size: 0.94rem;
            font-weight: 500;
            overflow-wrap: anywhere;
        }

        .room-map-detail-grid > .room-map-detail-wide {
            grid-column: 1 / -1;
        }

        .room-map-service-box {
            display: grid;
            gap: 8px;
            border-top: 1px solid #edf2f7;
            padding-top: 12px;
        }

        .room-map-room-type-box {
            display: grid;
            gap: 10px;
            border-top: 1px solid #edf2f7;
            padding-top: 12px;
        }

        .room-map-room-type-box h4 {
            margin: 0;
            color: #142033;
            font-size: 0.98rem;
            font-weight: 900;
        }

        .room-map-room-type-form {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 10px;
            align-items: end;
        }

        .room-map-room-type-form label {
            display: grid;
            gap: 6px;
            color: #66758a;
            font-size: 0.82rem;
            font-weight: 780;
        }

        .room-map-room-type-form select {
            min-height: 40px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 760;
        }

        .room-map-room-type-form button {
            min-height: 40px;
            border: 0;
            border-radius: 8px;
            background: #111827;
            color: #ffffff;
            font-weight: 830;
            padding: 9px 14px;
        }

        .room-map-room-type-form button:disabled {
            opacity: 0.65;
            cursor: not-allowed;
        }

        .room-map-room-type-note {
            margin: 0;
            color: #66758a;
            font-size: 0.8rem;
            font-weight: 720;
        }

        .room-map-service-title,
        .room-map-service-line {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .room-map-service-title span,
        .room-map-service-empty {
            color: #66758a;
            font-size: 0.82rem;
            font-weight: 760;
        }

        .room-map-service-line {
            border: 1px solid #edf2f7;
            border-radius: 8px;
            background: #fbfdff;
            padding: 9px 10px;
        }

        .room-map-service-line span,
        .room-map-service-line strong {
            color: #142033;
            font-size: 0.9rem;
            font-weight: 500;
        }

        .room-map-service-line strong {
            white-space: nowrap;
        }

        .room-map-service-empty {
            border: 1px dashed #cfdced;
            border-radius: 8px;
            padding: 10px;
            text-align: center;
        }

        .room-map-maintenance-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            border-top: 1px solid #edf2f7;
            padding-top: 12px;
        }

        .room-map-maintenance-btn {
            min-height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: 0;
            border-radius: 8px;
            color: #ffffff;
            font-weight: 820;
            padding: 9px 14px;
        }

        .room-map-maintenance-btn.to-maintenance {
            background: #9d741f;
        }

        .room-map-maintenance-btn.to-available {
            background: #168a55;
        }

        .room-map-empty {
            border: 1px dashed #cbd5e1;
            border-radius: 10px;
            background: #fbfdff;
            color: #66758a;
            font-weight: 760;
            padding: 34px 16px;
            text-align: center;
        }

        @@media (max-width: 640px) {
            .room-map-room-type-form {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="room-admin-page">
    <header class="room-admin-header">
        <div>
            <h1>Quản lý phòng</h1>
        </div>
        <a class="btn btn-dark admin-page-action" asp-controller="LoaiPhongs" asp-action="Index">
            <i class="bi bi-layers"></i>
            Quản lý loại phòng
        </a>
    </header>

    <section class="room-admin-panel">
        <label class="room-admin-search" for="roomMapSearch">
            <i class="bi bi-search"></i>
            <input id="roomMapSearch" type="search" placeholder="Tìm theo số phòng, khách, mã đặt phòng..." autocomplete="off" />
        </label>

        <div class="room-map-toolbar">
            <div class="room-map-summary">
                @foreach (var count in Model.StatusCounts)
                {
                    <span class="room-map-count @count.Status">@StatusLabel(count.Status): <strong>@count.Count</strong></span>
                }
            </div>
            <div class="room-map-controls">
                <label class="room-map-type-filter" for="roomMapTypeFilter">
                    <span>Loại phòng</span>
                    <select id="roomMapTypeFilter" class="form-select form-select-sm">
                        <option value="all">Tất cả</option>
                        @foreach (var roomType in roomTypes)
                        {
                            <option value="@roomType">@roomType</option>
                        }
                    </select>
                </label>
                <div class="room-map-filters" role="group" aria-label="Lọc trạng thái phòng">
                    <button type="button" class="active" data-room-map-filter="all">Tất cả</button>
                    <button type="button" data-room-map-filter="available">Trống</button>
                    <button type="button" data-room-map-filter="occupied">Đang sử dụng</button>
                    <button type="button" data-room-map-filter="maintenance">Bảo trì</button>
                </div>
            </div>
        </div>

        <div id="roomMapFloors" class="room-map-floors">
            @foreach (var floor in Model.Floors)
            {
                <section class="room-map-floor" data-room-map-floor>
                    <div class="room-map-floor-header">
                        <h3>Tầng @floor.Floor</h3>
                        <span data-room-map-floor-count>@floor.Rooms.Count phòng</span>
                    </div>
                    <div class="room-map-grid">
                        @foreach (var room in floor.Rooms.OrderBy(x => x.RoomNumber, StringComparer.OrdinalIgnoreCase))
                        {
                            <article class="room-map-tile @room.Status"
                                     data-room-map-room
                                     data-room-map-room-id="@room.RoomId"
                                     data-room-number="@room.RoomNumber"
                                     data-room-type-id="@room.RoomTypeId.Trim()"
                                     data-room-type="@room.RoomTypeName"
                                     data-room-floor="@room.Floor"
                                     data-room-status="@room.Status"
                                     data-room-status-label="@StatusLabel(room.Status)"
                                     data-room-guest="@room.CurrentGuestName"
                                     data-room-booking="@room.BookingCode"
                                     data-room-checkout="@room.CheckOutDate"
                                     role="button"
                                     tabindex="0">
                                <div class="room-map-tile-head">
                                    <strong>@room.RoomNumber</strong>
                                </div>
                                <div class="room-map-tile-meta">
                                    <span>@StatusLabel(room.Status)</span>
                                    @if (!string.IsNullOrWhiteSpace(room.CheckOutDate))
                                    {
                                        <small>Trả @room.CheckOutDate</small>
                                    }
                                    else
                                    {
                                        <small class="room-map-empty-line" aria-hidden="true">&nbsp;</small>
                                    }
                                    <small>@room.RoomTypeName</small>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        </div>

        <div id="roomMapEmptyState" class="room-map-empty" hidden>Không có phòng phù hợp bộ lọc hiện tại.</div>
    </section>

    <div id="roomMapDetailModal" class="room-map-modal" hidden>
        <div class="room-map-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="roomMapDetailTitle">
            <div class="room-map-modal-header">
                <h3 id="roomMapDetailTitle">Chi tiết phòng</h3>
                <button type="button" class="room-map-modal-close" id="roomMapDetailClose" aria-label="Đóng">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div id="roomMapDetailBody" class="room-map-modal-body"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const searchInput = document.getElementById("roomMapSearch");
            const typeFilter = document.getElementById("roomMapTypeFilter");
            const statusButtons = Array.from(document.querySelectorAll("[data-room-map-filter]"));
            const rooms = Array.from(document.querySelectorAll("[data-room-map-room]"));
            const floors = Array.from(document.querySelectorAll("[data-room-map-floor]"));
            const emptyState = document.getElementById("roomMapEmptyState");
            const detailModal = document.getElementById("roomMapDetailModal");
            const detailBody = document.getElementById("roomMapDetailBody");
            const detailClose = document.getElementById("roomMapDetailClose");
            const roomTypeOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(allRoomTypes));
            let statusFilter = "all";
            let selectedRoomElement = null;
            let serviceUsageCache = null;

            function normalizeText(value) {
                return (value || "")
                    .toLowerCase()
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .replace(/đ/g, "d");
            }

            function renderRoomMap() {
                const keyword = normalizeText(searchInput?.value);
                const selectedType = typeFilter?.value || "all";
                let visibleRooms = 0;

                rooms.forEach(function (room) {
                    const haystack = normalizeText([
                        room.dataset.roomNumber,
                        room.dataset.roomType,
                        room.dataset.roomStatusLabel,
                        room.dataset.roomGuest,
                        room.dataset.roomBooking
                    ].join(" "));
                    const visible = (!keyword || haystack.includes(keyword)) &&
                        (statusFilter === "all" || room.dataset.roomStatus === statusFilter) &&
                        (selectedType === "all" || room.dataset.roomType === selectedType);
                    room.hidden = !visible;
                    if (visible) visibleRooms += 1;
                });

                floors.forEach(function (floor) {
                    const floorRooms = Array.from(floor.querySelectorAll("[data-room-map-room]"));
                    const visibleCount = floorRooms.filter(room => !room.hidden).length;
                    const label = floor.querySelector("[data-room-map-floor-count]");
                    if (label) label.textContent = `${visibleCount} phòng`;
                    floor.hidden = visibleCount === 0;
                });

                if (emptyState) emptyState.hidden = visibleRooms > 0;
            }

            function openRoomDetail(room) {
                if (!detailModal || !detailBody) return;
                rooms.forEach(item => item.classList.remove("selected"));
                room.classList.add("selected");
                selectedRoomElement = room;

                const roomDto = roomElementToDetail(room);
                const hasBooking = Boolean(roomDto.bookingCode);
                renderRoomDetail(roomDto, { loadingServices: hasBooking && roomDto.status === "occupied" });

                if (!hasBooking || roomDto.status !== "occupied") return;

                Promise.all([
                    getRoomMapServiceUsage(),
                    fetchJson(`@Url.Action("Lookup", "Receptionist")?code=${encodeURIComponent(roomDto.bookingCode)}`)
                ])
                    .then(function ([serviceUsage, bookingLookup]) {
                        if (selectedRoomElement !== room) return;
                        const stay = (serviceUsage.activeStays || [])
                            .find(item => item.bookingCode === roomDto.bookingCode);
                        renderRoomDetail(roomDto, {
                            stay,
                            booking: bookingLookup.success ? bookingLookup.booking : null
                        });
                    })
                    .catch(function () {
                        if (selectedRoomElement !== room) return;
                        renderRoomDetail(roomDto, { serviceError: true });
                    });
            }

            function roomElementToDetail(room) {
                return {
                    roomId: room.dataset.roomMapRoomId || "",
                    roomNumber: room.dataset.roomNumber || "",
                    roomTypeId: room.dataset.roomTypeId || "",
                    roomTypeName: room.dataset.roomType || "",
                    floor: room.dataset.roomFloor || "",
                    status: room.dataset.roomStatus || "",
                    statusLabel: room.dataset.roomStatusLabel || "",
                    currentGuestName: room.dataset.roomGuest || "",
                    bookingCode: room.dataset.roomBooking || "",
                    checkOutDate: room.dataset.roomCheckout || ""
                };
            }

            async function getRoomMapServiceUsage() {
                if (serviceUsageCache) return serviceUsageCache;
                serviceUsageCache = await fetchJson("@Url.Action("ServiceUsage", "Receptionist")");
                return serviceUsageCache;
            }

            function renderRoomDetail(room, options = {}) {
                const stay = options.stay || null;
                const booking = options.booking || null;
                const serviceLines = stay?.serviceLines || [];
                const serviceHtml = options.loadingServices
                    ? `<div class="room-map-service-empty">Đang tải dịch vụ...</div>`
                    : options.serviceError
                        ? `<div class="room-map-service-empty">Chưa tải được dịch vụ của phòng này.</div>`
                        : serviceLines.length === 0
                            ? `<div class="room-map-service-empty">Chưa phát sinh dịch vụ.</div>`
                            : serviceLines.map(function (line) {
                                return `
                                    <div class="room-map-service-line">
                                        <span>${escapeHtml(formatDisplayText(line.serviceName))} x${line.quantity}</span>
                                        <strong>${formatMoney(line.total)}</strong>
                                    </div>
                                `;
                            }).join("");
                const bookedRooms = booking?.assignedRooms?.length
                    ? booking.assignedRooms.map(item => formatDisplayText(item.roomNumber))
                    : (stay?.roomNumbers || []).map(formatDisplayText);
                const roomNumbers = bookedRooms.length
                    ? `Phòng ${bookedRooms.map(escapeHtml).join(", ")}`
                    : `Phòng ${escapeHtml(formatDisplayText(room.roomNumber))}`;
                const canSetMaintenance = room.status === "available";
                const canCancelMaintenance = room.status === "maintenance";
                const canChangeRoomType = room.status !== "occupied";
                const roomTypeOptionsHtml = roomTypeOptions.map(function (option) {
                    const selected = option.RoomTypeId === room.roomTypeId ? "selected" : "";
                    return `<option value="${escapeHtml(option.RoomTypeId)}" ${selected}>${escapeHtml(formatDisplayText(option.RoomTypeName))}</option>`;
                }).join("");
                const roomTypeActionHtml = `
                    <div class="room-map-room-type-box">
                        <h4>Đổi loại phòng</h4>
                        <form class="room-map-room-type-form"
                              data-room-type-form
                              data-room-id="${escapeHtml(room.roomId)}"
                              data-current-room-type="${escapeHtml(room.roomTypeId)}">
                            <label>
                                Loại phòng mới
                                <select class="form-select" data-room-type-select ${canChangeRoomType ? "" : "disabled"}>
                                    ${roomTypeOptionsHtml}
                                </select>
                            </label>
                            <button type="submit" ${canChangeRoomType ? "" : "disabled"}>
                                <i class="bi bi-arrow-repeat"></i>
                                Cập nhật
                            </button>
                        </form>
                        <p class="room-map-room-type-note">${canChangeRoomType
                            ? "Chỉ đổi được khi phòng không thuộc đặt phòng đang hoạt động."
                            : "Phòng đang sử dụng nên chưa thể đổi loại phòng."}</p>
                    </div>`;
                const maintenanceActionHtml = canSetMaintenance || canCancelMaintenance
                    ? `
                        <div class="room-map-maintenance-actions">
                            <button type="button"
                                    class="room-map-maintenance-btn ${canSetMaintenance ? "to-maintenance" : "to-available"}"
                                    data-room-maintenance-toggle
                                    data-room-id="${escapeHtml(room.roomId)}"
                                    data-maintenance="${canSetMaintenance ? "true" : "false"}">
                                <i class="bi ${canSetMaintenance ? "bi-tools" : "bi-check2-circle"}"></i>
                                ${canSetMaintenance ? "Bảo trì phòng" : "Hủy bảo trì"}
                            </button>
                        </div>`
                    : "";
                const guestHtml = room.status === "occupied"
                    ? `
                        <div class="room-map-guest-box">
                            <div class="room-map-section-title">
                                <span>Thông tin khách hàng</span>
                            </div>
                            <div class="room-map-detail-grid">
                                <div>
                                    <span>Tên khách hàng</span>
                                    <strong>${escapeHtml(formatPersonName(booking?.customerName || stay?.customerName || room.currentGuestName || "-"))}</strong>
                                </div>
                                <div>
                                    <span>CCCD/Hộ chiếu</span>
                                    <strong>${escapeHtml(booking?.identityNumber || "-")}</strong>
                                </div>
                                <div>
                                    <span>Số điện thoại</span>
                                    <strong>${escapeHtml(formatSentenceText(booking?.phoneNumber || stay?.phoneNumber || "-"))}</strong>
                                </div>
                                <div>
                                    <span>Ngày đặt</span>
                                    <strong>${escapeHtml(booking?.bookingDate || "-")}</strong>
                                </div>
                                <div>
                                    <span>Ngày trả</span>
                                    <strong>${escapeHtml(booking?.checkOutDate || stay?.checkOutDate || room.checkOutDate || "-")}</strong>
                                </div>
                                <div>
                                    <span>Mã đặt phòng</span>
                                    <strong>${escapeHtml(booking?.bookingCode || room.bookingCode || "-")}</strong>
                                </div>
                                <div class="room-map-detail-wide">
                                    <span>Các phòng đang được booking cùng</span>
                                    <strong>${roomNumbers}</strong>
                                </div>
                            </div>
                        </div>`
                    : "";

                detailBody.innerHTML = `
                    <div class="room-map-detail-head">
                        <div>
                            <h3>Phòng ${escapeHtml(formatDisplayText(room.roomNumber))}</h3>
                        </div>
                        <span class="room-map-detail-status ${escapeHtml(room.status)}">${escapeHtml(formatSentenceText(room.statusLabel))}</span>
                    </div>
                    <div class="room-map-detail-grid">
                        <div>
                            <span>Loại phòng</span>
                            <strong>${escapeHtml(formatDisplayText(room.roomTypeName))}</strong>
                        </div>
                        <div>
                            <span>Tình trạng phòng</span>
                            <strong>${escapeHtml(formatSentenceText(room.statusLabel))}</strong>
                        </div>
                    </div>
                    ${guestHtml}
                    <div class="room-map-service-box">
                        <div class="room-map-service-title">
                            <span>Dịch vụ đã sử dụng</span>
                        </div>
                        ${serviceHtml}
                    </div>
                    ${roomTypeActionHtml}
                    ${maintenanceActionHtml}
                `;
                detailModal.hidden = false;
            }

            async function fetchJson(url, options) {
                const response = await fetch(url, options);
                if (!response.ok) {
                    throw new Error("Không thể kết nối máy chủ. Vui lòng thử lại.");
                }

                return response.json();
            }

            async function toggleRoomMaintenance(button) {
                const roomId = button.dataset.roomId || "";
                const maintenance = button.dataset.maintenance === "true";
                const confirmMessage = maintenance
                    ? "Chuyển phòng này sang trạng thái bảo trì?"
                    : "Hủy bảo trì và chuyển phòng về trạng thái trống?";
                if (!roomId || !confirm(confirmMessage)) return;

                button.disabled = true;
                const originalHtml = button.innerHTML;
                button.innerHTML = "Đang cập nhật...";
                try {
                    const response = await fetch("@Url.Action("Maintenance", "Room")", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ roomId, maintenance })
                    });
                    if (!response.ok) throw new Error("Không thể cập nhật phòng.");
                    const result = await response.json();
                    if (!result.success) {
                        alert(result.message || "Không thể cập nhật phòng.");
                        button.disabled = false;
                        button.innerHTML = originalHtml;
                        return;
                    }

                    location.reload();
                } catch (error) {
                    alert(error.message || "Không thể cập nhật phòng.");
                    button.disabled = false;
                    button.innerHTML = originalHtml;
                }
            }

            async function changeRoomType(form) {
                const roomId = form.dataset.roomId || "";
                const currentRoomType = form.dataset.currentRoomType || "";
                const select = form.querySelector("[data-room-type-select]");
                const roomTypeId = select?.value || "";
                const button = form.querySelector("button[type='submit']");
                const selectedLabel = select?.selectedOptions?.[0]?.textContent?.trim() || "";
                if (!roomId || !roomTypeId) return;
                if (roomTypeId === currentRoomType) {
                    alert("Loại phòng không thay đổi.");
                    return;
                }
                if (!confirm(`Đổi phòng này sang loại ${selectedLabel}?`)) return;

                if (button) {
                    button.disabled = true;
                    button.dataset.originalHtml = button.innerHTML;
                    button.innerHTML = "Đang cập nhật...";
                }
                try {
                    const response = await fetch("@Url.Action("ChangeType", "Room")", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ roomId, roomTypeId })
                    });
                    if (!response.ok) throw new Error("Không thể đổi loại phòng.");
                    const result = await response.json();
                    if (!result.success) {
                        alert(result.message || "Không thể đổi loại phòng.");
                        if (button) {
                            button.disabled = false;
                            button.innerHTML = button.dataset.originalHtml || "Cập nhật";
                        }
                        return;
                    }

                    location.reload();
                } catch (error) {
                    alert(error.message || "Không thể đổi loại phòng.");
                    if (button) {
                        button.disabled = false;
                        button.innerHTML = button.dataset.originalHtml || "Cập nhật";
                    }
                }
            }

            function closeRoomDetail() {
                if (detailModal) detailModal.hidden = true;
                if (detailBody) detailBody.innerHTML = "";
                selectedRoomElement = null;
                rooms.forEach(item => item.classList.remove("selected"));
            }

            function formatMoney(value) {
                return new Intl.NumberFormat("vi-VN", {
                    style: "currency",
                    currency: "VND",
                    maximumFractionDigits: 0
                }).format(value || 0);
            }

            function formatSentenceText(value) {
                const text = String(value ?? "").trim();
                if (!shouldNormalizeUppercase(text)) return text;

                const lower = text.toLocaleLowerCase("vi-VN");
                return lower.replace(/^(\P{L}*)(\p{L})/u, function (_, prefix, letter) {
                    return `${prefix}${letter.toLocaleUpperCase("vi-VN")}`;
                });
            }

            function formatPersonName(value) {
                const text = String(value ?? "").trim();
                if (!shouldNormalizeUppercase(text)) return text;

                return text.toLocaleLowerCase("vi-VN").replace(/\p{L}[\p{L}'-]*/gu, function (word) {
                    return word.charAt(0).toLocaleUpperCase("vi-VN") + word.slice(1);
                });
            }

            function formatDisplayText(value) {
                const text = String(value ?? "").trim();
                if (!shouldNormalizeUppercase(text)) return text;

                return text.toLocaleLowerCase("vi-VN").replace(/\p{L}[\p{L}'-]*/gu, function (word) {
                    return word.charAt(0).toLocaleUpperCase("vi-VN") + word.slice(1);
                });
            }

            function shouldNormalizeUppercase(text) {
                return /[\p{L}]/u.test(text) &&
                    /[\p{Lu}]/u.test(text) &&
                    !/[\p{Ll}]/u.test(text);
            }

            function escapeHtml(value) {
                return String(value || "")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            statusButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    statusFilter = button.dataset.roomMapFilter || "all";
                    statusButtons.forEach(item => item.classList.remove("active"));
                    button.classList.add("active");
                    renderRoomMap();
                });
            });

            searchInput?.addEventListener("input", renderRoomMap);
            typeFilter?.addEventListener("change", renderRoomMap);

            detailBody?.addEventListener("click", function (event) {
                const button = event.target.closest("[data-room-maintenance-toggle]");
                if (!button) return;
                toggleRoomMaintenance(button);
            });
            detailBody?.addEventListener("submit", function (event) {
                const form = event.target.closest("[data-room-type-form]");
                if (!form) return;
                event.preventDefault();
                changeRoomType(form);
            });

            rooms.forEach(function (room) {
                room.addEventListener("click", function () {
                    openRoomDetail(room);
                });
                room.addEventListener("keydown", function (event) {
                    if (event.key !== "Enter" && event.key !== " ") return;
                    event.preventDefault();
                    openRoomDetail(room);
                });
            });

            detailClose?.addEventListener("click", closeRoomDetail);
            detailModal?.addEventListener("click", function (event) {
                if (event.target === detailModal) closeRoomDetail();
            });
            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape" && detailModal && !detailModal.hidden) closeRoomDetail();
            });

            renderRoomMap();
        })();
    </script>
}
