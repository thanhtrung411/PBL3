            <div class="modal-header">
                <h5 class="modal-title" id="bookRoomModalLabel">Đặt phòng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="bookRoomForm">
                    <input type="hidden" id="bookRoomNumber" name="roomNumber" />
                    
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <h6 class="fw-bold border-bottom pb-2">Thông tin khách hàng</h6>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="guestName" class="form-label">Họ và tên</label>
