@functions {
    public class RoomItem
    {
        public string Number { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public string? Guest { get; set; }
        public string? CheckOut { get; set; }
    }
}
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý phòng";

    var rooms = new List<RoomItem>();

    void AddRoom(string number, string type, string status, string? guest = null, string? checkout = null)
    {
        rooms.Add(new RoomItem { Number = number, Type = type, Status = status, Guest = guest, CheckOut = checkout });
    }

    // Tầng 1: Standard (101-108)
    AddRoom("101", "Standard", "Có khách", "Nguyễn Văn A", "12:00");
    AddRoom("102", "Standard", "Trống");
    AddRoom("103", "Standard", "Bảo trì");
    AddRoom("104", "Standard", "Có khách", "Trần Thị B", "12:00");
    for (int i = 5; i <= 8; i++) AddRoom($"10{i}", "Standard", "Trống");

    // Tầng 2: Deluxe (201-208)
    AddRoom("201", "Deluxe", "Trống");
    AddRoom("202", "Deluxe", "Có khách", "Nguyễn Văn B", "12:00");
    AddRoom("203", "Deluxe", "Dọn dẹp");
    AddRoom("204", "Deluxe", "Trống");
    for (int i = 5; i <= 8; i++) AddRoom($"20{i}", "Deluxe", "Trống");

    // Tầng 3: Suit (301-308)
    AddRoom("301", "Suit", "Có khách", "Lê Văn C", "12:00");
    AddRoom("302", "Suit", "Trống");
    for (int i = 3; i <= 8; i++) AddRoom($"30{i}", "Suit", "Trống");

    // Tầng 4: Presidential (401-402)
    AddRoom("401", "Presidential", "Có khách", "Phạm Thị D", "12:00");
    AddRoom("402", "Presidential", "Dọn dẹp");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1 fw-bold">Quản lý phòng</h3>
        <p class="text-muted mb-0">Theo dõi và quản lý trạng thái tất cả phòng</p>
    </div>
    <button class="btn btn-dark px-4" data-bs-toggle="modal" data-bs-target="#addRoomModal"><i class="bi bi-plus"></i> Thêm phòng mới</button>
</div>

<!-- Filters -->
<div class="card-custom mb-4 py-3">
    <div class="row align-items-center">
        <div class="col-md-6">
            <div class="input-group flex-nowrap">
                <span class="input-group-text bg-light border-end-0" id="addon-wrapping"><i class="bi bi-search"></i></span>
                <input type="text" id="searchInput" class="form-control bg-light border-start-0" placeholder="Tìm kiếm phòng, tên khách..." aria-label="Search" aria-describedby="addon-wrapping">
            </div>
        </div>
        <div class="col-md-3">
            <select id="filterType" class="form-select bg-light text-muted">
                <option value="">Loại phòng</option>
                <option>Standard</option>
                <option>Deluxe</option>
                <option>Suit</option>
                <option>Presidential</option>
            </select>
        </div>
        <div class="col-md-3">
            <select id="filterStatus" class="form-select bg-light text-muted">
                <option value="">Trạng thái</option>
                <option>Trống</option>
                <option>Có khách</option>
                <option>Bảo trì</option>
                <option>Dọn dẹp</option>
            </select>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col">
        <div class="card-custom text-center py-3">
            <div class="text-muted small mb-1">Standard</div>
            <div class="fw-bold fs-4">2/8</div>
            <div class="small text-muted mt-1">Giá: 800,000đ /đêm</div>
        </div>
    </div>
    <div class="col">
        <div class="card-custom text-center py-3">
            <div class="text-muted small mb-1">Deluxe</div>
            <div class="fw-bold fs-4">1/8</div>
            <div class="small text-muted mt-1">Giá: 1,500,000đ /đêm</div>
        </div>
    </div>
    <div class="col">
        <div class="card-custom text-center py-3">
            <div class="text-muted small mb-1">Suit</div>
            <div class="fw-bold fs-4">1/8</div>
            <div class="small text-muted mt-1">Giá: 2,500,000đ /đêm</div>
        </div>
    </div>
    <div class="col">
        <div class="card-custom text-center py-3">
            <div class="text-muted small mb-1">Presidential</div>
            <div class="fw-bold fs-4">1/2</div>
            <div class="small text-muted mt-1">Giá: 5,000,000đ /đêm</div>
        </div>
    </div>
</div>

<!-- Rooms Grid -->
<div class="row g-4" id="rooms-grid">
    @foreach (var room in rooms)
    {
        <div class="col-md-3">
            <div class="card-custom bg-light p-3 position-relative d-flex flex-column room-card" id="room-card-@room.Number" style="min-height: 260px;">
                <button class="btn btn-icon-only position-absolute top-0 end-0 m-2"><i class="bi bi-gear"></i></button>
                <div class="fw-bold mb-2">@room.Number</div>

                <div class="text-center mb-2 status-container">
                    @if (room.Status == "Có khách")
                    {
                        <span class="badge-status badge-occupied">Có khách</span>
                    }
                    else if (room.Status == "Trống")
                    {
                        <span class="badge-status badge-empty">Trống</span>
                    }
                    else if (room.Status == "Bảo trì")
                    {
                        <span class="badge-status badge-maintenance">Bảo trì</span>
                    }
                    else if (room.Status == "Dọn dẹp")
                    {
                        <span class="badge-status badge-cleaning">Dọn dẹp</span>
                    }
                    else if (room.Status == "Đã giữ")
                    {
                        <span class="badge-status badge-reserved">Đã giữ</span>
                    }
                </div>

                <div class="d-flex flex-column flex-grow-1 justify-content-center guest-info-container">
                    <div class="text-center text-muted small mb-1">@room.Type</div>

                    @if (!string.IsNullOrEmpty(room.Guest))
                    {
                        <div class="text-center fw-bold mb-1 guest-name">@room.Guest</div>
                        <div class="text-center small text-muted mb-3 checkout-time">Check-out: @room.CheckOut</div>
                    }
                </div>

                <div class="action-container mt-auto">
                    @if (room.Status == "Có khách")
                    {
                        <button class="btn btn-dark w-100 btn-checkout" data-room="@room.Number" data-guest="@room.Guest" data-checkout="@room.CheckOut">Trả phòng</button>
                    }
                    else if (room.Status == "Trống")
                    {
                        <button class="btn btn-dark w-100 btn-book-room" data-room="@room.Number">Đặt phòng</button>
                    }
                    else if (room.Status == "Bảo trì")
                    {
                        <button class="btn shadow-sm bg-white text-dark w-100 border-0 btn-finish-task" data-room="@room.Number" data-status="available">Hoàn tất bảo trì</button>
                    }
                    else if (room.Status == "Dọn dẹp")
                    {
                        <div class="d-grid gap-2">
                            <button class="btn shadow-sm bg-white text-dark border-0 btn-finish-task" data-room="@room.Number" data-status="available">Hoàn thành dọn dẹp</button>
                            <button class="btn btn-sm btn-outline-danger border-0 btn-report-damage" data-room="@room.Number">Báo hư hỏng (Bảo trì)</button>
                        </div>
                    }
                    else if (room.Status == "Đã giữ")
                    {
                        <button class="btn btn-dark w-100 btn-checkin" data-room="@room.Number">Nhận phòng (Check-in)</button>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- Book Room Modal -->
<div class="modal fade" id="bookRoomModal" tabindex="-1" aria-labelledby="bookRoomModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bookRoomModalLabel">Đặt phòng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="bookRoomForm">
                    <input type="hidden" id="bookRoomNumber" name="roomNumber" />

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <h6 class="fw-bold border-bottom pb-2">Thông tin khách hàng</h6>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="guestName" class="form-label">Họ và tên</label>
                            <input type="text" class="form-control" id="guestName" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="guestId" class="form-label">CMND/CCCD/Hộ chiếu</label>
                            <input type="text" class="form-control" id="guestId" required>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="guestPhone" class="form-label">Số điện thoại</label>
                            <input type="tel" class="form-control" id="guestPhone" required>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="guestNationality" class="form-label">Quốc tịch</label>
                            <input type="text" class="form-control" id="guestNationality" value="Việt Nam">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="guestGender" class="form-label">Giới tính</label>
                            <select class="form-select" id="guestGender">
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="guestEmail" class="form-label">Email</label>
                            <input type="email" class="form-control" id="guestEmail" placeholder="example@email.com">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="guestAddress" class="form-label">Địa chỉ thường trú</label>
                            <input type="text" class="form-control" id="guestAddress" placeholder="Nhập địa chỉ thường trú">
                        </div>

                        <div class="col-md-12 mb-3 mt-2">
                            <h6 class="fw-bold border-bottom pb-2">Thông tin đặt phòng</h6>
                        </div>
                        <div class="col-md-12 mb-3">
                            <label for="guestCount" class="form-label">Số lượng khách</label>
                            <input type="number" class="form-control" id="guestCount" value="1" min="1">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="checkInDate" class="form-label">Ngày nhận phòng</label>
                            <input type="date" class="form-control" id="checkInDate" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="checkOutDate" class="form-label">Ngày trả phòng</label>
                            <input type="date" class="form-control" id="checkOutDate" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="checkInTime" class="form-label">Giờ nhận phòng</label>
                            <input type="time" class="form-control" id="checkInTime" value="14:00">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="checkOutTime" class="form-label">Giờ trả phòng dự kiến</label>
                            <input type="time" class="form-control" id="checkOutTime" value="12:00">
                        </div>
                        <div class="col-md-12 mb-3">
                            <label for="bookingNotes" class="form-label">Ghi chú đặc biệt</label>
                            <textarea class="form-control" id="bookingNotes" rows="2"></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Huỷ</button>
                <button type="button" class="btn btn-outline-dark" id="btnBookFuture">Đặt trước (Giữ phòng)</button>
                <button type="button" class="btn btn-dark" id="btnSubmitBookRoom">Nhận phòng ngay</button>
            </div>
        </div>
    </div>
</div>

<!-- Add Room Modal -->
<div class="modal fade" id="addRoomModal" tabindex="-1" aria-labelledby="addRoomModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border: none; border-radius: 1rem; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.15);">
            <!-- Header -->
            <div class="modal-header border-0 px-4 pt-4 pb-2">
                <div>
                    <h5 class="modal-title fw-bold fs-5" id="addRoomModalLabel">
                        <i class="bi bi-plus-circle-fill text-primary me-2"></i>Thêm phòng mới
                    </h5>
                    <p class="text-muted small mb-0 mt-1">Nhập thông tin phòng cần thêm vào hệ thống</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <!-- Body -->
            <div class="modal-body px-4 py-3">
                <form id="addRoomForm">
                    <div class="row g-3">
                        <!-- Số phòng -->
                        <div class="col-md-6">
                            <label for="roomNo" class="form-label fw-semibold text-dark">Số phòng <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="roomNo" required placeholder="VD: 501"
                                   style="border-radius: 0.5rem; padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s;">
                        </div>
                        <!-- Loại phòng -->
                        <div class="col-md-6">
                            <label for="roomType" class="form-label fw-semibold text-dark">Loại phòng <span class="text-danger">*</span></label>
                            <select class="form-select" id="roomType" required
                                    style="border-radius: 0.5rem; padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s; cursor: pointer;">
                                <option value="Standard">Standard</option>
                                <option value="Deluxe">Deluxe</option>
                                <option value="Suit">Suit</option>
                                <option value="Presidential">Presidential</option>
                            </select>
                        </div>
                        <!-- Tầng -->
                        <div class="col-md-6">
                            <label for="roomFloor" class="form-label fw-semibold text-dark">Tầng <span class="text-danger">*</span></label>
                            <select class="form-select" id="roomFloor" required
                                    style="border-radius: 0.5rem; padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s; cursor: pointer;">
                                <option value="1">Tầng 1</option>
                                <option value="2">Tầng 2</option>
                                <option value="3">Tầng 3</option>
                                <option value="4">Tầng 4</option>
                                <option value="5">Tầng 5</option>
                            </select>
                        </div>
                        <!-- Trạng thái -->
                        <div class="col-md-6">
                            <label for="roomStatus" class="form-label fw-semibold text-dark">Trạng thái <span class="text-danger">*</span></label>
                            <select class="form-select" id="roomStatus" required
                                    style="border-radius: 0.5rem; padding: 0.6rem 0.85rem; border-color: #e5e7eb; transition: all 0.2s; cursor: pointer;">
                                <option value="Trống" selected>Trống</option>
                                <option value="Bảo trì">Bảo trì</option>
                            </select>
                        </div>
                        <!-- Ghi chú -->
                        <div class="col-12">
                            <label for="roomNote" class="form-label fw-semibold text-dark">Ghi chú</label>
                            <textarea class="form-control" id="roomNote" rows="3" placeholder="Nhập ghi chú về phòng (nếu có)..."
                                      style="border-radius: 0.5rem; padding: 0.6rem 0.85rem; border-color: #e5e7eb; resize: vertical; transition: all 0.2s;"></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <!-- Footer -->
            <div class="modal-footer border-0 px-4 pb-4 pt-2">
                <button type="button" class="btn btn-light px-4 border" data-bs-dismiss="modal"
                        style="border-radius: 0.5rem; font-weight: 500;">
                    Huỷ
                </button>
                <button type="button" class="btn btn-dark px-4" id="btnSubmitAddRoom"
                        style="border-radius: 0.5rem; font-weight: 500;">
                    <i class="bi bi-check-lg me-1"></i>Lưu phòng
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function() {

        // =============================================
        // SEARCH & FILTER FUNCTIONALITY
        // =============================================
        function filterRooms() {
        var searchVal = $('#searchInput').val().toLowerCase().trim();
        var typeVal   = $('#filterType').val().toLowerCase().trim();
        var statusVal = $('#filterStatus').val().toLowerCase().trim();

        $('.room-card').each(function() {
        var card       = $(this);
        var roomNumber = card.find('.fw-bold').first().text().toLowerCase();
        var guestName  = (card.find('.guest-name').text() || '').toLowerCase();
        var roomType   = (card.find('.guest-info-container .text-muted.small').first().text() || '').toLowerCase();
        var statusText = (card.find('.status-container .badge-status').text() || '').toLowerCase();

        var matchSearch = !searchVal ||
        roomNumber.includes(searchVal) ||
        guestName.includes(searchVal);

        var matchType   = !typeVal   || roomType.includes(typeVal);
        var matchStatus = !statusVal || statusText.includes(statusVal);

        // Show/hide the parent col-md-3 wrapper
        if (matchSearch && matchType && matchStatus) {
        card.closest('.col-md-3').show();
        } else {
        card.closest('.col-md-3').hide();
        }
        });

        // Show "no results" message if all hidden
        var visibleCount = $('.room-card').closest('.col-md-3:visible').length;
        if (visibleCount === 0) {
        if ($('#no-results').length === 0) {
        $('#rooms-grid').append('<div id="no-results" class="col-12 text-center text-muted py-5"><i class="bi bi-search fs-1 d-block mb-3"></i>Không tìm thấy phòng phù hợp.</div>');
        }
        } else {
        $('#no-results').remove();
        }
        }

        // Trigger filter on any input/change
        $('#searchInput').on('input', filterRooms);
        $('#filterType').on('change', filterRooms);
        $('#filterStatus').on('change', filterRooms);

        // =============================================
        // CHECKOUT FUNCTIONALITY
        // =============================================
        $(document).on('click', '.btn-checkout', function(e) {
        e.preventDefault();
        var btn = $(this);
        var roomNumber = btn.data('room');
        var guestName = btn.data('guest');
        var checkoutTime = btn.data('checkout');

        Swal.fire({
        title: 'Xác nhận trả phòng?',
        text: `Bạn có chắc muốn trả phòng ${roomNumber} không? Khách: ${guestName}, Check-out: ${checkoutTime}`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#212529',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Xác nhận trả phòng',
        cancelButtonText: 'Huỷ'
        }).then((result) => {
        if (result.isConfirmed) {
        // Disable button and show loading
        var originalText = btn.html();
        btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang xử lý...');

        $.ajax({
        url: '@Url.Action("Checkout", "Room")',
        type: 'POST',
        data: { roomNumber: roomNumber },
        success: function(res) {
        if (res.success) {
        // Update UI
        var card = $('#room-card-' + roomNumber);

        // Update status badge to "Dọn dẹp" as per new requirement
        var statusContainer = card.find('.status-container');
        statusContainer.html('<span class="badge-status badge-cleaning">Dọn dẹp</span>');

        // Remove guest info
        card.find('.guest-name').remove();
        card.find('.checkout-time').remove();

        // Update button to "Hoàn thành dọn dẹp" and "Báo hư hỏng"
        var actionContainer = card.find('.action-container');
        actionContainer.html(`
        <div class="d-grid gap-2">
        <button class="btn shadow-sm bg-white text-dark border-0 btn-finish-task" data-room="${roomNumber}" data-status="available">Hoàn thành dọn dẹp</button>
        <button class="btn btn-sm btn-outline-danger border-0 btn-report-damage" data-room="${roomNumber}">Báo hư hỏng (Bảo trì)</button>
        </div>
        `);

        Swal.fire('Thành công!', 'Trả phòng thành công. Phòng đã chuyển sang trạng thái dọn dẹp.', 'success');
        } else {
        btn.prop('disabled', false).html(originalText);
        Swal.fire('Lỗi!', 'Có lỗi xảy ra, vui lòng thử lại.', 'error');
        }
        },
        error: function() {
        btn.prop('disabled', false).html(originalText);
        Swal.fire('Lỗi!', 'Không thể kết nối đến máy chủ.', 'error');
        }
        });
        }
        });
        });

        // =============================================
        // FINISH TASK (CLEANING / MAINTENANCE)
        // =============================================
        $(document).on('click', '.btn-finish-task', function(e) {
        e.preventDefault();
        var btn = $(this);
        var roomNumber = btn.data('room');
        var status = btn.data('status');
        var taskName = btn.text().toLowerCase();

        Swal.fire({
        title: 'Xác nhận ' + taskName + '?',
        text: `Phòng ${roomNumber} sẽ chuyển sang trạng thái Trống.`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#212529',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Xác nhận',
        cancelButtonText: 'Huỷ'
        }).then((result) => {
        if (result.isConfirmed) {
        var originalText = btn.html();
        btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang xử lý...');

        $.ajax({
        url: '@Url.Action("FinishTask", "Room")',
        type: 'POST',
        data: { roomNumber: roomNumber, status: status },
        success: function(res) {
        if (res.success) {
        var card = $('#room-card-' + roomNumber);
        card.find('.status-container').html('<span class="badge-status badge-empty">Trống</span>');

        // Ensure guest info is removed
        card.find('.guest-name').remove();
        card.find('.checkout-time').remove();

        card.find('.action-container').html(`<button class="btn btn-dark w-100 btn-book-room" data-room="${roomNumber}">Đặt phòng</button>`);
        Swal.fire('Thành công!', 'Phòng đã sẵn sàng đón khách.', 'success');
        } else {
        btn.prop('disabled', false).html(originalText);
        Swal.fire('Lỗi!', 'Có lỗi xảy ra, vui lòng thử lại.', 'error');
        }
        },
        error: function() {
        btn.prop('disabled', false).html(originalText);
        Swal.fire('Lỗi!', 'Không thể kết nối đến máy chủ.', 'error');
        }
        });
        }
        });
        });

        // =============================================
        // REPORT DAMAGE (MAINTENANCE)
        // =============================================
        $(document).on('click', '.btn-report-damage', function(e) {
        e.preventDefault();
        var btn = $(this);
        var roomNumber = btn.data('room');

        Swal.fire({
        title: 'Báo phòng hư hỏng?',
        text: `Chuyển phòng ${roomNumber} sang trạng thái bảo trì?`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Xác nhận bảo trì',
        cancelButtonText: 'Huỷ'
        }).then((result) => {
        if (result.isConfirmed) {
        $.ajax({
        url: '@Url.Action("FinishTask", "Room")', // Reuse task endpoint
        type: 'POST',
        data: { roomNumber: roomNumber, status: 'maintenance' },
        success: function(res) {
        if (res.success) {
        var card = $('#room-card-' + roomNumber);
        card.find('.status-container').html('<span class="badge-status badge-maintenance">Bảo trì</span>');
        card.find('.action-container').html(`<button class="btn shadow-sm bg-white text-dark w-100 border-0 btn-finish-task" data-room="${roomNumber}" data-status="available">Hoàn tất bảo trì</button>`);
        Swal.fire('Đã cập nhật!', 'Phòng đã chuyển sang trạng thái bảo trì.', 'success');
        }
        }
        });
        }
        });
        });

        // =============================================
        // ADD NEW ROOM - Form focus styles
        // =============================================
        $('#addRoomForm .form-control, #addRoomForm .form-select').on('focus', function () {
        $(this).css({
        'border-color': '#3b82f6',
        'box-shadow': '0 0 0 3px rgba(59, 130, 246, 0.15)'
        });
        }).on('blur', function () {
        $(this).css({
        'border-color': '#e5e7eb',
        'box-shadow': 'none'
        });
        });

        // Reset form on modal close
        $('#addRoomModal').on('hidden.bs.modal', function () {
        $('#addRoomForm')[0].reset();
        });

        // =============================================
        // ADD NEW ROOM - Save handler
        // =============================================
        $('#btnSubmitAddRoom').click(function() {
        var form = $('#addRoomForm')[0];
        if (!form.checkValidity()) {
        form.reportValidity();
        return;
        }

        bootstrap.Modal.getInstance(document.getElementById('addRoomModal')).hide();
        Swal.fire({
        title: 'Thành công!',
        text: 'Đã lưu phòng mới vào hệ thống.',
        icon: 'success',
        timer: 1500,
        showConfirmButton: false
        }).then(() => {
        location.reload();
        });
        });

        // =============================================
        // BOOK ROOM FUNCTIONALITY
        // =============================================
        $(document).on('click', '.btn-book-room', function(e) {
        e.preventDefault();
        var roomNumber = $(this).data('room');
        $('#bookRoomNumber').val(roomNumber);
        $('#bookRoomForm')[0].reset();

        // Set default dates
        var today = new Date().toISOString().split('T')[0];
        $('#checkInDate').val(today);

        $('#bookRoomModalLabel').text('Đặt phòng ' + roomNumber);
        var bookModal = new bootstrap.Modal(document.getElementById('bookRoomModal'));
        bookModal.show();
        });

        function submitBooking(status) {
        var form = $('#bookRoomForm')[0];
        if (!form.checkValidity()) {
        form.reportValidity();
        return;
        }

        var roomNumber = $('#bookRoomNumber').val();
        var guestName = $('#guestName').val();

        $.ajax({
        url: '@Url.Action("BookRoom", "Room")',
        type: 'POST',
        data: { roomNumber: roomNumber, status: status },
        success: function(res) {
        if (res.success) {
        bootstrap.Modal.getInstance(document.getElementById('bookRoomModal')).hide();
        var card = $('#room-card-' + roomNumber);

        if (status === 'occupied') {
        card.find('.status-container').html('<span class="badge-status badge-occupied">Có khách</span>');
        card.find('.action-container').html(`<button class="btn btn-dark w-100 btn-checkout" data-room="${roomNumber}" data-guest="${guestName}" data-checkout="...">Trả phòng</button>`);
        } else {
        card.find('.status-container').html('<span class="badge-status badge-reserved">Đã giữ</span>');
        card.find('.action-container').html(`<button class="btn btn-dark w-100 btn-checkin" data-room="${roomNumber}">Nhận phòng (Check-in)</button>`);
        }

        Swal.fire('Thành công!', 'Đã cập nhật trạng thái phòng.', 'success');
        location.reload(); // For demo simplicity
        }
        }
        });
        }

        $('#btnSubmitBookRoom').click(function() { submitBooking('occupied'); });
        $('#btnBookFuture').click(function() { submitBooking('reserved'); });

        $(document).on('click', '.btn-checkin', function() {
        var roomNumber = $(this).data('room');
        Swal.fire('Check-in!', 'Khách đã nhận phòng ' + roomNumber, 'success').then(() => location.reload());
        });

        });
    </script>
}



