                            <label for="checkInDate" class="form-label">Ngày nhận phòng</label>
                            <input type="date" class="form-control" id="checkInDate" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="checkOutDate" class="form-label">Ngày trả phòng</label>
                            <input type="date" class="form-control" id="checkOutDate" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="checkInTime" class="form-label">Giờ nhận phòng</label>
                            <input type="time" class="form-control" id="checkInTime" value="14:00">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="checkOutTime" class="form-label">Giờ trả phòng dự kiến</label>
                            <input type="time" class="form-control" id="checkOutTime" value="12:00">
                        </div>
                        <div class="col-md-12 mb-3">
                            <label for="bookingNotes" class="form-label">Ghi chú đặc biệt</label>
                            <textarea class="form-control" id="bookingNotes" rows="2"></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Huỷ</button>
                <button type="button" class="btn btn-outline-dark" id="btnBookFuture">Đặt trước (Giữ phòng)</button>
                <button type="button" class="btn btn-dark" id="btnSubmitBookRoom">Nhận phòng ngay</button>
            </div>
        </div>
    </div>
</div>

<!-- Add Room Modal -->
<div class="modal fade" id="addRoomModal" tabindex="-1" aria-labelledby="addRoomModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addRoomModalLabel">Thêm phòng mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addRoomForm">
                    <div class="mb-3">
                        <label for="roomNo" class="form-label">Số phòng</label>
                        <input type="text" class="form-control" id="roomNo" required>
                    </div>
                    <div class="mb-3">
                        <label for="roomType" class="form-label">Loại Phòng</label>
                        <select class="form-select" id="roomType" required>
                            <option value="Standard">Standard</option>
                            <option value="Deluxe">Deluxe</option>
                            <option value="Suit">Suit</option>
                            <option value="Presidential">Presidential</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="roomPrice" class="form-label">Giá (VNĐ)</label>
                        <input type="number" class="form-control" id="roomPrice" required>
                    </div>
                    <div class="mb-3">
                        <label for="roomCapacity" class="form-label">Sức chứa (Người)</label>
                        <input type="number" class="form-control" id="roomCapacity" value="2" required>
                    </div>
                    <div class="mb-3">
                        <label for="roomDesc" class="form-label">Mô tả</label>
                        <textarea class="form-control" id="roomDesc" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="roomFacilities" class="form-label">Tiện nghi</label>
                        <input type="text" class="form-control" id="roomFacilities" placeholder="Wifi, TV, Điều hòa...">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Huỷ</button>
                <button type="button" class="btn btn-dark" id="btnSubmitAddRoom">Lưu phòng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function() {

        // =============================================
        // SEARCH & FILTER FUNCTIONALITY
        // =============================================
        function filterRooms() {
        var searchVal = $('#searchInput').val().toLowerCase().trim();
        var typeVal   = $('#filterType').val().toLowerCase().trim();
        var statusVal = $('#filterStatus').val().toLowerCase().trim();

        $('.room-card').each(function() {
        var card       = $(this);
        var roomNumber = card.find('.fw-bold').first().text().toLowerCase();
        var guestName  = (card.find('.guest-name').text() || '').toLowerCase();
        var roomType   = (card.find('.guest-info-container .text-muted.small').first().text() || '').toLowerCase();
        var statusText = (card.find('.status-container .badge-status').text() || '').toLowerCase();

        var matchSearch = !searchVal ||
        roomNumber.includes(searchVal) ||
        guestName.includes(searchVal);

        var matchType   = !typeVal   || roomType.includes(typeVal);
        var matchStatus = !statusVal || statusText.includes(statusVal);

        // Show/hide the parent col-md-3 wrapper
        if (matchSearch && matchType && matchStatus) {
        card.closest('.col-md-3').show();
        } else {
        card.closest('.col-md-3').hide();
        }
        });

        // Show "no results" message if all hidden
        var visibleCount = $('.room-card').closest('.col-md-3:visible').length;
        if (visibleCount === 0) {
        if ($('#no-results').length === 0) {
        $('#rooms-grid').append('<div id="no-results" class="col-12 text-center text-muted py-5"><i class="bi bi-search fs-1 d-block mb-3"></i>Không tìm thấy phòng phù hợp.</div>');
        }
        } else {
        $('#no-results').remove();
        }
        }

        // Trigger filter on any input/change
        $('#searchInput').on('input', filterRooms);
        $('#filterType').on('change', filterRooms);
        $('#filterStatus').on('change', filterRooms);

        // =============================================
        // CHECKOUT FUNCTIONALITY
        // =============================================
        $(document).on('click', '.btn-checkout', function(e) {
        e.preventDefault();
        var btn = $(this);
        var roomNumber = btn.data('room');
        var guestName = btn.data('guest');
        var checkoutTime = btn.data('checkout');

        Swal.fire({
        title: 'Xác nhận trả phòng?',
        text: `Bạn có chắc muốn trả phòng ${roomNumber} không? Khách: ${guestName}, Check-out: ${checkoutTime}`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#212529',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Xác nhận trả phòng',
        cancelButtonText: 'Huỷ'
        }).then((result) => {
        if (result.isConfirmed) {
        // Disable button and show loading
        var originalText = btn.html();
        btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang xử lý...');

        $.ajax({
        url: '@Url.Action("Checkout", "Room")',
        type: 'POST',
        data: { roomNumber: roomNumber },
        success: function(res) {
        if (res.success) {
        // Update UI
        var card = $('#room-card-' + roomNumber);

        // Update status badge to "Dọn dẹp" as per new requirement
        var statusContainer = card.find('.status-container');
        statusContainer.html('<span class="badge-status badge-cleaning">Dọn dẹp</span>');

        // Remove guest info
        card.find('.guest-name').remove();
        card.find('.checkout-time').remove();

        // Update button to "Hoàn thành dọn dẹp" and "Báo hư hỏng"
        var actionContainer = card.find('.action-container');
        actionContainer.html(`
        <div class="d-grid gap-2">
        <button class="btn shadow-sm bg-white text-dark border-0 btn-finish-task" data-room="${roomNumber}" data-status="available">Hoàn thành dọn dẹp</button>
        <button class="btn btn-sm btn-outline-danger border-0 btn-report-damage" data-room="${roomNumber}">Báo hư hỏng (Bảo trì)</button>
        </div>
        `);

        Swal.fire('Thành công!', 'Trả phòng thành công. Phòng đã chuyển sang trạng thái dọn dẹp.', 'success');
        } else {
        btn.prop('disabled', false).html(originalText);
        Swal.fire('Lỗi!', 'Có lỗi xảy ra, vui lòng thử lại.', 'error');
        }
        },
        error: function() {
        btn.prop('disabled', false).html(originalText);
        Swal.fire('Lỗi!', 'Không thể kết nối đến máy chủ.', 'error');
        }
        });
        }
        });
        });

        // =============================================
        // FINISH TASK (CLEANING / MAINTENANCE)
        // =============================================
        $(document).on('click', '.btn-finish-task', function(e) {
        e.preventDefault();
        var btn = $(this);
        var roomNumber = btn.data('room');
        var status = btn.data('status');
        var taskName = btn.text().toLowerCase();

        Swal.fire({
        title: 'Xác nhận ' + taskName + '?',
        text: `Phòng ${roomNumber} sẽ chuyển sang trạng thái Trống.`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#212529',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Xác nhận',
        cancelButtonText: 'Huỷ'
        }).then((result) => {
        if (result.isConfirmed) {
        var originalText = btn.html();
        btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang xử lý...');

        $.ajax({
        url: '@Url.Action("FinishTask", "Room")',
        type: 'POST',
        data: { roomNumber: roomNumber, status: status },
        success: function(res) {
        if (res.success) {
        var card = $('#room-card-' + roomNumber);
        card.find('.status-container').html('<span class="badge-status badge-empty">Trống</span>');

        // Ensure guest info is removed
        card.find('.guest-name').remove();
        card.find('.checkout-time').remove();

        card.find('.action-container').html(`<button class="btn btn-dark w-100 btn-book-room" data-room="${roomNumber}">Đặt phòng</button>`);
        Swal.fire('Thành công!', 'Phòng đã sẵn sàng đón khách.', 'success');
        } else {
        btn.prop('disabled', false).html(originalText);
        Swal.fire('Lỗi!', 'Có lỗi xảy ra, vui lòng thử lại.', 'error');
        }
        },
        error: function() {
        btn.prop('disabled', false).html(originalText);
        Swal.fire('Lỗi!', 'Không thể kết nối đến máy chủ.', 'error');
        }
        });
        }
        });
        });

        // =============================================
        // REPORT DAMAGE (MAINTENANCE)
        // =============================================
        $(document).on('click', '.btn-report-damage', function(e) {
        e.preventDefault();
        var btn = $(this);
        var roomNumber = btn.data('room');

        Swal.fire({
        title: 'Báo phòng hư hỏng?',
        text: `Chuyển phòng ${roomNumber} sang trạng thái bảo trì?`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Xác nhận bảo trì',
        cancelButtonText: 'Huỷ'
        }).then((result) => {
        if (result.isConfirmed) {
        $.ajax({
        url: '@Url.Action("FinishTask", "Room")', // Reuse task endpoint
        type: 'POST',
        data: { roomNumber: roomNumber, status: 'maintenance' },
        success: function(res) {
        if (res.success) {
        var card = $('#room-card-' + roomNumber);
        card.find('.status-container').html('<span class="badge-status badge-maintenance">Bảo trì</span>');
        card.find('.action-container').html(`<button class="btn shadow-sm bg-white text-dark w-100 border-0 btn-finish-task" data-room="${roomNumber}" data-status="available">Hoàn tất bảo trì</button>`);
        Swal.fire('Đã cập nhật!', 'Phòng đã chuyển sang trạng thái bảo trì.', 'success');
        }
        }
        });
        }
        });
        });

        // =============================================
        // ADD NEW ROOM
        // =============================================
        $('#btnSubmitAddRoom').click(function() {
        var form = $('#addRoomForm')[0];
        if (!form.checkValidity()) {
        form.reportValidity();
        return;
        }

        Swal.fire('Thành công!', 'Đã lưu phòng mới vào cơ sở dữ liệu. Trạng thái mặc định: Trống.', 'success').then(() => {
        bootstrap.Modal.getInstance(document.getElementById('addRoomModal')).hide();
        location.reload(); // Simple reload to show new room
        });
        });

        // =============================================
        // BOOK ROOM FUNCTIONALITY
        // =============================================
        $(document).on('click', '.btn-book-room', function(e) {
        e.preventDefault();
        var roomNumber = $(this).data('room');
        $('#bookRoomNumber').val(roomNumber);
        $('#displayRoomNumber').val(roomNumber); // Display read-only
        $('#bookRoomForm')[0].reset();
                
        // Set default dates
        var today = new Date().toISOString().split('T')[0];
        $('#checkInDate').val(today);
                
        $('#bookRoomModalLabel').text('Đặt phòng ' + roomNumber);
        var bookModal = new bootstrap.Modal(document.getElementById('bookRoomModal'));
        bookModal.show();
        });

        function submitBooking(status) {
        var form = $('#bookRoomForm')[0];
        if (!form.checkValidity()) {
        form.reportValidity();
        return;
        }

        var roomNumber = $('#bookRoomNumber').val();
        var guestName = $('#guestName').val();
                
        $.ajax({
        url: '@Url.Action("BookRoom", "Room")',
        type: 'POST',
        data: { roomNumber: roomNumber, status: status },
        success: function(res) {
        if (res.success) {
        bootstrap.Modal.getInstance(document.getElementById('bookRoomModal')).hide();
        var card = $('#room-card-' + roomNumber);
                            
        if (status === 'occupied') {
        card.find('.status-container').html('<span class="badge-status badge-occupied">Có khách</span>');
        card.find('.action-container').html(`<button class="btn btn-dark w-100 btn-checkout" data-room="${roomNumber}" data-guest="${guestName}" data-checkout="...">Trả phòng</button>`);
        } else {
        card.find('.status-container').html('<span class="badge-status badge-reserved">Đã giữ</span>');
        card.find('.action-container').html(`<button class="btn btn-dark w-100 btn-checkin" data-room="${roomNumber}">Nhận phòng (Check-in)</button>`);
        }

        Swal.fire('Thành công!', 'Đã cập nhật trạng thái phòng.', 'success');
        location.reload(); // For demo simplicity
        }
        }
        });
        }

        $('#btnSubmitBookRoom').click(function() { submitBooking('occupied'); });
        $('#btnBookFuture').click(function() { submitBooking('reserved'); });

        $(document).on('click', '.btn-checkin', function() {
        var roomNumber = $(this).data('room');
        Swal.fire('Check-in!', 'Khách đã nhận phòng ' + roomNumber, 'success').then(() => location.reload());
        });

        });
    </script>
}




