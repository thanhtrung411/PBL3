@model PBL3.Models.AccountSettingsViewModel
@using System.Security.Claims

@{
    var role = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "";
    var isAdmin = string.Equals(role, "admin", StringComparison.OrdinalIgnoreCase);
    Layout = null;
    ViewData["Title"] = "Cài đặt tài khoản";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cài đặt tài khoản - Venus Hotel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>

<main class="account-settings-page">
    <div class="account-settings-card">
        <div class="account-settings-head">
            <div>
                <h1>Cài đặt tài khoản</h1>
                <p>Chỉnh sửa thông tin của tài khoản đang đăng nhập.</p>
            </div>
            <a class="btn btn-light border fw-bold" href="@(isAdmin ? Url.Action("Index", "Home") : Url.Action("Index", "Receptionist"))">
                <i class="bi bi-arrow-left"></i>
                Quay lại
            </a>
        </div>

        @if (TempData["SettingsSuccess"] is string successMessage)
        {
            <div class="alert alert-success">@successMessage</div>
        }

        <form asp-action="Settings" method="post" class="account-settings-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <input type="hidden" asp-for="AccountId" />
            <input type="hidden" asp-for="EmployeeId" />

            <section>
                <h2>Thông tin tài khoản</h2>
                <div class="settings-grid">
                    <div>
                        <label asp-for="Username" class="form-label">Tên đăng nhập</label>
                        <input asp-for="Username" class="form-control" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>
                    <div>
                        <label class="form-label">Vai trò</label>
                        <input class="form-control" value="@Model.RoleName" disabled />
                    </div>
                    <div>
                        <label asp-for="NewPassword" class="form-label">Mật khẩu mới</label>
                        <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>
            </section>

            <section>
                <h2>Thông tin cá nhân</h2>
                <div class="settings-grid">
                    <div>
                        <label asp-for="FullName" class="form-label">Họ tên</label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="Gender" class="form-label">Giới tính</label>
                        <select asp-for="Gender" class="form-select">
                            <option value="">Chưa chọn</option>
                            <option>Nam</option>
                            <option>Nữ</option>
                            <option>Khác</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="BirthDate" class="form-label">Ngày sinh</label>
                        <input asp-for="BirthDate" type="date" class="form-control" />
                    </div>
                    <div>
                        <label asp-for="Phone" class="form-label">Số điện thoại</label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="Address" class="form-label">Địa chỉ</label>
                        <input asp-for="Address" class="form-control" />
                    </div>
                </div>
            </section>

            <div class="account-settings-actions">
                <button type="submit" class="btn btn-dark px-4 fw-bold">
                    <i class="bi bi-check2"></i>
                    Lưu thay đổi
                </button>
            </div>
        </form>
    </div>
</main>

<style>
    .account-settings-page {
        min-height: 100vh;
        padding: 34px;
        background: linear-gradient(180deg, #fbfdff 0%, #f7f9fc 100%);
        color: #142033;
    }

    .account-settings-card {
        max-width: 980px;
        margin: 0 auto;
        border: 1px solid #dfe7f0;
        border-radius: 14px;
        background: #ffffff;
        box-shadow: 0 18px 42px rgba(15, 23, 42, 0.08);
        padding: 24px;
    }

    .account-settings-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 20px;
    }

    .account-settings-head h1 {
        margin: 0;
        color: #111827;
        font-size: 1.9rem;
        font-weight: 900;
    }

    .account-settings-head p {
        margin: 6px 0 0;
        color: #66758a;
        font-weight: 600;
    }

    .account-settings-form {
        display: grid;
        gap: 22px;
    }

    .account-settings-form section {
        display: grid;
        gap: 12px;
    }

    .account-settings-form h2 {
        margin: 0;
        color: #142033;
        font-size: 1rem;
        font-weight: 900;
    }

    .settings-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .account-settings-actions {
        display: flex;
        justify-content: flex-end;
        border-top: 1px solid #edf2f7;
        padding-top: 18px;
    }

    @@media (max-width: 720px) {
        .account-settings-page {
            padding: 18px;
        }

        .account-settings-head,
        .settings-grid {
            grid-template-columns: 1fr;
            flex-direction: column;
        }
    }
</style>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
