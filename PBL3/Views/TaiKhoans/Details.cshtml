@model PBL3.Models.TaiKhoan

@{
    ViewData["Title"] = "Chi tiết Tài khoản";
}

<h1>Chi tiết Tài khoản</h1>

<div>
    <h4>Tài Khoản</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">Mã TK</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.MaTk)</dd>
        
        <dt class = "col-sm-2">Tên đăng nhập</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.TenDangNhap)</dd>

        <dt class = "col-sm-2">Nhân viên</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.MaNvNavigation.HoTen)</dd>

        <dt class = "col-sm-2">Vai trò</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.MaVaiTroNavigation.TenVaiTro)</dd>
        
        <dt class = "col-sm-2">Trạng thái</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.TrangThai)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.MaTk">Sửa</a> |
    <a asp-action="Index">Quay lại danh sách</a>
</div>
