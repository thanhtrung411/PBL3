@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý cơ sở vật chất";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex gap-2 flex-grow-1" style="max-width: 700px;">
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" id="searchInput" class="form-control bg-white border-start-0"
                   placeholder="Tìm kiếm cơ sở vật chất...">
        </div>
        <select id="categoryFilter" class="form-select bg-white" style="width: 150px;">
            <option value="all">Tất cả</option>
            <option value="Phòng khách">Phòng khách</option>
            <option value="Dịch vụ">Dịch vụ</option>
            <option value="An ninh">An ninh</option>
            <option value="Tiện ích">Tiện ích</option>
            <option value="Giải trí">Giải trí</option>
        </select>
        <select id="statusFilter" class="form-select bg-white" style="width: 150px;">
            <option value="all">Tất cả trạng thái</option>
            <option value="Tốt">Tốt</option>
            <option value="Bảo trì định kỳ">Bảo trì định kỳ</option>
            <option value="Cần sửa chữa">Cần sửa chữa</option>
        </select>
    </div>
    <button class="btn btn-primary px-4"><i class="bi bi-plus"></i> Thêm cơ sở vật chất</button>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
