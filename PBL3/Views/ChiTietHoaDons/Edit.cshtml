@model PBL3.Models.ChiTietHoaDon

@{
    ViewData["Title"] = "Chỉnh sửa hạng mục";
}

<h1>Chỉnh sửa hạng mục hóa đơn</h1>

<h4>Chi Tiết Hóa Đơn</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MaCthd" />
            
            <div class="form-group">
                <label asp-for="MaHoaDon" class="control-label">Mã Hóa Đơn Gốc</label>
                <select asp-for="MaHoaDon" class="form-control" asp-items="ViewBag.MaHoaDon"></select>
                <span asp-validation-for="MaHoaDon" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LoaiMuc" class="control-label">Loại hạng mục</label>
                <select asp-for="LoaiMuc" class="form-control">
                    <option value="PHONG">Tiền phòng</option>
                    <option value="DICHVU">Tiền dịch vụ</option>
                    <option value="DATCOC">Tiền đặt cọc</option>
                    <option value="GIAMGIADICHVU">Giảm giá dịch vụ</option>
                    <option value="PHUTHU">Phụ thu</option>
                </select>
                <span asp-validation-for="LoaiMuc" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NoiDung" class="control-label">Nội dung (VD: Tiền phòng 3 ngày)</label>
                <input asp-for="NoiDung" class="form-control" />
                <span asp-validation-for="NoiDung" class="text-danger"></span>
            </div>

            <div class="form-group border border-warning p-3 my-2 bg-light">
                <label class="text-muted">Các hạng mục liên kết (để trống nếu không dùng)</label>
                
                <label asp-for="MaPhong" class="control-label mt-2">Phòng liên quan</label>
                <select asp-for="MaPhong" class="form-control" asp-items="ViewBag.MaPhong">
                    <option value="">-- Không có phòng --</option>
                </select>

                <label asp-for="MaDv" class="control-label mt-2">Dịch vụ sử dụng</label>
                <select asp-for="MaDv" class="form-control" asp-items="ViewBag.MaDv">
                    <option value="">-- Không sử dụng dịch vụ --</option>
                </select>

                <label asp-for="MaGiamGia" class="control-label mt-2">Mã giảm giá áp dụng (nếu có)</label>
                <select asp-for="MaGiamGia" class="form-control" asp-items="ViewBag.MaGiamGia">
                    <option value="">-- Không áp dụng mã --</option>
                </select>
            </div>

            <div class="form-group">
                <label asp-for="NgayApDung" class="control-label">Ngày áp dụng hạng mục</label>
                <input asp-for="NgayApDung" type="date" class="form-control" />
                <span asp-validation-for="NgayApDung" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SoNguoi" class="control-label">Số người</label>
                <input asp-for="SoNguoi" type="number" class="form-control" />
                <span asp-validation-for="SoNguoi" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SoLuong" class="control-label">Số lượng / Số đêm</label>
                <input asp-for="SoLuong" type="number" class="form-control" />
                <span asp-validation-for="SoLuong" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DonGia" class="control-label">Đơn giá</label>
                <input asp-for="DonGia" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="DonGia" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ThanhTien" class="control-label font-weight-bold text-danger">Thành Tiền</label>
                <input asp-for="ThanhTien" type="number" step="0.01" class="form-control text-danger font-weight-bold" />
                <span asp-validation-for="ThanhTien" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TrangThai" class="control-label">Trạng thái hạng mục</label>
                <select asp-for="TrangThai" class="form-control">
                    <option value="HIEU_LUC">Hiệu lực</option>
                    <option value="HUY">Bị hủy</option>
                    <option value="DA_TINH_TIEN">Đã tính tiền</option>
                </select>
                <span asp-validation-for="TrangThai" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="GhiChu" class="control-label">Ghi chú thêm</label>
                <input asp-for="GhiChu" class="form-control" />
                <span asp-validation-for="GhiChu" class="text-danger"></span>
            </div>
            
            <div class="form-group mt-3">
                <input type="submit" value="Lưu" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Quay lại danh sách</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
