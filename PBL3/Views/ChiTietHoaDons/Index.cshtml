@model IEnumerable<PBL3.Models.ChiTietHoaDon>

@{
    ViewData["Title"] = "Chi tiết các hạng mục Hóa đơn";
}

<h1>Chi tiết Hóa đơn (CTHD)</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Thêm hạng mục mới</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Mã Hóa Đơn</th>
            <th>Mã CTHD</th>
            <th>Loại hạng mục</th>
            <th>Nội dung</th>
            <th>Phòng</th>
            <th>Dịch vụ</th>
            <th>Số lượng</th>
            <th>Thành tiền</th>
            <th>Trạng thái</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.MaHoaDon)</td>
            <td>@Html.DisplayFor(modelItem => item.MaCthd)</td>
            <td>@Html.DisplayFor(modelItem => item.LoaiMuc)</td>
            <td>@Html.DisplayFor(modelItem => item.NoiDung)</td>
            <td>@Html.DisplayFor(modelItem => item.MaPhongNavigation.SoPhong)</td>
            <td>@Html.DisplayFor(modelItem => item.MaDvNavigation.TenDv)</td>
            <td>@Html.DisplayFor(modelItem => item.SoLuong)</td>
            <td><b class="text-danger">@Html.DisplayFor(modelItem => item.ThanhTien)</b></td>
            <td>@Html.DisplayFor(modelItem => item.TrangThai)</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaCthd">Sửa</a> |
                <a asp-action="Details" asp-route-id="@item.MaCthd">Chi tiết</a> |
                <a asp-action="Delete" asp-route-id="@item.MaCthd">Xóa</a>
            </td>
        </tr>
}
    </tbody>
</table>
