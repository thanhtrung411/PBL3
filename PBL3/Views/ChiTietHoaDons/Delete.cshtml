@model PBL3.Models.ChiTietHoaDon

@{
    ViewData["Title"] = "Xóa hạng mục";
}

<h1>Xóa hạng mục</h1>

<h3>Bạn có chắc chắn muốn xóa hạng mục này?</h3>
<div>
    <h4>Hạng mục</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-3">Mã CTHD</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.MaCthd)</dd>
        
        <dt class = "col-sm-3">Mã Hóa đơn</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.MaHoaDon)</dd>

        <dt class = "col-sm-3">Nội dung</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.NoiDung)</dd>

        <dt class = "col-sm-3">THÀNH TIỀN</dt>
        <dd class = "col-sm-9 text-danger">@Html.DisplayFor(model => model.ThanhTien)</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="MaCthd" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="Index">Quay lại danh sách</a>
    </form>
</div>
