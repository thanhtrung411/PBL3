@model PBL3.Models.ChiTietHoaDon

@{
    ViewData["Title"] = "Chi tiết hạng mục";
}

<h1>Chi tiết hạng mục hóa đơn</h1>

<div>
    <h4>Hạng mục</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-3">Mã CTHD</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.MaCthd)</dd>
        
        <dt class = "col-sm-3">Mã Hóa đơn</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.MaHoaDon)</dd>

        <dt class = "col-sm-3">Loại hạng mục</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.LoaiMuc)</dd>
        
        <dt class = "col-sm-3">Phòng</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.MaPhongNavigation.SoPhong)</dd>
        
        <dt class = "col-sm-3">Dịch vụ</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.MaDvNavigation.TenDv)</dd>
        
        <dt class = "col-sm-3">Nội dung</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.NoiDung)</dd>
        
        <dt class = "col-sm-3">Số lượng</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.SoLuong)</dd>

        <dt class = "col-sm-3">Đơn giá</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.DonGia)</dd>

        <dt class = "col-sm-3 font-weight-bold">THÀNH TIỀN</dt>
        <dd class = "col-sm-9 font-weight-bold text-danger">@Html.DisplayFor(model => model.ThanhTien)</dd>
        
        <dt class = "col-sm-3">Trạng thái</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.TrangThai)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.MaCthd">Sửa</a> |
    <a asp-action="Index">Quay lại danh sách</a>
</div>
