@model PBL3.Models.MaGiamGium

@{
    ViewData["Title"] = "Chi tiết mã giảm giá";
}

<h1>Chi tiết mã giảm giá</h1>

<div>
    <h4>Mã Giảm Giá</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">Mã Hệ Thống</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.MaGiamGia)</dd>
        
        <dt class = "col-sm-2">Code</dt>
        <dd class = "col-sm-10"><b>@Html.DisplayFor(model => model.CodeGiamGia)</b></dd>
        
        <dt class = "col-sm-2">Tên</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.TenMaGiamGia)</dd>
        
        <dt class = "col-sm-2">Loại</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.LoaiGiamGia)</dd>
        
        <dt class = "col-sm-2">Mức giảm</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.GiaTriGiam)</dd>

        <dt class = "col-sm-2">Giảm tối đa</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.GiamToiDa)</dd>

        <dt class = "col-sm-2">Phạm vi</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.PhamViApDung)</dd>
        
        <dt class = "col-sm-2">Từ Ngày</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.TuNgay)</dd>
        
        <dt class = "col-sm-2">Đến Ngày</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.DenNgay)</dd>
        
        <dt class = "col-sm-2">Phát hành</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.SoLuongPhatHanh)</dd>
        
        <dt class = "col-sm-2">Đã dùng</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.SoLuongDaDung)</dd>

        <dt class = "col-sm-2">Trạng thái</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.TrangThai)</dd>
        
        <dt class = "col-sm-2">Mô tả</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.MoTa)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.MaGiamGia">Edit</a> |
    <a asp-action="Index">Quay lại danh sách</a>
</div>
