@using System.Text.Json
@model PBL3.Models.AdminDashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tổng quan";
}

<div class="admin-page-header">
    <div>
        <h3 class="admin-page-title">Tổng quan</h3>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card-custom">
            <div class="d-flex justify-content-between align-items-start">
                <div class="card-title-sm">Tổng phòng <i class="bi bi-door-closed ms-2 text-muted"></i></div>
            </div>
            <div class="card-value">@Model.TotalRooms</div>
            <div class="card-title-sm">Tổng số phòng</div>
            <div class="card-subtext">@Model.OperationalRooms phòng đang hoạt động</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom">
            <div class="d-flex justify-content-between align-items-start">
                <div class="card-title-sm">Khách đang ở <i class="bi bi-people ms-2 text-muted"></i></div>
            </div>
            <div class="card-value">89</div>
            <div class="card-title-sm">Phòng đã thuê</div>
            <div class="card-subtext">+3% so với tuần trước</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom">
            <div class="card-title-sm">Doanh thu hôm nay <i class="bi bi-currency-dollar ms-2 text-muted"></i></div>
            <div class="card-value">@Model.TodayRevenue.ToString("N0")đ</div>
            <div class="card-title-sm">Tính đến @Model.GeneratedAt.ToString("HH:mm")</div>
            <div class="card-subtext">Từ hóa đơn đã thanh toán hôm nay</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom">
            <div class="d-flex justify-content-between align-items-start">
                <div class="card-title-sm">Tỷ lệ lấp đầy <i class="bi bi-graph-up ms-2 text-muted"></i></div>
            </div>
            <div class="card-value">@Model.OccupancyRate.ToString("0.#")%</div>
            <div class="card-title-sm">@Model.OccupiedRooms / @Model.OperationalRooms phòng</div>
            <div class="card-subtext">Tính theo phòng đang sử dụng</div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-7">
        <div class="card-custom">
            <div class="card-title-sm mb-3 text-dark fw-bold">Doanh thu 6 tháng gần nhất</div>
            <canvas id="revenueChart" style="max-height: 250px;"></canvas>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card-custom">
            <div class="card-title-sm mb-3 text-dark fw-bold">Tình Trạng Phòng</div>
            <div class="d-flex justify-content-center">
                <canvas id="statusChart" style="max-height: 250px; max-width: 250px;"></canvas>
            </div>
            <div class="d-flex justify-content-center gap-3 mt-3 flex-wrap">
                @foreach (var status in Model.RoomStatuses)
                {
                    <span style="font-size: 0.8rem;"><i class="bi bi-circle-fill @status.LegendClass"></i> @status.Label: @status.Count</span>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-12">
        <div class="card-custom">
            <div class="card-title-sm mb-3 text-dark fw-bold">Danh sách đặt phòng</div>
            <div class="table-responsive">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>Mã đặt phòng</th>
                            <th>Khách hàng</th>
                            <th>Phòng</th>
                            <th>Nhận phòng</th>
                            <th>Số đêm</th>
                            <th>Trạng thái</th>
                            <th>Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentBookings.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted">Chưa có dữ liệu đặt phòng</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var booking in Model.RecentBookings)
                            {
                                <tr>
                                    <td class="fw-bold">@booking.BookingCode</td>
                                    <td>
                                        <div>@booking.CustomerName</div>
                                        <small class="text-muted">@booking.CustomerPhone</small>
                                    </td>
                                    <td>@booking.RoomSummary</td>
                                    <td>@booking.CheckInDate.ToString("dd/MM/yyyy")</td>
                                    <td>@booking.Nights</td>
                                    <td><span class="badge-status @booking.StatusClass">@booking.StatusLabel</span></td>
                                    <td>
                                        <a class="btn-icon-only" asp-controller="BookingManagement" asp-action="Index" title="Xem đặt phòng"><i class="bi bi-eye"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const revenueLabels = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyRevenueLabels));
        const revenueValues = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyRevenueValues));
        const statusLabels = @Html.Raw(JsonSerializer.Serialize(Model.RoomStatuses.Select(x => x.Label)));
        const statusValues = @Html.Raw(JsonSerializer.Serialize(Model.RoomStatuses.Select(x => x.Count)));
        const statusColors = @Html.Raw(JsonSerializer.Serialize(Model.RoomStatuses.Select(x => x.Color)));
        const formatCurrency = value => new Intl.NumberFormat('vi-VN').format(value) + 'đ';

        const ctxRev = document.getElementById('revenueChart').getContext('2d');
        new Chart(ctxRev, {
            type: 'bar',
            data: {
                labels: revenueLabels,
                datasets: [{
                    label: 'Doanh thu',
                    data: revenueValues,
                    backgroundColor: '#4e73df',
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: context => formatCurrency(context.parsed.y)
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: value => formatCurrency(value)
                        }
                    }
                }
            }
        });

        const ctxStatus = document.getElementById('statusChart').getContext('2d');
        new Chart(ctxStatus, {
            type: 'doughnut',
            data: {
                labels: statusLabels,
                datasets: [{
                    data: statusValues,
                    backgroundColor: statusColors,
                    borderWidth: 0,
                    cutout: '75%'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                }
            }
        });
    </script>
}
