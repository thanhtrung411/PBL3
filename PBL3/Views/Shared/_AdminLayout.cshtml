@using System.Security.Claims

@{
    // 1. Lấy thông tin từ User Identity
    var fullName = User.Claims.FirstOrDefault(c => c.Type == "FullName")?.Value ?? User.Identity?.Name ?? "Khách";
    var role = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "Nhân viên";
    var isAdmin = string.Equals(role, "admin", StringComparison.OrdinalIgnoreCase);

    // 2. Tự động lấy 2 chữ cái để làm Avatar (VD: Đỗ Trần Hoài Nhi -> HN)
    var initials = "NV";
    if (!string.IsNullOrWhiteSpace(fullName) && fullName != "Khách")
    {
        var words = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length >= 2)
        {
            initials = $"{words[words.Length - 2][0]}{words[words.Length - 1][0]}".ToUpper();
        }
        else if (words.Length == 1)
        {
            initials = words[0].Substring(0, Math.Min(2, words[0].Length)).ToUpper();
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hotel Manager</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PBL3.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <h2>Hotel Manager</h2>
            <p>Khách sạn Venus</p>
        </div>
        
        <nav class="d-flex flex-column gap-1 flex-grow-1">
            <a class="nav-item-sidebar @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" href="/Admin">
                <i class="bi bi-grid-1x2"></i> Tổng quan
            </a>
            <a class="nav-item-sidebar @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Room" ? "active" : "")" asp-area="" asp-controller="Room" asp-action="Index">
                <i class="bi bi-door-closed"></i> Quản lý phòng
            </a>
            <a class="nav-item-sidebar @(ViewContext.RouteData.Values["Controller"]?.ToString() == "LoaiPhongs" ? "active" : "")" asp-area="" asp-controller="LoaiPhongs" asp-action="Index">
                <i class="bi bi-layers"></i> Loai phong
            </a>
            <a class="nav-item-sidebar @(ViewContext.RouteData.Values["Controller"]?.ToString() == "BookingManagement" ? "active" : "")" asp-area="" asp-controller="BookingManagement" asp-action="Index">
                <i class="bi bi-calendar-check"></i> Đặt phòng
            </a>
            <a class="nav-item-sidebar @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Customer" ? "active" : "")" asp-area="" asp-controller="Customer" asp-action="Index">
                <i class="bi bi-people"></i> Khách hàng
            </a>
            <a class="nav-item-sidebar @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Staff" ? "active" : "")" asp-area="" asp-controller="Staff" asp-action="Index">
                <i class="bi bi-person-badge"></i> Quản lý nhân viên
            </a>
            <a class="nav-item-sidebar @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Report" ? "active" : "")" asp-area="" asp-controller="Report" asp-action="Index">
                <i class="bi bi-bar-chart"></i> Báo cáo
            </a>
            <a class="nav-item-sidebar @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Service" ? "active" : "")" asp-area="" asp-controller="Service" asp-action="Index">
                <i class="bi bi-bell"></i> Quản lí dịch vụ
            </a>
            <a class="nav-item-sidebar @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Invoice" ? "active" : "")" asp-area="" asp-controller="Invoice" asp-action="Index">
                <i class="bi bi-receipt"></i> Hoá đơn
            </a>
            <a class="nav-item-sidebar @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Promotion" ? "active" : "")" asp-area="" asp-controller="Promotion" asp-action="Index">
                <i class="bi bi-tag"></i> Quản lí khuyến mãi
            </a>
        </nav>

        <div class="sidebar-footer mt-auto dropup">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle-user p-2 rounded" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="user-avatar">
                        @initials
                    </div>
                    <div class="user-info ms-2">
                        <div class="user-name">@fullName</div>
                        <div class="user-role">@role</div>
                    </div>
                    <i class="bi bi-chevron-down ms-auto text-dark"></i>
                </a>
                <ul class="dropdown-menu shadow w-100 border-0 mb-1 rounded-3">
                    <li>
                        <a class="dropdown-item py-2 d-flex align-items-center text-dark fw-medium" asp-controller="Account" asp-action="Settings">
                            <i class="bi bi-gear me-3 fs-5"></i> Cài đặt
                        </a>
                    </li>
                    @if (isAdmin)
                    {
                        <li>
                            <a class="dropdown-item py-2 d-flex align-items-center text-dark fw-medium" asp-controller="Receptionist" asp-action="Index">
                                <i class="bi bi-arrow-left-right me-3 fs-5"></i> Sang Lễ tân
                            </a>
                        </li>
                    }
                    <li>
                        <a class="dropdown-item py-2 d-flex align-items-center text-dark fw-medium" asp-controller="Account" asp-action="Logout">
                            <i class="bi bi-box-arrow-right me-3 fs-5"></i> Đăng xuất
                        </a>
                    </li>
                </ul>
            }
        </div>
    </aside>

    <!-- Main Content -->
    <main class="main-wrapper">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
