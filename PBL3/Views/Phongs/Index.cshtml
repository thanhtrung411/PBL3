@model IEnumerable<PBL3.Models.Phong>

@{
    ViewData["Title"] = "Danh sách Phòng";
}

<h1>Danh sách Phòng</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Thêm phòng mới</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MaPhong)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SoPhong)
            </th>
            <th>
                Loại phòng
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tang)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrangThai)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GhiChu)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.MaPhong)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SoPhong)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaLoaiPhongNavigation.TenLoaiPhong)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Tang)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TrangThai)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GhiChu)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaPhong">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaPhong">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaPhong">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
