@using System.Security.Claims
@{
    Layout = null;
    ViewData["Title"] = "Lễ tân";
    var fullName = User.Identity?.Name ?? "Nhân viên";
    var role = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "receptionist";
    var isAdmin = string.Equals(role, "admin", StringComparison.OrdinalIgnoreCase);
    var roleLabel = isAdmin ? "admin" : "lễ tân";
    var initials = "NV";
    if (!string.IsNullOrWhiteSpace(fullName))
    {
        var words = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length >= 2)
        {
            initials = $"{words[^2][0]}{words[^1][0]}".ToUpperInvariant();
        }
        else if (words.Length == 1)
        {
            initials = words[0][..Math.Min(2, words[0].Length)].ToUpperInvariant();
        }
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lễ tân - Venus Hotel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/receptionist-demo.css" asp-append-version="true" />
</head>
<body>
    <div class="reception-shell">
        <aside class="reception-sidebar">
            <div class="brand-block">
                <span class="brand-mark">VH</span>
                <div>
                    <strong>Venus Hotel</strong>
                    <small>Reception Desk</small>
                </div>
            </div>

            <nav class="feature-nav" aria-label="Chức năng lễ tân">
                <button type="button" class="feature-nav-item active" id="checkInNavBtn">
                    <i class="bi bi-qr-code-scan"></i>
                    <span>Check-in</span>
                </button>
                <button type="button" class="feature-nav-item" id="walkInNavBtn">
                    <i class="bi bi-person-plus"></i>
                    <span>Khách vãng lai</span>
                </button>
                <button type="button" class="feature-nav-item" id="todayArrivalsNavBtn">
                    <i class="bi bi-calendar2-check"></i>
                    <span>Khách đến hôm nay</span>
                    <span class="badge rounded-pill bg-danger ms-auto" id="todayArrivalsBadge" style="display:none">0</span>
                </button>
                <button type="button" class="feature-nav-item" id="roomMapNavBtn">
                    <i class="bi bi-door-open"></i>
                    <span>Sơ đồ phòng</span>
                </button>
                <button type="button" class="feature-nav-item" id="serviceUsageNavBtn">
                    <i class="bi bi-cup-hot"></i>
                    <span>Sử dụng dịch vụ</span>
                </button>
                <button type="button" class="feature-nav-item" id="checkoutNavBtn">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Check-out</span>
                    <span class="badge rounded-pill bg-danger ms-auto" id="checkoutBadge" style="display:none">0</span>
                </button>
            </nav>

            <div class="reception-sidebar-footer dropdown dropup">
                <button class="reception-user-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="reception-user-avatar">@initials</span>
                    <span class="reception-user-text">
                        <strong>@fullName</strong>
                        <small>@roleLabel</small>
                    </span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <ul class="dropdown-menu reception-user-menu shadow border-0 rounded-3">
                    <li>
                        <a class="dropdown-item" href="@Url.Action("Settings", "Account")">
                            <i class="bi bi-gear"></i>
                            Cài đặt
                        </a>
                    </li>
                    @if (isAdmin)
                    {
                        <li>
                            <a class="dropdown-item" href="@Url.Action("Index", "Home")">
                                <i class="bi bi-arrow-left-right"></i>
                                Sang Admin
                            </a>
                        </li>
                    }
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item text-danger" href="@Url.Action("Logout", "Account")">
                            <i class="bi bi-box-arrow-left"></i>
                            Đăng xuất
                        </a>
                    </li>
                </ul>
            </div>
        </aside>

        <main class="reception-main">
            <header class="reception-header">
                <div>
                    <h1 id="receptionHeaderTitle">Check-in khách đặt phòng</h1>
                </div>
                <div class="header-status">
                    <i class="bi bi-shield-check"></i>
                </div>
                <button type="button" class="btn btn-outline-secondary header-refresh" id="refreshCheckInBtn">
                    <i class="bi bi-arrow-clockwise"></i>
                    Làm mới
                </button>
            </header>

            <section class="workflow-strip" aria-label="Tiến trình check-in">
                <button type="button" class="workflow-step active" data-step-indicator="scan">
                    <span>1</span>
                    <strong>Quét mã</strong>
                </button>
                <button type="button" class="workflow-step" data-step-indicator="details">
                    <span>2</span>
                    <strong>Thông tin</strong>
                </button>
                <button type="button" class="workflow-step" data-step-indicator="rooms">
                    <span>3</span>
                    <strong>Chọn phòng</strong>
                </button>
                <button type="button" class="workflow-step" data-step-indicator="confirm">
                    <span>4</span>
                    <strong>Xác nhận</strong>
                </button>
                <button type="button" class="workflow-step" data-step-indicator="done">
                    <span>5</span>
                    <strong>Hoàn tất</strong>
                </button>
            </section>

            <div class="alert-area" id="alertArea" aria-live="polite"></div>

            <section class="reception-panel" data-step-panel="walkIn">
                <div class="walkin-flow">
                        <form id="walkInForm" class="service-form walkin-form" data-walkin-view="info">
                            <div>
                                <h3>Thông tin khách</h3>
                            </div>
                            <div class="walkin-field">
                                <label for="walkInCustomerName">Họ và tên</label>
                                <input id="walkInCustomerName" class="form-control" autocomplete="off" placeholder="Nguyễn Văn A" />
                            </div>
                            <div class="walkin-field">
                                <label for="walkInPhone">Số điện thoại</label>
                                <input id="walkInPhone" class="form-control" autocomplete="off" />
                            </div>
                            <div class="walkin-field">
                                <label for="walkInIdentity">CCCD/Hộ chiếu</label>
                                <input id="walkInIdentity" class="form-control" autocomplete="off" />
                            </div>
                            <div class="walkin-field">
                                <label for="walkInGuestCount">Số khách</label>
                                <input id="walkInGuestCount" class="form-control" type="number" min="1" step="1" value="1" />
                            </div>
                            <div class="walkin-field">
                                <label for="walkInCheckinDate">Ngày nhận phòng</label>
                                <input id="walkInCheckinDate" class="form-control" type="date" />
                            </div>
                            <div class="walkin-field">
                                <label for="walkInCheckoutDate">Ngày trả phòng</label>
                                <input id="walkInCheckoutDate" class="form-control" type="date" />
                            </div>
                            <div class="walkin-field walkin-span-2">
                                <label for="walkInNote">Ghi chú</label>
                                <textarea id="walkInNote" class="form-control" rows="2" placeholder="Yêu cầu đặc biệt hoặc ghi chú nội bộ"></textarea>
                            </div>
                            <button type="button" class="btn btn-primary walkin-span-2" id="walkInLoadRoomsBtn">
                                Tiếp tục chọn phòng
                                <i class="bi bi-arrow-right"></i>
                            </button>
                        </form>

                        <div class="checkout-detail-panel walkin-room-panel" data-walkin-view="rooms" hidden>
                            <div class="panel-heading room-heading">
                                <div>
                                    <h3>Chọn phòng</h3>
                                </div>
                                <div class="legend">
                                    <span><i class="legend-dot available"></i>Trống</span>
                                    <span><i class="legend-dot selected"></i>Đang chọn</span>
                                    <span><i class="legend-dot reserved"></i>Hết lượt chọn</span>
                                </div>
                            </div>
                            <div class="walkin-booking-panel compact">
                                <div class="walkin-guest-summary" id="walkInGuestSummary"></div>
                                <button type="button" class="btn btn-outline-secondary walkin-edit-btn" id="walkInEditGuestBtn">
                                    <i class="bi bi-pencil-square"></i>
                                    Sửa thông tin
                                </button>
                            </div>
                            <div id="walkInRoomSummary" class="checkout-detail-empty">Nhập ngày trả phòng để tải phòng trống.</div>
                            <div id="walkInRoomGroups" class="room-groups"></div>
                            <div class="walkin-selection-bar">
                                <div>
                                    <strong><span id="walkInSelectedCount">0</span> phòng đã chọn</strong>
                                    <div id="walkInSelectedTypes" class="walkin-selected-types">Chưa chọn phòng</div>
                                    <span>Đáp ứng <span id="walkInSelectedCapacity">0</span> khách · <span id="walkInStayNights">0</span> đêm · <span id="walkInTotalAmount">0đ</span></span>
                                </div>
                                <button type="button" class="btn btn-primary" id="walkInGoPaymentBtn" disabled>Thanh toán</button>
                            </div>
                        </div>

                        <div class="checkout-detail-panel walkin-payment-panel" data-walkin-view="payment" hidden>
                            <div class="walkin-payment-heading">
                                <h3>Thanh toán</h3>
                            </div>
                            <div class="walkin-payment-overview">
                                <div class="walkin-payment-due-card">
                                    <span>Cần thanh toán</span>
                                    <strong id="walkInPaymentDue">0đ</strong>
                                    <small>Tổng tiền phòng cho các phòng đã chọn.</small>
                                </div>
                                <div class="walkin-payment-method-card">
                                    <h4>Phương thức thanh toán</h4>
                                    <div class="walkin-payment-options">
                                        <label class="walkin-payment-option">
                                            <input type="radio" name="walkInPaymentChoice" value="cash" checked />
                                            <span>
                                                <strong>Tiền mặt</strong>
                                                <small>Nhập số tiền khách đưa và kiểm tra tiền thối.</small>
                                            </span>
                                        </label>
                                        <label class="walkin-payment-option">
                                            <input type="radio" name="walkInPaymentChoice" value="vnpay" />
                                            <span>
                                                <strong>VNPay</strong>
                                                <small>Giữ phòng đã chọn và chuyển sang cổng VNPay.</small>
                                            </span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <input id="walkInPaymentMethod" type="hidden" value="Tiền mặt" />
                            <div class="walkin-cash-box" id="walkInCashBox">
                                <div class="walkin-payment-field">
                                    <label for="walkInPaymentAmount">Số tiền khách đưa</label>
                                    <input id="walkInPaymentAmount" class="form-control" type="text" inputmode="numeric" autocomplete="off" value="0" />
                                </div>
                                <div class="checkout-total-box walkin-change-box">
                                    <div class="checkout-money-row strong"><span>Tiền thối</span><strong id="walkInChangeAmount">0đ</strong></div>
                                </div>
                            </div>
                            <div class="action-row">
                                <button type="button" class="btn btn-outline-secondary" data-walkin-back="rooms">Quay lại</button>
                                <button type="button" class="btn btn-primary" id="walkInReviewBtn">Xem xác nhận</button>
                            </div>
                        </div>

                        <div class="checkout-detail-panel walkin-confirm-panel" data-walkin-view="confirm" hidden>
                            <div>
                                <h3>Xác nhận check-in</h3>
                            </div>
                            <div id="walkInConfirmSummary" class="walkin-confirm-summary"></div>
                            <div class="action-row">
                                <button type="button" class="btn btn-outline-secondary" data-walkin-back="payment">Quay lại</button>
                                <button type="button" class="btn btn-success" id="walkInConfirmBtn" disabled>
                                    <i class="bi bi-check2-circle"></i>
                                    Hoàn tất
                                </button>
                            </div>
                        </div>

                        <div class="success-panel walkin-done-panel" data-walkin-view="done" hidden>
                            <i class="bi bi-check2-circle"></i>
                            <h2>Hoàn tất check-in vãng lai</h2>
                            <p id="walkInDoneMessage">Check-in khách vãng lai thành công.</p>
                            <div id="walkInDoneRooms" class="walkin-done-summary"></div>
                            <button type="button" class="btn btn-primary" id="walkInNewBtn">
                                Check-in khách mới
                            </button>
                        </div>
                    </div>
            </section>

            <section class="reception-panel" data-step-panel="today">
                <div class="tool-panel">
                    <div class="panel-heading room-heading">
                        <div>
                            <h2>Khách đến hôm nay</h2>
                        </div>
                        <div class="today-summary" id="todayArrivalsSummary">Đang tải...</div>
                    </div>
                    <div id="todayArrivalsList" class="arrival-list"></div>
                </div>
            </section>

            <section class="reception-panel" data-step-panel="roomMap">
                <div class="tool-panel">
                    <div class="panel-heading room-heading">
                        <div>
                            <h2>Sơ đồ phòng</h2>
                        </div>
                        <button type="button" class="btn btn-outline-secondary" id="roomMapRefreshBtn">
                            <i class="bi bi-arrow-clockwise"></i>
                            Cập nhật
                        </button>
                    </div>
                    <div class="room-map-toolbar">
                        <div id="roomMapSummary" class="room-map-summary"></div>
                        <div class="room-map-controls">
                            <label class="room-map-type-filter" for="roomMapTypeFilter">
                                <span>Loại phòng</span>
                                <select id="roomMapTypeFilter" class="form-select form-select-sm">
                                    <option value="all">Tất cả</option>
                                </select>
                            </label>
                            <div class="room-map-filters" role="group" aria-label="Lọc trạng thái phòng">
                                <button type="button" class="active" data-room-map-filter="all">Tất cả</button>
                                <button type="button" data-room-map-filter="available">Trống</button>
                                <button type="button" data-room-map-filter="occupied">Đang sử dụng</button>
                                <button type="button" data-room-map-filter="maintenance">Bảo trì</button>
                            </div>
                        </div>
                    </div>
                    <div id="roomMapFloors" class="room-map-floors"></div>
                    <div id="roomMapDetailModal" class="room-map-modal" hidden>
                        <div class="room-map-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="roomMapDetailTitle">
                            <div class="room-map-modal-header">
                                <h3 id="roomMapDetailTitle">Chi tiết phòng</h3>
                                <button type="button" class="room-map-modal-close" id="roomMapDetailClose" aria-label="Đóng">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                            <div id="roomMapDetailBody" class="room-map-modal-body"></div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="reception-panel" data-step-panel="services">
                <div class="tool-panel">
                    <div class="panel-heading room-heading">
                        <div>
                            <h2>Sử dụng dịch vụ</h2>
                        </div>
                        <button type="button" class="btn btn-outline-secondary" id="serviceUsageRefreshBtn">
                            <i class="bi bi-arrow-clockwise"></i>
                            Cập nhật
                        </button>
                    </div>

                    <div class="service-usage-grid service-usage-form-only">
                        <form id="serviceUsageForm" class="service-form service-entry-form">
                            <div>
                                <h3>Ghi nhận dịch vụ</h3>
                            </div>
                            <div id="serviceSelectedStayInfo" class="service-selected-box"></div>
                            <label for="serviceBookingSelect">Khách / phòng / booking</label>
                            <select id="serviceBookingSelect" class="form-select" placeholder="Tìm theo tên khách, phòng hoặc mã đặt phòng"></select>

                            <label for="serviceOptionSelect">Dịch vụ</label>
                            <select id="serviceOptionSelect" class="form-select" placeholder="Tìm theo tên dịch vụ hoặc loại dịch vụ"></select>
                            <div id="serviceSelectedServiceInfo" class="service-selected-box service-selected-box-muted"></div>

                            <div class="service-form-row">
                                <div>
                                    <label for="serviceQuantityInput">Số lượng</label>
                                    <input id="serviceQuantityInput" class="form-control" type="number" min="1" step="1" value="1" />
                                </div>
                                <div>
                                    <label>Tạm tính</label>
                                    <output id="serviceLineEstimate" class="service-estimate">0đ</output>
                                </div>
                            </div>

                            <label for="serviceNoteInput">Ghi chú</label>
                            <textarea id="serviceNoteInput" class="form-control" rows="3" placeholder="Ví dụ: giao tại phòng, thanh toán khi trả phòng"></textarea>

                            <button type="submit" class="btn btn-primary btn-lg" id="addServiceUsageBtn">
                                <i class="bi bi-plus-circle"></i>
                                Thêm vào hóa đơn
                            </button>
                        </form>
                    </div>
                </div>
            </section>

            <section class="reception-panel" data-step-panel="checkout">
                <div class="tool-panel">
                    <div class="panel-heading room-heading">
                        <div>
                            <h2>Check-out khách lưu trú</h2>
                        </div>
                        <button type="button" class="btn btn-outline-secondary" id="checkoutRefreshBtn">
                            <i class="bi bi-arrow-clockwise"></i>
                            Cập nhật
                        </button>
                    </div>

                    <div class="checkout-grid">
                        <div class="checkout-list-panel" id="checkoutListPanel">
                            <div class="service-section-title">
                                <strong>Khách đang ở</strong>
                                <span id="checkoutSummary">Đang tải...</span>
                            </div>
                            <div class="checkout-toolbar">
                                <div class="checkout-search-field">
                                    <i class="bi bi-search"></i>
                                    <input id="checkoutSearchInput" class="form-control form-control-lg" autocomplete="off" placeholder="Tìm theo tên khách, phòng, mã đặt phòng..." />
                                </div>
                                <div class="checkout-control">
                                    <label for="checkoutScopeSelect">Hiển thị</label>
                                    <select id="checkoutScopeSelect" class="form-select form-select-lg">
                                        <option value="today" selected>Trả hôm nay</option>
                                        <option value="all">Tất cả</option>
                                    </select>
                                </div>
                                <div class="checkout-control">
                                    <label for="checkoutSortSelect">Sắp xếp</label>
                                    <select id="checkoutSortSelect" class="form-select form-select-lg">
                                        <option value="checkoutDateAsc" selected>Ngày trả gần nhất</option>
                                        <option value="checkoutDateDesc">Ngày trả xa nhất</option>
                                        <option value="roomAsc">Số phòng</option>
                                        <option value="nameAsc">Tên A-Z</option>
                                        <option value="remainingDesc">Còn thu cao nhất</option>
                                    </select>
                                </div>
                            </div>
                            <div id="checkoutStayList" class="service-stay-list"></div>
                        </div>

                        <div class="checkout-detail-panel" id="checkoutDetailPanel" hidden>
                            <div class="checkout-payment-head">
                                <button type="button" class="btn btn-outline-secondary" id="checkoutBackToListBtn">
                                    <i class="bi bi-arrow-left"></i>
                                    Khách đang ở
                                </button>
                                <h3>Thanh toán trả phòng</h3>
                            </div>
                            <div class="checkout-payment-grid">
                                <div class="checkout-invoice-side">
                                    <div id="checkoutDetail" class="checkout-detail-empty">Chọn một khách để xem hóa đơn.</div>
                                </div>

                                <div class="checkout-money-side">
                                    <div id="checkoutMoneySummary" class="checkout-total-box"></div>

                                    <form id="checkoutPaymentForm" class="checkout-payment-form">
                                        <input type="hidden" id="checkoutBookingCode" />

                                        <label for="checkoutPaymentAmount">Số tiền thu thêm</label>
                                        <input id="checkoutPaymentAmount" class="form-control form-control-lg" type="text" inputmode="numeric" autocomplete="off" value="0" />

                                        <label for="checkoutPaymentMethod">Phương thức</label>
                                        <select id="checkoutPaymentMethod" class="form-select form-select-lg">
                                            <option value="Tiền mặt">Tiền mặt</option>
                                            <option value="VNPAY">VNPAY</option>
                                        </select>

                                        <label for="checkoutNote">Ghi chú</label>
                                        <textarea id="checkoutNote" class="form-control" rows="3" placeholder="Ví dụ: khách đã kiểm tra minibar, phòng ổn"></textarea>

                                        <div class="checkout-receipt-options">
                                            <label class="checkout-receipt-option" for="checkoutSendEmail">
                                                <input id="checkoutSendEmail" type="checkbox" checked />
                                                <span>Gửi hóa đơn qua mail</span>
                                            </label>
                                            <label class="checkout-receipt-option" for="checkoutPrintInvoice">
                                                <input id="checkoutPrintInvoice" type="checkbox" checked />
                                                <span>In hóa đơn</span>
                                            </label>
                                        </div>

                                        <div class="checkout-email-field">
                                            <label for="checkoutReceiptEmail">Email nhận hóa đơn</label>
                                            <input id="checkoutReceiptEmail" class="form-control" type="email" placeholder="example@email.com" autocomplete="email" />
                                        </div>

                                        <button type="submit" class="btn btn-success btn-lg" id="confirmCheckoutBtn" disabled>
                                            <i class="bi bi-check2-circle"></i>
                                            Xác nhận check-out
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <div class="checkout-result-panel" id="checkoutPaymentResultPanel" hidden>
                            <div class="checkout-result-icon" id="checkoutPaymentResultIcon">
                                <i class="bi bi-check2"></i>
                            </div>
                            <h3 id="checkoutPaymentResultTitle">Thanh toán VNPay check-out</h3>
                            <p id="checkoutPaymentResultMessage">Đang cập nhật kết quả thanh toán.</p>
                            <div class="checkout-result-details">
                                <div>
                                    <span>Mã đặt phòng</span>
                                    <strong id="checkoutPaymentResultBooking">-</strong>
                                </div>
                                <div>
                                    <span>Số tiền</span>
                                    <strong id="checkoutPaymentResultAmount">0đ</strong>
                                </div>
                                <div>
                                    <span>Mã giao dịch</span>
                                    <strong id="checkoutPaymentResultTransaction">Chưa có</strong>
                                </div>
                                <div>
                                    <span>Ngân hàng</span>
                                    <strong id="checkoutPaymentResultBank">Chưa có</strong>
                                </div>
                            </div>
                            <div class="checkout-result-actions">
                                <button type="button" class="btn btn-dark" id="checkoutResultBackBtn">
                                    <i class="bi bi-arrow-left"></i>
                                    Khách đang ở
                                </button>
                                <button type="button" class="btn btn-outline-secondary" id="checkoutResultRefreshBtn">
                                    <i class="bi bi-arrow-clockwise"></i>
                                    Cập nhật check-out
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="reception-panel active" data-step-panel="scan">
                <div class="scan-grid">
                    <div class="tool-panel checkin-scan-card">
                        <div class="panel-heading">
                            <div>
                                <h2>Quét mã đặt phòng</h2>
                            </div>
                            <i class="bi bi-camera"></i>
                        </div>
                        <div class="scanner-frame">
                            <div id="qrReader" class="qr-reader"></div>
                            <div class="scanner-placeholder" id="scannerPlaceholder">
                                <i class="bi bi-qr-code"></i>
                                <span>Camera sẽ hiển thị tại đây</span>
                            </div>
                        </div>
                        <div class="action-row">
                            <button type="button" class="btn btn-dark" id="startScannerBtn">
                                <i class="bi bi-camera-video"></i>
                                Mở camera
                            </button>
                            <button type="button" class="btn btn-outline-secondary" id="stopScannerBtn" disabled>
                                <i class="bi bi-camera-video-off"></i>
                                Tắt camera
                            </button>
                        </div>
                    </div>

                    <div class="tool-panel checkin-lookup-card">
                        <div class="panel-heading">
                            <div>
                                <h2>Nhập mã đặt phòng</h2>
                            </div>
                            <i class="bi bi-keyboard"></i>
                        </div>
                        <form id="manualLookupForm" class="manual-form">
                            <label for="bookingCodeInput">Mã đặt phòng</label>
                            <input id="bookingCodeInput" class="form-control form-control-lg" autocomplete="off" placeholder="DP00000019" />
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-search"></i>
                                Kiểm tra
                            </button>
                        </form>
                    </div>
                </div>
            </section>

            <section class="reception-panel" data-step-panel="details">
                <div class="section-grid">
                    <div class="tool-panel checkin-info-card">
                        <div class="panel-heading">
                            <div>
                                <h2>Thông tin khách</h2>
                            </div>
                            <i class="bi bi-person-vcard"></i>
                        </div>
                        <div id="guestDetails" class="details-list"></div>
                    </div>

                    <div class="tool-panel checkin-info-card">
                        <div class="panel-heading">
                            <div>
                                <h2>Thông tin đặt phòng</h2>
                            </div>
                            <i class="bi bi-receipt"></i>
                        </div>
                        <div id="bookingDetails" class="details-list"></div>
                        <div id="roomRequirements" class="requirement-list"></div>
                    </div>
                </div>
                <div class="footer-actions">
                    <button type="button" class="btn btn-outline-secondary" data-back-step="scan">
                        <i class="bi bi-arrow-left"></i>
                        Quay lại
                    </button>
                    <button type="button" class="btn btn-primary" id="continueToRoomsBtn">
                        Tiếp tục chọn phòng
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </section>

            <section class="reception-panel" data-step-panel="rooms">
                <div class="tool-panel">
                    <div class="panel-heading room-heading">
                        <div>
                            <h2>Chọn phòng theo loại đã đặt</h2>
                        </div>
                        <div class="legend">
                            <span><i class="legend-dot available"></i>Trống</span>
                            <span><i class="legend-dot selected"></i>Đang chọn</span>
                            <span><i class="legend-dot blocked"></i>Không khả dụng</span>
                        </div>
                    </div>
                    <div id="roomGroups" class="room-groups"></div>
                </div>
                <div class="footer-actions">
                    <button type="button" class="btn btn-outline-secondary" data-back-step="details">
                        <i class="bi bi-arrow-left"></i>
                        Quay lại
                    </button>
                    <button type="button" class="btn btn-primary" id="continueToConfirmBtn" disabled>
                        Kiểm tra lại
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </section>

            <section class="reception-panel" data-step-panel="confirm">
                <div class="section-grid">
                    <div class="tool-panel checkin-info-card">
                        <div class="panel-heading">
                            <div>
                                <h2>Xác nhận trước check-in</h2>
                            </div>
                            <i class="bi bi-clipboard-check"></i>
                        </div>
                        <div id="confirmDetails" class="confirm-list"></div>
                    </div>
                    <div class="tool-panel checkin-info-card">
                        <div class="panel-heading">
                            <div>
                                <h2>Phòng sẽ giao khách</h2>
                            </div>
                            <i class="bi bi-door-open"></i>
                        </div>
                        <div id="confirmRooms" class="selected-room-list"></div>
                    </div>
                </div>
                <div class="footer-actions">
                    <button type="button" class="btn btn-outline-secondary" data-back-step="rooms">
                        <i class="bi bi-arrow-left"></i>
                        Chọn lại phòng
                    </button>
                    <button type="button" class="btn btn-success" id="confirmCheckInBtn">
                        <i class="bi bi-check2-circle"></i>
                        Xác nhận check-in
                    </button>
                </div>
            </section>

            <section class="reception-panel" data-step-panel="done">
                <div class="success-panel">
                    <i class="bi bi-check-circle-fill"></i>
                    <h2>Check-in thành công</h2>
                    <p id="successMessage">Khách đã được nhận phòng.</p>
                    <div id="assignedRooms" class="selected-room-list compact"></div>
                    <button type="button" class="btn btn-dark" id="newCheckInBtn">
                        <i class="bi bi-plus-circle"></i>
                        Check-in lượt mới
                    </button>
                </div>
            </section>
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/html5-qrcode" referrerpolicy="no-referrer"></script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script src="~/js/receptionist-demo.js" asp-append-version="true"></script>
</body>
</html>
