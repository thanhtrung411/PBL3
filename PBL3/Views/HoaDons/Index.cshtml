@model IEnumerable<PBL3.Models.HoaDon>

@{
    ViewData["Title"] = "Danh sách Hóa đơn";
}

<h1>Danh sách Hóa đơn</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Tạo mới Hóa đơn</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Mã Hóa Đơn</th>
            <th>Mã Đặt Phòng</th>
            <th>Tổng tiền phòng</th>
            <th>Tổng dịch vụ</th>
            <th>Giảm giá</th>
            <th>Thanh toán</th>
            <th>Đã trả</th>
            <th>Trạng thái</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.MaHoaDon)</td>
            <td>@Html.DisplayFor(modelItem => item.MaDatPhong)</td>
            <td>@Html.DisplayFor(modelItem => item.TongTienPhong)</td>
            <td>@Html.DisplayFor(modelItem => item.TongTienDichVu)</td>
            <td>@Html.DisplayFor(modelItem => item.TienGiamGiaPhong)</td>
            <td><b class="text-danger">@Html.DisplayFor(modelItem => item.TongThanhToan)</b></td>
            <td><b class="text-success">@Html.DisplayFor(modelItem => item.SoTienDaThanhToan)</b></td>
            <td>@Html.DisplayFor(modelItem => item.TrangThai)</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaHoaDon">Sửa</a> |
                <a asp-action="Details" asp-route-id="@item.MaHoaDon">Chi tiết</a> |
                <a asp-action="Delete" asp-route-id="@item.MaHoaDon">Xóa</a>
            </td>
        </tr>
}
    </tbody>
</table>
