@model PBL3.Models.DatPhong

@{
    ViewData["Title"] = "Chi tiết Đặt phòng";
}

<h1>Chi tiết Đặt phòng</h1>

<div>
    <h4>Đặt phòng</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-3">Mã Đặt Phòng</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.MaDatPhong)</dd>
        
        <dt class = "col-sm-3">Khách hàng liên kết</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.MaKhNavigation.HoTen)</dd>

        <dt class = "col-sm-3">Nhân viên tạo</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.MaNvNavigation.HoTen)</dd>
        
        <dt class = "col-sm-3">Ngày lập đơn</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.NgayDat)</dd>
        
        <dt class = "col-sm-3">Thời gian lưu trú</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.NgayNhanPhong) - @Html.DisplayFor(model => model.NgayTraPhong)</dd>
        
        <dt class = "col-sm-3">Trạng thái</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.TrangThai)</dd>
        
        <dt class = "col-sm-3">Thông tin khách (Snapshot)</dt>
        <dd class = "col-sm-9">
            Tên: @Html.DisplayFor(model => model.TenKhSnapshot) <br />
            SĐT: @Html.DisplayFor(model => model.SdtSnapshot) <br />
            CCCD: @Html.DisplayFor(model => model.CccdSnapshot)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.MaDatPhong">Sửa</a> |
    <a asp-action="Index">Quay lại danh sách</a>
</div>
