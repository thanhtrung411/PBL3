@model PBL3.Models.DatPhong

@{
    ViewData["Title"] = "Xóa Đặt phòng";
}

<h1>Xóa Đặt phòng</h1>

<h3>Bạn có chắc chắn muốn xóa đơn đặt phòng này?</h3>
<div>
    <h4>Đặt phòng</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-3">Mã Đặt Phòng</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.MaDatPhong)</dd>
        
        <dt class = "col-sm-3">Khách (Snapshot)</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.TenKhSnapshot)</dd>

        <dt class = "col-sm-3">Ngày lập đơn</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.NgayDat)</dd>
        
        <dt class = "col-sm-3">Trạng thái</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.TrangThai)</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="MaDatPhong" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="Index">Quay lại danh sách</a>
    </form>
</div>
