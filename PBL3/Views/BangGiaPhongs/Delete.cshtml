@model PBL3.Models.BangGiaPhong

@{
    ViewData["Title"] = "Xóa Bảng giá phòng";
}

<h1>Xóa Bảng giá phòng</h1>

<h3>Bạn có chắc chắn muốn xóa bảng giá phòng này?</h3>
<div>
    <h4>Bảng giá phòng</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">Mã Bảng Giá</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.MaBangGia)</dd>
        
        <dt class = "col-sm-2">Loại phòng</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.MaLoaiPhongNavigation.TenLoaiPhong)</dd>

        <dt class = "col-sm-2">Giá áp dụng</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.GiaApDung)</dd>
        
        <dt class = "col-sm-2">Trạng thái</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.TrangThai)</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="MaBangGia" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="Index">Quay lại danh sách</a>
    </form>
</div>
