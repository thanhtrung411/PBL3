@model PBL3.Models.MaGiamGium

@{
    ViewData["Title"] = "Thêm mã giảm giá";
}

<h1>Thêm mã giảm giá mới</h1>

<h4>Mã Giảm Giá</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group">
                <label asp-for="MaGiamGia" class="control-label">Mã hệ thống</label>
                <input asp-for="MaGiamGia" class="form-control" />
                <span asp-validation-for="MaGiamGia" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="CodeGiamGia" class="control-label">Code giảm giá (Vd: SUMMER2026)</label>
                <input asp-for="CodeGiamGia" class="form-control" />
                <span asp-validation-for="CodeGiamGia" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="TenMaGiamGia" class="control-label">Tên chương trình</label>
                <input asp-for="TenMaGiamGia" class="form-control" />
                <span asp-validation-for="TenMaGiamGia" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="LoaiGiamGia" class="control-label">Loại giảm giá</label>
                <select asp-for="LoaiGiamGia" class="form-control">
                    <option value="PHANTRAM">Phần trăm (%)</option>
                    <option value="TIENMAT">Tiền mặt (VNĐ)</option>
                </select>
                <span asp-validation-for="LoaiGiamGia" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="GiaTriGiam" class="control-label">Giá trị giảm</label>
                <input asp-for="GiaTriGiam" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="GiaTriGiam" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="HoaDonToiThieu" class="control-label">Hóa đơn tối thiểu</label>
                <input asp-for="HoaDonToiThieu" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="HoaDonToiThieu" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="GiamToiDa" class="control-label">Giảm tối đa (để trống nếu không giới hạn)</label>
                <input asp-for="GiamToiDa" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="GiamToiDa" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PhamViApDung" class="control-label">Phạm vi áp dụng</label>
                <select asp-for="PhamViApDung" class="form-control">
                    <option value="PHONG">Chỉ phòng</option>
                    <option value="DICHVU">Chỉ dịch vụ</option>
                </select>
                <span asp-validation-for="PhamViApDung" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TuNgay" class="control-label">Từ ngày</label>
                <input asp-for="TuNgay" type="date" class="form-control" />
                <span asp-validation-for="TuNgay" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DenNgay" class="control-label">Đến ngày</label>
                <input asp-for="DenNgay" type="date" class="form-control" />
                <span asp-validation-for="DenNgay" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SoLuongPhatHanh" class="control-label">Số lượng phát hành</label>
                <input asp-for="SoLuongPhatHanh" type="number" class="form-control" />
                <span asp-validation-for="SoLuongPhatHanh" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TrangThai" class="control-label">Trạng thái</label>
                <select asp-for="TrangThai" class="form-control">
                    <option value="Hoạt động">Hoạt động</option>
                    <option value="Tạm khóa">Tạm khóa</option>
                    <option value="Hết lượt">Hết lượt</option>
                    <option value="Hết hạn">Hết hạn</option>
                </select>
                <span asp-validation-for="TrangThai" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MoTa" class="control-label">Mô tả</label>
                <textarea asp-for="MoTa" class="form-control" rows="2"></textarea>
                <span asp-validation-for="MoTa" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="GhiChu" class="control-label">Ghi chú</label>
                <input asp-for="GhiChu" class="form-control" />
                <span asp-validation-for="GhiChu" class="text-danger"></span>
            </div>
            
            <div class="form-group mt-3">
                <input type="submit" value="Tạo mới" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Quay lại danh sách</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
