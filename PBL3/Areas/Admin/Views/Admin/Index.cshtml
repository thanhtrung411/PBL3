@{
    ViewData["Title"] = "Tổng quan Source CRUD";

    var groups = new[]
    {
        new
        {
            Title = "Phòng và giá",
            Description = "Quản lý loại phòng, phòng và bảng giá áp dụng.",
            Icon = "bi-door-closed",
            Accent = "text-primary",
            Links = new[]
            {
                new { Text = "Phòng", Controller = "Phongs", Icon = "bi-door-closed" },
                new { Text = "Loại phòng", Controller = "LoaiPhongs", Icon = "bi-layers" },
                new { Text = "Bảng giá phòng", Controller = "BangGiaPhongs", Icon = "bi-tags" }
            }
        },
        new
        {
            Title = "Đặt phòng và hóa đơn",
            Description = "Theo dõi phiếu đặt, hóa đơn và chi tiết tính tiền.",
            Icon = "bi-receipt",
            Accent = "text-success",
            Links = new[]
            {
                new { Text = "Đặt phòng", Controller = "DatPhongs", Icon = "bi-calendar-check" },
                new { Text = "Hóa đơn", Controller = "HoaDons", Icon = "bi-receipt" },
                new { Text = "Chi tiết hóa đơn", Controller = "ChiTietHoaDons", Icon = "bi-list-check" }
            }
        },
        new
        {
            Title = "Khách hàng và dịch vụ",
            Description = "Quản lý hồ sơ khách, dịch vụ và mã ưu đãi.",
            Icon = "bi-people",
            Accent = "text-info",
            Links = new[]
            {
                new { Text = "Khách hàng", Controller = "KhachHangs", Icon = "bi-people" },
                new { Text = "Dịch vụ", Controller = "DichVus", Icon = "bi-bell" },
                new { Text = "Mã giảm giá", Controller = "MaGiamGias", Icon = "bi-ticket-perforated" },
                new { Text = "Link ảnh", Controller = "LinkAnhs", Icon = "bi-images" }
            }
        },
        new
        {
            Title = "Nhân sự và phân quyền",
            Description = "Quản lý nhân viên, tài khoản đăng nhập và vai trò.",
            Icon = "bi-shield-check",
            Accent = "text-warning",
            Links = new[]
            {
                new { Text = "Nhân viên", Controller = "NhanViens", Icon = "bi-person-badge" },
                new { Text = "Tài khoản", Controller = "TaiKhoans", Icon = "bi-person-lock" },
                new { Text = "Vai trò", Controller = "VaiTros", Icon = "bi-shield-check" }
            }
        }
    };
}

<div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-4">
    <div>
        <div class="text-uppercase text-muted fw-bold small mb-2">Source CRUD</div>
        <h1 class="h3 fw-bold mb-2">Tổng quan dữ liệu hệ thống</h1>
        <p class="text-muted mb-0">Chọn một nhóm bên dưới hoặc dùng menu bên trái để quản lý dữ liệu khách sạn.</p>
    </div>
    <a class="btn btn-dark d-inline-flex align-items-center gap-2" asp-area="" asp-controller="Booking" asp-action="Index">
        <i class="bi bi-arrow-left"></i>
        Về trang khách
    </a>
</div>

<div class="row g-4">
    @foreach (var group in groups)
    {
        <div class="col-12 col-xl-6">
            <section class="card-custom">
                <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
                    <div>
                        <div class="card-title-sm text-uppercase">@group.Title</div>
                        <h2 class="h5 fw-bold mb-2">@group.Description</h2>
                    </div>
                    <i class="bi @group.Icon @group.Accent fs-1"></i>
                </div>

                <div class="d-grid gap-2">
                    @foreach (var link in group.Links)
                    {
                        <a class="btn btn-light border d-flex align-items-center justify-content-between text-start"
                           asp-area="Admin"
                           asp-controller="@link.Controller"
                           asp-action="Index">
                            <span class="d-inline-flex align-items-center gap-2 fw-semibold">
                                <i class="bi @link.Icon"></i>
                                @link.Text
                            </span>
                            <i class="bi bi-chevron-right text-muted"></i>
                        </a>
                    }
                </div>
            </section>
        </div>
    }
</div>
