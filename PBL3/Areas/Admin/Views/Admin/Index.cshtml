@{
    ViewData["Title"] = "Tổng quan Quản trị";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <h1 class="h3 mb-4 text-gray-800">Dashboard Quản Trị</h1>
            <p class="lead">Chào mừng bạn đến với khu vực Quản trị hệ thống Khách sạn.</p>
            <p>Vui lòng chọn chức năng ở thanh điều hướng bên trái để quản lý dữ liệu hệ thống.</p>
        </div>
    </div>
    
    <div class="row mt-4">
        <!-- Card 1 -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Quản lý Phòng</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">Cơ sở vật chất</div>
                        </div>
                        <div class="col-auto">
                            <i class="fa-solid fa-bed fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2 -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Đặt phòng & Hóa đơn</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">Giao dịch</div>
                        </div>
                        <div class="col-auto">
                            <i class="fa-solid fa-dollar-sign fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3 -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Khách hàng
                            </div>
                            <div class="row no-gutters align-items-center">
                                <div class="col-auto">
                                    <div class="h5 mb-0 mr-3 font-weight-bold text-gray-800">Đối tác</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fa-solid fa-users fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4 -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Nhân sự</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">Hệ thống</div>
                        </div>
                        <div class="col-auto">
                            <i class="fa-solid fa-cogs fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
