@model IEnumerable<PBL3.Models.TaiKhoan>

@{
    ViewData["Title"] = "Danh sách Tài khoản";
}

<h1>Danh sách Tài khoản</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Thêm tài khoản mới</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Mã TK</th>
            <th>Tên đăng nhập</th>
            <th>Nhân viên</th>
            <th>Vai trò</th>
            <th>Trạng thái</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.MaTk)</td>
            <td>@Html.DisplayFor(modelItem => item.TenDangNhap)</td>
            <td>@Html.DisplayFor(modelItem => item.MaNvNavigation.HoTen)</td>
            <td>@Html.DisplayFor(modelItem => item.MaVaiTroNavigation.TenVaiTro)</td>
            <td>@Html.DisplayFor(modelItem => item.TrangThai)</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaTk">Sửa</a> |
                <a asp-action="Details" asp-route-id="@item.MaTk">Chi tiết</a> |
                <a asp-action="Delete" asp-route-id="@item.MaTk">Xóa</a>
            </td>
        </tr>
}
    </tbody>
</table>
