@model PBL3.Models.DatPhong

@{
    ViewData["Title"] = "Chỉnh sửa Đặt phòng";
}

<h1>Chỉnh sửa Đặt phòng</h1>

<h4>Đặt Phòng</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MaDatPhong" />
            
            <div class="form-group">
                <label asp-for="MaKh" class="control-label">Khách hàng liên kết</label>
                <select asp-for="MaKh" class="form-control" asp-items="ViewBag.MaKh"></select>
                <span asp-validation-for="MaKh" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaNv" class="control-label">Nhân viên thực hiện</label>
                <select asp-for="MaNv" class="form-control" asp-items="ViewBag.MaNv"></select>
                <span asp-validation-for="MaNv" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TenKhSnapshot" class="control-label">Tên khách (Snapshot)</label>
                <input asp-for="TenKhSnapshot" class="form-control" />
                <span asp-validation-for="TenKhSnapshot" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CccdSnapshot" class="control-label">CCCD (Snapshot)</label>
                <input asp-for="CccdSnapshot" class="form-control" />
                <span asp-validation-for="CccdSnapshot" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SdtSnapshot" class="control-label">SĐT (Snapshot)</label>
                <input asp-for="SdtSnapshot" class="form-control" />
                <span asp-validation-for="SdtSnapshot" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NgayDat" class="control-label">Ngày giờ tạo</label>
                <input asp-for="NgayDat" type="datetime-local" class="form-control" />
                <span asp-validation-for="NgayDat" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NgayNhanPhong" class="control-label">Ngày nhận phòng</label>
                <input asp-for="NgayNhanPhong" type="date" class="form-control" />
                <span asp-validation-for="NgayNhanPhong" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NgayTraPhong" class="control-label">Ngày trả phòng (dự kiến)</label>
                <input asp-for="NgayTraPhong" type="date" class="form-control" />
                <span asp-validation-for="NgayTraPhong" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TrangThai" class="control-label">Trạng thái</label>
                <select asp-for="TrangThai" class="form-control">
                    <option value="GIU_CHO">Giữ chỗ</option>
                    <option value="DA_DAT_COC">Đã đặt cọc</option>
                    <option value="NHAN_PHONG">Nhận phòng</option>
                    <option value="TRA_PHONG">Trả phòng</option>
                    <option value="DA_HUY">Đã hủy</option>
                </select>
                <span asp-validation-for="TrangThai" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="GhiChu" class="control-label">Ghi chú</label>
                <input asp-for="GhiChu" class="form-control" />
                <span asp-validation-for="GhiChu" class="text-danger"></span>
            </div>
            
            <div class="form-group mt-3">
                <input type="submit" value="Lưu" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Quay lại danh sách</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
