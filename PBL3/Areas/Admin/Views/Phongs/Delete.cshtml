@model PBL3.Models.Phong

@{
    ViewData["Title"] = "Xóa phòng";
}

<h1>Xóa phòng</h1>

<h3>Bạn có chắc chắn muốn xóa phòng này?</h3>
<div>
    <h4>Phong</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MaPhong)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MaPhong)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SoPhong)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SoPhong)
        </dd>
        <dt class = "col-sm-2">
            Loại phòng
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MaLoaiPhongNavigation.TenLoaiPhong)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Tang)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Tang)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TrangThai)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TrangThai)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.GhiChu)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.GhiChu)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="MaPhong" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="Index">Quay lại danh sách</a>
    </form>
</div>
