@model PBL3.Models.LinkAnh

@{
    ViewData["Title"] = "Chi tiết link ảnh";
}

<h1 class="h3 fw-bold mb-3">Chi tiết link ảnh</h1>

<div class="card-custom">
    <div class="row g-4">
        <div class="col-md-4">
            <img src="@Model.UrlAnh" alt="@Model.ThongTin" class="img-fluid rounded border" onerror="this.style.display='none';" />
        </div>
        <div class="col-md-8">
            <dl class="row mb-0">
                <dt class="col-sm-3">Mã ảnh</dt>
                <dd class="col-sm-9">@Model.MaAnh</dd>

                <dt class="col-sm-3">Đối tượng</dt>
                <dd class="col-sm-9">@Model.DoiTuong</dd>

                <dt class="col-sm-3">URL ảnh</dt>
                <dd class="col-sm-9 text-break">@Model.UrlAnh</dd>

                <dt class="col-sm-3">Thông tin</dt>
                <dd class="col-sm-9">@Model.ThongTin</dd>

                <dt class="col-sm-3">Thứ tự</dt>
                <dd class="col-sm-9">@Model.ThuTu</dd>

                <dt class="col-sm-3">Ảnh đại diện</dt>
                <dd class="col-sm-9">@(Model.LaAnhDaiDien ? "Có" : "Không")</dd>

                <dt class="col-sm-3">Trạng thái</dt>
                <dd class="col-sm-9">@Model.TrangThai</dd>
            </dl>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.MaAnh" class="btn btn-primary">Sửa</a>
    <a asp-action="Index" class="btn btn-light border">Quay lại</a>
</div>
