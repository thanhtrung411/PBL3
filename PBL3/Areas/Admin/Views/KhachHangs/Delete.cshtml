@model PBL3.Models.KhachHang

@{
    ViewData["Title"] = "Xóa khách hàng";
}

<h1>Xóa khách hàng</h1>

<h3>Bạn có chắc chắn muốn xóa khách hàng này?</h3>
<div>
    <h4>KhachHang</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">Mã KH</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.MaKh)</dd>
        
        <dt class = "col-sm-2">Họ Tên</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.HoTen)</dd>
        
        <dt class = "col-sm-2">CCCD</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Cccd)</dd>
        
        <dt class = "col-sm-2">Số điện thoại</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.SoDienThoai)</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="MaKh" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="Index">Quay lại danh sách</a>
    </form>
</div>
