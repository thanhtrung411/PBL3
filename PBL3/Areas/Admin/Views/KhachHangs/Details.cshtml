@model PBL3.Models.KhachHang

@{
    ViewData["Title"] = "Chi tiết khách hàng";
}

<h1>Chi tiết khách hàng</h1>

<div>
    <h4>KhachHang</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">Mã KH</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.MaKh)</dd>
        
        <dt class = "col-sm-2">Họ Tên</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.HoTen)</dd>
        
        <dt class = "col-sm-2">Giới tính</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.GioiTinh)</dd>
        
        <dt class = "col-sm-2">Ngày sinh</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.NgaySinh)</dd>
        
        <dt class = "col-sm-2">CCCD</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Cccd)</dd>
        
        <dt class = "col-sm-2">Số điện thoại</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.SoDienThoai)</dd>
        
        <dt class = "col-sm-2">Email</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Email)</dd>
        
        <dt class = "col-sm-2">Địa chỉ</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.DiaChi)</dd>
        
        <dt class = "col-sm-2">Quốc tịch</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.QuocTich)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.MaKh">Edit</a> |
    <a asp-action="Index">Quay lại danh sách</a>
</div>
