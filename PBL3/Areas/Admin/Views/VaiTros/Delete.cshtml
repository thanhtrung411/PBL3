@model PBL3.Models.VaiTro

@{
    ViewData["Title"] = "Xóa vai trò";
}

<h1>Xóa vai trò</h1>

<h3>Bạn có chắc chắn muốn xóa vai trò này?</h3>
<div>
    <h4>VaiTro</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MaVaiTro)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MaVaiTro)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TenVaiTro)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TenVaiTro)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MoTa)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MoTa)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="MaVaiTro" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="Index">Quay lại danh sách</a>
    </form>
</div>
