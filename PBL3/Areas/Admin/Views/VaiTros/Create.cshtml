@model PBL3.Models.VaiTro

@{
    ViewData["Title"] = "Thêm vai trò mới";
}

<h1>Thêm vai trò mới</h1>

<h4>VaiTro</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="MaVaiTro" class="control-label"></label>
                <input asp-for="MaVaiTro" class="form-control" />
                <span asp-validation-for="MaVaiTro" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TenVaiTro" class="control-label"></label>
                <input asp-for="TenVaiTro" class="form-control" />
                <span asp-validation-for="TenVaiTro" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MoTa" class="control-label"></label>
                <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
                <span asp-validation-for="MoTa" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Tạo mới" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Quay lại danh sách</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
