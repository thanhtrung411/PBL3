@{
    var controller = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    var title = ViewData["Title"]?.ToString() ?? "Source CRUD";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - Source CRUD</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PBL3.styles.css" asp-append-version="true" />
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-header">
            <h2>Hotel Manager</h2>
            <p>Source CRUD</p>
        </div>

        <nav class="d-flex flex-column gap-1 flex-grow-1" aria-label="Source CRUD navigation">
            <a class="nav-item-sidebar @(controller == "Admin" ? "active" : "")" asp-area="Admin" asp-controller="Admin" asp-action="Index">
                <i class="bi bi-grid-1x2"></i>
                <span>Tổng quan</span>
            </a>
            <a class="nav-item-sidebar @(controller == "Phongs" ? "active" : "")" asp-area="Admin" asp-controller="Phongs" asp-action="Index">
                <i class="bi bi-door-closed"></i>
                <span>Phòng</span>
            </a>
            <a class="nav-item-sidebar @(controller == "LoaiPhongs" ? "active" : "")" asp-area="Admin" asp-controller="LoaiPhongs" asp-action="Index">
                <i class="bi bi-layers"></i>
                <span>Loại phòng</span>
            </a>
            <a class="nav-item-sidebar @(controller == "BangGiaPhongs" ? "active" : "")" asp-area="Admin" asp-controller="BangGiaPhongs" asp-action="Index">
                <i class="bi bi-tags"></i>
                <span>Bảng giá phòng</span>
            </a>
            <a class="nav-item-sidebar @(controller == "KhachHangs" ? "active" : "")" asp-area="Admin" asp-controller="KhachHangs" asp-action="Index">
                <i class="bi bi-people"></i>
                <span>Khách hàng</span>
            </a>
            <a class="nav-item-sidebar @(controller == "DatPhongs" ? "active" : "")" asp-area="Admin" asp-controller="DatPhongs" asp-action="Index">
                <i class="bi bi-calendar-check"></i>
                <span>Đặt phòng</span>
            </a>
            <a class="nav-item-sidebar @(controller == "HoaDons" ? "active" : "")" asp-area="Admin" asp-controller="HoaDons" asp-action="Index">
                <i class="bi bi-receipt"></i>
                <span>Hóa đơn</span>
            </a>
            <a class="nav-item-sidebar @(controller == "ChiTietHoaDons" ? "active" : "")" asp-area="Admin" asp-controller="ChiTietHoaDons" asp-action="Index">
                <i class="bi bi-list-check"></i>
                <span>Chi tiết hóa đơn</span>
            </a>
            <a class="nav-item-sidebar @(controller == "DichVus" ? "active" : "")" asp-area="Admin" asp-controller="DichVus" asp-action="Index">
                <i class="bi bi-bell"></i>
                <span>Dịch vụ</span>
            </a>
            <a class="nav-item-sidebar @(controller == "NhanViens" ? "active" : "")" asp-area="Admin" asp-controller="NhanViens" asp-action="Index">
                <i class="bi bi-person-badge"></i>
                <span>Nhân viên</span>
            </a>
            <a class="nav-item-sidebar @(controller == "TaiKhoans" ? "active" : "")" asp-area="Admin" asp-controller="TaiKhoans" asp-action="Index">
                <i class="bi bi-person-lock"></i>
                <span>Tài khoản</span>
            </a>
            <a class="nav-item-sidebar @(controller == "VaiTros" ? "active" : "")" asp-area="Admin" asp-controller="VaiTros" asp-action="Index">
                <i class="bi bi-shield-check"></i>
                <span>Vai trò</span>
            </a>
            <a class="nav-item-sidebar @(controller == "MaGiamGias" ? "active" : "")" asp-area="Admin" asp-controller="MaGiamGias" asp-action="Index">
                <i class="bi bi-ticket-perforated"></i>
                <span>Mã giảm giá</span>
            </a>
            <a class="nav-item-sidebar @(controller == "LinkAnhs" ? "active" : "")" asp-area="Admin" asp-controller="LinkAnhs" asp-action="Index">
                <i class="bi bi-images"></i>
                <span>Link ảnh</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <a class="nav-item-sidebar" asp-area="" asp-controller="Booking" asp-action="Index">
                <i class="bi bi-arrow-left"></i>
                <span>Về trang khách</span>
            </a>
        </div>
    </aside>

    <main class="main-wrapper">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }

        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
