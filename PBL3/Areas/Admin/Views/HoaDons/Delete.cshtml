@model PBL3.Models.HoaDon

@{
    ViewData["Title"] = "Xóa Hóa đơn";
}

<h1>Xóa Hóa đơn</h1>

<h3>Bạn có chắc chắn muốn xóa hóa đơn này (Không khuyến khích)?</h3>
<div>
    <h4>Hóa đơn</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-3">Mã Hóa Đơn</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.MaHoaDon)</dd>
        
        <dt class = "col-sm-3">Mã Đặt Phòng</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.MaDatPhong)</dd>

        <dt class = "col-sm-3">TỔNG THANH TOÁN</dt>
        <dd class = "col-sm-9 text-danger">@Html.DisplayFor(model => model.TongThanhToan)</dd>

        <dt class = "col-sm-3">Trạng thái</dt>
        <dd class = "col-sm-9">@Html.DisplayFor(model => model.TrangThai)</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="MaHoaDon" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="Index">Quay lại danh sách</a>
    </form>
</div>
