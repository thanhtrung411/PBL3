@model PBL3.Models.HoaDon

@{
    ViewData["Title"] = "Tạo mới Hóa đơn";
}

<h1>Tạo mới Hóa đơn</h1>

<h4>Hóa Đơn</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group">
                <label asp-for="MaHoaDon" class="control-label">Mã Hóa Đơn</label>
                <input asp-for="MaHoaDon" class="form-control" />
                <span asp-validation-for="MaHoaDon" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="MaDatPhong" class="control-label">Mã Lịch Đặt Phòng</label>
                <select asp-for="MaDatPhong" class="form-control" asp-items="ViewBag.MaDatPhong"></select>
                <span asp-validation-for="MaDatPhong" class="text-danger"></span>
            </div>

            <div class="form-group border border-primary p-3 my-2 rounded">
                <label asp-for="TongTienPhong" class="control-label">Tổng tiền phòng</label>
                <input asp-for="TongTienPhong" type="number" step="0.01" class="form-control mb-2" />

                <label asp-for="TongTienDichVu" class="control-label">Tổng tiền dịch vụ</label>
                <input asp-for="TongTienDichVu" type="number" step="0.01" class="form-control mb-2" />

                <label asp-for="TienDatCoc" class="control-label">Tiền đặt cọc</label>
                <input asp-for="TienDatCoc" type="number" step="0.01" class="form-control mb-2" />
            </div>

            <div class="form-group">
                <label asp-for="MaGiamGiaPhong" class="control-label">Mã giảm giá</label>
                <select asp-for="MaGiamGiaPhong" class="form-control" asp-items="ViewBag.MaGiamGiaPhong">
                    <option value="">-- Không áp dụng mã --</option>
                </select>
                <span asp-validation-for="MaGiamGiaPhong" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TienGiamGiaPhong" class="control-label">Tiền giảm được</label>
                <input asp-for="TienGiamGiaPhong" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="TienGiamGiaPhong" class="text-danger"></span>
            </div>

            <div class="form-group bg-light p-3 my-2 border border-danger">
                <label asp-for="TongThanhToan" class="control-label"><b>TỔNG CẦN THANH TOÁN</b></label>
                <input asp-for="TongThanhToan" type="number" step="0.01" class="form-control mb-2 text-danger font-weight-bold" />
                
                <label asp-for="SoTienDaThanhToan" class="control-label">Số tiền khách đã đưa</label>
                <input asp-for="SoTienDaThanhToan" type="number" step="0.01" class="form-control mb-2 text-success font-weight-bold" />
                
                <label asp-for="NgayThanhToanCuoi" class="control-label">Ngày thanh toán ghi nhận</label>
                <input asp-for="NgayThanhToanCuoi" type="datetime-local" class="form-control mb-2" />
                
                <label asp-for="PhuongThucThanhToan" class="control-label">PPTT</label>
                <select asp-for="PhuongThucThanhToan" class="form-control">
                    <option value="Tiền mặt">Tiền mặt</option>
                    <option value="Chuyển khoản">Chuyển khoản</option>
                    <option value="Thẻ">Thẻ Tín dụng</option>
                    <option value="QR">QR Code</option>
                </select>
                <span asp-validation-for="PhuongThucThanhToan" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TrangThai" class="control-label">Trạng thái Hóa đơn</label>
                <select asp-for="TrangThai" class="form-control">
                    <option value="CHUA_THANH_TOAN">Chưa thanh toán</option>
                    <option value="THANH_TOAN_MOT_PHAN">Thanh toán 1 phần</option>
                    <option value="DA_THANH_TOAN">Đã thanh toán hết</option>
                    <option value="DA_HUY">Đã hủy bỏ</option>
                </select>
                <span asp-validation-for="TrangThai" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="GhiChu" class="control-label">Ghi chú thêm</label>
                <input asp-for="GhiChu" class="form-control" />
                <span asp-validation-for="GhiChu" class="text-danger"></span>
            </div>
            
            <div class="form-group mt-3">
                <input type="submit" value="Tạo mới" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Quay lại danh sách</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
