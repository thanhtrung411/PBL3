@model PBL3.Models.NhanVien

@{
    ViewData["Title"] = "Xóa nhân viên";
}

<h1>Xóa nhân viên</h1>

<h3>Bạn có chắc chắn muốn xóa nhân viên này?</h3>
<div>
    <h4>NhanVien</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">Mã NV</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.MaNv)</dd>
        
        <dt class = "col-sm-2">Họ Tên</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.HoTen)</dd>
        
        <dt class = "col-sm-2">Số điện thoại</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.SoDienThoai)</dd>
        
        <dt class = "col-sm-2">Trạng thái</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.TrangThai)</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="MaNv" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="Index">Quay lại danh sách</a>
    </form>
</div>
